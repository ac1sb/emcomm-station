#!/bin/bash
# Hardware and service status for the Diagnostics screen (and for SSH sessions).
# Usage: emcomm-diag [usb|ports|audio|services|events|rig|gps|all]
set -u

# shellcheck disable=SC1091
[ -r /etc/emcomm/station.env ] && . /etc/emcomm/station.env
RIGCTLD_HOST=${RIGCTLD_HOST:-127.0.0.1}
RIGCTLD_PORT=${RIGCTLD_PORT:-4532}

section() { printf '\n== %s ==\n' "$1"; }

show_usb() {
  section "USB devices (vendor:product)"
  lsusb | sed -E 's/^Bus [0-9]+ Device [0-9]+: ID //' | grep -v -i 'root hub'
}

show_ports() {
  section "Radio ports"
  for dev in /dev/rig-cat /dev/rig-ptt; do
    if [ -e "$dev" ]; then
      printf '%-14s -> %s\n' "$dev" "$(readlink -f "$dev")"
    else
      printf '%-14s not present\n' "$dev"
    fi
  done
  section "All USB serial ports"
  if [ -d /dev/serial/by-id ]; then
    for link in /dev/serial/by-id/*; do
      printf '%s -> %s\n' "${link##*/}" "$(readlink -f "$link")"
    done
  else
    echo "none"
  fi
}

show_audio() {
  section "Sound cards"
  aplay -l 2>/dev/null | grep '^card' || echo "no playback devices"
  if aplay -l 2>/dev/null | grep -q 'rigaudio'; then
    echo "radio sound card: rigaudio (found)"
  else
    echo "radio sound card: rigaudio NOT found"
  fi
  local dev
  for dev in SINK:speaker SOURCE:microphone; do
    printf 'default %s: %s\n' "${dev#*:}" \
      "$(wpctl inspect "@DEFAULT_AUDIO_${dev%%:*}@" 2>/dev/null | sed -n 's/.*node.description = "\(.*\)"/\1/p')"
  done
  # Everything that isn't a radio app plays here instead of the radio (Settings > Audio).
  printf 'listening speaker: %s\n' "$(emcomm-audio speaker 2>/dev/null || echo 'none (other sound is silent)')"
}

show_services() {
  section "Services"
  printf '%-10s %s\n' rigctld "$(systemctl is-active rigctld 2>/dev/null)"
  local name port
  while read -r name port; do
    if (exec 3<>"/dev/tcp/127.0.0.1/$port") 2>/dev/null; then
      printf '%-10s running (port %s)\n' "$name" "$port"
    else
      printf '%-10s not running\n' "$name"
    fi
  done <<'EOF'
Pat 8080
VARA 8300
ARDOP 8515
Direwolf 8000
EOF
}

show_rig() {
  section "Rig control"
  local freq
  if freq=$(rigctl -m 2 -r "${RIGCTLD_HOST}:${RIGCTLD_PORT}" f 2>/dev/null) && [ -n "$freq" ]; then
    echo "rigctld OK, frequency ${freq} Hz"
  else
    echo "rigctld not answering on ${RIGCTLD_HOST}:${RIGCTLD_PORT}"
  fi
}

show_gps() {
  section "GPS and time"
  if [ -e /dev/gps0 ]; then
    printf '%-14s -> %s\n' /dev/gps0 "$(readlink -f /dev/gps0)"
  else
    echo "/dev/gps0      not present (plug in a USB GPS, or pick its port in Settings)"
  fi
  local tpv
  tpv=$(timeout 4 gpspipe -w -n 12 2>/dev/null | grep '"class":"TPV"' | tail -n 1)
  case "$tpv" in
    *'"mode":3'*) echo "fix: 3D" ;;
    *'"mode":2'*) echo "fix: 2D" ;;
    "") echo "fix: no answer from gpsd" ;;
    *) echo "fix: none yet (needs a view of the sky)" ;;
  esac
  [ -n "$tpv" ] && echo "$tpv" | grep -oE '"(lat|lon|time)":[^,]*' | tr '\n' ' ' && echo
  chronyc -n tracking 2>/dev/null | grep -E '^(Reference ID|System time|Leap status)' ||
    echo "chrony not running"
  command -v emcomm-mesh-nodes >/dev/null && emcomm-mesh-nodes --show-position
}

show_events() {
  section "Recent USB events (last 30 min)"
  journalctl -k --since "-30min" --no-pager -o short-monotonic 2>/dev/null |
    grep -iE 'usb [0-9-]+:|ttyUSB|cp210x|snd-usb|USB Audio' | tail -n 12 ||
    echo "none"
}

case "${1:-all}" in
  usb) show_usb ;;
  ports) show_ports ;;
  audio) show_audio ;;
  services) show_services ;;
  rig) show_rig ;;
  events) show_events ;;
  gps) show_gps ;;
  all) show_usb; show_ports; show_audio; show_services; show_rig; show_gps; show_events ;;
  *) echo "usage: $0 [usb|ports|audio|services|events|rig|gps|all]" >&2; exit 2 ;;
esac
