#!/usr/bin/env python3
"""The files the Files page shows: Winlink attachments, Downloads and SSTV pictures.

  emcomm-files --list              one JSON line per file, newest first
  emcomm-files --extract MSG N     save attachment N of a Winlink message (.b2f) in
                                   ~/Winlink attachments/MID/ and print its path
  emcomm-files --pdf FILE          turn a Word, Excel, PowerPoint or similar file into a
                                   PDF with LibreOffice (kept in ~/.cache/emcomm/files)
                                   and print its path

Attachments are read straight out of Pat's mailbox, so they needn't be downloaded
first. Nothing here needs the internet.
"""

import email.errors
import email.header
import glob
import hashlib
import json
import os
import shutil
import subprocess
import sys
import time

HOME = os.path.expanduser("~")
MAILBOX = os.environ.get("EMCOMM_PAT_MAILBOX", os.path.join(HOME, ".local/share/pat/mailbox"))
ATTACHMENTS = os.path.join(HOME, "Winlink attachments")
DOWNLOADS = os.path.join(HOME, "Downloads")
SSTV = os.path.join(HOME, "qsstv/rx_sstv")  # where QSSTV saves the pictures it receives
CACHE = os.path.join(HOME, ".cache/emcomm/files")
BOXES = {"in": "Inbox", "out": "Outbox", "sent": "Sent", "archive": "Archive"}

KINDS = {
    "pdf": {".pdf"},
    "image": {".png", ".jpg", ".jpeg", ".gif", ".bmp", ".tif", ".tiff", ".webp"},
    "text": {".txt", ".csv", ".log", ".md", ".json", ".xml", ".ini", ".conf", ".kml", ".gpx", ".213"},
    "office": {".doc", ".docx", ".odt", ".rtf", ".xls", ".xlsx", ".ods", ".ppt", ".pptx", ".odp", ".wpd"},
}


def kind_of(name):
    """pdf, image, text, office (LibreOffice turns it into a PDF) or other."""
    ext = os.path.splitext(name)[1].lower()
    return next((kind for kind, exts in KINDS.items() if ext in exts), "other")


def decode(value):
    """A header value, with any =?utf-8?...?= words (Winlink Express writes them) decoded."""
    try:
        return str(email.header.make_header(email.header.decode_header(value)))
    except (ValueError, LookupError, email.errors.HeaderParseError):
        return value


def read_b2f(path, want=None):
    """A Winlink (B2F) message: (headers, [(name, size)], data of file `want` or None).
    Headers, a blank line, the body, then each file, each followed by CRLF, in the order
    of the File: headers ("File: SIZE NAME")."""
    with open(path, "rb") as f:
        raw = f.read()
    raw = raw.lstrip(b"\r\n \t")
    end = raw.find(b"\r\n\r\n")
    sep = 4
    if end < 0:
        end, sep = raw.find(b"\n\n"), 2
    if end < 0:
        raise ValueError("no end to the header")
    headers, files = {}, []
    for line in raw[:end].decode("utf-8", errors="replace").splitlines():
        key, _, value = line.partition(":")
        key, value = key.strip(), value.strip()
        if key.lower() == "file":
            size, _, name = value.partition(" ")
            files.append((decode(name.strip()), int(size)))
        else:
            headers.setdefault(key, value)
    data = None
    if want is not None:
        pos = end + sep + int(headers.get("Body", "0") or 0)
        for i, (_name, size) in enumerate(files):
            if raw[pos:pos + 2] == b"\r\n":
                pos += 2
            if i == want:
                data = raw[pos:pos + size]
                if len(data) != size:
                    raise ValueError("the message is cut short")
                break
            pos += size
    return headers, files, data


def utc(seconds):
    return time.strftime("%Y-%m-%d %H:%MZ", time.gmtime(seconds))


def winlink_files(mailbox=MAILBOX):
    rows = []
    for path in glob.glob(os.path.join(mailbox, "*", "*", "*.b2f")):
        box = os.path.basename(os.path.dirname(path))
        if box not in BOXES:
            continue
        try:
            headers, files, _ = read_b2f(path)
        except (OSError, ValueError):
            continue
        when = headers.get("Date", "")  # 2026/10/26 14:05, in UTC
        try:
            sort = time.mktime(time.strptime(when, "%Y/%m/%d %H:%M")) - time.timezone
        except ValueError:
            sort = os.path.getmtime(path)
        for i, (name, size) in enumerate(files):
            rows.append({"source": "winlink", "name": os.path.basename(name) or f"attachment {i + 1}",
                         "kind": kind_of(name), "size": size, "time": sort, "when": utc(sort),
                         "message": path, "index": i, "mid": headers.get("Mid", ""), "box": BOXES[box],
                         "from": headers.get("From", ""), "subject": decode(headers.get("Subject", ""))})
    return rows


def folder_files(folder, source):
    rows = []
    for path in glob.glob(os.path.join(folder, "*")):
        name = os.path.basename(path)
        if not os.path.isfile(path) or name.startswith(".") or name.endswith((".part", ".crdownload")):
            continue
        kind = kind_of(name)
        if source == "sstv" and kind != "image":
            continue
        st = os.stat(path)
        rows.append({"source": source, "name": name, "kind": kind, "size": st.st_size,
                     "time": st.st_mtime, "when": utc(st.st_mtime), "path": path})
    return rows


def all_files():
    rows = winlink_files() + folder_files(DOWNLOADS, "downloads") + folder_files(SSTV, "sstv")
    return sorted(rows, key=lambda r: r["time"], reverse=True)


def safe_name(name):
    name = os.path.basename(name.replace("\\", "/")).strip() or "attachment"
    return "".join(c if c.isprintable() and c not in '/\0' else "_" for c in name)


def extract(message, index, dest=ATTACHMENTS):
    """Save one attachment of a message; the path. A copy already there is kept (it may
    have been edited), unless it was cut short."""
    headers, files, data = read_b2f(message, int(index))
    if data is None:
        raise ValueError("no such attachment")
    folder = os.path.join(dest, safe_name(headers.get("Mid", "") or os.path.basename(message)[:-4]))
    path = os.path.join(folder, safe_name(files[int(index)][0]))
    if os.path.exists(path) and os.path.getsize(path) >= len(data):
        return path
    os.makedirs(folder, exist_ok=True)
    with open(path + ".part", "wb") as f:
        f.write(data)
    os.replace(path + ".part", path)
    return path


def to_pdf(path, cache=CACHE, soffice=None):
    """A PDF of an office file, made by LibreOffice once and kept until the file changes."""
    soffice = soffice or shutil.which("soffice") or shutil.which("libreoffice")
    if not soffice:
        raise FileNotFoundError("LibreOffice isn't installed")
    st = os.stat(path)
    key = hashlib.sha1(f"{os.path.abspath(path)}|{st.st_mtime_ns}|{st.st_size}".encode()).hexdigest()[:16]
    out_dir = os.path.join(cache, key)
    pdf = os.path.join(out_dir, os.path.splitext(os.path.basename(path))[0] + ".pdf")
    if os.path.exists(pdf):
        return pdf
    os.makedirs(out_dir, exist_ok=True)
    # Its own profile, so a LibreOffice window that's open doesn't swallow the job.
    profile = "file://" + os.path.join(cache, "profile")
    result = subprocess.run([soffice, f"-env:UserInstallation={profile}", "--headless", "--convert-to", "pdf",
                             "--outdir", out_dir, path], capture_output=True, text=True, timeout=180, check=False)
    if not os.path.exists(pdf):
        raise RuntimeError((result.stderr or result.stdout or "LibreOffice couldn't read it").strip()[-300:])
    return pdf


def main(argv):
    try:
        if argv == ["--list"]:
            for row in all_files():
                print(json.dumps(row))
        elif len(argv) == 3 and argv[0] == "--extract":
            print(extract(argv[1], argv[2]))
        elif len(argv) == 2 and argv[0] == "--pdf":
            print(to_pdf(argv[1]))
        else:
            print(__doc__.strip(), file=sys.stderr)
            return 2
    except (OSError, ValueError, RuntimeError, subprocess.TimeoutExpired) as exc:
        print(exc, file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
