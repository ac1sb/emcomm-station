def tail_file(path, lines=400):
    try:
        with open(os.path.expanduser(path), encoding="utf-8", errors="replace") as f:
            return "".join(f.readlines()[-lines:]) or "(empty)\n"
    except FileNotFoundError:
        return "Nothing logged yet.\n"
    except OSError as exc:
        return f"Can't read {path}: {exc}\n"


def b2f_headers(path):
    """The header block of a Winlink (B2F) message: everything before the first blank line."""
    headers = {}
    with open(path, "rb") as f:
        for raw in f:
            line = raw.decode("utf-8", errors="replace").rstrip("\r\n")
            if not line:
                break
            key, _, value = line.partition(":")
            headers.setdefault(key.strip(), value.strip())
    return headers


def pat_mail_summary(callsign, limit=200):
    rows = []
    for folder in ("in", "out", "sent", "archive"):
        for path in glob.glob(os.path.join(PAT_MAILBOX, callsign, folder, "*.b2f")):
            try:
                h = b2f_headers(path)
            except OSError:
                continue
            rows.append((h.get("Date", ""), folder, h.get("From", ""), h.get("To", ""), h.get("Subject", "")))
    if not rows:
        return "No Winlink messages yet.\n"
    rows.sort(reverse=True)
    lines = [f"{'Date (UTC)':<17} {'Box':<8} {'From':<12} {'To':<12} Subject"]
    lines += [f"{d:<17} {box:<8} {frm[:12]:<12} {to[:12]:<12} {subj}" for d, box, frm, to, subj in rows[:limit]]
    return "\n".join(lines) + "\n"


def note_line(call, note, freq=None, mode=None, when=None):
    when = when or time.gmtime()
    return (f"{time.strftime('%Y-%m-%d %H:%MZ', when)}  {freq or '-':>12}  {mode or '-':<6}  "
            f"{call.upper() or '-':<10}  {' '.join(note.split())}\n")


class Launcher(Gtk.Window):
    def __init__(self, config):
        super().__init__(title="Emcomm-CNC")
        self.config = config
        self.station = load_station()
        self.presets = load_presets()
        self.models = load_hamlib_models()
        self.choices = {}
        self._filling = False
        self.set_default_size(1024, 600)

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        root.get_style_context().add_class("page")
        self.add(root)
        root.pack_start(self._topbar(), False, False, 0)

        self.stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE)
        self.stack.add_named(self._home_page(), "home")
        self.stack.add_named(self._diag_page(), "diagnostics")
        self.stack.add_named(self._settings_page(), "settings")
        self.stack.add_named(self._logs_page(), "logs")
        root.pack_start(self.stack, True, True, 0)

        self._tick_clock()
        GLib.timeout_add_seconds(1, self._tick_clock)
        self._poll_status()
        GLib.timeout_add_seconds(5, self._poll_status)
        self.connect("key-press-event", self._on_key)

    # ---- keyboard ------------------------------------------------------

    def _on_key(self, _widget, event):
        """Esc/F1 Home, F2 Diagnostics, F3 Settings, F4 Logs, 1-9 open a tile on Home."""
        pages = {Gdk.KEY_Escape: "home", Gdk.KEY_F1: "home",
                 Gdk.KEY_F2: "diagnostics", Gdk.KEY_F3: "settings", Gdk.KEY_F4: "logs"}
        if event.keyval in pages:
            self.stack.set_visible_child_name(pages[event.keyval])
            return True
        if self.stack.get_visible_child_name() == "home" and Gdk.KEY_1 <= event.keyval <= Gdk.KEY_9:
            index = event.keyval - Gdk.KEY_1
            if index < len(self.tiles) and self.tiles[index].get_sensitive():
                self.tiles[index].clicked()
            return True
        return False

    # ---- top bar -------------------------------------------------------

    def _topbar(self):
        bar = Gtk.Box(spacing=20)
        bar.get_style_context().add_class("topbar")
        self.call_label = Gtk.Label()
        self.call_label.get_style_context().add_class("callsign")
        bar.pack_start(self.call_label, False, False, 0)
        self.grid_label = Gtk.Label()
        self.grid_label.get_style_context().add_class("muted")
        bar.pack_start(self.grid_label, False, False, 0)
        self._show_station()

        self.clock = Gtk.Label()
        self.clock.get_style_context().add_class("mono")
        bar.pack_end(self.clock, False, False, 0)
        self.audio_status = Gtk.Label()
        bar.pack_end(self.audio_status, False, False, 0)
        self.rig_status = Gtk.Label()
        bar.pack_end(self.rig_status, False, False, 0)
        return bar

    def _show_station(self):
        self.call_label.set_text(self.station.get("callsign", ""))
        self.grid_label.set_text(f"Grid {self.station.get('grid', '')}")

    def _tick_clock(self):
        self.clock.set_text(time.strftime("%H:%M UTC", time.gmtime()))
        return True

    def _poll_status(self):
        def work():
            freq = format_freq(rigctld_query(*RIGCTLD, "f"))
            audio = os.path.exists("/proc/asound/rigaudio")
            GLib.idle_add(self._show_status, freq, audio)

        threading.Thread(target=work, daemon=True).start()
        return True

    def _show_status(self, freq, audio):
        if freq:
            self.rig_status.set_markup(f"<span foreground='#4FC3B8'>●</span>  Rig  <tt>{freq}</tt>")
        else:
            self.rig_status.set_markup("<span foreground='#9AA0A6'>○</span>  Rig not connected")
        dot = "<span foreground='#4FC3B8'>●</span>" if audio else "<span foreground='#9AA0A6'>○</span>"
        self.audio_status.set_markup(f"{dot}  Radio audio")
        self._refresh_tiles()
        return False

    # ---- home ----------------------------------------------------------

    def _home_page(self):
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16, margin=20)
        grid = Gtk.Grid(column_spacing=12, row_spacing=12, column_homogeneous=True, row_homogeneous=True)
        self.tiles = []
        for i, app in enumerate(self.config.get("apps", [])):
            tile = self._tile(app, i + 1 if i < 9 else None)
            self.tiles.append(tile)
            grid.attach(tile, i % 3, i // 3, 1, 1)
        page.pack_start(grid, True, True, 0)

        nav = Gtk.Box(spacing=12, homogeneous=True)
        nav.pack_start(self._navbtn("Diagnostics  F2", lambda *_: self.stack.set_visible_child_name("diagnostics")), True, True, 0)
        nav.pack_start(self._navbtn("Settings  F3", lambda *_: self.stack.set_visible_child_name("settings")), True, True, 0)
        nav.pack_start(self._navbtn("Logs  F4", lambda *_: self.stack.set_visible_child_name("logs")), True, True, 0)
        nav.pack_start(self._navbtn("Power", self._power_dialog), True, True, 0)
        page.pack_end(nav, False, False, 0)
        return page

    def _tile(self, app, key=None):
        btn = Gtk.Button()
        btn.get_style_context().add_class("tile")
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        btn.app = app
        btn.icon_slot = Gtk.Box()
        self._set_tile_icon(btn)
        top = Gtk.Box()
        top.pack_start(btn.icon_slot, True, True, 0)
        if key:
            hint = Gtk.Label(label=str(key), yalign=0)
            hint.get_style_context().add_class("key-hint")
            top.pack_end(hint, False, False, 0)
        name = Gtk.Label(label=app.get("name", ""), xalign=0)
        name.get_style_context().add_class("tile-name")
        detail = Gtk.Label(xalign=0)
        detail.get_style_context().add_class("tile-detail")
        box.pack_start(top, True, True, 0)
        box.pack_start(name, False, False, 0)
        box.pack_start(detail, False, False, 0)
        btn.add(box)
        btn.detail = detail
        btn.connect("clicked", self._tile_clicked)
        # Long-press (touch), right-click or the Menu key: change the tile's icon.
        btn.long_press = Gtk.GestureLongPress.new(btn)
        btn.long_press.set_propagation_phase(Gtk.PropagationPhase.CAPTURE)
        btn.long_press.connect("pressed", lambda *_: self._icon_menu(btn))
        btn.connect("button-press-event", lambda _w, e: e.button == 3 and (self._icon_menu(btn) or True))
        btn.connect("popup-menu", lambda *_: self._icon_menu(btn) or True)
        self._update_tile(btn)
        return btn

    def _set_tile_icon(self, btn):
        for child in btn.icon_slot.get_children():
            btn.icon_slot.remove(child)
        path = find_icon(btn.app.get("icon", ""))
        widget = None
        if path:
            try:
                pixbuf = GdkPixbuf.Pixbuf.new_from_file_at_scale(path, ICON_SIZE, ICON_SIZE, True)
                widget = Gtk.Image.new_from_pixbuf(pixbuf)
            except GLib.Error:
                widget = None
        if widget is None:
            # No icon, or it can't be read: show the short code instead.
            widget = Gtk.Label(label=btn.app.get("code", ""))
            widget.get_style_context().add_class("tile-code")
        widget.set_halign(Gtk.Align.START)
        btn.icon_slot.pack_start(widget, False, False, 0)
        btn.icon_slot.show_all()

    def _icon_menu(self, btn):
        if not btn.app.get("icon"):
            return
        menu = Gtk.Menu()
        change = Gtk.MenuItem(label=f"Change {btn.app['name']} icon…")
        change.connect("activate", lambda *_: self._choose_icon(btn))
        menu.append(change)
        if user_icon(btn.app["icon"]):
            reset = Gtk.MenuItem(label="Use the standard icon")
            reset.connect("activate", lambda *_: self._reset_icon(btn))
            menu.append(reset)
        menu.show_all()
        menu.attach_to_widget(btn)
        menu.popup_at_widget(btn, Gdk.Gravity.CENTER, Gdk.Gravity.NORTH_WEST, None)

    def _choose_icon(self, btn):
        mount_usb_sticks()
        dialog = Gtk.FileChooserDialog(title=f"Pick an image for {btn.app['name']}", transient_for=self,
                                       action=Gtk.FileChooserAction.OPEN)
        dialog.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Use this image", Gtk.ResponseType.OK)
        images = Gtk.FileFilter()
        images.set_name("Images (SVG, PNG, JPG)")
        for pattern in ("*.svg", "*.png", "*.jpg", "*.jpeg", "*.SVG", "*.PNG", "*.JPG", "*.JPEG"):
            images.add_pattern(pattern)
        dialog.add_filter(images)
        for folder in [os.path.expanduser("~/Downloads")] + glob.glob(f"/media/{os.environ.get('USER', '')}/*"):
            if os.path.isdir(folder):
                dialog.add_shortcut_folder(folder)
        dialog.set_size_request(800, 500)
        response = dialog.run()
        path = dialog.get_filename()
        dialog.destroy()
        if response != Gtk.ResponseType.OK or not path:
            return
        try:
            GdkPixbuf.Pixbuf.new_from_file_at_scale(path, ICON_SIZE, ICON_SIZE, True)
        except GLib.Error:
            self._message("That file isn't an image the station can show.")
            return
        remove_user_icon(btn.app["icon"])
        os.makedirs(USER_ICONS, exist_ok=True)
        ext = os.path.splitext(path)[1].lower().replace(".jpeg", ".jpg")
        shutil.copyfile(path, os.path.join(USER_ICONS, btn.app["icon"] + ext))
        self._set_tile_icon(btn)

    def _reset_icon(self, btn):
        remove_user_icon(btn.app["icon"])
        self._set_tile_icon(btn)

    def _message(self, text):
        dialog = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.INFO,
                                   buttons=Gtk.ButtonsType.OK, text=text)
        dialog.run()
        dialog.destroy()

    @staticmethod
    def _app_state(app):
        """'ready', 'setup' (installed, needs first-time setup) or 'missing'."""
        if shutil.which(app.get("command", "")) is None:
            return "missing"
        ready = app.get("ready")
        if ready and not os.path.exists(os.path.expanduser(ready)):
            return "setup"
        return "ready"

    def _update_tile(self, btn):
        btn.app_state = self._app_state(btn.app)
        installable = bool(btn.app.get("app"))
        btn.detail.set_text({"ready": btn.app.get("detail", ""),
                             "setup": "Tap to set up",
                             "missing": "Not installed · tap to install" if installable else "Not installed",
                             }[btn.app_state])
        btn.set_sensitive(btn.app_state != "missing" or installable)
        ctx = btn.get_style_context()
        if btn.app_state == "ready":
            ctx.remove_class("not-ready")
        else:
            ctx.add_class("not-ready")

    def _refresh_tiles(self):
        for btn in self.tiles:
            self._update_tile(btn)

    def _tile_clicked(self, btn):
        app = btn.app
        if btn.app_state != "missing":
            run_detached(app.get("run") or [app["command"]])
            return
        if self._confirm(f"Install {app['name']}?",
                         "It's downloaded from the internet, which takes a few minutes."):
            self._run_in_terminal(f"Installing {app['name']}", UPDATE_CMD + ["--app", app["app"]],
