def gps_fix(timeout=2.5):
    """(fix mode 2 or 3, lat, lon) from gpsd; None while it has no fix; False if gpsd isn't answering."""
    try:
        with socket.create_connection(GPSD, timeout=timeout) as s:
            s.sendall(b'?WATCH={"enable":true,"json":true};\n')
            buf, deadline = b"", time.time() + timeout
            while time.time() < deadline:
                chunk = s.recv(4096)
                if not chunk:
                    break
                buf += chunk
                *lines, buf = buf.split(b"\n")
                for line in lines:
                    try:
                        msg = json.loads(line)
                    except ValueError:
                        continue
                    if msg.get("class") == "TPV":
                        if msg.get("mode", 0) >= 2 and "lat" in msg and "lon" in msg:
                            return msg["mode"], msg["lat"], msg["lon"]
                        return None
    except socket.timeout:
        return None
    except OSError:
        return False
    return None


def latlon_to_grid(lat, lon):
    """Six-character Maidenhead locator, such as FN31pr."""
    lon = min(max(lon + 180, 0), 359.9999)
    lat = min(max(lat + 90, 0), 179.9999)
    return (chr(65 + int(lon // 20)) + chr(65 + int(lat // 10)) + str(int(lon % 20 // 2)) + str(int(lat % 10))
            + chr(97 + int(lon % 2 * 12)) + chr(97 + int(lat % 1 * 24)))


def format_freq(hz_text):
    try:
        hz = int(hz_text)
    except (TypeError, ValueError):
        return None
    mhz, rest = divmod(hz, 1_000_000)
    khz, h = divmod(rest, 1000)
    return f"{mhz}.{khz:03d}.{h:03d}"


