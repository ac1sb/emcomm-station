def is_folder(entry):
    return isinstance(entry, dict) and "folder" in entry


def apply_folders(order, folders):
    """order (codes and markers) with the standard folders put in, each where its first app was."""
    order = list(order)
    for folder in folders or []:
        members = [code for code in folder.get("apps", []) if code in order][:FOLDER_MAX]
        if not members:
            continue
        order[order.index(members[0])] = {"folder": folder.get("name") or "Folder", "apps": members}
        order = [entry for entry in order if is_folder(entry) or entry not in members]
    return order


def standard_order(apps, folders):
    return apply_folders([app.get("code") for app in apps], folders)


def arrange_tiles(apps, order):
    """The Home slots in the operator's order: apps (dicts), GAP, PAGE and folders
    ({"folder": name, "apps": [app dicts]}). Apps the saved order doesn't know (new ones)
    go at the end; codes no longer installed are dropped."""
    by_code = {app.get("code"): app for app in apps}
    slots, placed = [], set()
    for code in order if isinstance(order, list) else []:
        if is_folder(code):
            inside = []
            for member in code.get("apps") or []:
                if isinstance(member, str) and member in by_code and member not in placed \
                        and len(inside) < FOLDER_MAX:
                    inside.append(by_code[member])
                    placed.add(member)
            slots.append({"folder": str(code.get("folder") or "Folder"), "apps": inside})
        elif not isinstance(code, str):
            continue
        elif code in (GAP, PAGE):
            slots.append(code)
        elif code in by_code and code not in placed:
            slots.append(by_code[code])
            placed.add(code)
    while slots and slots[-1] in (GAP, PAGE):
        slots.pop()  # new apps join the last page, not an empty one
    return slots + [app for app in apps if app.get("code") not in placed]


def paginate(slots, per_page=PER_PAGE, keep_empty_last=False):
    """Split slots into Home pages: [(indices of the page's slots, where a slot added at its end goes)].
    A PAGE marker starts a new page; a page that fills up carries on onto the next."""
    pages, current = [], []
    for i, slot in enumerate(slots):
        if isinstance(slot, str) and slot == PAGE:
            pages.append((current, i))
            current = []
            continue
        if len(current) == per_page:
            pages.append((current, i))
            current = []
        current.append(i)
    if current or not pages or keep_empty_last or (slots and isinstance(slots[-1], str) and slots[-1] == PAGE):
        pages.append((current, len(slots)))
    return pages


