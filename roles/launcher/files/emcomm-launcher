def pactl(*args):
    try:
        result = subprocess.run(["pactl", *args], capture_output=True, text=True, timeout=5, check=False)
    except (OSError, subprocess.TimeoutExpired):
        return None
    return result.stdout.strip() if result.returncode == 0 else None


def sound_names():
    """{node name: description} for every speaker and microphone PipeWire knows."""
    names = {}
    for kind in ("sinks", "sources"):
        try:
            for node in json.loads(pactl("-f", "json", "list", kind) or "[]"):
                names[node.get("name")] = node.get("description") or node.get("name")
        except (ValueError, AttributeError):
            pass
    return names


def alert_sounds(on=None):
    """GNOME's (and Ubuntu's) alert sounds: on or off now, or switch them. None if there are none."""
    key = ["org.gnome.desktop.sound", "event-sounds"]
    try:
        if on is not None:
            subprocess.run(["gsettings", "set", *key, "true" if on else "false"],
                           capture_output=True, timeout=5, check=False)
        out = subprocess.run(["gsettings", "get", *key], capture_output=True, text=True, timeout=5, check=False)
    except (OSError, subprocess.TimeoutExpired):
        return None
    return {"true": True, "false": False}.get(out.stdout.strip())


def save_sound_before():
    """Note the computer's own speaker, microphone and alert sounds, once, before the radio takes over."""
    if os.path.exists(AUDIO_BEFORE):
        return
    write_json(AUDIO_BEFORE, {"sink": pactl("get-default-sink"), "source": pactl("get-default-source"),
                              "alert_sounds": alert_sounds()})


def restore_sound_before(devices=True):
    """Put the computer's own sound back (devices=False: only the alert sounds) and forget it."""
    before = read_json(AUDIO_BEFORE, None)
    if not isinstance(before, dict):
        return
    if devices:
        if before.get("sink"):
            pactl("set-default-sink", before["sink"])
        if before.get("source"):
            pactl("set-default-source", before["source"])
    if before.get("alert_sounds") is not None:
        alert_sounds(before["alert_sounds"])
    try:
        os.remove(AUDIO_BEFORE)
    except OSError:
        pass


