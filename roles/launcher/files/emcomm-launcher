        self._fill_match_combo(self.igate_ptt, serial_ports, ptt or "", fixed=[("", "None: receive only")])
        if keep:
            self._igate_show_radio()
            return
        s = read_json(IGATE_CONFIG, {})
        mode = s.get("mode") if s.get("mode") in self.igate_modes else "off"
        self.igate_modes[mode].set_active(True)
        self.igate_explain.set_text(next(d for v, _l, d in IGATE_MODES if v == mode))
        call = self.station.get("callsign", "")
        call = "" if call == "N0CALL" else call
        self.igate_ssid.remove_all()
        for ssid in range(16):
            self.igate_ssid.append(str(ssid), (f"{call}-{ssid}" if ssid else call or "Your callsign") +
                                   {10: "  (usual for an iGate)", 0: "  (no SSID)"}.get(ssid, ""))
        self.igate_ssid.set_active_id(str(s.get("ssid", 10)))
        self.igate_server.set_active_id(s.get("server") or IGATE_SERVERS[0][0])
        self.igate_comment.set_text(s.get("comment", "Emcomm-CNC iGate"))
        here = grid_to_latlon(self.station.get("grid", ""))
        for entry, key, i in ((self.igate_lat, "lat", 0), (self.igate_lon, "lon", 1)):
            entry.set_text("" if s.get(key) is None else str(s[key]))
            entry.set_placeholder_text(f"{here[i]:.4f}" if here else "")
        self.igate_pass_label.set_text(
            f"APRS-IS passcode {aprs_passcode(call)}, worked out from your callsign. Latitude and longitude place "
            "the iGate on the APRS map; left empty, it's the centre of your grid square."
            if call else "Set your callsign in Settings > User first.")
        self.igate_message.set_text("")
        self._igate_show_radio()

    def _igate_show_radio(self):
        ok, muted = self.colours["ok"], self.colours["muted"]
        card = os.path.exists("/proc/asound/aprsaudio")
        ptt = os.path.exists("/dev/aprs-ptt")
        self.igate_radio_label.set_markup(
            (f"<span foreground='{ok}'>●</span>  The APRS radio's sound card is plugged in"
             + (" with its PTT port." if ptt else ".")) if card else
            f"<span foreground='{muted}'>○</span>  No APRS radio plugged in. Use a 2 m radio kept on 144.390 MHz "
            "with its own Digirig; the APRS tile uses it too.")

    def _igate_watch(self):
        """Refresh what the iGate is doing while the page shows."""
        def tick():
            if self.stack.get_visible_child_name() != "aprs-igate":
                return False
            try:
                out = subprocess.run(["emcomm-igate", "--status"], capture_output=True, text=True, timeout=5,
                                     check=False).stdout
                st = json.loads(out)
            except (OSError, ValueError, subprocess.TimeoutExpired):
                st = {"state": "missing", "text": "The iGate isn't installed yet. Run Update station."}
            colour = {"running": self.colours["ok"], "waiting": self.colours["accent"],
                      "stopped": self.colours["accent"]}.get(st.get("state"), self.colours["muted"])
            text = st.get("text") or {"off": "The iGate is off.", "starting": "Starting…"}.get(st.get("state"), "")
            self.igate_status.set_markup(f"<span foreground='{colour}'>●</span>  {GLib.markup_escape_text(text)}")
            self._igate_show_radio()
            return True

        if tick():
            GLib.timeout_add_seconds(3, tick)

    def _igate_save(self):
        mode = next(v for v, b in self.igate_modes.items() if b.get_active())
        coords = {}
        for entry, key, limit in ((self.igate_lat, "lat", 90), (self.igate_lon, "lon", 180)):
            text = entry.get_text().strip()
            if not text:
                coords[key] = None
                continue
            try:
                value = float(text)
            except ValueError:
                value = None
            if value is None or abs(value) > limit:
                self.igate_message.set_text(f"{key.replace('lat', 'Latitude').replace('lon', 'Longitude')} "
                                            f"should be a number of degrees, like {'43.16' if key == 'lat' else '-73.07'}.")
                return
            coords[key] = round(value, 4)
        card, ptt = self._chosen(self.igate_card) or None, self._chosen(self.igate_ptt) or None
        if mode == "two-way" and not ptt:
            self.igate_message.set_text("Two-way needs the PTT port: pick the Digirig's serial port.")
            return
        if mode != "off" and not card:
            self.igate_message.set_text("Pick the APRS radio's sound card first.")
            return
        write_json(IGATE_CONFIG, {"mode": mode, "ssid": int(self.igate_ssid.get_active_id() or 10),
                                  "server": self.igate_server.get_active_id() or IGATE_SERVERS[0][0],
                                  "comment": self.igate_comment.get_text().strip(), **coords})
        saved = read_json(APRS_RADIO, {})
        if saved.get("audio_match") == card and saved.get("ptt_match") == ptt:
            self.igate_message.set_text("Saved.")
            return
        self.igate_message.set_text("Saving…")

        def work():
            with tempfile.NamedTemporaryFile("w", suffix=".json", delete=False) as f:
                json.dump({"audio_match": card, "ptt_match": ptt}, f)
                path = f.name
            try:
                result = subprocess.run(APPLY_CMD + ["--aprs", path], stdout=subprocess.PIPE,
                                        stderr=subprocess.STDOUT, text=True, timeout=60)
                text = result.stdout.strip()
            except (OSError, subprocess.TimeoutExpired) as exc:
                text = f"Not saved: {exc}"
            finally:
                os.unlink(path)
            GLib.idle_add(lambda: (self.igate_message.set_text(text), self._igate_show_radio()) and False)

        threading.Thread(target=work, daemon=True).start()

