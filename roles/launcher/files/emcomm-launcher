ZONEINFO = os.environ.get("EMCOMM_ZONEINFO", "/usr/share/zoneinfo")
ZONE_AREAS = ("Africa", "America", "Antarctica", "Arctic", "Asia", "Atlantic", "Australia", "Europe",
              "Indian", "Pacific")


_ZONES = []


def time_zones():
    """The places a time zone can be picked by (America/New_York...), and UTC. Read once."""
    if not _ZONES:
        names = {"UTC"}
        for area in ZONE_AREAS:
            for folder, _dirs, files in os.walk(os.path.join(ZONEINFO, area)):
                names.update(os.path.relpath(os.path.join(folder, f), ZONEINFO) for f in files)
        _ZONES.extend(sorted(names))
    return _ZONES


def current_time_zone():
    """The time zone the clock shows: TZ once one has been picked here, else the computer's,
    from /etc/timezone or the /etc/localtime link."""
    if os.environ.get("TZ", "").strip(":") in time_zones():
        return os.environ["TZ"].strip(":")
    try:
        with open("/etc/timezone", encoding="utf-8") as f:
            name = f.read().strip()
        if name and name not in ("Etc/UTC", "Etc/UCT"):
            return name
    except OSError:
        pass
    link = os.path.realpath("/etc/localtime")
    name = link.split("zoneinfo/", 1)[1] if "zoneinfo/" in link else "UTC"
    return "UTC" if name in ("Etc/UTC", "Etc/UCT", "UCT", "Universal", "Zulu", "Etc/Zulu") else name


def clock_text(now=None, utc_seconds=False):
    """Local time with its zone, then UTC; only UTC when the computer's clock is set to UTC."""
    now = time.time() if now is None else now
    utc = time.strftime("%H:%M:%S UTC" if utc_seconds else "%H:%M UTC", time.gmtime(now))
    local = time.localtime(now)
    if local.tm_gmtoff == 0 and local.tm_zone in ("UTC", "GMT"):
        return utc
    return f"{time.strftime('%H:%M', local)} {local.tm_zone}   {utc}"


