def free_sdr(wait=5.0):
    """Stop whatever holds an SDR receiver (Gqrx, the Scanner, rtl_tcp...), forcefully if it
    doesn't stop in a few seconds, and clear the lock. The weather radio listener takes its
    dongle back by itself. Returns the names stopped."""
    procs = sdr_processes()
    for pid, _name in procs:
        try:
            os.kill(pid, signal.SIGTERM)
        except OSError:
            pass
    deadline = time.monotonic() + wait
    while time.monotonic() < deadline and any(os.path.exists(f"/proc/{pid}") for pid, _n in procs):
        time.sleep(0.2)
    for pid, _name in procs:
        try:
            os.kill(pid, signal.SIGKILL)
        except OSError:
            pass
    if not sdr_user():
        try:
            os.remove(SDR_LOCK)
        except OSError:
            pass
    return sorted({"Gqrx" if n == "gqrx" else "Scanner" if n == "emcomm-scanner" else n for _p, n in procs})


def rigctld_query(host, port, command, timeout=1.0):
    """Send one rigctld command and return the first reply line, or None."""
    try:
        with socket.create_connection((host, port), timeout=timeout) as s:
            s.sendall(command.encode() + b"\n")
            data = s.recv(256).decode(errors="replace")
            return data.splitlines()[0].strip() if data else None
    except OSError:
        return None


