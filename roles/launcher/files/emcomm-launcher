def aprs_passcode(call):
    """The APRS-IS passcode for a callsign, as emcomm-igate works it out."""
    call = call.upper().split("-")[0].split("/")[0]
    code = 0x73E2
    for i in range(0, len(call), 2):
        code ^= ord(call[i]) << 8
        if i + 1 < len(call):
            code ^= ord(call[i + 1])
    return code & 0x7FFF


