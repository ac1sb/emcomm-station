            json.dump(config, f, indent=1)
        os.replace(NWR_CONFIG + ".tmp", NWR_CONFIG)
        self._show_online()

    def _check_radio_alerts(self):
        """Pop up a warning the weather radio has just heard, since nobody may be looking at the top bar."""
        record = online_record("nwr")
        if record.get("updated") == getattr(self, "nwr_seen", None):
            return
        self.nwr_seen = record.get("updated")
        self._update_alert_badge()
        for alert in active_alerts(record):
            key = (alert.get("code"), alert.get("starts"))
            if alert.get("severity") in ("Extreme", "Severe") and key not in self.nwr_shown:
                self.nwr_shown.add(key)
                ends = iso_epoch(alert.get("ends", ""))
                until = f" until {time.strftime('%H:%M', time.localtime(ends))}" if ends else ""
                dialog = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.WARNING,
                                           text=f"{alert['event']}{until}",
                                           secondary_text=f"{alert['headline']}\n{alert['area']}\n"
                                                          f"Heard on {alert['sender']}.")
                dialog.add_buttons("Show alerts", 1, "OK", Gtk.ResponseType.OK)
                self.present()
                if dialog.run() == 1:
                    self._open_online("alerts")
                dialog.destroy()

