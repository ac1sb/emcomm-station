class PickList(Gtk.Button):
    """A drop-down list that can be searched by typing, standing in for Gtk.ComboBoxText
    (append, set_active_id, get_active_id, get_active_text, set_active, get_active,
    remove_all and the "changed" signal). Tapping it opens the list under a search box;
    typing, on the button or in the box, keeps only the choices with every word typed."""

    __gsignals__ = {"changed": (GObject.SignalFlags.RUN_FIRST, None, ())}

    def __init__(self):
        super().__init__()
        self.get_style_context().add_class("picklist")
        self.items, self.active = [], -1
        box = Gtk.Box(spacing=8)
        self.label = Gtk.Label(xalign=0, ellipsize=Pango.EllipsizeMode.END, width_chars=8)
        box.pack_start(self.label, True, True, 0)
        box.pack_end(Gtk.Image.new_from_icon_name("pan-down-symbolic", Gtk.IconSize.BUTTON), False, False, 0)
        self.add(box)
        self.connect("clicked", lambda *_: self.popup())
        self.connect("key-press-event", self._key)
        self.popover = None

    # ---- the Gtk.ComboBoxText calls the windows use ----
    def append(self, item_id, text):
        self.items.append((item_id, text))

    def append_text(self, text):
        self.append(None, text)

    def remove_all(self):
        self.items = []
        self._select(-1)

    def get_active(self):
        return self.active

    def set_active(self, index):
        self._select(index if 0 <= index < len(self.items) else -1)

    def get_active_id(self):
        return self.items[self.active][0] if self.active >= 0 else None

    def get_active_text(self):
        return self.items[self.active][1] if self.active >= 0 else None

    def set_active_id(self, item_id):
        if item_id is None:
            self._select(-1)
            return True
        for n, (value, _text) in enumerate(self.items):
            if value == item_id:
                self._select(n)
                return True
        return False

    def _select(self, index):
        changed = index != self.active
        self.active = index
        self.label.set_text(self.items[index][1] if index >= 0 else "")
        if changed:
            self.emit("changed")

    # ---- the list ----
    def _key(self, _widget, event):
        char = chr(Gdk.keyval_to_unicode(event.keyval) or 0)
        if char.isprintable() and char.strip() and not event.state & Gdk.ModifierType.CONTROL_MASK:
            self.popup(char)
            return True
        return False

    def popup(self, typed=""):
        if not self.items:
            return
        self.popover = Gtk.Popover(relative_to=self, position=Gtk.PositionType.BOTTOM)
        self.popover.get_style_context().add_class("picklist-pop")
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6, margin=8)
        search = Gtk.SearchEntry(placeholder_text="Type to search", can_default=False)
        box.pack_start(search, False, False, 0)
        listbox = Gtk.ListBox(selection_mode=Gtk.SelectionMode.SINGLE, activate_on_single_click=True)
        rows = []
        for n, (_value, text) in enumerate(self.items):
            row = Gtk.ListBoxRow()
            row.index, row.words = n, text.lower()
            label = Gtk.Label(label=text, xalign=0, margin=10, ellipsize=Pango.EllipsizeMode.END)
            row.add(label)
            listbox.add(row)
            rows.append(row)
        empty = Gtk.Label(label="No matches", margin=10)
        empty.get_style_context().add_class("muted")
        listbox.set_placeholder(empty)
        empty.show()
        scroller = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER)
        scroller.set_propagate_natural_height(True)
        scroller.set_max_content_height(300)
        box.set_size_request(max(260, self.get_allocated_width()), -1)
        scroller.add(listbox)
        box.pack_start(scroller, True, True, 0)
        self.popover.add(box)

        def matches(row):
            words = search.get_text().lower().split()
            return all(w in row.words for w in words)

        listbox.set_filter_func(matches)

        def choose(row):
            if row is not None:
                self._select(row.index)
            self.popover.popdown()

        def first_shown():
            return next((r for r in rows if r.get_child_visible() and matches(r)), None)

        listbox.connect("row-activated", lambda _l, row: choose(row))
        search.connect("search-changed", lambda *_: listbox.invalidate_filter())
        search.connect("activate", lambda *_: choose(first_shown()))
        search.connect("stop-search", lambda *_: self.popover.popdown())
        self.popover.connect("closed", lambda p: p.destroy())
        box.show_all()
        self.popover.popup()
        # Typing goes to the search box. It isn't focused at first unless something was
        # typed, so a tap doesn't bring up the on-screen keyboard over the list.
        self.popover.connect("key-press-event",
                             lambda _p, event: not search.has_focus() and search.handle_event(event))
        if typed:
            search.grab_focus()
            search.set_text(typed)
            search.set_position(-1)
        elif self.active >= 0:
            listbox.select_row(rows[self.active])
            GLib.idle_add(lambda: rows[self.active].grab_focus() and False)  # scrolls it into view
        else:
            listbox.grab_focus()

class HomeBar(Gtk.Window):
    """A thin bar across the top of the screen, above every app, with Home, the
    local and UTC clock and the on-screen keyboard. Apps open below it; the launcher, when
    in front, covers it."""

    def __init__(self, launcher):
        super().__init__(title="Emcomm-CNC Home bar")
        self.launcher = launcher
        # A desktop has its own taskbar to get back to the launcher.
        self.enabled = not launcher.desktop or launcher.session
        self.set_type_hint(Gdk.WindowTypeHint.DOCK)
        self.set_decorated(False)
        self.set_keep_above(True)
        self.set_accept_focus(False)
        self.set_skip_taskbar_hint(True)
        self.set_skip_pager_hint(True)
        self.stick()
        box = Gtk.Box(spacing=8)
        box.get_style_context().add_class("homebar")
        home = Gtk.Button(label="⌂  Home")
        home.get_style_context().add_class("navbtn")
        home.connect("clicked", lambda *_: launcher.go_home())
        box.pack_start(home, False, False, 0)
        # One button per open app: tap to bring it to the front, ✕ to close it.
        self.apps_box = Gtk.Box(spacing=6)
        apps_scroll = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.EXTERNAL,
                                         vscrollbar_policy=Gtk.PolicyType.NEVER)
        apps_scroll.add(self.apps_box)
        box.pack_start(apps_scroll, True, True, 0)
        self.shown = None
        keyboard = Gtk.Button(label="⌨  Keyboard")
        keyboard.get_style_context().add_class("navbtn")
        keyboard.connect("clicked", lambda *_: launcher.toggle_keyboard())
        box.pack_end(keyboard, False, False, 0)
        self.clock = Gtk.Label()
        self.clock.get_style_context().add_class("homebar-clock")
        box.pack_end(self.clock, False, False, 0)
        # Recording (and Broadcastify) at a glance, from any app; tap for the Recorder page.
        self.rec = Gtk.Button(label="Rec")
        self.rec.get_style_context().add_class("navbtn")
        self.rec.connect("clicked", lambda *_: launcher.show_page("recorder"))
        box.pack_end(self.rec, False, False, 0)
        self.add(box)
        if self.enabled:
            GLib.timeout_add(1500, self.refresh_apps)
        screen = self.get_screen()
        screen.connect("size-changed", lambda *_: self.place())
        screen.connect("monitors-changed", lambda *_: self.place())
        self.connect("realize", lambda *_: self.place())

    def refresh_apps(self):
        """Show the open apps, the one in front highlighted. Rebuilt only on a change."""
        windows = open_windows()
        active = active_window()
        named = []
        for win in windows:
            app = window_app(win, self.launcher.config.get("apps", []), self.launcher.started)
            named.append((win["id"], app["name"] if app else (win["title"] or win["cls"])))
        state = (named, active)
        if state == self.shown:
            return True
        self.shown = state
        for child in self.apps_box.get_children():
            self.apps_box.remove(child)
        for wid, name in named:
            pair = Gtk.Box()
            pair.get_style_context().add_class("linked")
            show = Gtk.Button(label=name)
            show.get_child().set_ellipsize(Pango.EllipsizeMode.END)
            show.get_child().set_max_width_chars(14)
            close = Gtk.Button(label="✕", tooltip_text=f"Close {name}")
            for btn in (show, close):
                btn.get_style_context().add_class("navbtn")
                if wid == active:
                    btn.get_style_context().add_class("current")
            show.connect("clicked", lambda _b, w=wid: self.bring_forward(w))
            close.connect("clicked", lambda _b, w=wid: self.close_app(w))
            pair.pack_start(show, False, False, 0)
            pair.pack_start(close, False, False, 0)
            self.apps_box.pack_start(pair, False, False, 0)
        self.apps_box.show_all()
        return True

    def bring_forward(self, wid):
        wmctrl("-i", "-a", hex(wid))
        GLib.timeout_add(300, lambda: self.refresh_apps() and False)

    def close_app(self, wid):
        # The polite close, as the window's own ✕: an app can still ask to save first.
        wmctrl("-i", "-c", hex(wid))
        GLib.timeout_add(800, lambda: self.refresh_apps() and False)

    def place(self):
        """Fit the bar to the top of the main screen, and keep apps from covering it."""
        if not self.enabled:
            return
        display = Gdk.Display.get_default()
        monitor = display.get_primary_monitor() or display.get_monitor(0)
        if not monitor:
            return
        geom = monitor.get_geometry()
        height = round(HOME_BAR_HEIGHT * self.launcher.text_scale)
        self.set_size_request(geom.width, height)
        self.resize(geom.width, height)
        self.move(geom.x, geom.y)
        window = self.get_window()
        if not window or not hasattr(window, "get_xid"):
            return
        # Reserve the strip (_NET_WM_STRUT_PARTIAL), so Openbox keeps maximized apps below it.
        strut = [0, 0, geom.y + height, 0, 0, 0, 0, 0, geom.x, geom.x + geom.width - 1, 0, 0]
        for name, values in (("_NET_WM_STRUT_PARTIAL", strut), ("_NET_WM_STRUT", strut[:4])):
            try:
                subprocess.run(["xprop", "-id", str(window.get_xid()), "-f", name, "32c", "-set", name,
                                ", ".join(map(str, values))], capture_output=True, timeout=5, check=False)
            except (OSError, subprocess.TimeoutExpired):
                pass


