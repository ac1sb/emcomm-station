    def _net_show(self, reload=False):
        if reload:
            self.ncs_path, self.ncs = open_net()
        net = self.ncs
        is_open = net is not None
        self.ncs_start_btn.set_label("Close net" if is_open else "Start net")
        for btn in self.ncs_entry_btns:
            btn.set_sensitive(is_open)
        self._ncs_filling = True
        if is_open:
            self.ncs_name.set_text(net.get("name", ""))
            self.ncs_incident.set_text(net.get("incident", ""))
            self.ncs_operator.set_text(net.get("operator", ""))
            calls = checked_in(net)
            self.ncs_status.set_text(f"Open since {time.strftime('%H%MZ', time.gmtime(net['started']))} · "
                                     f"{len(calls)} checked in" + (f": {' '.join(calls)}" if calls else ""))
            text = net_lines(net)
        else:
            self.ncs_status.set_text("No net open. Name it and tap Start net.")
            text = ("Start a net to log check-ins and traffic. Each entry gets the UTC time.\n\n"
                    "Check in: type the callsign in From and press Enter (a message is kept as a note).\n"
                    "Log: From, To and Message for traffic; To left blank means you, net control.\n"
                    "ICS-309 log prints the open or last net; ICS-205 plan prints My frequencies.\n")
        self._ncs_filling = False
        buf = self.ncs_view.get_buffer()
        buf.set_text(text)
        GLib.idle_add(lambda: self.ncs_view.scroll_to_iter(buf.get_end_iter(), 0, False, 0, 1) and False)

    def _net_details_changed(self, *_):
        if self._ncs_filling or not self.ncs:
            return
        self.ncs.update(name=self.ncs_name.get_text().strip(), incident=self.ncs_incident.get_text().strip(),
                        operator=self.ncs_operator.get_text().strip())
        save_net(self.ncs_path, self.ncs)

    def _net_start_or_close(self, *_):
        if self.ncs:
            dialog = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.QUESTION,
                                       text=f"Close {self.ncs.get('name') or 'the net'}?",
                                       secondary_text="Its log is kept for the ICS-309.")
            dialog.add_buttons("Keep it open", Gtk.ResponseType.CANCEL, "Close net", Gtk.ResponseType.OK)
            response = dialog.run()
            dialog.destroy()
            if response != Gtk.ResponseType.OK:
                return
            self.ncs["closed"] = int(time.time())
            save_net(self.ncs_path, self.ncs)
            self.ncs_path, self.ncs = None, None
        else:
            now = int(time.time())
            freq = format_freq(rigctld_query(*RIGCTLD, "f"))
            self.ncs = {"name": self.ncs_name.get_text().strip() or "Net",
                        "incident": self.ncs_incident.get_text().strip(),
                        "operator": self.ncs_operator.get_text().strip(),
                        "callsign": self.station.get("callsign", ""), "started": now, "closed": None,
                        "frequency": freq or "", "entries": []}
            self.ncs_path = os.path.join(NETS_DIR, time.strftime("%Y%m%d-%H%M%S.json", time.gmtime(now)))
            self.ncs["entries"].append({"time": now, "from": self.ncs["callsign"], "to": "",
                                        "message": f"Net opened{' on ' + freq if freq else ''}"})
            save_net(self.ncs_path, self.ncs)
        self._net_show()

    def _net_add(self, checkin):
        if not self.ncs:
            return
        sender = self.ncs_from.get_text().strip().upper()
        to = self.ncs_to.get_text().strip().upper()
        message = " ".join(self.ncs_message.get_text().split())
        if checkin and not sender:
            self.ncs_from.grab_focus()
            return
        if not checkin and not (sender or message):
            return
        if checkin:
            to = to or self.ncs.get("callsign", "")
            message = "Checked in" + (f": {message}" if message else "")
        entry = {"time": int(time.time()), "from": sender or self.ncs.get("callsign", ""),
                 "to": to or (self.ncs.get("callsign", "") if sender else ""), "message": message}
        if checkin:
            entry["checkin"] = True
        self.ncs["entries"].append(entry)
        save_net(self.ncs_path, self.ncs)
        for widget in (self.ncs_from, self.ncs_to, self.ncs_message):
            widget.set_text("")
        self.ncs_from.grab_focus()
        self._net_show()

    def _net_undo(self, *_):
        if self.ncs and len(self.ncs["entries"]) > 1:
            self.ncs["entries"].pop()
            save_net(self.ncs_path, self.ncs)
            self._net_show()

    def _net_ics309(self, *_):
        path = self.ncs_path
        if not path:
            nets = sorted(glob.glob(os.path.join(NETS_DIR, "*.json")))
            path = nets[-1] if nets else None
        if not path:
            self.ncs_status.set_text("No nets logged yet.")
            return
        self._run_ics(["309", path], "ICS-309 Communications Log")

    def _net_ics205(self, *_):
        self._run_ics(["205", "--incident", self.ncs_incident.get_text().strip()],
                      "ICS-205 Radio Communications Plan")

    def _run_ics(self, args, title):
        """Fill in the form with emcomm-ics and show it, with a Print button."""
        try:
            result = subprocess.run([ICS_CMD] + args, capture_output=True, text=True, timeout=30, check=False)
        except (OSError, subprocess.TimeoutExpired) as exc:
            self.ncs_status.set_text(f"Couldn't fill in the form: {exc}")
            return
        if result.returncode != 0:
            self.ncs_status.set_text(result.stderr.strip().splitlines()[-1] if result.stderr.strip()
                                     else "Couldn't fill in the form.")
            return
        path = result.stdout.strip().splitlines()[-1]
        self.ncs_status.set_text(f"Saved to {path.replace(os.path.expanduser('~'), '~')}")
        if shutil.which("emcomm-webview"):
            run_detached(["emcomm-webview", "--print", GLib.filename_to_uri(path, None), title])

