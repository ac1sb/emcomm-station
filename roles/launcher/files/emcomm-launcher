    def _online_alerts(self):
        record = online_record("alerts")
        alerts = all_alerts()
        grid = self.station.get("grid", "?")
        status = record_status(record, f"Weather alerts for grid {grid} from the National Weather Service (US only)")
        if (record.get("updated") or online_record("nwr").get("listening")) and not alerts:
            status = "No weather alerts in force. " + status
        self.online_status.set_text(status)
        rows = [self._nwr_row()]
        for alert in alerts:
            ends = iso_epoch(alert.get("ends", ""))
            until = f"until {time.strftime('%a %H:%M', time.localtime(ends))}" if ends else ""
            colour = self.colours["danger"] if alert["severity"] in ("Extreme", "Severe") else self.colours["accent"]
            text = "\n\n".join(filter(None, [alert["headline"], alert["description"], alert["instruction"],
                                             f"Areas: {alert['area']}", alert["sender"]]))
            rows.append(self._info_row(alert["severity"], alert["event"],
                                       " · ".join(filter(None, [until, alert["area"]])),
                                       [("Details", lambda *_, e=alert["event"], t=text: self._text_dialog(e, t))],
                                       colour))
        self._fill_online_list(rows)

    def _online_space(self):
        space, bands = online_record("space"), online_record("bands")
        self.online_status.set_text(record_status(space, "Space weather from NOAA") + " · " +
                                    record_status(bands, "band conditions from N0NBH (hamqsl.com)"))
        s, b = space.get("data") or {}, bands.get("data") or {}
        lines = []
        sfi = s.get("sfi") or b.get("sfi")
        if sfi:
            hint = ("upper bands (15 to 10 m) mostly closed" if int(sfi) < 90 else
                    "upper bands open at times" if int(sfi) < 150 else "upper bands open")
            lines.append(f"Solar flux (SFI)     {sfi:<6}  {hint}")
        kp = s.get("kp")
        if kp is not None:
            hint = ("quiet: HF normal" if kp < 3 else "unsettled: some fading at high latitudes" if kp < 4 else
                    "active: HF noisy, polar paths poor" if kp < 5 else
                    f"storm (G{min(5, int(kp) - 4)}): HF may fade out; try 80 and 40 m NVIS")
            lines.append(f"Planetary K index    {kp:<6g}  {hint}")
        scales = s.get("scales") or {}
        if scales:
            names = {"R": "radio blackouts", "S": "radiation storms", "G": "geomagnetic storms"}
            lines.append("NOAA scales today    " + " · ".join(
                f"{k}{v['level']} {names[k]}" + (f" ({v['text']})" if v["level"] else "") for k, v in scales.items()))
        if b.get("bands"):
            lines += ["", f"HF band conditions (updated {b.get('updated', '').strip()})", f"{'':16}{'Day':10}Night"]
            for band, times in b["bands"].items():
                lines.append(f"  {band:14}{times.get('day', '?'):10}{times.get('night', '?')}")
            extra = [f"Geomagnetic field {b['geomag']}" if b.get("geomag") else "",
                     f"noise {b['noise']}" if b.get("noise") else "",
                     f"A index {b['a']}" if b.get("a") else "", f"sunspots {b['sunspots']}" if b.get("sunspots") else ""]
            lines += ["", " · ".join(filter(None, extra))]
            open_vhf = [f"{p['name'].replace('-', ' ')} ({p['where'].replace('_', ' ')}): {p['state']}"
                        for p in b.get("vhf", []) if p["state"].lower() != "band closed"]
            if open_vhf:
                lines += ["VHF: " + "; ".join(open_vhf)]
        self._show_text("\n".join(lines) if lines else "")

    def _online_heard(self):
        record = online_record("heard")
        heard = record.get("data") or []
        call = self.station.get("callsign", "")
        if record.get("updated") and not heard:
            status = (f"No one has reported hearing {call} on PSKReporter in the last 6 hours. Reports come from "
                      "FT8, JS8Call and other digital stations that are online. ")
        else:
            status = f"{len(heard)} stations reported hearing {call} in the last 6 hours. " if heard else ""
        self.online_status.set_text(status + record_status(record, "From PSKReporter"))
        here = grid_to_latlon(self.station.get("grid", ""))
        rows = []
        for h in heard:
            there = grid_to_latlon(h["grid"])
            where = ""
            if here and there:
                miles, bearing = distance_bearing(here, there)
                where = f"{miles:,.0f} mi at {bearing:03.0f}°"
            details = [where, h["mode"], f"SNR {h['snr']} dB" if h["snr"] is not None else "", ago(h["time"])]
            band = band_name(h["freq"] / 1e6) if h["freq"] else "?"
            rows.append(self._info_row(band, f"{h['call']}  ·  {h['grid']}", " · ".join(filter(None, details))))
        self._fill_online_list(rows)

    def _online_lookup(self):
        acc = read_json(ACCOUNTS_PATH, {})
        services = [name for name, key in (("QRZ", "qrz_user"), ("HamQTH", "hamqth_user"), ("aprs.fi", "aprsfi_key"))
                    if acc.get(key)]
        self.online_status.set_text(("Looks up with " + ", ".join(services) + ". Callsigns looked up before "
                                     "still show when the station is offline.") if services else
                                    "Add a QRZ or HamQTH login under Accounts to look up callsigns.")
        self._show_text(self.lookup_text)
        self.lookup_entry.grab_focus()

    def _lookup(self, *_):
        call = self.lookup_entry.get_text().strip().upper()
        if not call:
            return
        if not shutil.which(ONLINE_CMD):
            self.online_status.set_text("The online helper isn't installed; tap Update station in Settings.")
            return
        self.online_status.set_text(f"Looking up {call}…")

        def work():
            try:
                out = subprocess.run([ONLINE_CMD, "lookup", call], capture_output=True, text=True, timeout=60).stdout
                result = json.loads(out)
            except (OSError, subprocess.TimeoutExpired, ValueError):
                result = {"call": call, "errors": ["The lookup didn't finish."]}
            GLib.idle_add(self._lookup_done, result)

        threading.Thread(target=work, daemon=True).start()

    def _lookup_done(self, r):
        lines = []
        if r.get("notfound"):
            lines.append(f"{r['call']} isn't in the callbook.")
        elif r.get("source"):
            lines += [f"{r['call']}   {r.get('name', '')}".rstrip(),
                      ", ".join(filter(None, [r.get("city"), r.get("state"), r.get("country")]))]
            where = f"Grid {r['grid']}" if r.get("grid") else ""
            if r.get("miles") is not None:
                where += f" · {r['miles']:,.0f} mi at {r['bearing']:03.0f}°"
            lines += [where.strip(" ·")]
            if r.get("class"):
                lines.append(f"Licence class {r['class']}" + (f", expires {r['expires']}" if r.get("expires") else ""))
            if r.get("email"):
                lines.append(r["email"])
            source = f"From {r['source']}"
            if r.get("cached"):
                source += f", saved {ago(r.get('updated'))} (couldn't reach it now)"
            lines += ["", source]
            if r.get("note"):
                lines.append(r["note"])
        aprs = r.get("aprs")
        if aprs:
            here = grid_to_latlon(self.station.get("grid", ""))
            where = ""
            if here and aprs.get("lat") is not None:
                miles, bearing = distance_bearing(here, (aprs["lat"], aprs["lon"]))
                where = f", {miles:,.0f} mi at {bearing:03.0f}°"
            if aprs.get("lat") is not None and aprs.get("lon") is not None:
                place = f"  {aprs['lat']:.4f}, {aprs['lon']:.4f}"
            else:
                place = "  (no position given)"
            lines += ["", f"Last APRS position (aprs.fi): {aprs['name']} {ago(aprs.get('time'))}{where}",
                      f"{place}  {aprs.get('comment', '')}".rstrip()]
        elif "aprs" in r:
            lines += ["", "No recent APRS position on aprs.fi."]
        if r.get("errors"):
            lines += [""] + r["errors"]
        self.lookup_text = "\n".join(lines).strip()
        if self.online_combo.get_active_id() == "lookup":
            self._online_lookup()
        return False

    def _nwr_row(self):
        """The weather radio's state, first in the alerts list, with its Set up button."""
        record, config = online_record("nwr"), read_json(NWR_CONFIG, {})
        if record.get("listening") and not record.get("error"):
            colour, lead = self.colours["ok"], "Listening"
            detail = [f"{record['listening']:.3f} MHz",
                      "your counties: " + county_names(config.get("codes")) if config.get("codes")
                      else "every county it hears"]
            test = record.get("last_test")
            detail.append(f"{test['event']} heard {ago(test['time'])}" if test else "no weekly test heard yet")
        else:
            paused = (record.get("error") or "").startswith("Paused")
            colour, lead = self.colours["muted"], "Paused" if paused else "Off"
            detail = [record.get("error") or "Receives alerts with no internet, using an RTL-SDR dongle."]
        return self._info_row(lead, "NOAA Weather Radio", " · ".join(detail), [("Set up", self._edit_nwr)], colour)

