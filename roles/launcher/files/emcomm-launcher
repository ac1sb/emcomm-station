    def _open_online(self, section):
        self.online_combo.set_active_id(section)
        self.stack.set_visible_child_name("online")

    def _show_online(self, fetch=False):
        section = self.online_combo.get_active_id()
        self.lookup_row.set_visible(section == "lookup")
        self.online_map_btn.set_visible(section == "heard" and bool(shutil.which("emcomm-map")))
        self.online_refresh_btn.set_visible(section != "lookup")
        {"alerts": self._online_alerts, "space": self._online_space, "heard": self._online_heard,
         "lookup": self._online_lookup}[section]()
        if fetch and ONLINE_SOURCES[section]:
            # Quick when the saved answer is recent: emcomm-online only fetches what's due.
            self._online_refresh()

    def _online_refresh(self, force=False):
        section = self.online_combo.get_active_id()
        if not shutil.which(ONLINE_CMD):
            self.online_status.set_text("The online helper isn't installed; tap Update station in Settings.")
            return
        if force:
            self.online_status.set_text("Checking…")
        self.online_refresh_btn.set_sensitive(False)
        argv = [ONLINE_CMD, "refresh"] + (["--force"] if force else []) + ONLINE_SOURCES[section]

        def work():
            try:
                subprocess.run(argv, capture_output=True, timeout=120, check=False)
            except (OSError, subprocess.TimeoutExpired):
                pass
            GLib.idle_add(self._online_refreshed, section)

        threading.Thread(target=work, daemon=True).start()

    def _online_refreshed(self, section):
        self.online_refresh_btn.set_sensitive(True)
        self._update_alert_badge()
        current = self.online_combo.get_active_id()
        if self.stack.get_visible_child_name() == "online" and current != "lookup" and section in (None, current):
            self._show_online()
        return False

    def _background_online(self):
        """Keep weather alerts and propagation fresh while the station has internet."""
        if self.net_connected and shutil.which(ONLINE_CMD):
            def work():
                try:
                    subprocess.run([ONLINE_CMD, "refresh"] + BACKGROUND_SOURCES, capture_output=True,
                                   timeout=180, check=False)
                except (OSError, subprocess.TimeoutExpired):
                    pass
                GLib.idle_add(self._online_refreshed, None)

            threading.Thread(target=work, daemon=True).start()
        return True

