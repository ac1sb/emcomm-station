    def _audio_refresh(self):
        if self.desktop:
            self._filling = True
            self.audio_buttons[self.audio["radio_default"]].set_active(True)
            self.audio_quiet.set_active(self.audio["quiet"])
            self.audio_quiet.set_sensitive(self.audio["radio_default"] == "while_open")
            self._filling = False
        ok, muted = self.colours["ok"], self.colours["muted"]
        if os.path.exists("/proc/asound/rigaudio"):
            self.audio_radio_label.set_markup(f"<span foreground='{ok}'>●</span>  The radio's sound card is "
                                              "plugged in.")
        else:
            self.audio_radio_label.set_markup(
                f"<span foreground='{muted}'>○</span>  No radio sound card found. Plug in the radio's USB "
                "audio (a Digirig, or the radio's own USB port) and pick it under Settings > Radio.")
        names = sound_names()
        sink, source = pactl("get-default-sink"), pactl("get-default-source")
        if sink or source:
            text = (f"Speaker now: {names.get(sink, sink or 'none')}.  "
                    f"Microphone now: {names.get(source, source or 'none')}.")
            if self.desktop and os.path.exists(AUDIO_BEFORE):
                before = read_json(AUDIO_BEFORE, {})
                text += (f" When you exit: {names.get(before.get('sink'), before.get('sink') or 'none')} and "
                         f"{names.get(before.get('source'), before.get('source') or 'none')}.")
        else:
            text = "Couldn't read the sound settings (is PipeWire running?)."
        self.audio_now_label.set_text(text)

    def _set_audio_choice(self, value):
        if self._filling or value == self.audio["radio_default"]:
            return
        with self._audio_lock:  # after a status check that's applying the old choice has finished
            self.audio["radio_default"] = value
            write_json(AUDIO_PATH, self.audio)
            if value == "never":
                restore_sound_before()  # the computer's own speaker and microphone, now
            elif value == "always":
                restore_sound_before(devices=False)  # the radio stays; alert sounds come back
            self.default_audio_card = None  # the next status check applies it
        self._poll_status()
        GLib.timeout_add(1500, lambda: self._audio_refresh() and False)
        self._audio_refresh()

    def _set_audio_quiet(self, quiet):
        if self._filling:
            return
        self.audio["quiet"] = quiet
        write_json(AUDIO_PATH, self.audio)
        before = read_json(AUDIO_BEFORE, None)
        if isinstance(before, dict) and before.get("alert_sounds") is not None:
            alert_sounds(False if quiet else before["alert_sounds"])

