    def _load_reference_sections(self, select=None):
        current = select or self.ref_combo.get_active_id()
        self.ref_sections = dict((path, title) for title, path in reference_sections())
        self.ref_combo.remove_all()
        for path, title in self.ref_sections.items():
            self.ref_combo.append(path, title)
        # Start on the operator's own list once it has something in it.
        if current not in self.ref_sections:
            others = [p for p in self.ref_sections if p.endswith(".csv") and p != MY_FREQS]
            current = MY_FREQS if read_freqs(MY_FREQS) or not others else others[0]
        self.ref_combo.set_active_id(current)

    def _show_reference(self):
        path = self.ref_combo.get_active_id()
        if not path:
            return
        self.ref_status.set_text("")
        gateways = path == GATEWAYS
        self.ref_gw_mode.set_visible(gateways)
        self.ref_gw_update.set_visible(gateways)
        self.ref_add.set_visible(not gateways)
        if gateways:
            self._show_gateways()
            return
        if path.endswith(".txt"):
            try:
                with open(path, encoding="utf-8") as f:
                    text = f.read()
            except OSError:
                text = ""
            self.ref_text.get_buffer().set_text(text)
            self.ref_stack.set_visible_child_name("text")
            return
        rows = read_freqs(path)
        mine = path == MY_FREQS
        if mine and rows:
            # Keeps CHIRP's copy current, also when the list was copied in from a USB stick.
            export_chirp(rows)
        if not rows:
            self.ref_status.set_text("Nothing here yet. Tune the radio and tap Add frequency." if mine else "")
        self._fill_ref_list(rows, my_index=mine)

    def _fill_ref_list(self, rows, my_index=False):
        for child in self.ref_list.get_children():
            self.ref_list.remove(child)
        for index, row in enumerate(rows):
            self.ref_list.add(self._freq_row(row, index if my_index else None))
        self.ref_list.show_all()
        self.ref_stack.set_visible_child_name("list")

    def _show_gateways(self):
        rows = nearest_gateways(self.station.get("grid", ""), self.ref_gw_mode.get_active_id() or "all")
        if rows is None:
            self._fill_ref_list([])
            if shutil.which("pat"):
                # Pat writes its list the first time it's asked (from its built-in copy when offline).
                self._update_gateway_list(force=False)
            else:
                self.ref_status.set_text("Install Winlink mail (Pat) from its tile to get the gateway list.")
            return
        self._fill_ref_list(rows)
        try:
            updated = time.strftime("%Y-%m-%d", time.localtime(os.path.getmtime(RMSLIST)))
        except OSError:
            updated = "?"
        self.ref_status.set_text(f"Nearest to {self.station.get('grid', '?')} · list from {updated}")

    def _update_gateway_list(self, *_, force=True):
        if not shutil.which("pat"):
            self.ref_status.set_text("Install Winlink mail (Pat) from its tile to get the gateway list.")
            return
        self.ref_status.set_text("Getting the gateway list…")
        self.ref_gw_update.set_sensitive(False)

        def work():
            args = ["pat", "rmslist"] + (["--force-download"] if force else [])
            try:
                result = subprocess.run(args, capture_output=True, text=True, timeout=60)
                ok = result.returncode == 0
            except (OSError, subprocess.TimeoutExpired):
                ok = False
            GLib.idle_add(self._gateway_list_done, ok)

        threading.Thread(target=work, daemon=True).start()

    def _gateway_list_done(self, ok):
        self.ref_gw_update.set_sensitive(True)
        if self.ref_combo.get_active_id() == GATEWAYS:
            self._show_gateways()
            if not ok:
                self.ref_status.set_text("Couldn't download a new gateway list; the station needs internet for that.")
        return False

    def _freq_row(self, row, my_index=None):
        box = Gtk.Box(spacing=16)
        box.get_style_context().add_class("freq-row")
        mhz = f"{row['MHz']:.4f}"
        freq = Gtk.Label(label=mhz[:-1] if mhz.endswith("0") else mhz, xalign=1, width_chars=9)
        freq.get_style_context().add_class("freq")
        box.pack_start(freq, False, False, 0)
        mode = Gtk.Label(label=row["Mode"].replace("PKT", "DATA-"), xalign=0, width_chars=7)
        mode.get_style_context().add_class("mono")
        mode.get_style_context().add_class("muted")
        box.pack_start(mode, False, False, 0)
        text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        name = Gtk.Label(label=row["Name"], xalign=0, ellipsize=Pango.EllipsizeMode.END)
        name.get_style_context().add_class("tile-name")
        text.pack_start(name, False, False, 0)
        detail = freq_detail(row)
        if detail:
            note = Gtk.Label(label=detail, xalign=0, ellipsize=Pango.EllipsizeMode.END)
            note.get_style_context().add_class("tile-detail")
            text.pack_start(note, False, False, 0)
        box.pack_start(text, True, True, 0)
        if my_index is not None:
            box.pack_end(self._navbtn("Remove", lambda *_: self._remove_frequency(my_index)), False, False, 0)
        box.pack_end(self._navbtn("Tune", lambda *_: self._tune(row)), False, False, 0)
        return box

    def _tune(self, row):
        label = f"{row['MHz']:g} MHz {row['Mode']}".strip()
        if row.get("Offset") is not None or row.get("Tone"):
            missed = tune_split(row["MHz"], row.get("Offset"), row.get("Tone"))
            if missed is None:
                self.ref_status.set_text(f"The radio didn't take {row['MHz']:g} MHz FM; it may not cover that "
                                         "band, or isn't connected.")
            elif missed:
                self.ref_status.set_text(f"Radio on {row['MHz']:g} MHz FM. Set the {' and '.join(missed)} on "
                                         "the radio; it didn't take them from here.")
            else:
                self.ref_status.set_text(f"Radio on {row['MHz']:g} MHz FM, {freq_detail({**row, 'Note': ''})}")
            return
        if tune_radio(row["MHz"], row["Mode"]):
            self.ref_status.set_text(f"Radio on {label}")
        else:
            self.ref_status.set_text(f"The radio didn't take {label}; check it's connected and on the right band.")

    def _add_frequency(self, *_):
        dialog = Gtk.Dialog(title="Add frequency", transient_for=self, modal=True)
        dialog.set_default_size(560, -1)
        dialog.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Add", Gtk.ResponseType.OK)
        grid = Gtk.Grid(column_spacing=12, row_spacing=12, margin=16)
        mhz = Gtk.Entry(placeholder_text="14.300", input_purpose=Gtk.InputPurpose.NUMBER)
        mode = Gtk.ComboBoxText()
        for m in MODES:
            mode.append(m, m.replace("PKT", "DATA-"))
        name = Gtk.Entry(placeholder_text="County ARES net")
        note = Gtk.Entry(placeholder_text="Sundays 19:00 local")
        offset = Gtk.Entry(placeholder_text="Repeaters only: -0.6, +5 or 0 for simplex")
        tone = Gtk.Entry(placeholder_text="Repeaters only: CTCSS tone, e.g. 100.0")
        # Start from where the radio is now.
        hz = rigctld_query(*RIGCTLD, "f")
        if hz and hz.isdigit():
            mhz.set_text(f"{int(hz) / 1_000_000:.6f}".rstrip("0").rstrip("."))
        current_mode = rigctld_query(*RIGCTLD, "m")
        mode.set_active_id(current_mode if current_mode in MODES else "USB")
        for i, (label, widget) in enumerate((("MHz", mhz), ("Mode", mode), ("Name", name), ("Note", note),
                                             ("Offset MHz", offset), ("Tone Hz", tone))):
            grid.attach(Gtk.Label(label=label, xalign=0), 0, i, 1, 1)
            widget.set_hexpand(True)
            grid.attach(widget, 1, i, 1, 1)
        dialog.get_content_area().add(grid)
        dialog.show_all()
        while dialog.run() == Gtk.ResponseType.OK:
            try:
                value = float(mhz.get_text().strip())
            except ValueError:
                mhz.grab_focus()
                continue
            rows = read_freqs(MY_FREQS)
            shift, ctcss = to_float(offset.get_text()), to_float(tone.get_text())
            if (offset.get_text().strip() and shift is None) or (tone.get_text().strip() and not ctcss):
                (offset if shift is None and offset.get_text().strip() else tone).grab_focus()
                continue
            rows.append({"MHz": value, "Mode": mode.get_active_id(),
                         "Name": name.get_text().strip() or f"{value:g} MHz", "Note": note.get_text().strip(),
                         "Offset": shift, "Tone": ctcss})
            write_freqs(MY_FREQS, rows)
            self._load_reference_sections(select=MY_FREQS)
            break
        dialog.destroy()

    def _remove_frequency(self, index):
        rows = read_freqs(MY_FREQS)
        if index >= len(rows):
            return
        if self._confirm(f"Remove {rows[index]['Name']}?", "It comes off My frequencies."):
            del rows[index]
            write_freqs(MY_FREQS, rows)
            self._show_reference()

    def _diag_page(self):
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12, margin=20)

        header = Gtk.Box(spacing=12)
        header.pack_start(self._navbtn("‹ Home  Esc", lambda *_: self.stack.set_visible_child_name("home")), False, False, 0)
        title = Gtk.Label(label="Diagnostics", xalign=0)
        title.get_style_context().add_class("title")
        header.pack_start(title, False, False, 0)
        header.pack_end(self._navbtn("Refresh", lambda *_: self._run_into_output(["emcomm-diag", "all"])), False, False, 0)
        page.pack_start(header, False, False, 0)

        body = Gtk.Box(spacing=16)
        self.output = Gtk.TextView(editable=False, cursor_visible=False, monospace=True,
                                   left_margin=12, top_margin=8, wrap_mode=Gtk.WrapMode.CHAR)
        scroller = Gtk.ScrolledWindow()
        scroller.add(self.output)
        body.pack_start(scroller, True, True, 0)

        actions = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        actions.set_size_request(240, -1)
        actions.pack_start(self._navbtn("Read frequency", lambda *_: self._run_into_output(["emcomm-diag", "rig"])), False, False, 0)
        actions.pack_start(self._navbtn("PTT test (2 s)", self._confirm_ptt, "danger"), False, False, 0)
        actions.pack_start(self._navbtn("Audio levels", lambda *_: run_detached(["xterm", "-fa", "IBM Plex Mono", "-fs", "12", "-e", "alsamixer", "-c", "rigaudio"])), False, False, 0)
        actions.pack_start(self._navbtn("Rig control log", lambda *_: run_detached(["xterm", "-fa", "IBM Plex Mono", "-fs", "11", "-e", "journalctl", "-f", "-u", "rigctld"])), False, False, 0)
        actions.pack_start(self._navbtn("Terminal", lambda *_: run_detached(["xterm", "-fa", "IBM Plex Mono", "-fs", "12"])), False, False, 0)
        body.pack_start(actions, False, False, 0)
        page.pack_start(body, True, True, 0)

        page.connect("map", lambda *_: self._run_into_output(["emcomm-diag", "all"]))
        return page

    def _confirm_ptt(self, *_):
        dialog = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.WARNING,
                                   buttons=Gtk.ButtonsType.OK_CANCEL,
                                   text="Key the transmitter for 2 seconds?")
        dialog.format_secondary_text("Make sure an antenna or dummy load is connected.")
        response = dialog.run()
        dialog.destroy()
        if response == Gtk.ResponseType.OK:
            self._run_into_output(["emcomm-ptt-test", "2"])

    def _run_into_output(self, argv):
        buf = self.output.get_buffer()
        buf.set_text(f"$ {' '.join(argv)}\n")

        def work():
            try:
                result = subprocess.run(argv, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                        text=True, timeout=30)
                text = result.stdout
            except (OSError, subprocess.TimeoutExpired) as exc:
                text = f"failed: {exc}\n"
            GLib.idle_add(lambda: buf.insert(buf.get_end_iter(), text) and False)

        threading.Thread(target=work, daemon=True).start()


def main():
    win = Launcher(load_config())
    win.connect("destroy", Gtk.main_quit)
    if not os.environ.get("EMCOMM_LAUNCHER_WINDOWED"):
        win.fullscreen()
    win.show_all()
    win.home_bar.show_all()
    if win.station.get("callsign", "N0CALL") == "N0CALL":
        # First boot: ask for callsign and radio before anything else.
        win.stack.set_visible_child_name("settings")
    Gtk.main()


if __name__ == "__main__":
    main()
