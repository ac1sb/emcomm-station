# Programs that open an SDR receiver, by the name they run as; Free the receiver stops them.
SDR_PROGRAMS = {"gqrx", "emcomm-scanner", "rtl_tcp", "rtl_sdr", "rtl_power", "rtl_test"}


def sdr_processes():
    """(pid, name) of this user's programs that may be holding an SDR receiver."""
    found = []
    for entry in os.listdir("/proc"):
        if not entry.isdigit() or int(entry) == os.getpid():
            continue
        try:
            if os.stat(f"/proc/{entry}").st_uid != os.getuid():
                continue
            with open(f"/proc/{entry}/cmdline", "rb") as f:
                argv = [a.decode(errors="replace") for a in f.read().split(b"\0") if a]
        except OSError:
            continue
        names = [os.path.basename(a) for a in argv[:2]]  # the program, or the script an interpreter runs
        name = next((n for n in names if n in SDR_PROGRAMS), None)
        if name and "--pick-receiver" not in argv:
            found.append((int(entry), name))
    return found


