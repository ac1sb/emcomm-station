        self.ref_combo.remove_all()
        for path, title in self.ref_sections.items():
            self.ref_combo.append(path, title)
        # Start on the operator's own list once it has something in it.
        if current not in self.ref_sections:
            others = [p for p in self.ref_sections if p.endswith(".csv") and p != MY_FREQS]
            current = MY_FREQS if read_freqs(MY_FREQS) or not others else others[0]
