    def _tile(self, app, key=None):
        btn = Gtk.Button()
        btn.get_style_context().add_class("tile")
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        btn.app = app
        btn.icon_slot = Gtk.Box()
        self._set_tile_icon(btn)
        top = Gtk.Box()
        top.pack_start(btn.icon_slot, True, True, 0)
        if key:
            hint = Gtk.Label(label=str(key), yalign=0)
            hint.get_style_context().add_class("key-hint")
            top.pack_end(hint, False, False, 0)
        # Ellipsize, so five tiles across still fit a 1024-pixel screen.
        name = Gtk.Label(label=app.get("name", ""), xalign=0, ellipsize=Pango.EllipsizeMode.END)
        name.get_style_context().add_class("tile-name")
        detail = Gtk.Label(xalign=0, ellipsize=Pango.EllipsizeMode.END)
        detail.get_style_context().add_class("tile-detail")
        box.pack_start(top, True, True, 0)
        box.pack_start(name, False, False, 0)
        box.pack_start(detail, False, False, 0)
        btn.add(box)
        btn.detail = detail
        btn.connect("clicked", self._tile_clicked)
        # Long-press (touch), right-click or the Menu key: change the tile's icon.
        btn.long_press = Gtk.GestureLongPress.new(btn)
        btn.long_press.set_propagation_phase(Gtk.PropagationPhase.CAPTURE)
        btn.long_press.connect("pressed", lambda *_: self._icon_menu(btn))
        btn.connect("button-press-event", lambda _w, e: e.button == 3 and (self._icon_menu(btn) or True))
        btn.connect("popup-menu", lambda *_: self._icon_menu(btn) or True)
        self._update_tile(btn)
        return btn

    def _apply_theme(self, name):
        """Switch between the dark and light colours, now and on later starts."""
        self.theme = name
        self.colours = THEMES[name]
        screen = Gdk.Screen.get_default()
        if self.css_provider:
            Gtk.StyleContext.remove_provider_for_screen(screen, self.css_provider)
        self.css_provider = Gtk.CssProvider()
        self.css_provider.load_from_data(CSS.substitute(self.colours).encode())
        Gtk.StyleContext.add_provider_for_screen(screen, self.css_provider,
                                                 Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    def _toggle_theme(self, btn):
        name = "light" if self.theme == "dark" else "dark"
        self._apply_theme(name)
        try:
            save_theme(name)
        except OSError:
            pass
        btn.set_label(self._theme_button_label())
        for tile in self.tiles:
            self._set_tile_icon(tile)
        self._poll_status()

    def _theme_button_label(self):
        return "Light mode" if self.theme == "dark" else "Dark mode"

    def _set_tile_icon(self, btn):
        for child in btn.icon_slot.get_children():
            btn.icon_slot.remove(child)
        path = find_icon(btn.app.get("icon", ""))
        widget = None
        if path:
            try:
                widget = Gtk.Image.new_from_pixbuf(load_icon(path, self.colours["accent"]))
            except (GLib.Error, OSError):
                widget = None
        if widget is None:
            # No icon, or it can't be read: show the short code instead.
            widget = Gtk.Label(label=btn.app.get("code", ""))
            widget.get_style_context().add_class("tile-code")
        widget.set_halign(Gtk.Align.START)
        btn.icon_slot.pack_start(widget, False, False, 0)
        btn.icon_slot.show_all()

    def _icon_menu(self, btn):
        if not btn.app.get("icon"):
            return
        menu = Gtk.Menu()
        change = Gtk.MenuItem(label=f"Change {btn.app['name']} icon…")
        change.connect("activate", lambda *_: self._choose_icon(btn))
        menu.append(change)
        if user_icon(btn.app["icon"]):
            reset = Gtk.MenuItem(label="Use the standard icon")
            reset.connect("activate", lambda *_: self._reset_icon(btn))
            menu.append(reset)
        menu.show_all()
        menu.attach_to_widget(btn)
        menu.popup_at_widget(btn, Gdk.Gravity.CENTER, Gdk.Gravity.NORTH_WEST, None)

    def _choose_icon(self, btn):
        mount_usb_sticks()
        dialog = Gtk.FileChooserDialog(title=f"Pick an image for {btn.app['name']}", transient_for=self,
                                       action=Gtk.FileChooserAction.OPEN)
        dialog.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Use this image", Gtk.ResponseType.OK)
        images = Gtk.FileFilter()
        images.set_name("Images (SVG, PNG, JPG)")
        for pattern in ("*.svg", "*.png", "*.jpg", "*.jpeg", "*.SVG", "*.PNG", "*.JPG", "*.JPEG"):
            images.add_pattern(pattern)
        dialog.add_filter(images)
        for folder in [os.path.expanduser("~/Downloads")] + glob.glob(f"/media/{os.environ.get('USER', '')}/*"):
            if os.path.isdir(folder):
                dialog.add_shortcut_folder(folder)
        dialog.set_size_request(800, 500)
        response = dialog.run()
        path = dialog.get_filename()
        dialog.destroy()
        if response != Gtk.ResponseType.OK or not path:
            return
        try:
            GdkPixbuf.Pixbuf.new_from_file_at_scale(path, ICON_SIZE, ICON_SIZE, True)
        except GLib.Error:
            self._message("That file isn't an image the station can show.")
            return
        remove_user_icon(btn.app["icon"])
        os.makedirs(USER_ICONS, exist_ok=True)
        ext = os.path.splitext(path)[1].lower().replace(".jpeg", ".jpg")
        shutil.copyfile(path, os.path.join(USER_ICONS, btn.app["icon"] + ext))
        self._set_tile_icon(btn)

    def _reset_icon(self, btn):
        remove_user_icon(btn.app["icon"])
        self._set_tile_icon(btn)

    def _message(self, text):
        dialog = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.INFO,
                                   buttons=Gtk.ButtonsType.OK, text=text)
        dialog.run()
        dialog.destroy()

    @staticmethod
    def _app_state(app):
        """'ready', 'setup' (installed, needs first-time setup) or 'missing'."""
        if shutil.which(app.get("command", "")) is None:
            return "missing"
        ready = app.get("ready")
        if ready and not os.path.exists(os.path.expanduser(ready)):
            return "setup"
        return "ready"

    def _update_tile(self, btn):
        btn.app_state = self._app_state(btn.app)
        installable = bool(btn.app.get("app"))
        btn.detail.set_text({"ready": btn.app.get("detail", ""),
                             "setup": "Tap to set up",
                             "missing": "Tap to install" if installable else "Not installed",
                             }[btn.app_state])
        btn.set_sensitive(btn.app_state != "missing" or installable)
        ctx = btn.get_style_context()
        if btn.app_state == "ready":
            ctx.remove_class("not-ready")
        else:
            ctx.add_class("not-ready")

    def _refresh_tiles(self):
        for btn in self.tiles:
            self._update_tile(btn)

    def _tile_clicked(self, btn):
        app = btn.app
        if btn.app_state != "missing":
            run_detached(app.get("run") or [app["command"]])
            return
        if self._confirm(f"Install {app['name']}?",
                         "It's downloaded from the internet, which takes a few minutes."):
            self._run_in_terminal(f"Installing {app['name']}", UPDATE_CMD + ["--app", app["app"]],
                                  self._refresh_tiles)

    def _confirm(self, text, secondary):
        dialog = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.QUESTION,
                                   buttons=Gtk.ButtonsType.OK_CANCEL, text=text)
        dialog.format_secondary_text(secondary)
        response = dialog.run()
        dialog.destroy()
        return response == Gtk.ResponseType.OK

    def _run_in_terminal(self, title, argv, on_done=None):
        """Show argv's progress in a terminal window; call on_done once it's closed."""
        script = '"$@"; echo; read -r -p "Press Enter to close. " _'
        proc = subprocess.Popen(["xterm", "-fa", "IBM Plex Mono", "-fs", "12", "-geometry", "110x30",
                                 "-T", title, "-e", "bash", "-c", script, "emcomm"] + argv,
                                start_new_session=True)
        if on_done:
            GLib.child_watch_add(GLib.PRIORITY_DEFAULT, proc.pid, lambda *_: on_done())

    def _update_station(self, *_):
        if self._confirm("Update the station?",
                         "Downloads the latest Emcomm-CNC and installs any missing apps. Settings are kept. "
                         "The home screen restarts when it's done."):
            # The kiosk's autostart loop starts the new launcher after this one quits.
            self._run_in_terminal("Updating the station", UPDATE_CMD, Gtk.main_quit)

