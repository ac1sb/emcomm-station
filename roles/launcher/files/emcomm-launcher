        stream.pack_end(self.stream_btn, False, False, 0)
        stream.pack_end(Gtk.Label(label="At start-up"), False, False, 0)
        stream.pack_end(self.stream_at_start, False, False, 0)
        page.pack_start(stream, False, False, 0)

        # Select picks several recordings to delete at once; tapping a row then ticks it.
        self.rec_selecting, self.rec_selected = False, set()
        pick_bar = Gtk.Box(spacing=12)
        self.rec_pick_note = Gtk.Label(xalign=0)
        self.rec_pick_note.get_style_context().add_class("muted")
        pick_bar.pack_start(self.rec_pick_note, True, True, 0)
        self.rec_pick_cancel = self._navbtn("Cancel", lambda *_: self._recorder_select(False))
        self.rec_pick_delete = self._navbtn("Delete", lambda *_: self._recorder_delete_selected(), "danger")
        self.rec_pick_all = self._navbtn("Select all", lambda *_: self._recorder_select_all())
        self.rec_pick = self._navbtn("Select", lambda *_: self._recorder_select(True))
        for btn in (self.rec_pick_cancel, self.rec_pick_delete, self.rec_pick_all, self.rec_pick):
            btn.set_no_show_all(True)  # shown as the list needs them
            pick_bar.pack_end(btn, False, False, 0)
        page.pack_start(pick_bar, False, False, 0)

        self.rec_list = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE)
        self.rec_list.connect("row-activated", self._recorder_row_tapped)
        scroller = Gtk.ScrolledWindow()
        scroller.add(self.rec_list)
        page.pack_start(scroller, True, True, 0)
        hint = Gtk.Label(xalign=0, wrap=True, label=(
            "Records the radio's receive audio to ~/Recordings, named with the time and frequency. "
            "\"When there's a signal\" keeps only the parts with audio above the squelch, so hours of monitoring "
            "take little space. Recordings play on headphones or a speaker, never through the radio. "
            "Broadcastify streams the same receive audio to your feed while the internet is up."))
        hint.get_style_context().add_class("muted")
        page.pack_start(hint, False, False, 0)

        self.rec_listed = None
        page.connect("map", lambda *_: self._recorder_tick(page))
        page.connect("unmap", lambda *_: self._recorder_select(False))
        return page

    def _recorder_tick(self, page):
        """While the page shows: the level meter twice a second, the list when it changes."""
        if not page.get_mapped():
            return False
        status = recorder_status()
        running = status is not None
        self.rec_stop.set_sensitive(running)
        self.rec_voice.set_sensitive(not running)
        self.rec_all.set_sensitive(not running)
        level = (status or {}).get("level")
        self.rec_level.set_value(max(0, 60 + level) if isinstance(level, (int, float)) else 0)
        last = None if status else read_json(RECORDER_STATUS, None)
        if status and status.get("error"):
            text = status["error"]
        elif isinstance(last, dict) and last.get("error"):
            text = last["error"]  # the recorder stopped with an error
        elif status and status.get("recording"):
            text = f"Recording {status.get('file') or ''}"
        elif status:
            text = "Listening for a signal…" if status.get("mode") == "voice" else "Recording everything"
        else:
            text = "Stopped"
        if not getattr(self, "rec_message_until", 0) > time.time():
            self.rec_page_status.set_text(text)
        self._stream_show()
        found = recordings()
        stamp = [(p, s) for p, s, _l in found[:50]]
        if stamp != self.rec_listed:
            self.rec_listed = stamp
            self._recorder_fill(found)
        if not getattr(self, "rec_ticking", False):
            self.rec_ticking = True

            def tick():
                alive = self._recorder_tick(page)
                if not alive:
                    self.rec_ticking = False
                return alive

            GLib.timeout_add(500, tick)
        return True

    def _recorder_fill(self, found):
        for child in self.rec_list.get_children():
            self.rec_list.remove(child)
        if not found:
            self.rec_list.add(self._info_row("", "No recordings yet", "Tap a Record button to start."))
        shown = {path for path, _s, _l in found[:50]}
        self.rec_shown_count = len(shown)
        self.rec_selected &= shown  # deleted elsewhere, or no longer among the newest
        for path, size, seconds in found[:50]:
            day = os.path.basename(os.path.dirname(path))
            name = os.path.splitext(os.path.basename(path))[0]
            when, _, rest = name.partition(" ")
            length = f"{int(seconds // 60)}:{int(seconds % 60):02d}"
            mb = f"{size / 1e6:.1f} MB" if size >= 1e6 else f"{size // 1000 + 1} kB"
            detail = " · ".join(filter(None, [rest.replace(" ", " MHz ", 1) if rest else "", length, mb]))
            clock = f"{when[:2]}:{when[2:4]}:{when[4:6]}" if len(when) >= 6 else when
            if self.rec_selecting:
                row = self._info_row(clock, day, detail)
                tick = Gtk.CheckButton(active=path in self.rec_selected, valign=Gtk.Align.CENTER, can_focus=False)
                tick.get_style_context().add_class("pick")
                tick.connect("toggled", lambda b, p=path: self._recorder_tick_one(p, b.get_active()))
                row.pack_start(tick, False, False, 0)
                row.reorder_child(tick, 0)
            else:
                row = self._info_row(clock, day, detail,
                                     [("Play", lambda *_, p=path: self._recorder_play(p)),
                                      ("Delete", lambda *_, p=path: self._recorder_delete(p))])
            row.rec_path = path
            self.rec_list.add(row)
        self.rec_list.show_all()
        self._recorder_pick_show()

    def _recorder_pick_show(self):
        """The Select bar: Select, or while selecting, how many are ticked and what to do with them."""
        picking, count = self.rec_selecting, self.rec_shown_count
        self.rec_pick.set_visible(not picking and count > 0)
        for btn in (self.rec_pick_all, self.rec_pick_delete, self.rec_pick_cancel):
            btn.set_visible(picking)
        n = len(self.rec_selected)
        self.rec_pick_all.get_child().set_text("Select none" if picking and n == count else "Select all")
        self.rec_pick_delete.get_child().set_text(f"Delete {n}" if n else "Delete")
        self.rec_pick_delete.set_sensitive(n > 0)
        if picking:
            self.rec_pick_note.set_text(f"{n} of {count} selected. Tap recordings to select them."
                                        if count else "No recordings.")
        else:
            self.rec_pick_note.set_text(f"Newest {count} recordings" if count >= 50 else
                                        f"{count} recording{'' if count == 1 else 's'}" if count else "")

    def _recorder_select(self, on):
        if on == self.rec_selecting and not on:
            return
        self.rec_selecting = on
        self.rec_selected = set()
        found = recordings()  # rebuild the rows, with or without their tick boxes
        self.rec_listed = [(p, s) for p, s, _l in found[:50]]
        self._recorder_fill(found)

    def _recorder_tick_one(self, path, on):
        (self.rec_selected.add if on else self.rec_selected.discard)(path)
        self._recorder_pick_show()

    def _recorder_row_tapped(self, _list, row):
        """While selecting, a tap anywhere on a recording ticks or unticks it."""
        box = row.get_child()
        if not self.rec_selecting or not hasattr(box, "rec_path"):
            return
        tick = box.get_children()[0]
        tick.set_active(not tick.get_active())

    def _recorder_select_all(self):
        shown = [row.get_child() for row in self.rec_list.get_children()]
        paths = {box.rec_path for box in shown if hasattr(box, "rec_path")}
        everything = paths and self.rec_selected >= paths
        for box in shown:
            if hasattr(box, "rec_path"):
                box.get_children()[0].set_active(not everything)

    def _recorder_delete_selected(self):
        paths = sorted(self.rec_selected)
        if not paths:
            return
        size = 0
        for path in paths:
            try:
                size += os.path.getsize(path)
            except OSError:
                pass
        what = "this recording" if len(paths) == 1 else f"these {len(paths)} recordings"
        dialog = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.QUESTION,
                                   text=f"Delete {what}?",
                                   secondary_text=f"{size / 1e6:.1f} MB. This can't be undone.")
        dialog.add_buttons("Keep them", Gtk.ResponseType.CANCEL, "Delete", Gtk.ResponseType.OK)
        response = dialog.run()
        dialog.destroy()
        if response != Gtk.ResponseType.OK:
            return
        failed = []
        for path in paths:
            try:
                os.remove(path)
            except FileNotFoundError:
                pass
            except OSError as exc:
                failed.append(f"{os.path.basename(path)}: {exc.strerror}")
        self._recorder_select(False)
        deleted = len(paths) - len(failed)
        self._recorder_message(f"Deleted {deleted} recording{'' if deleted == 1 else 's'}."
                               + (f" Couldn't delete {'; '.join(failed)}" if failed else ""))

    def _recorder_message(self, text):
        self.rec_page_status.set_text(text)
        self.rec_message_until = time.time() + 6

    def _recorder_save_settings(self, mode=None):
        settings = read_json(RECORDER_SETTINGS, {})
        if not isinstance(settings, dict):
            settings = {}
        settings.update(at_start=self.rec_at_start.get_active(),
                        stream_at_start=self.stream_at_start.get_active())
        if mode:
            settings["mode"] = mode
        write_json(RECORDER_SETTINGS, settings)

    def _recorder_autostart(self):
        """Start recording and streaming as the Recorder page's switches ask, after a restart or power cut."""
        settings = read_json(RECORDER_SETTINGS, {})
        if not isinstance(settings, dict):
            return False
        if settings.get("at_start") and not recorder_status():
            self._recorder_start(settings.get("mode") == "all", remember=False)
        if settings.get("stream_at_start") and not stream_status() and stream_problem() is None:
            self._stream_start()
        return False

    def _recorder_start(self, everything, remember=True):
        if not shutil.which(RECORDER_CMD):
            self._recorder_message("The recorder isn't installed; tap Update station in Settings.")
            return
        if remember:
            self._recorder_save_settings("all" if everything else "voice")
        try:
            os.remove(RECORDER_STATUS)  # a previous run's error
        except OSError:
            pass
        run_detached([RECORDER_CMD, "run"] + (["--all"] if everything else []))
        self._recorder_message("Starting…")

    def _recorder_stop(self):
        status = recorder_status()
        if status:
            try:
                os.kill(int(status["pid"]), signal.SIGTERM)
            except OSError:
                pass
        self._recorder_message("Stopped. The last recording is saved.")

    def _recorder_play(self, path):
        self._recorder_message(f"Playing {os.path.basename(path)}…")

        def work():
            result = subprocess.run([RECORDER_CMD, "play", path], capture_output=True, text=True, check=False)
            if result.returncode != 0 and result.stderr.strip():
                GLib.idle_add(self._recorder_message, result.stderr.strip().splitlines()[-1])

        threading.Thread(target=work, daemon=True).start()

    def _recorder_delete(self, path):
        dialog = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.QUESTION,
                                   text="Delete this recording?", secondary_text=os.path.basename(path))
        dialog.add_buttons("Keep it", Gtk.ResponseType.CANCEL, "Delete", Gtk.ResponseType.OK)
        response = dialog.run()
        dialog.destroy()
        if response == Gtk.ResponseType.OK:
            try:
                os.remove(path)
            except OSError as exc:
                self._recorder_message(f"Couldn't delete it: {exc}")

    def _stream_show(self):
        status = stream_status()
        last = None if status else read_json(STREAM_STATUS, None)
        if status and status.get("live"):
            since = time.strftime("%H:%MZ", time.gmtime(status.get("since") or time.time()))
            text = f"Live since {since}"
        elif status and status.get("error"):
            text = status["error"]
        elif status:
            text = "Connecting…"
        elif isinstance(last, dict) and last.get("error"):
            text = last["error"]
        elif stream_problem() is not None:
            text = "Not set up: tap Feed settings and type in your feed's details."
        else:
            text = "Off"
        self.stream_state.set_text(text)
        self.stream_btn.set_label("Stop stream" if status else "Go live")

    def _stream_start(self):
        if not shutil.which(STREAM_CMD) or not shutil.which("ffmpeg"):
            self._recorder_message("Streaming isn't installed; tap Update station in Settings.")
            return
        try:
            os.remove(STREAM_STATUS)  # a previous run's error
        except OSError:
            pass
        run_detached([STREAM_CMD, "run"])

    def _stream_toggle(self, *_):
        status = stream_status()
        if status:
            try:
                os.kill(int(status["pid"]), signal.SIGTERM)
            except OSError:
                pass
            return
        if stream_problem() is not None and not self._stream_dialog():
            return
        self._stream_start()

    def _stream_dialog(self, *_):
        """The feed's details from Broadcastify. Returns True if they were saved."""
        feed = read_json(STREAM_CONFIG, {})
        if not isinstance(feed, dict):
            feed = {}
        dialog = Gtk.Dialog(title="Broadcastify feed", transient_for=self, modal=True)
        dialog.set_default_size(720, -1)
        dialog.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Save", Gtk.ResponseType.OK)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12, margin=16)
        grid = Gtk.Grid(column_spacing=16, row_spacing=10, column_homogeneous=True)
        widgets = {}
        for i, (key, label, secret) in enumerate((("server", "Server, e.g. audio9.broadcastify.com", False),
                                                  ("port", "Port", False), ("mount", "Mount", False),
                                                  ("password", "Password", True))):
            entry = Gtk.Entry(visibility=not secret)
            entry.set_text(str(feed.get(key) or ("80" if key == "port" else "")))
            widgets[key] = entry
            grid.attach(self._field(label, entry), i % 2, i // 2, 1, 1)
        box.pack_start(grid, False, False, 0)
        hint = Gtk.Label(xalign=0, wrap=True, label=(
            "Apply for a feed at broadcastify.com (Feed provider). Once it's approved, its technical details "
            "page lists the server, port, mount and password. The stream sends MP3 at 16 kbit/s mono, "
            "as Broadcastify asks."))
        hint.set_max_width_chars(90)
        hint.get_style_context().add_class("muted")
        box.pack_start(hint, False, False, 0)
        dialog.get_content_area().add(box)
        dialog.show_all()
        response = dialog.run()
        values = {key: entry.get_text().strip() for key, entry in widgets.items()}
        dialog.destroy()
        if response != Gtk.ResponseType.OK:
            return False
        feed.update(values)
        try:
            feed["port"] = int(feed["port"] or 80)
        except ValueError:
            pass
        write_json(STREAM_CONFIG, feed, private=True)  # the password stays readable only by the station user
        self._stream_show()
        return True

