def read_json(path, default):
    try:
        with open(path, encoding="utf-8") as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


def load_config():
    return read_json(CONFIG_PATH, {"apps": []})


def load_station():
    return read_json(STATION_PATH, {"callsign": "N0CALL", "grid": "", "radio": ""})


def load_profiles():
    """Radio profiles as (id, profile), sorted by display name."""
    profiles = []
    try:
        names = sorted(os.listdir(PROFILES_DIR))
    except OSError:
        names = []
    for name in names:
        if name.endswith(".json"):
            profile = read_json(os.path.join(PROFILES_DIR, name), None)
            if profile:
                profiles.append((name[:-5], profile))
    return sorted(profiles, key=lambda p: p[1].get("radio_name", p[0]))


def rigctld_query(host, port, command, timeout=1.0):
    """Send one rigctld command and return the first reply line, or None."""
    try:
        with socket.create_connection((host, port), timeout=timeout) as s:
            s.sendall(command.encode() + b"\n")
            data = s.recv(256).decode(errors="replace")
            return data.splitlines()[0].strip() if data else None
    except OSError:
        return None


def format_freq(hz_text):
    try:
        hz = int(hz_text)
    except (TypeError, ValueError):
        return None
    mhz, rest = divmod(hz, 1_000_000)
    khz, h = divmod(rest, 1000)
    return f"{mhz}.{khz:03d}.{h:03d}"


def run_detached(argv):
    subprocess.Popen(argv, start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


class Launcher(Gtk.Window):
    def __init__(self, config):
        super().__init__(title="Emcomm-CNC")
        self.config = config
        self.station = load_station()
        self.profiles = load_profiles()
        self.set_default_size(1024, 600)

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        root.get_style_context().add_class("page")
        self.add(root)
        root.pack_start(self._topbar(), False, False, 0)

        self.stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE)
        self.stack.add_named(self._home_page(), "home")
        self.stack.add_named(self._diag_page(), "diagnostics")
        self.stack.add_named(self._settings_page(), "settings")
        root.pack_start(self.stack, True, True, 0)

        self._tick_clock()
        GLib.timeout_add_seconds(1, self._tick_clock)
        self._poll_status()
        GLib.timeout_add_seconds(5, self._poll_status)
        self.connect("key-press-event", self._on_key)

    # ---- keyboard ------------------------------------------------------

    def _on_key(self, _widget, event):
        """Esc/F1 Home, F2 Diagnostics, F3 Settings, 1-9 open a tile on Home."""
        pages = {Gdk.KEY_Escape: "home", Gdk.KEY_F1: "home",
                 Gdk.KEY_F2: "diagnostics", Gdk.KEY_F3: "settings"}
        if event.keyval in pages:
            self.stack.set_visible_child_name(pages[event.keyval])
            return True
        if self.stack.get_visible_child_name() == "home" and Gdk.KEY_1 <= event.keyval <= Gdk.KEY_9:
            index = event.keyval - Gdk.KEY_1
            if index < len(self.tiles) and self.tiles[index].get_sensitive():
                self.tiles[index].clicked()
            return True
        return False

    # ---- top bar -------------------------------------------------------

    def _topbar(self):
        bar = Gtk.Box(spacing=20)
        bar.get_style_context().add_class("topbar")
        self.call_label = Gtk.Label()
        self.call_label.get_style_context().add_class("callsign")
        bar.pack_start(self.call_label, False, False, 0)
        self.grid_label = Gtk.Label()
        self.grid_label.get_style_context().add_class("muted")
        bar.pack_start(self.grid_label, False, False, 0)
        self._show_station()

        self.clock = Gtk.Label()
        self.clock.get_style_context().add_class("mono")
        bar.pack_end(self.clock, False, False, 0)
        self.audio_status = Gtk.Label()
        bar.pack_end(self.audio_status, False, False, 0)
        self.rig_status = Gtk.Label()
        bar.pack_end(self.rig_status, False, False, 0)
        return bar

    def _show_station(self):
        self.call_label.set_text(self.station.get("callsign", ""))
        self.grid_label.set_text(f"Grid {self.station.get('grid', '')}")

    def _tick_clock(self):
        self.clock.set_text(time.strftime("%H:%M UTC", time.gmtime()))
        return True

    def _poll_status(self):
        def work():
            freq = format_freq(rigctld_query(*RIGCTLD, "f"))
            audio = os.path.exists("/proc/asound/rigaudio")
            GLib.idle_add(self._show_status, freq, audio)

        threading.Thread(target=work, daemon=True).start()
        return True

    def _show_status(self, freq, audio):
        if freq:
            self.rig_status.set_markup(f"<span foreground='#4FC3B8'>●</span>  Rig  <tt>{freq}</tt>")
        else:
            self.rig_status.set_markup("<span foreground='#9AA0A6'>○</span>  Rig not connected")
        dot = "<span foreground='#4FC3B8'>●</span>" if audio else "<span foreground='#9AA0A6'>○</span>"
        self.audio_status.set_markup(f"{dot}  Radio audio")
        return False

    # ---- home ----------------------------------------------------------

    def _home_page(self):
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16, margin=20)
        grid = Gtk.Grid(column_spacing=12, row_spacing=12, column_homogeneous=True, row_homogeneous=True)
        self.tiles = []
        for i, app in enumerate(self.config.get("apps", [])):
            tile = self._tile(app, i + 1 if i < 9 else None)
            self.tiles.append(tile)
            grid.attach(tile, i % 3, i // 3, 1, 1)
        page.pack_start(grid, True, True, 0)

        nav = Gtk.Box(spacing=12, homogeneous=True)
        nav.pack_start(self._navbtn("Diagnostics  F2", lambda *_: self.stack.set_visible_child_name("diagnostics")), True, True, 0)
        nav.pack_start(self._navbtn("Settings  F3", lambda *_: self.stack.set_visible_child_name("settings")), True, True, 0)
        nav.pack_start(self._navbtn("Power", self._power_dialog), True, True, 0)
        page.pack_end(nav, False, False, 0)
        return page

    def _tile(self, app, key=None):
        btn = Gtk.Button()
        btn.get_style_context().add_class("tile")
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        code = Gtk.Label(label=app.get("code", ""), xalign=0)
        code.get_style_context().add_class("tile-code")
        top = Gtk.Box()
        top.pack_start(code, True, True, 0)
        if key:
            hint = Gtk.Label(label=str(key), yalign=0)
            hint.get_style_context().add_class("key-hint")
            top.pack_end(hint, False, False, 0)
        name = Gtk.Label(label=app.get("name", ""), xalign=0)
        name.get_style_context().add_class("tile-name")
        installed = shutil.which(app.get("command", "")) is not None
        detail = Gtk.Label(label=app.get("detail", "") if installed else "Not installed yet", xalign=0)
        detail.get_style_context().add_class("tile-detail")
        box.pack_start(top, True, True, 0)
        box.pack_start(name, False, False, 0)
        box.pack_start(detail, False, False, 0)
        btn.add(box)
        btn.set_sensitive(installed)
        btn.connect("clicked", lambda *_: run_detached([app["command"]]))
        return btn

    def _navbtn(self, label, handler, extra_class=None):
        btn = Gtk.Button(label=label)
        btn.get_style_context().add_class("navbtn")
        if extra_class:
            btn.get_style_context().add_class(extra_class)
        btn.connect("clicked", handler)
        return btn

    def _power_dialog(self, *_):
        dialog = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.QUESTION,
                                   text="Shut down the station?")
        dialog.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Restart", 1, "Shut down", 2)
        response = dialog.run()
        dialog.destroy()
        if response == 1:
            run_detached(["systemctl", "reboot"])
        elif response == 2:
            run_detached(["systemctl", "poweroff"])

    # ---- settings ------------------------------------------------------

    def _field(self, label, widget):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        lbl = Gtk.Label(label=label, xalign=0)
        lbl.get_style_context().add_class("field-label")
        lbl.set_mnemonic_widget(widget)
        box.pack_start(lbl, False, False, 0)
        box.pack_start(widget, False, False, 0)
        return box

    def _section(self, title):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        box.get_style_context().add_class("section")
        heading = Gtk.Label(label=title.upper(), xalign=0)
        heading.get_style_context().add_class("section-title")
        box.pack_start(heading, False, False, 0)
        return box

    def _settings_page(self):
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12, margin=20)

        header = Gtk.Box(spacing=12)
        header.pack_start(self._navbtn("‹ Home  Esc", lambda *_: self.stack.set_visible_child_name("home")), False, False, 0)
        title = Gtk.Label(label="Station settings", xalign=0)
        title.get_style_context().add_class("title")
        header.pack_start(title, False, False, 0)
        page.pack_start(header, False, False, 0)

        cols = Gtk.Box(spacing=16, homogeneous=True)

        operator = self._section("Operator")
        self.callsign_entry = Gtk.Entry(max_length=12)
        self.grid_entry = Gtk.Entry(max_length=6)
        operator.pack_start(self._field("Callsign", self.callsign_entry), False, False, 0)
        operator.pack_start(self._field("Grid square", self.grid_entry), False, False, 0)
        self.settings_message = Gtk.Label(xalign=0, wrap=True)
        self.settings_message.set_max_width_chars(40)
        operator.pack_end(self.settings_message, False, False, 0)
        cols.pack_start(operator, True, True, 0)

        radio = self._section("Radio")
        self.radio_combo = Gtk.ComboBoxText()
        for radio_id, profile in self.profiles:
            self.radio_combo.append(radio_id, profile.get("radio_name", radio_id))
        self.radio_combo.connect("changed", self._radio_changed)
        self.baud_combo = Gtk.ComboBoxText()
        for baud in BAUD_RATES:
            self.baud_combo.append(baud, baud)
        self.ptt_combo = Gtk.ComboBoxText()
        for value, label in PTT_CHOICES:
            self.ptt_combo.append(value, label)
        radio.pack_start(self._field("Radio", self.radio_combo), False, False, 0)
        row = Gtk.Box(spacing=12, homogeneous=True)
        row.pack_start(self._field("CAT baud rate", self.baud_combo), True, True, 0)
        row.pack_start(self._field("PTT", self.ptt_combo), True, True, 0)
        radio.pack_start(row, False, False, 0)
        hint = Gtk.Label(label="The baud rate must match the radio's CAT RATE menu.", xalign=0, wrap=True)
        hint.set_max_width_chars(40)
        hint.get_style_context().add_class("tile-detail")
        radio.pack_start(hint, False, False, 0)
        cols.pack_start(radio, True, True, 0)
        page.pack_start(cols, True, True, 0)

        buttons = Gtk.Box(spacing=12, homogeneous=True)
        buttons.pack_start(self._navbtn("Undo changes", lambda *_: self._fill_settings()), True, True, 0)
        save = self._navbtn("Save and restart rig control", self._save_settings, "primary")
        buttons.pack_start(save, True, True, 0)
        page.pack_end(buttons, False, False, 0)

        self._fill_settings()
        page.connect("map", lambda *_: self._fill_settings())
        return page

    def _profile(self, radio_id):
        return dict(self.profiles).get(radio_id, {})

    def _fill_settings(self):
        st = self.station
        self.callsign_entry.set_text("" if st.get("callsign") == "N0CALL" else st.get("callsign", ""))
        self.grid_entry.set_text(st.get("grid", ""))
        self.radio_combo.set_active_id(st.get("radio") or (self.profiles[0][0] if self.profiles else None))
        profile = self._profile(self.radio_combo.get_active_id())
        self.baud_combo.set_active_id(str(st.get("cat_baud", profile.get("cat_baud", 38400))))
        self.ptt_combo.set_active_id(st.get("ptt_method", profile.get("ptt_method", "CAT")))
        self.settings_message.set_text("")

    def _radio_changed(self, combo):
        # A different radio starts from that profile's own baud rate and PTT.
        profile = self._profile(combo.get_active_id())
        if profile and combo.get_active_id() != self.station.get("radio"):
            self.baud_combo.set_active_id(str(profile.get("cat_baud", 38400)))
            self.ptt_combo.set_active_id(profile.get("ptt_method", "CAT"))

    def _save_settings(self, *_):
        new = {
            "callsign": self.callsign_entry.get_text().strip().upper(),
            "grid": self.grid_entry.get_text().strip(),
            "radio": self.radio_combo.get_active_id(),
            "cat_baud": int(self.baud_combo.get_active_id() or 38400),
            "ptt_method": self.ptt_combo.get_active_id(),
        }
        self._set_message("Saving…", None)

        def work():
            with tempfile.NamedTemporaryFile("w", suffix=".json", delete=False) as f:
                json.dump(new, f)
                path = f.name
            try:
                result = subprocess.run(APPLY_CMD + [path], stdout=subprocess.PIPE,
                                        stderr=subprocess.STDOUT, text=True, timeout=60)
                ok, text = result.returncode == 0, result.stdout.strip()
            except (OSError, subprocess.TimeoutExpired) as exc:
                ok, text = False, f"Settings not saved: {exc}"
            finally:
                os.unlink(path)
            GLib.idle_add(self._saved, ok, text)

        threading.Thread(target=work, daemon=True).start()

    def _saved(self, ok, text):
        self._set_message(text, ok)
        if ok:
            self.station = load_station()
            self._show_station()
            self.callsign_entry.set_text(self.station.get("callsign", ""))
            self.grid_entry.set_text(self.station.get("grid", ""))
        return False

    def _set_message(self, text, ok):
        ctx = self.settings_message.get_style_context()
        ctx.remove_class("ok")
        ctx.remove_class("error")
        if ok is not None:
            ctx.add_class("ok" if ok else "error")
        self.settings_message.set_text(text)

    # ---- diagnostics ---------------------------------------------------

    def _diag_page(self):
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12, margin=20)

        header = Gtk.Box(spacing=12)
        header.pack_start(self._navbtn("‹ Home  Esc", lambda *_: self.stack.set_visible_child_name("home")), False, False, 0)
        title = Gtk.Label(label="Diagnostics", xalign=0)
        title.get_style_context().add_class("title")
        header.pack_start(title, False, False, 0)
        header.pack_end(self._navbtn("Refresh", lambda *_: self._run_into_output(["emcomm-diag", "all"])), False, False, 0)
        page.pack_start(header, False, False, 0)

        body = Gtk.Box(spacing=16)
        self.output = Gtk.TextView(editable=False, cursor_visible=False, monospace=True,
                                   left_margin=12, top_margin=8, wrap_mode=Gtk.WrapMode.CHAR)
        scroller = Gtk.ScrolledWindow()
        scroller.add(self.output)
        body.pack_start(scroller, True, True, 0)

        actions = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        actions.set_size_request(240, -1)
        actions.pack_start(self._navbtn("Read frequency", lambda *_: self._run_into_output(["emcomm-diag", "rig"])), False, False, 0)
        actions.pack_start(self._navbtn("PTT test (2 s)", self._confirm_ptt, "danger"), False, False, 0)
        actions.pack_start(self._navbtn("Audio levels", lambda *_: run_detached(["xterm", "-fa", "IBM Plex Mono", "-fs", "12", "-e", "alsamixer", "-c", "rigaudio"])), False, False, 0)
        actions.pack_start(self._navbtn("Rig control log", lambda *_: run_detached(["xterm", "-fa", "IBM Plex Mono", "-fs", "11", "-e", "journalctl", "-f", "-u", "rigctld"])), False, False, 0)
        actions.pack_start(self._navbtn("Terminal", lambda *_: run_detached(["xterm", "-fa", "IBM Plex Mono", "-fs", "12"])), False, False, 0)
        body.pack_start(actions, False, False, 0)
        page.pack_start(body, True, True, 0)

        page.connect("map", lambda *_: self._run_into_output(["emcomm-diag", "all"]))
        return page

    def _confirm_ptt(self, *_):
        dialog = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.WARNING,
                                   buttons=Gtk.ButtonsType.OK_CANCEL,
                                   text="Key the transmitter for 2 seconds?")
        dialog.format_secondary_text("Make sure an antenna or dummy load is connected.")
        response = dialog.run()
        dialog.destroy()
        if response == Gtk.ResponseType.OK:
            self._run_into_output(["emcomm-ptt-test", "2"])

    def _run_into_output(self, argv):
        buf = self.output.get_buffer()
        buf.set_text(f"$ {' '.join(argv)}\n")

        def work():
            try:
                result = subprocess.run(argv, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                        text=True, timeout=30)
                text = result.stdout
            except (OSError, subprocess.TimeoutExpired) as exc:
                text = f"failed: {exc}\n"
            GLib.idle_add(lambda: buf.insert(buf.get_end_iter(), text) and False)

        threading.Thread(target=work, daemon=True).start()


def main():
    provider = Gtk.CssProvider()
    provider.load_from_data(CSS)
    Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), provider,
                                             Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
    win = Launcher(load_config())
    win.connect("destroy", Gtk.main_quit)
    if not os.environ.get("EMCOMM_LAUNCHER_WINDOWED"):
        win.fullscreen()
    win.show_all()
    if win.station.get("callsign", "N0CALL") == "N0CALL":
        # First boot: ask for callsign and radio before anything else.
        win.stack.set_visible_child_name("settings")
    Gtk.main()


if __name__ == "__main__":
    main()
