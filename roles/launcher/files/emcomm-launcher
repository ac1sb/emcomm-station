def pid_ancestors(pid):
    """The pid and its parents, nearest first."""
    chain = []
    while pid > 1 and len(chain) < 30:
        chain.append(pid)
        try:
            with open(f"/proc/{pid}/stat", encoding="utf-8") as f:
                pid = int(f.read().rsplit(")", 1)[1].split()[1])
        except (OSError, IndexError, ValueError):
            break
    return chain


def window_app(win, apps, started):
    """The launcher app a window belongs to: started from its tile (the window's
    process is the one the tile ran, or a child of it), or else its window class
    names the app's command. None for anything else."""
    chain = pid_ancestors(win["pid"])
    for app in apps:
        if started.get(app.get("code")) in chain:
            return app
    cls = win["cls"].lower().split(".")
    for app in apps:
        if app.get("command", "").lower() in cls and app.get("command") not in ("wine", "xterm"):
            return app
    return None


