    def _wifi_refresh(self, message=None):
        self.wifi_status.set_text(message or "Looking for networks…")

        def work():
            if not shutil.which("nmcli"):
                GLib.idle_add(self._wifi_show, None, [], "NetworkManager isn't installed; tap Update station.")
                return
            dev, state, ssid = wifi_state()
            if not dev:
                GLib.idle_add(self._wifi_show, None, [], f"No Wi-Fi: {state}.")
                return
            if state == "unmanaged":
                GLib.idle_add(self._wifi_show, None, [],
                              "This Wi-Fi adapter was set up by the Debian installer. To pick networks "
                              "here, remove its lines from /etc/network/interfaces and restart.")
                return
            nets, error = wifi_networks()
            GLib.idle_add(self._wifi_show, dev, nets or [], message or (
                f"Connected to {ssid}" if ssid else error or "Not connected. Tap a network to join it."))

        threading.Thread(target=work, daemon=True).start()

    def _wifi_show(self, dev, nets, status):
        self.wifi_device = dev
        self.wifi_status.set_text(status)
        self.wifi_disconnect.set_visible(any(n["in_use"] for n in nets))
        for child in self.wifi_list.get_children():
            self.wifi_list.remove(child)
