    def _tick_clock(self):
        self.clock.set_text(time.strftime("%H:%M UTC", time.gmtime()))
        return True

    def _poll_status(self):
        def work():
            freq = format_freq(rigctld_query(*RIGCTLD, "f"))
            audio = os.path.exists("/proc/asound/rigaudio")
            self._default_audio_to_radio(audio)
            net = self._network_summary()
            GLib.idle_add(self._show_status, freq, audio, net)

        threading.Thread(target=work, daemon=True).start()
        return True

    def _default_audio_to_radio(self, audio):
        """Each time the radio's sound card appears, make it the default audio device.
        Retried on later polls until PipeWire has picked the card up."""
        card = os.path.realpath("/proc/asound/rigaudio") if audio else None
        if card and card != self.default_audio_card and shutil.which("emcomm-audio-default"):
            result = subprocess.run(["emcomm-audio-default"], capture_output=True, check=False)
            if result.returncode == 0:
                self.default_audio_card = card
        elif not card:
            self.default_audio_card = None

    @staticmethod
    def _network_summary():
        """('Wi-Fi NAME' / 'Network' / 'No network', connected?), or None without NetworkManager."""
        if not shutil.which("nmcli"):
            return None
        _dev, _state, ssid = wifi_state()
        if ssid:
            return f"Wi-Fi {ssid}", True
        ok, out = nmcli("-t", "-f", "STATE", "general", timeout=5)
        connected = ok and out.strip().startswith("connected")
        return ("Network" if connected else "No network"), connected

    def _show_status(self, freq, audio, net=None):
        if freq:
            self.rig_status.set_markup(f"<span foreground='{self.colours['ok']}'>●</span>  Rig  <tt>{freq}</tt>")
        else:
            self.rig_status.set_markup(f"<span foreground='{self.colours['muted']}'>○</span>  Rig not connected")
        dot = (f"<span foreground='{self.colours['ok']}'>●</span>" if audio
               else f"<span foreground='{self.colours['muted']}'>○</span>")
        self.audio_status.set_markup(f"{dot}  Radio audio")
        if net:
            dot = (f"<span foreground='{self.colours['ok']}'>●</span>" if net[1]
                   else f"<span foreground='{self.colours['muted']}'>○</span>")
            self.net_status.set_markup(f"{dot}  {GLib.markup_escape_text(net[0])}")
        self.net_status.set_visible(bool(net))
        self._refresh_tiles()
        return False

