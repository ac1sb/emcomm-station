def load_icon(path, colour):
    """A tile icon as a pixbuf. The standard SVG icons are redrawn in the theme's accent colour."""
    if path.endswith(".svg") and path.startswith(ICONS_DIR + "/"):
        with open(path, "rb") as f:
            svg = f.read().replace(ICON_COLOUR.encode(), colour.encode())
        loader = GdkPixbuf.PixbufLoader()
        loader.set_size(ICON_SIZE, ICON_SIZE)
        loader.write(svg)
        loader.close()
        return loader.get_pixbuf()
    return GdkPixbuf.Pixbuf.new_from_file_at_scale(path, ICON_SIZE, ICON_SIZE, True)


