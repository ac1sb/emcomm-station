        return box

    def _wifi_connect(self, net):
        # "private": the network is saved for the station user, which the person at
        # the screen may do without an admin password.
        args = ["device", "wifi", "connect", net["ssid"], "private", "yes"]
        known, _ = nmcli("-t", "-f", "NAME", "connection", "show", net["ssid"], timeout=10)
        if net["secure"] and not known:
            password = self._ask_password(net["ssid"])
            if password is None:
                return
            args += ["password", password]
        if self.wifi_device:
            args += ["ifname", self.wifi_device]
        self.wifi_status.set_text(f"Connecting to {net['ssid']}…")

        def work():
            ok, out = nmcli(*args, timeout=60)
            if not ok and known:
                # A saved password that no longer works: forget it so the next tap asks again.
                nmcli("connection", "delete", net["ssid"], timeout=10)
            message = f"Connected to {net['ssid']}" if ok else f"Couldn't join {net['ssid']}: {out}"
            GLib.idle_add(self._wifi_refresh, message)

        threading.Thread(target=work, daemon=True).start()

    def _ask_password(self, ssid):
        dialog = Gtk.Dialog(title=f"Join {ssid}", transient_for=self, modal=True)
        dialog.set_default_size(520, -1)
        dialog.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Connect", Gtk.ResponseType.OK)
        dialog.set_default_response(Gtk.ResponseType.OK)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12, margin=16)
        box.pack_start(Gtk.Label(label=f"Password for {ssid}", xalign=0), False, False, 0)
        entry = Gtk.Entry(visibility=False, activates_default=True, input_purpose=Gtk.InputPurpose.PASSWORD)
        box.pack_start(entry, False, False, 0)
        show = Gtk.CheckButton(label="Show password")
        show.connect("toggled", lambda b: entry.set_visibility(b.get_active()))
        box.pack_start(show, False, False, 0)
        dialog.get_content_area().add(box)
        dialog.show_all()
        response = dialog.run()
        password = entry.get_text()
        dialog.destroy()
        return password if response == Gtk.ResponseType.OK and password else None

    def _wifi_disconnect_clicked(self, *_):
        if not self.wifi_device:
            return
        self.wifi_status.set_text("Disconnecting…")

        def work():
            ok, out = nmcli("device", "disconnect", self.wifi_device)
            GLib.idle_add(self._wifi_refresh, "Disconnected" if ok else f"Couldn't disconnect: {out}")

        threading.Thread(target=work, daemon=True).start()

