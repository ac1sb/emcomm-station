    def _wifi_refresh(self, message=None):
        self.wifi_status.set_text(message or "Looking for networks…")

        def work():
            if not shutil.which("nmcli"):
                GLib.idle_add(self._wifi_show, None, [], "NetworkManager isn't installed; tap Update station.")
                return
            dev, state, ssid = wifi_state()
            if not dev:
                GLib.idle_add(self._wifi_show, None, [], f"No Wi-Fi: {state}.")
                return
            if state == "unmanaged":
                GLib.idle_add(self._wifi_show, None, [],
                              "This Wi-Fi adapter was set up by the Debian installer. To pick networks "
                              "here, remove its lines from /etc/network/interfaces and restart.")
                return
            nets, error = wifi_networks()
            GLib.idle_add(self._wifi_show, dev, nets or [], message or (
                f"Connected to {ssid}" if ssid else error or "Not connected. Tap a network to join it."))

        threading.Thread(target=work, daemon=True).start()

    def _wifi_show(self, dev, nets, status):
        self.wifi_device = dev
        self.wifi_status.set_text(status)
        self.wifi_disconnect.set_visible(any(n["in_use"] for n in nets))
        for child in self.wifi_list.get_children():
            self.wifi_list.remove(child)
        for net in nets:
            self.wifi_list.add(self._wifi_row(net))
        self.wifi_list.show_all()
        return False

    def _wifi_row(self, net):
        box = Gtk.Box(spacing=16)
        box.get_style_context().add_class("freq-row")
        bars = "▂▄▆█"[:max(1, min(4, (net["signal"] + 24) // 25))]
        strength = Gtk.Label(label=bars.ljust(4), xalign=0, width_chars=5)
        strength.get_style_context().add_class("freq")
        box.pack_start(strength, False, False, 0)
        text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        name = Gtk.Label(label=net["ssid"], xalign=0, ellipsize=Pango.EllipsizeMode.END)
        name.get_style_context().add_class("tile-name")
        text.pack_start(name, False, False, 0)
        detail = ("Connected · " if net["in_use"] else "") + ("Password" if net["secure"] else "Open") + f" · {net['signal']}%"
        info = Gtk.Label(label=detail, xalign=0)
        info.get_style_context().add_class("tile-detail")
        text.pack_start(info, False, False, 0)
        box.pack_start(text, True, True, 0)
        if not net["in_use"]:
            box.pack_end(self._navbtn("Connect", lambda *_: self._wifi_connect(net), "primary"), False, False, 0)
        return box

    def _wifi_connect(self, net):
        # "private": the network is saved for the station user, which the person at
        # the screen may do without an admin password.
        args = ["device", "wifi", "connect", net["ssid"], "private", "yes"]
        known, _ = nmcli("-t", "-f", "NAME", "connection", "show", net["ssid"], timeout=10)
        if net["secure"] and not known:
            password = self._ask_password(net["ssid"])
            if password is None:
                return
            args += ["password", password]
        if self.wifi_device:
            args += ["ifname", self.wifi_device]
        self.wifi_status.set_text(f"Connecting to {net['ssid']}…")

        def work():
            ok, out = nmcli(*args, timeout=60)
            if not ok and known:
                # A saved password that no longer works: forget it so the next tap asks again.
                nmcli("connection", "delete", net["ssid"], timeout=10)
            message = f"Connected to {net['ssid']}" if ok else f"Couldn't join {net['ssid']}: {out}"
            GLib.idle_add(self._wifi_refresh, message)

        threading.Thread(target=work, daemon=True).start()

    def _ask_password(self, ssid):
        dialog = Gtk.Dialog(title=f"Join {ssid}", transient_for=self, modal=True)
        dialog.set_default_size(520, -1)
        dialog.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Connect", Gtk.ResponseType.OK)
        dialog.set_default_response(Gtk.ResponseType.OK)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12, margin=16)
        box.pack_start(Gtk.Label(label=f"Password for {ssid}", xalign=0), False, False, 0)
        entry = Gtk.Entry(visibility=False, activates_default=True, input_purpose=Gtk.InputPurpose.PASSWORD)
        box.pack_start(entry, False, False, 0)
        show = Gtk.CheckButton(label="Show password")
        show.connect("toggled", lambda b: entry.set_visibility(b.get_active()))
        box.pack_start(show, False, False, 0)
        dialog.get_content_area().add(box)
        dialog.show_all()
        response = dialog.run()
        password = entry.get_text()
        dialog.destroy()
        return password if response == Gtk.ResponseType.OK and password else None

    def _wifi_disconnect_clicked(self, *_):
        if not self.wifi_device:
            return
        self.wifi_status.set_text("Disconnecting…")

        def work():
            ok, out = nmcli("device", "disconnect", self.wifi_device)
            GLib.idle_add(self._wifi_refresh, "Disconnected" if ok else f"Couldn't disconnect: {out}")

        threading.Thread(target=work, daemon=True).start()

