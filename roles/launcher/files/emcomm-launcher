    def _forms_tick(self, page):
        """While the page shows, look for new or changed items every few seconds. The list
        comes from a separate program, so it's asked off the screen's thread."""
        if not page.get_mapped():
            self.forms_ticking = False
            return False
        if not getattr(self, "forms_busy", False):
            self.forms_busy = True
            threading.Thread(target=lambda: GLib.idle_add(self._forms_found, forms_list()), daemon=True).start()
        if not getattr(self, "forms_ticking", False):
            self.forms_ticking = True
            GLib.timeout_add_seconds(4, self._forms_tick, page)
        return True

    def _forms_found(self, found):
        self.forms_busy = False
        stamp = [(m["path"], m.get("modified"), m.get("open")) for m in found]
        if stamp != self.forms_listed:
            self.forms_listed, self.forms_found = stamp, found
            self._forms_fill(found)
        return False

    def _forms_fill(self, found):
        keep = self.forms_item["path"] if self.forms_item else None
        kind = self.forms_filter.get_active_id() or "all"
        shown = [m for m in found if kind == "all" or m.get("kind") == kind
                 or (kind == "forms" and m.get("kind") in ("309", "205", "form"))]
        for child in self.forms_list.get_children():
            self.forms_list.remove(child)
        for item in shown:
            row = Gtk.ListBoxRow()
            row.item = item
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2, margin=8)
            name = Gtk.Label(label=("● " if item.get("open") else "") + (item.get("title") or "(untitled)"), xalign=0,
                             ellipsize=Pango.EllipsizeMode.END)
            name.get_style_context().add_class("tile-name")
            note = Gtk.Label(label=item.get("detail", ""), xalign=0, ellipsize=Pango.EllipsizeMode.END)
            note.get_style_context().add_class("tile-detail")
            box.pack_start(name, False, False, 0)
            box.pack_start(note, False, False, 0)
            row.add(box)
            self.forms_list.add(row)
        if not shown:
            hint = Gtk.Label(xalign=0, wrap=True, margin=12, label=(
                "Nothing here yet.\n\nNew ▾ starts an ICS-213 message (typed on the form), a net log, "
                "or an ICS-309 or ICS-205 form. Messages fldigi receives show here too.\n\n"
                "This is the blank ICS-213; Print gives you paper copies."))
            hint.get_style_context().add_class("muted")
            row = Gtk.ListBoxRow(selectable=False, activatable=False)
            row.add(hint)
            self.forms_list.add(row)
        self.forms_list.show_all()
        if not shown:
            self._forms_show(None)
            return
        rows = [r for r in self.forms_list.get_children() if hasattr(r, "item")]
        pick = next((r for r in rows if r.item["path"] == keep), rows[0])
        self.forms_item = None  # the file may have changed: show it again
        self.forms_list.select_row(pick)
        if self.forms_item is None:  # the same row again: no row-selected signal
            self._forms_show(pick.item)

    def _forms_selected(self, _listbox, row):
        if row is not None and hasattr(row, "item") and (self.forms_item is None
                                                         or row.item["path"] != self.forms_item["path"]):
            self._forms_show(row.item)

    def _forms_show(self, item):
        """Show the item picked: a message on the form, a net as its log, a form by name."""
        self.forms_item = item
        kind = item.get("kind") if item else None
        group = "213" if kind == "213" else "net" if kind == "net" else "form" if kind else None
        for name, btns in self.forms_kind_btns.items():
            for btn in btns:
                btn.set_visible(name == group)
        if group in ("213", None):
            self.forms_view.set_visible_child_name("pdf")
            self._ics213_show(item["path"] if item else None)
            return
        self.f213_path, self.f213_doc = None, None
        if kind == "net":
            net = read_json(item["path"], {})
            net = net if isinstance(net, dict) else {}
            lines = [net.get("name") or "Net", item.get("detail", "")]
            if net.get("incident"):
                lines.append(f"Incident: {net['incident']}")
            operator = " ".join(filter(None, [net.get("operator", ""), net.get("callsign", "")]))
            if operator:
                lines.append(f"Net control: {operator}")
            if net.get("frequency"):
                lines.append(f"Frequency: {net['frequency']}")
            text = "\n".join(lines) + "\n\n" + net_lines(net)
            self.f213_status.set_text("Net control logs check-ins and traffic; ICS-309 log fills in the form for "
                                      "this net.")
        else:
            text = (f"{item.get('title', '')}\n{item.get('detail', '')}\n\n"
                    "Open / Print shows the filled-in form with a Print button; the print dialog can also "
                    f"save a PDF to a USB stick.\n\nKept at {item['path'].replace(os.path.expanduser('~'), '~')}\n")
            self.f213_status.set_text("")
        self.forms_view.set_visible_child_name("text")
        self.forms_text.get_buffer().set_text(text)

