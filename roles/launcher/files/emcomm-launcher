    def go_home(self):
        """Bring the launcher back in front of any app, on its Home page."""
        self.show_page("home")

    def show_page(self, name):
        """Bring the launcher back in front of any app, on the page given."""
        self.stack.set_visible_child_name(name)
        self.deiconify()
        self._set_fullscreen(not self._keyboard_shown())
        self.present_with_time(Gtk.get_current_event_time())

    # ---- on-screen keyboard -------------------------------------------

    def _keyboard_shown(self):
        return self.keyboard_proc is not None and self.keyboard_proc.poll() is None

    def toggle_keyboard(self, *_):
        if self._keyboard_shown():
            self._hide_keyboard()
        else:
            self._show_keyboard()

    def _show_keyboard(self, auto=False):
        if self._keyboard_shown():
            return
        try:
            self.keyboard_proc = subprocess.Popen(KEYBOARD_CMD, stdout=subprocess.DEVNULL,
                                                  stderr=subprocess.DEVNULL, start_new_session=True)
            self.keyboard_auto = auto
            GLib.child_watch_add(GLib.PRIORITY_DEFAULT, self.keyboard_proc.pid, self._keyboard_exited,
                                 self.keyboard_proc)
        except OSError:
            if not auto:
                self._message("The on-screen keyboard (Onboard) isn't installed. Run Update station.")
            return
        # A full-screen window covers the keyboard, so make room for it instead.
        self._set_fullscreen(False)

    def _hide_keyboard(self):
        if self._keyboard_shown():
            self.keyboard_proc.terminate()
        self.keyboard_proc = None
        self.keyboard_auto = False
        self._set_fullscreen(True)

    def _keyboard_exited(self, _pid, _status, proc):
        """Onboard closed (its own quit key, or hidden from here): back to full screen."""
        if self.keyboard_proc is proc:
            self._hide_keyboard()

    def _set_fullscreen(self, full):
        if os.environ.get("EMCOMM_LAUNCHER_WINDOWED"):
            return
        if full:
            self.fullscreen()
        else:
            self.unfullscreen()
            self.maximize()

    def _watch_text_entries(self):
        """Show the keyboard when a text box in the launcher (or one of its dialogs) is
        tapped on a touchscreen, and hide it again when typing is done."""
        def touched(widget, event):
            device = event.get_source_device() if event else None
            if device and device.get_source() == Gdk.InputSource.TOUCHSCREEN:
                self.last_touch = time.monotonic()
            return True

        def entry_focused(widget, *_):
            if isinstance(widget, Gtk.Entry) and time.monotonic() - self.last_touch < 1.0:
                self._show_keyboard(auto=True)
            return True

        def entry_left(widget, *_):
            if isinstance(widget, Gtk.Entry) and self.keyboard_auto:
                GLib.timeout_add(400, self._hide_auto_keyboard)
            return True

        GObject.add_emission_hook(Gtk.Widget, "button-press-event", touched)
        GObject.add_emission_hook(Gtk.Widget, "touch-event", touched)
        GObject.add_emission_hook(Gtk.Widget, "focus-in-event", entry_focused)
        GObject.add_emission_hook(Gtk.Widget, "focus-out-event", entry_left)

        # Onboard's own hide key: give the launcher its full screen back.
        def keyboard_changed(_bus, _sender, _path, _iface, _signal, params):
            iface, changed, _invalid = params.unpack()
            if iface == "org.onboard.Onboard.Keyboard" and changed.get("Visible") is False:
                GLib.idle_add(self._hide_keyboard)

        try:
            bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
            bus.signal_subscribe(None, "org.freedesktop.DBus.Properties", "PropertiesChanged",
                                 "/org/onboard/Onboard/Keyboard", None, Gio.DBusSignalFlags.NONE, keyboard_changed)
        except GLib.Error:
            pass  # no session bus: the keyboard buttons still work

    def _hide_auto_keyboard(self):
        """Hide a keyboard that came up by itself once no launcher text box has focus."""
        if not self.keyboard_auto:
            return False
        for window in Gtk.Window.list_toplevels():
            if window.is_active() and isinstance(window.get_focus(), Gtk.Entry):
                return False
        self._hide_keyboard()
        return False

    # ---- keyboard ------------------------------------------------------

    def _on_key(self, _widget, event):
        """Esc/F1 Home, F2 Diagnostics, F3 Settings, F4 Logs, F5 Reference, F6 Wi-Fi, F7 Online,
        F8 Net control, F9 Forms, 1-9 open a tile on Home, Page Up/Down change Home page."""
        pages = {Gdk.KEY_Escape: "home", Gdk.KEY_F1: "home", Gdk.KEY_F2: "diagnostics",
                 Gdk.KEY_F3: "settings", Gdk.KEY_F4: "logs", Gdk.KEY_F5: "reference", Gdk.KEY_F6: "wifi",
                 Gdk.KEY_F7: "online", Gdk.KEY_F8: "net", Gdk.KEY_F9: "forms"}
        if event.keyval in pages:
            self.stack.set_visible_child_name(pages[event.keyval])
            return True
        if self.stack.get_visible_child_name() in ("home", "folder") and Gdk.KEY_1 <= event.keyval <= Gdk.KEY_9:
            index, tiles = event.keyval - Gdk.KEY_1, self._page_tiles()
            if index < len(tiles) and tiles[index].get_sensitive():
                tiles[index].clicked()
            return True
        if self.stack.get_visible_child_name() == "home" and event.keyval in (Gdk.KEY_Page_Up, Gdk.KEY_Page_Down):
            self._show_home_page(self.page_index + (1 if event.keyval == Gdk.KEY_Page_Down else -1))
            return True
        return False

