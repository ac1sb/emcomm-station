    def _show_station(self):
        self.call_label.set_text(self.station.get("callsign", ""))
        self.grid_label.set_text(f"Grid {self.station.get('grid', '')}")

    def _tick_clock(self):
        now = time.time()
        self.clock.set_text(clock_text(now))
        rec = self._rec_markup()
        self.rec_status.set_markup(rec)
        if getattr(self, "home_bar", None):
            # UTC to the second there, for setting a clock or checking FT8 timing by eye.
            self.home_bar.clock.set_text(f"{self.station.get('callsign', '')}   {clock_text(now, utc_seconds=True)}")
            self.home_bar.rec.get_child().set_markup(rec)
        return True

    def _rec_markup(self):
        """● Rec in red while recording, ○ Rec when not; ● Live while streaming to Broadcastify."""
        red, muted = self.colours["danger"], self.colours["muted"]
        text = (f"<span foreground='{red}'>●</span>  Rec" if recorder_status()
                else f"<span foreground='{muted}'>○  Rec</span>")
        stream = stream_status()
        if stream and stream.get("live"):
            text += f"   <span foreground='{red}'>●</span>  Live"
        elif stream:
            text += f"   <span foreground='{muted}'>◌  Live</span>"
        return text

    def _poll_status(self):
        # One check at a time: when nmcli is slow, checks mustn't pile up or report out of order.
        if not self._poll_lock.acquire(blocking=False):
            return True

        def work():
            try:
                freq = format_freq(rigctld_query(*RIGCTLD, "f"))
                audio = os.path.exists("/proc/asound/rigaudio")
                self._default_audio_to_radio(audio)
                net = self._network_summary()
                gps = gps_fix() if os.path.exists(GPS_DEV) else "absent"
                GLib.idle_add(self._show_status, freq, audio, net, gps)
            finally:
                self._poll_lock.release()

        threading.Thread(target=work, daemon=True).start()
        return True

    def _show_gps(self, gps):
        """Top bar: GPS grid when there's a fix; nothing when no GPS is plugged in."""
        self.gps_grid = latlon_to_grid(gps[1], gps[2]) if isinstance(gps, tuple) else None
        if gps == "absent":
            self.gps_status.set_text("")
        elif self.gps_grid:
            moved = self.gps_grid[:4].upper() != self.station.get("grid", "")[:4].upper()
            colour = self.colours["accent"] if moved else self.colours["ok"]
            hint = "  (tap to use)" if moved else ""
            self.gps_status.set_markup(f"<span foreground='{colour}'>●</span>  GPS {self.gps_grid}{hint}")
        else:
            words = "no fix yet" if gps is None else "not answering"
            self.gps_status.set_markup(f"<span foreground='{self.colours['muted']}'>○</span>  GPS {words}")
        if hasattr(self, "grid_gps_btn"):
            self.grid_gps_btn.set_sensitive(bool(self.gps_grid))

    def _grid_from_gps(self, *_):
        if not self.gps_grid:
            return
        grid = self.gps_grid
        self.stack.set_visible_child_name("station-user")
        # After the page has filled itself in from the saved settings.
        GLib.idle_add(self._set_grid_from_gps, grid)

    def _set_grid_from_gps(self, grid):
        self.grid_entry.set_text(grid)
        self._set_message(f"Grid {grid} filled in from the GPS. Tap Save to use it.", True)
        return False

    def _default_audio_to_radio(self, audio):
        """Each time the radio's sound card appears, make it the default audio device.
        Retried on later polls until PipeWire has picked the card up."""
        card = os.path.realpath("/proc/asound/rigaudio") if audio else None
        with self._audio_lock:  # Settings > Audio can't change the choice halfway through
            choice = self._audio_choice()
            if choice == "never":
                return
            if card and card != self.default_audio_card and shutil.which("emcomm-audio-default"):
                if choice == "while_open":
                    save_sound_before()
                    if self.audio["quiet"]:
                        alert_sounds(False)  # so a notification ding isn't transmitted
                result = subprocess.run(["emcomm-audio-default"], capture_output=True, check=False)
                if result.returncode == 0:
                    self.default_audio_card = card
            elif not card:
                self.default_audio_card = None

    @staticmethod
    def _network_summary():
        """('Wi-Fi NAME' / 'Network' / 'No network', connected?), or None without NetworkManager."""
        if not shutil.which("nmcli"):
            return None
        _dev, _state, ssid = wifi_state()
        if ssid:
            return f"Wi-Fi {ssid}", True
        ok, out = nmcli("-t", "-f", "STATE", "general", timeout=5)
        # NetworkManager counts only its own devices; the wired port the Debian installer
        # set up stays with ifupdown, so a default route counts too.
        connected = (ok and out.strip().startswith("connected")) or has_default_route()
        return ("Network" if connected else "No network"), connected

    def _show_status(self, freq, audio, net=None, gps="absent"):
        if freq:
            self.rig_status.set_markup(f"<span foreground='{self.colours['ok']}'>●</span>  Rig  <tt>{freq}</tt>")
        else:
            self.rig_status.set_markup(f"<span foreground='{self.colours['muted']}'>○</span>  Rig not connected")
        dot = (f"<span foreground='{self.colours['ok']}'>●</span>" if audio
               else f"<span foreground='{self.colours['muted']}'>○</span>")
        self.audio_status.set_markup(f"{dot}  Radio audio")
        if net:
            dot = (f"<span foreground='{self.colours['ok']}'>●</span>" if net[1]
                   else f"<span foreground='{self.colours['muted']}'>○</span>")
            self.net_status.set_markup(f"{dot}  {GLib.markup_escape_text(net[0])}")
        self.net_connected = bool(net and net[1])
        self._show_gps(gps)
        self._check_radio_alerts()
        self.net_status.set_visible(bool(net))
        self._refresh_tiles()
        return False

    # ---- home ----------------------------------------------------------

    def _home_page(self):
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10, margin=20)
        self.home_page = page
        # Arranging: tap a tile, then tap where it goes.
        self.arrange_bar = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4, no_show_all=True)
        self.arrange_bar.get_style_context().add_class("arrange-bar")
        self.arrange_hint = Gtk.Label(xalign=0, wrap=True)
        self.arrange_bar.pack_start(self.arrange_hint, False, False, 0)
        buttons = Gtk.Box(spacing=10)
        self.arrange_bar.pack_start(buttons, False, False, 0)
        self.reset_btn = self._navbtn("Standard order", lambda *_: self._arrange_reset())
        self.folder_new_btn = self._navbtn("New folder", lambda *_: self._arrange_new_folder())
        self.arrange_buttons = [self._navbtn("Done", lambda *_: self._arrange(False), "primary"), self.reset_btn,
                                self._navbtn("New page", lambda *_: self._arrange_add_page()),
                                self.folder_new_btn,
                                self._navbtn("Add a gap", lambda *_: self._arrange_add_gap())]
        self.gap_remove_btn = self._navbtn("Remove gap", lambda *_: self._arrange_remove_gap())
        self.page_remove_btn = self._navbtn("Remove page", lambda *_: self._arrange_remove_page())
        # A folder picked: open it (to arrange what's inside), rename it, or empty it onto Home.
        self.folder_open_btn = self._navbtn("Open folder", lambda *_: self._open_folder(self.picked))
        self.folder_rename_btn = self._navbtn("Rename folder", lambda *_: self._rename_folder(self.picked))
        self.folder_remove_btn = self._navbtn("Remove folder", lambda *_: self._arrange_remove_folder())
        self.picked_buttons = [self.gap_remove_btn, self.page_remove_btn, self.folder_open_btn,
                               self.folder_rename_btn, self.folder_remove_btn]
        for btn in self.arrange_buttons + self.picked_buttons:
            buttons.pack_end(btn, False, False, 0)
        page.pack_start(self.arrange_bar, False, False, 0)
        # Home pages: a fixed grid of tiles each; swipe, tap the arrows or press Page Up/Down.
        self.home_pages = Gtk.Stack(transition_type=Gtk.StackTransitionType.SLIDE_LEFT_RIGHT,
                                    transition_duration=200)
        names = read_json(TILE_NAMES, {})
        for app in self.config.get("apps", []):
            app["standard_name"] = app.get("name", "")
            custom = names.get(app.get("code")) if isinstance(names, dict) else None
            if isinstance(custom, str) and custom.strip():
                app["name"] = custom.strip()
        self.app_tiles = {app.get("code"): self._tile(app) for app in self.config.get("apps", [])}
        self.arranging, self.picked = False, None
        self.page_index, self.page_grids, self.last_swipe = 0, [], 0.0
        self.folder_tiles, self.open_folder = [], None
        saved = read_json(TILE_ORDER, {})
        order = saved.get("order") if isinstance(saved, dict) else None
        if not isinstance(order, list):
            order = standard_order(self.config.get("apps", []), self.config.get("folders"))
        elif not saved.get("folders"):  # arranged before there were folders: add the standard ones
            order = apply_folders(order, self.config.get("folders"))
        self.slots = self._slots_from(order)
        swipe = Gtk.GestureSwipe.new(self.home_pages)
        swipe.set_propagation_phase(Gtk.PropagationPhase.CAPTURE)
        swipe.connect("swipe", self._home_swiped)
        self.home_swipe = swipe  # the gesture lives as long as this reference
        page.pack_start(self.home_pages, True, True, 0)
        self.page_bar = Gtk.Box(spacing=12, halign=Gtk.Align.CENTER, no_show_all=True)
        self.page_bar.get_style_context().add_class("page-bar")
        self.page_prev = self._navbtn("◀", lambda *_: self._show_home_page(self.page_index - 1))
        self.page_next = self._navbtn("▶", lambda *_: self._show_home_page(self.page_index + 1))
        self.page_dots = Gtk.Label()
        self.page_dots.get_style_context().add_class("page-dots")
        self.page_bar.pack_start(self.page_prev, False, False, 0)
        self.page_bar.pack_start(self.page_dots, False, False, 0)
        self.page_bar.pack_start(self.page_next, False, False, 0)
        page.pack_start(self.page_bar, False, False, 0)
        self._lay_out_tiles()

        # Settings and Diagnostics are in the top bar's ⏻ menu; Logs and Reference are tiles.
        return page

    def _station_menu(self, button):
        """The ⏻ menu: Settings, Diagnostics, and Power (restart or shut down)."""
        menu = Gtk.Popover(relative_to=button, position=Gtk.PositionType.BOTTOM)
        menu.get_style_context().add_class("station-menu")
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, margin=10)

        def go(handler):
            menu.popdown()
            handler()

        for label, handler in (("Settings  F3", lambda: self.stack.set_visible_child_name("settings")),
                               ("Diagnostics  F2", lambda: self.stack.set_visible_child_name("diagnostics")),
                               ("Power…", self._power_dialog)):
            item = self._navbtn(label, lambda _b, h=handler: go(h))
            item.get_child().set_xalign(0)
            item.set_size_request(240, -1)
            box.pack_start(item, False, False, 0)
        box.show_all()
        menu.add(box)
        return menu

    def _lay_out_tiles(self):
        """Put the tiles on Home pages in self.slots' order. Number keys 1-9 open the page's first nine."""
        for grid in self.page_grids:
            for child in grid.get_children():
                grid.remove(child)  # the tiles live on; only the page grids are rebuilt
            self.home_pages.remove(grid)
        self.pages = paginate(self.slots, keep_empty_last=self.arranging)
        self.page_grids = []
        for number, (indices, end) in enumerate(self.pages):
            grid = Gtk.Grid(column_spacing=12, row_spacing=12, column_homogeneous=True, row_homogeneous=True)
            for n, i in enumerate(indices):
                unparent(self.slots[i])
                grid.attach(self.slots[i], n % TILE_COLUMNS, n // TILE_COLUMNS, 1, 1)
            # Keep every tile the same size on a page that isn't full; while arranging,
            # the spare places take a tile to the end of this page.
            for n in range(len(indices), PER_PAGE):
                spare = self._spare_place(end) if self.arranging else Gtk.Box()
                grid.attach(spare, n % TILE_COLUMNS, n // TILE_COLUMNS, 1, 1)
            self.page_grids.append(grid)
            self.home_pages.add_named(grid, str(number))
        self.folder_tiles = [t for t in self.slots if not isinstance(t, str) and t.kind == "folder"]
        self.tiles = [t for t in self.slots if not isinstance(t, str) and t.kind == "app"]
        for folder in self.folder_tiles:
            self.tiles += folder.members
        self.home_pages.show_all()
        self._show_home_page(min(self.page_index, len(self.pages) - 1), animate=False)
        if self.arranging:  # saved as it changes, so leaving the page any way keeps it
            self._save_tiles()

    def _save_tiles(self):
        def entry(tile):
            if isinstance(tile, str):
                return tile
            if tile.kind == "folder":
                return {"folder": tile.name, "apps": [t.app.get("code") for t in tile.members]}
            return tile.app.get("code") if tile.kind == "app" else GAP
        write_json(TILE_ORDER, {"order": [entry(t) for t in self.slots], "folders": True})

    def _slots_from(self, order):
        """Home slots (tile widgets and PAGE markers) for a saved order."""
        slots = []
        for entry in arrange_tiles(self.config.get("apps", []), order):
            if is_folder(entry):
                slots.append(self._folder_tile(entry["folder"],
                                               [self.app_tiles[a.get("code")] for a in entry["apps"]]))
            elif isinstance(entry, dict):
                slots.append(self.app_tiles[entry.get("code")])
            else:
                slots.append(self._gap_tile() if entry == GAP else PAGE)
        return slots

    def _page_tiles(self):
        """The tiles the number keys open: on the folder shown, or on the Home page shown."""
        if self.stack.get_visible_child_name() == "folder" and self.open_folder is not None:
            return list(self.open_folder.members)
        indices = self.pages[self.page_index][0] if self.pages else []
        return [self.slots[i] for i in indices if self.slots[i].kind != "gap"]

    def _show_home_page(self, index, animate=True):
        """Show Home page index (wrapping past either end)."""
        count = len(self.pages)
        self.page_index = index % count if count else 0
        self.home_pages.set_transition_type(Gtk.StackTransitionType.SLIDE_LEFT_RIGHT if animate
                                            else Gtk.StackTransitionType.NONE)
        self.home_pages.set_visible_child_name(str(self.page_index))
        inside = self.open_folder.members if self.open_folder is not None else []
        for tile in self.tiles + self.folder_tiles:
            if tile not in inside:  # the folder shown numbers its own
                tile.key_hint.set_text("")
        indices = self.pages[self.page_index][0] if self.pages else []
        for i, tile in enumerate([self.slots[i] for i in indices if self.slots[i].kind != "gap"][:9]):
            tile.key_hint.set_text(str(i + 1))
        many = count > 1 or self.arranging
        self.page_bar.set_no_show_all(not many)
        if many:
            self.page_dots.set_text("  ".join("●" if i == self.page_index else "○" for i in range(count))
                                    + f"   Page {self.page_index + 1} of {count}")
            self.page_bar.show_all()
        else:
            self.page_bar.hide()
        if self.arranging:
            self._arrange_show()

    def _home_swiped(self, _gesture, vx, vy):
        if abs(vx) > 500 and abs(vx) > 2 * abs(vy) and len(self.pages) > 1:
            self.last_swipe = time.monotonic()  # the tile under the finger shouldn't open
            self._show_home_page(self.page_index + (1 if vx < 0 else -1))

    def _spare_place(self, end):
        """An empty place on a page, while arranging: tapping it moves the picked tile there."""
        btn = Gtk.Button()
        btn.get_style_context().add_class("tile")
        btn.get_style_context().add_class("gap")
        btn.set_can_focus(False)
        btn.connect("clicked", lambda *_: self._arrange_to_end(end))
        return btn

    def _gap_tile(self):
        btn = Gtk.Button()
        btn.get_style_context().add_class("tile")
        btn.get_style_context().add_class("gap")
        btn.app, btn.kind = None, "gap"
        btn.set_can_focus(False)
        btn.connect("clicked", lambda b: self._arrange_tap(b) if self.arranging else None)
        return btn

    def _arrange(self, on):
        """Arrange mode: tapping tiles moves them instead of opening apps."""
        self.arranging, self.picked = on, None
        if not on:  # an empty page left at the end goes away
            while self.slots and isinstance(self.slots[-1], str):
                self.slots.pop()
                self._save_tiles()
        self._lay_out_tiles()
        if self.open_folder is not None:
            self._lay_out_folder()
        ctx = self.home_page.get_style_context()
        (ctx.add_class if on else ctx.remove_class)("arranging")
        # no_show_all keeps the bar hidden when the window first shows everything.
        self.arrange_bar.set_no_show_all(not on)
        if on:
            self.arrange_bar.show_all()
            self.stack.set_visible_child_name("home")
        else:
            self.arrange_bar.hide()
        self._arrange_show()

    def _arrange_show(self, note=None):
        for tile in [t for t in self.slots if not isinstance(t, str)] + self.tiles:
            (tile.get_style_context().add_class if tile is self.picked
             else tile.get_style_context().remove_class)("picked")
        kind = self.picked.kind if self.picked is not None else None
        on_home = self.arranging and self.picked in self.slots
        self.gap_remove_btn.set_visible(on_home and kind == "gap")
        for btn in (self.folder_open_btn, self.folder_rename_btn, self.folder_remove_btn):
            btn.set_visible(on_home and kind == "folder")
        self.reset_btn.set_visible(kind is None)
        self.folder_new_btn.set_visible(kind in (None, "app"))
        self.page_remove_btn.set_visible(self.arranging and kind is None and len(self.pages) > 1)
        if self.picked is None:
            hint = ("Tap a tile, then tap where it should go, or tap a folder to put it in. "
                    "Folders, gaps and pages group apps.")
        elif kind == "folder":
            hint = (f"Now tap where the {self.picked.name} folder should go, or open it to arrange "
                    "what's inside. Tap it again to cancel.")
        elif kind == "gap":
            hint = "Now tap where the gap should go (◀ ▶ or swipe for other pages). Tap it again to cancel."
        else:
            hint = (f"Now tap where {self.picked.app['name']} should go, or a folder to put it in "
                    "(◀ ▶ or swipe for other pages). Tap it again to cancel.")
        self.arrange_hint.set_text(note or hint)
        if self.open_folder is not None:
            self._folder_show()

    def _arrange_tap(self, tile):
        members = self.open_folder.members if self.open_folder is not None else []
        if self.picked is None:
            self.picked = tile
        elif tile is self.picked:
            self.picked = None
        elif self.picked in members and tile in members:  # a new place inside the folder
            members.insert(members.index(tile), members.pop(members.index(self.picked)))
            self.picked = None
            self._folder_changed(self.open_folder)
        elif tile in self.slots and (self.picked in self.slots or self.picked.kind == "app"):
            if self.picked in self.slots:
                self.slots = move_slot(self.slots, self.slots.index(self.picked), self.slots.index(tile))
            else:  # out of its folder onto Home
                self._take_from_folder(self.picked)
                self.slots.insert(self.slots.index(tile), self.picked)
            self.picked = None
            self._lay_out_tiles()
        else:
            self.picked = tile
        self._arrange_show()

    def _arrange_to_end(self, end):
        """Move the picked tile to the end of a page (end: where paginate says a slot there goes)."""
        if self.picked is None:
            return
        if self.picked in self.slots:
            src = self.slots.index(self.picked)
            self.slots = move_slot(self.slots, src, end - 1 if src < end else end)
        else:
            self._take_from_folder(self.picked)
            self.slots.insert(end, self.picked)
        self.picked = None
        self._lay_out_tiles()

    def _arrange_add_page(self):
        """A new empty page after the last one; the picked tile, if any, moves onto it."""
        while self.slots and isinstance(self.slots[-1], str) and self.slots[-1] == PAGE:
            self.slots.pop()  # one empty page at the end at a time
        self.slots.append(PAGE)
        picked, self.picked = self.picked, None
        if picked is not None:
            if picked in self.slots:
                self.slots.remove(picked)
            else:
                self._take_from_folder(picked)
            self.slots.append(picked)
        self._lay_out_tiles()
        self._show_home_page(len(self.pages) - 1)

    def _arrange_remove_page(self):
        """Fold the page shown into the one before it (its tiles move up, nothing is lost)."""
        if len(self.pages) < 2:
            return
        indices, end = self.pages[self.page_index]
        start = indices[0] if indices else end
        # The marker that starts this page, if there is one (an overflow page has none).
        marker = start - 1 if self.page_index and start and isinstance(self.slots[start - 1], str) else None
        if marker is None and self.page_index == 0:
            first_marker = next((i for i, t in enumerate(self.slots) if isinstance(t, str) and t == PAGE), None)
            marker = first_marker
        if marker is None:
            self.arrange_hint.set_text("This page is here because the one before it is full: "
                                       "move some tiles off that page first.")
            return
        del self.slots[marker]
        self.picked = None
        self.page_index = max(0, self.page_index - 1)
        self._lay_out_tiles()

    def _arrange_add_gap(self):
        gap = self._gap_tile()
        at = self.slots.index(self.picked) if self.picked in self.slots else self.pages[self.page_index][1]
        self.slots.insert(at, gap)
        self.picked = None
        self._lay_out_tiles()
        self._arrange_show()

    def _arrange_remove_gap(self):
        if self.picked is not None and self.picked.kind == "gap":
            self.slots.remove(self.picked)
            self.picked = None
            self._lay_out_tiles()
            self._arrange_show()

    def _arrange_reset(self):
        for tile in self.app_tiles.values():
            unparent(tile)
        self.slots = self._slots_from(standard_order(self.config.get("apps", []), self.config.get("folders")))
        self.picked = None
        self._lay_out_tiles()
        self._arrange_show()

    # ---- folders -------------------------------------------------------

    def _folder_tile(self, name, members):
        btn = Gtk.Button()
        btn.get_style_context().add_class("tile")
        btn.get_style_context().add_class("folder")
        btn.app, btn.kind, btn.name, btn.members = None, "folder", name, list(members)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        btn.icon_slot = Gtk.Box()
        top = Gtk.Box()
        top.pack_start(btn.icon_slot, True, True, 0)
        btn.key_hint = Gtk.Label(yalign=0)
        btn.key_hint.get_style_context().add_class("key-hint")
        top.pack_end(btn.key_hint, False, False, 0)
        btn.name_label = Gtk.Label(xalign=0, ellipsize=Pango.EllipsizeMode.END)
        btn.name_label.get_style_context().add_class("tile-name")
        btn.detail = Gtk.Label(xalign=0, ellipsize=Pango.EllipsizeMode.END)
        btn.detail.get_style_context().add_class("tile-detail")
        box.pack_start(top, True, True, 0)
        box.pack_start(btn.name_label, False, False, 0)
        box.pack_start(btn.detail, False, False, 0)
        btn.add(box)
        btn.connect("clicked", self._folder_clicked)
        self._add_long_press(btn)
        self._update_folder_tile(btn)
        return btn

    def _update_folder_tile(self, btn):
        btn.name_label.set_text(btn.name)
        names = [t.app.get("name", "") for t in btn.members]
        btn.detail.set_text(" · ".join(names) if names else "Empty folder")
        self._set_tile_icon(btn)

    def _folder_clicked(self, btn):
        if time.monotonic() - self.last_swipe < 0.5:
            return
        if not self.arranging:
            self._open_folder(btn)
        elif self.picked is not None and self.picked.kind == "app" and self.picked not in btn.members:
            if len(btn.members) >= FOLDER_MAX:
                self._arrange_show(f"The {btn.name} folder is full.")
                return
            picked, self.picked = self.picked, None
            self._move_into_folder(picked, btn)
            self._arrange_show()
        else:
            self._arrange_tap(btn)

    def _move_into_folder(self, tile, folder):
        if tile in self.slots:
            self.slots.remove(tile)
        else:
            self._take_from_folder(tile)
        folder.members.append(tile)
        self._folder_changed(folder)
        self._lay_out_tiles()
        self._save_tiles()

    def _folder_of(self, tile):
        return next((f for f in self.folder_tiles if tile in f.members), None)

    def _menu_take_out(self, tile):
        """From the long-press menu: put the app on Home just after its folder."""
        folder = self._folder_of(tile)
        if folder is None:
            return
        self._take_from_folder(tile)
        self.slots.insert(self.slots.index(folder) + 1, tile)
        self._lay_out_tiles()
        self._save_tiles()

    def _menu_new_folder(self, tile):
        """From the long-press menu: a new folder holding this app, where the app was."""
        name = self._ask_name("Name the new folder", "Folder")
        if not name:
            return
        folder = self._folder_tile(name, [])
        old = self._folder_of(tile)
        if tile in self.slots:
            self.slots[self.slots.index(tile)] = folder
        else:
            self._take_from_folder(tile)
            self.slots.insert(self.slots.index(old) + 1 if old in self.slots else len(self.slots), folder)
        folder.members.append(tile)
        self._update_folder_tile(folder)
        self._lay_out_tiles()
        self._save_tiles()

    def _take_from_folder(self, tile):
        for folder in self.folder_tiles:
            if tile in folder.members:
                folder.members.remove(tile)
                unparent(tile)
                self._folder_changed(folder)
                return

    def _folder_changed(self, folder):
        self._update_folder_tile(folder)
        if folder is self.open_folder:
            self._lay_out_folder()
        self._save_tiles()

    def _folder_page(self):
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12, margin=20)
        header = Gtk.Box(spacing=12)
        header.pack_start(self._navbtn("‹ Home  Esc", lambda *_: self.stack.set_visible_child_name("home")),
                          False, False, 0)
        self.folder_title = Gtk.Label(xalign=0)
        self.folder_title.get_style_context().add_class("title")
        header.pack_start(self.folder_title, False, False, 0)
        header.pack_end(self._navbtn("Rename", lambda *_: self._rename_folder(self.open_folder)),
                        False, False, 0)
        self.folder_out_btn = self._navbtn("Take out of folder", lambda *_: self._folder_take_out())
        header.pack_end(self.folder_out_btn, False, False, 0)
        page.pack_start(header, False, False, 0)
        self.folder_hint = Gtk.Label(xalign=0, wrap=True)
        self.folder_hint.get_style_context().add_class("muted")
        page.pack_start(self.folder_hint, False, False, 0)
        self.folder_grid = Gtk.Grid(column_spacing=12, row_spacing=12, column_homogeneous=True,
                                    row_homogeneous=True)
        page.pack_start(self.folder_grid, True, True, 0)
        # Room for the page buttons Home has, so the tiles are the same size here.
        page.pack_end(Gtk.Box(height_request=52), False, False, 0)
        page.connect("unmap", lambda *_: self._folder_closed())
        return page

    def _open_folder(self, folder):
        if folder is None or folder.kind != "folder":
            return
        self.open_folder = folder
        if self.picked is folder:
            self.picked = None
        self._lay_out_folder()
        self.stack.set_visible_child_name("folder")
        self._folder_show()

    def _folder_closed(self):
        if self.stack.get_visible_child_name() != "folder":
            self.open_folder = None
            if self.arranging:
                self._arrange_show()

    def _lay_out_folder(self):
        folder = self.open_folder
        for child in self.folder_grid.get_children():
            self.folder_grid.remove(child)
        for n, tile in enumerate(folder.members):
            unparent(tile)
            tile.key_hint.set_text(str(n + 1) if n < 9 else "")
            self.folder_grid.attach(tile, n % TILE_COLUMNS, n // TILE_COLUMNS, 1, 1)
        for n in range(len(folder.members), PER_PAGE):
            self.folder_grid.attach(Gtk.Box(), n % TILE_COLUMNS, n // TILE_COLUMNS, 1, 1)
        self.folder_title.set_text(folder.name)
        self.folder_grid.show_all()

    def _folder_show(self):
        """The folder page's hint and buttons, for arranging or not."""
        picked_here = self.arranging and self.picked in (self.open_folder.members if self.open_folder else [])
        self.folder_out_btn.set_visible(picked_here)
        for tile in self.open_folder.members if self.open_folder else []:
            (tile.get_style_context().add_class if tile is self.picked
             else tile.get_style_context().remove_class)("picked")
        if not self.arranging:
            self.folder_hint.set_text("")
            self.folder_hint.hide()
            return
        self.folder_hint.show()
        if picked_here:
            self.folder_hint.set_text(f"Now tap where {self.picked.app['name']} should go in this folder, "
                                      "or go back Home and tap where it should go there. "
                                      "Take out of folder puts it next to the folder.")
        else:
            self.folder_hint.set_text("Tap a tile, then tap where it should go. ‹ Home goes back to arranging Home.")

    def _folder_take_out(self):
        tile, folder = self.picked, self.open_folder
        if tile is None or folder is None or tile not in folder.members:
            return
        self._take_from_folder(tile)
        self.slots.insert(self.slots.index(folder) + 1, tile)
        self.picked = None
        self._lay_out_tiles()
        self._arrange_show()

    def _ask_name(self, title, name=""):
        dialog = Gtk.Dialog(title=title, transient_for=self, modal=True)
        dialog.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "OK", Gtk.ResponseType.OK)
        dialog.set_default_response(Gtk.ResponseType.OK)
        box = dialog.get_content_area()
        box.set_spacing(10)
        box.set_border_width(16)
        label = Gtk.Label(label=title, xalign=0)
        label.get_style_context().add_class("field-label")
        entry = Gtk.Entry(text=name, max_length=24, activates_default=True, width_chars=24)
        box.pack_start(label, False, False, 0)
        box.pack_start(entry, False, False, 0)
        dialog.show_all()
        response = dialog.run()
        text = entry.get_text().strip()
        dialog.destroy()
        return text if response == Gtk.ResponseType.OK and text else None

    def _rename_tile(self, btn):
        name = self._ask_name(f"Name for the {btn.app['standard_name']} tile", btn.app["name"])
        if name:
            self._set_tile_name(btn, name)

    def _set_tile_name(self, btn, name):
        """Show the tile (and the app in folders and the Home bar) by name; None: the standard name."""
        names = read_json(TILE_NAMES, {})
        names = names if isinstance(names, dict) else {}
        code = btn.app.get("code")
        if name and name != btn.app["standard_name"]:
            names[code] = name
        else:
            names.pop(code, None)
            name = btn.app["standard_name"]
        write_json(TILE_NAMES, names)
        btn.app["name"] = name
        btn.name_label.set_text(name)
        for folder in self.folder_tiles:
            if btn in folder.members:
                self._update_folder_tile(folder)

    def _rename_folder(self, folder):
        if folder is None or folder.kind != "folder":
            return
        name = self._ask_name("Folder name", folder.name)
        if name:
            folder.name = name
            self._folder_changed(folder)
            if self.arranging:
                self._arrange_show()

    def _arrange_new_folder(self):
        """A new folder: in the picked tile's place, holding it, or at the end of this page."""
        name = self._ask_name("Name the new folder", "Folder")
        if not name:
            return
        picked, self.picked = self.picked, None
        folder = self._folder_tile(name, [])
        if picked is not None and picked.kind == "app":
            if picked in self.slots:
                self.slots[self.slots.index(picked)] = folder
            else:
                self._take_from_folder(picked)
                self.slots.insert(self.pages[self.page_index][1], folder)
            folder.members.append(picked)
            self._update_folder_tile(folder)
        else:
            self.slots.insert(self.pages[self.page_index][1], folder)
        self._lay_out_tiles()
        self._arrange_show()

    def _arrange_remove_folder(self):
        """Put the picked folder's apps back on Home where it was."""
        folder = self.picked
        if folder is None or folder.kind != "folder" or folder not in self.slots:
            return
        at = self.slots.index(folder)
        for tile in folder.members:
            unparent(tile)
        self.slots[at:at + 1] = folder.members
        self.picked = None
        self._lay_out_tiles()
        self._arrange_show()

    def _tile(self, app):
        btn = Gtk.Button()
        btn.get_style_context().add_class("tile")
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        btn.app, btn.kind = app, "app"
        btn.icon_slot = Gtk.Box()
        self._set_tile_icon(btn)
        top = Gtk.Box()
        top.pack_start(btn.icon_slot, True, True, 0)
        btn.key_hint = Gtk.Label(yalign=0)
        btn.key_hint.get_style_context().add_class("key-hint")
        top.pack_end(btn.key_hint, False, False, 0)
        # Ellipsize, so five tiles across still fit a 1024-pixel screen.
        name = Gtk.Label(label=app.get("name", ""), xalign=0, ellipsize=Pango.EllipsizeMode.END)
        name.get_style_context().add_class("tile-name")
        btn.name_label = name
        detail = Gtk.Label(xalign=0, ellipsize=Pango.EllipsizeMode.END)
        detail.get_style_context().add_class("tile-detail")
        box.pack_start(top, True, True, 0)
        box.pack_start(name, False, False, 0)
        box.pack_start(detail, False, False, 0)
        btn.add(box)
        btn.detail = detail
        btn.connect("clicked", self._tile_clicked)
        self._add_long_press(btn)
        self._update_tile(btn)
        return btn

    def _add_long_press(self, btn):
        # Long-press (touch), right-click or the Menu key: change the tile's icon.
        # The menu opens when the finger lifts: one opened under the finger closes on release.
        btn.long_press = Gtk.GestureLongPress.new(btn)
        btn.long_press.set_propagation_phase(Gtk.PropagationPhase.CAPTURE)
        btn.long_pressed = False
        btn.long_press.connect("pressed", lambda g, *_: self._tile_long_pressed(btn, g))
        btn.long_press.connect("end", lambda *_: self._tile_long_press_end(btn))
        btn.connect("button-press-event", lambda _w, e: e.button == 3 and (self._icon_menu(btn) or True))
        btn.connect("popup-menu", lambda *_: self._icon_menu(btn) or True)

    def _apply_theme(self, name):
        """Switch to one of the colour themes, now and on later starts."""
        self.theme = name
        self.colours = THEMES[name]
        screen = Gdk.Screen.get_default()
        if self.css_provider:
            Gtk.StyleContext.remove_provider_for_screen(screen, self.css_provider)
        self.css_provider = Gtk.CssProvider()
        self.css_provider.load_from_data(scaled_css(self.colours, self.text_scale).encode())
        Gtk.StyleContext.add_provider_for_screen(screen, self.css_provider,
                                                 Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    def _set_theme(self, name):
        self._apply_theme(name)
        try:
            save_theme(name)
        except OSError:
            pass
        for tile in self.tiles + self.folder_tiles:
            self._set_tile_icon(tile)
        self._poll_status()

    def _set_text_scale(self, scale):
        self.text_scale = scale
        # Text the launcher doesn't size itself (pt sizes) follows the font DPI.
        Gtk.Settings.get_default().set_property("gtk-xft-dpi", round(96 * scale * 1024))
        self._apply_theme(self.theme)
        self.home_bar.place()

    # ---- display -------------------------------------------------------

    def _display_dialog(self, *_):
        """Colours, resolution, text size and rotation. A change to the screen goes
        back by itself unless kept, in case the screen can't show it."""
        try:
            result = subprocess.run([DISPLAY_CMD, "show"], capture_output=True, text=True, timeout=20, check=False)
            info = json.loads(result.stdout)
        except (OSError, ValueError, subprocess.TimeoutExpired):
            info = {}
        outputs = info.get("outputs") or []
        old = info.get("config") or {"mode": "auto", "rotate": "normal", "text_scale": self.text_scale}
        output = outputs[0] if outputs else None

        dialog = Gtk.Dialog(title="Display", transient_for=self, modal=True)
        dialog.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Apply", Gtk.ResponseType.OK)
        dialog.set_default_response(Gtk.ResponseType.OK)
        box = dialog.get_content_area()
        box.set_spacing(10)
        box.set_border_width(16)
        grid = Gtk.Grid(column_spacing=16, row_spacing=10)
        box.pack_start(grid, False, False, 0)

        def combo(row, label, choices, current):
            widget = PickList()
            for value, text in choices:
                widget.append(value, text)
            widget.set_active_id(current if current in [v for v, _ in choices] else choices[0][0])
            name = Gtk.Label(label=label, xalign=0)
            name.get_style_context().add_class("field-label")
            grid.attach(name, 0, row, 1, 1)
            grid.attach(widget, 1, row, 1, 1)
            return widget

        theme = combo(0, "Colours", THEME_NAMES, self.theme)
        modes = [("auto", "Automatic" + (f" ({output['preferred']})" if output and output["preferred"] else ""))]
        modes += [(m, m.replace("x", " × ")) for m in (output["modes"] if output else [])]
        mode = combo(1, "Resolution", modes, old["mode"])
        size = combo(2, "Text size", [(str(v), t) for v, t in TEXT_SIZES], str(old["text_scale"]))
        rotate = combo(3, "Rotation", ROTATIONS, old["rotate"])
        old_splash = (read_json(SPLASH_PATH, {}) or {}).get("style", "logo")
        splash = None
        if not self.desktop:  # a computer used for other things keeps its own start-up screen
            styles = SPLASH_STYLES
            if old_splash == "picture":
                styles = [("logo", SPLASH_STYLES[0][1]), ("picture", "Your picture"),
                          ("new-picture", "A different picture…")] + SPLASH_STYLES[2:]
            splash = combo(4, "Start-up screen", styles, old_splash)
        if output:
            where = f"{output['name']} screen, now {(output['current'] or 'off').replace('x', ' × ')}."
            if len(outputs) > 1:
                where += f" Other screens ({', '.join(o['name'] for o in outputs[1:])}) are left as they are."
        else:
            where = "Couldn't read the screen, so only colours and text size can change."
            mode.set_sensitive(False)
            rotate.set_sensitive(False)
        if self.desktop and not self.session:
            where = "Your desktop's own display settings set the resolution and rotation."
            mode.set_sensitive(False)
            rotate.set_sensitive(False)
        note = Gtk.Label(label=where + " A touchscreen turns with the screen. Large text needs a screen bigger "
                         "than 1024 × 600.", xalign=0, wrap=True, max_width_chars=50)
        note.get_style_context().add_class("muted")
        box.pack_start(note, False, False, 0)
        dialog.show_all()
        response = dialog.run()
        new = {"mode": mode.get_active_id(), "rotate": rotate.get_active_id(),
               "text_scale": float(size.get_active_id())}
        new_theme = theme.get_active_id()
        new_splash = splash.get_active_id() if splash else old_splash
        dialog.destroy()
        if response != Gtk.ResponseType.OK:
            return
        if new_theme != self.theme:
            self._set_theme(new_theme)
        if new_splash != old_splash:
            self._set_splash("picture" if new_splash == "new-picture" else new_splash)
        if new == old:
            return
        if self.desktop and not self.session:
            self._apply_display(new)  # text size only
            return
        error = self._apply_display(new)
        if error:
            self._apply_display(old)
            self._message(f"The screen didn't change: {error}")
            return
        # Anything that might leave the screen unreadable goes back by itself unless kept.
        if not self._keep_display():
            self._apply_display(old)

    def _set_splash(self, style):
        """Change the start-up screen (for a picture, ask which first). The helper
        rebuilds the boot files, which takes about a minute, so it runs in the background."""
        args = ["set", style]
        if style == "picture":
            png = self._pick_splash_picture()
            if not png:
                return
            args.append(png)
        self._message("Changing the start-up screen. This takes about a minute; "
                      "you'll see it the next time the station starts.")

        def work():
            try:
                result = subprocess.run(SPLASH_CMD + args, capture_output=True, text=True, timeout=600, check=False)
                error = None if result.returncode == 0 else (result.stderr.strip() or "it didn't work")
            except (OSError, subprocess.TimeoutExpired) as exc:
                error = str(exc)
            if len(args) == 3:
                try:
                    os.remove(args[2])
                except OSError:
                    pass
            GLib.idle_add(lambda: self._message(
                f"The start-up screen didn't change: {error}" if error else "The new start-up screen is ready.")
                and False)

        threading.Thread(target=work, daemon=True).start()

    def _pick_splash_picture(self):
        """Ask for a picture (from a USB stick or Downloads) and make it a PNG no bigger than
        1920 × 1080 for the start-up screen. Returns the PNG's path, or None."""
        mount_usb_sticks()
        dialog = Gtk.FileChooserDialog(title="Pick a picture for the start-up screen", transient_for=self,
                                       action=Gtk.FileChooserAction.OPEN)
        dialog.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Use this picture", Gtk.ResponseType.OK)
        images = Gtk.FileFilter()
        images.set_name("Pictures (PNG, JPG)")
        for pattern in ("*.png", "*.jpg", "*.jpeg", "*.PNG", "*.JPG", "*.JPEG"):
            images.add_pattern(pattern)
        dialog.add_filter(images)
        for folder in [os.path.expanduser("~/Downloads")] + glob.glob(f"/media/{os.environ.get('USER', '')}/*"):
            if os.path.isdir(folder):
                dialog.add_shortcut_folder(folder)
        dialog.set_size_request(800, 500)
        response = dialog.run()
        path = dialog.get_filename()
        dialog.destroy()
        if response != Gtk.ResponseType.OK or not path:
            return None
        try:
            pixbuf = GdkPixbuf.Pixbuf.new_from_file_at_scale(path, 1920, 1080, True)
            out = os.path.join(GLib.get_tmp_dir(), f"emcomm-splash-{os.getpid()}.png")
            pixbuf.savev(out, "png", [], [])
        except GLib.Error as exc:
            self._message(f"Couldn't use that picture: {exc.message}")
            return None
        return out

    def _apply_display(self, config):
        """Save the display settings and set the screen. Returns an error message, or None."""
        try:
            os.makedirs(os.path.dirname(DISPLAY_PATH), exist_ok=True)
            with open(DISPLAY_PATH + ".tmp", "w", encoding="utf-8") as f:
                json.dump(config, f)
            os.replace(DISPLAY_PATH + ".tmp", DISPLAY_PATH)
            if self.desktop and not self.session:
                self._set_text_scale(config["text_scale"])
                return None
            result = subprocess.run([DISPLAY_CMD, "apply"], capture_output=True, text=True, timeout=30, check=False)
        except (OSError, subprocess.TimeoutExpired) as exc:
            return str(exc)
        self._set_text_scale(config["text_scale"])
        if result.returncode != 0:
            return result.stderr.strip() or "it didn't work"
        return None

    def _keep_display(self, seconds=15):
        dialog = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.QUESTION,
                                   text="Keep these display settings?")
        dialog.add_buttons("Go back", Gtk.ResponseType.CANCEL, "Keep", Gtk.ResponseType.OK)
        left = [seconds]

        def tick():
            if left[0] is None:
                return False
            left[0] -= 1
            if left[0] <= 0:
                dialog.response(Gtk.ResponseType.CANCEL)
                return False
            dialog.format_secondary_text(f"Going back to the old settings in {left[0]} seconds.")
            return True

        dialog.format_secondary_text(f"Going back to the old settings in {seconds} seconds.")
        GLib.timeout_add_seconds(1, tick)
        response = dialog.run()
        left[0] = None
        dialog.destroy()
        return response == Gtk.ResponseType.OK

    def _set_tile_icon(self, btn):
        for child in btn.icon_slot.get_children():
            btn.icon_slot.remove(child)
        if btn.kind == "folder":
            # The first four apps' icons, small, two by two.
            grid = Gtk.Grid(column_spacing=4, row_spacing=4, halign=Gtk.Align.START)
            grid.get_style_context().add_class("folder-icons")
            for n, tile in enumerate(btn.members[:4]):
                path = find_icon(tile.app.get("icon", ""))
                try:
                    image = Gtk.Image.new_from_pixbuf(load_icon(path, self.colours["accent"], 20)) if path else None
                except (GLib.Error, OSError):
                    image = None
                if image is None:
                    image = Gtk.Label(label=tile.app.get("code", "")[:2])
                    image.get_style_context().add_class("key-hint")
                image.set_size_request(20, 20)
                grid.attach(image, n % 2, n // 2, 1, 1)
            badge = Gtk.Box(halign=Gtk.Align.START)
            badge.get_style_context().add_class("tile-icon")
            badge.pack_start(grid, False, False, 0)
            btn.icon_slot.pack_start(badge, False, False, 0)
            btn.icon_slot.show_all()
            return
        path = find_icon(btn.app.get("icon", ""))
        widget = None
        if path:
            try:
                widget = Gtk.Image.new_from_pixbuf(load_icon(path, self.colours["accent"]))
            except (GLib.Error, OSError):
                widget = None
        if widget is None:
            # No icon, or it can't be read: show the short code instead.
            widget = Gtk.Label(label=btn.app.get("code", ""))
            widget.get_style_context().add_class("tile-code")
        else:  # the icon sits on a softly tinted square
            badge = Gtk.Box()
            badge.get_style_context().add_class("tile-icon")
            badge.pack_start(widget, False, False, 0)
            widget = badge
        widget.set_halign(Gtk.Align.START)
        btn.icon_slot.pack_start(widget, False, False, 0)
        btn.icon_slot.show_all()

    @staticmethod
    def _tile_long_pressed(btn, gesture):
        # Claim the press, so lifting the finger doesn't also tap the tile.
        gesture.set_state(Gtk.EventSequenceState.CLAIMED)
        btn.long_pressed = True

    def _tile_long_press_end(self, btn):
        if btn.long_pressed:
            btn.long_pressed = False
            GLib.idle_add(lambda: self._icon_menu(btn) and False)

    def _icon_menu(self, btn):
        if self.arranging:
            return
        menu = Gtk.Menu()
        arrange = Gtk.MenuItem(label="Arrange tiles…")
        arrange.connect("activate", lambda *_: self._arrange(True))
        menu.append(arrange)
        if btn.kind == "folder":
            rename = Gtk.MenuItem(label=f"Rename {btn.name} folder…")
            rename.connect("activate", lambda *_: self._rename_folder(btn))
            menu.append(rename)
        else:
            rename = Gtk.MenuItem(label=f"Rename {btn.app['name']}…")
            rename.connect("activate", lambda *_: self._rename_tile(btn))
            menu.append(rename)
            if btn.app["name"] != btn.app.get("standard_name", btn.app["name"]):
                standard = Gtk.MenuItem(label=f"Use the standard name ({btn.app['standard_name']})")
                standard.connect("activate", lambda *_: self._set_tile_name(btn, None))
                menu.append(standard)
        if btn.kind == "app":
            here = self._folder_of(btn)
            move = Gtk.MenuItem(label=f"Move {btn.app['name']} to a folder")
            folders = Gtk.Menu()
            for folder in self.folder_tiles:
                if folder is here or folder not in self.slots:
                    continue
                item = Gtk.MenuItem(label=folder.name + ("  (full)" if len(folder.members) >= FOLDER_MAX else ""))
                item.set_sensitive(len(folder.members) < FOLDER_MAX)
                item.connect("activate", lambda _i, f=folder: self._move_into_folder(btn, f))
                folders.append(item)
            new_folder = Gtk.MenuItem(label="New folder…")
            new_folder.connect("activate", lambda *_: self._menu_new_folder(btn))
            folders.append(new_folder)
            move.set_submenu(folders)
            menu.append(move)
            if here is not None:
                out = Gtk.MenuItem(label=f"Take {btn.app['name']} out of {here.name}")
                out.connect("activate", lambda *_: self._menu_take_out(btn))
                menu.append(out)
        if btn.kind == "app" and btn.app.get("icon"):
            change = Gtk.MenuItem(label=f"Change {btn.app['name']} icon…")
            change.connect("activate", lambda *_: self._choose_icon(btn))
            menu.append(change)
        if btn.kind == "app" and btn.app.get("icon") and user_icon(btn.app["icon"]):
            reset = Gtk.MenuItem(label="Use the standard icon")
            reset.connect("activate", lambda *_: self._reset_icon(btn))
            menu.append(reset)
        menu.show_all()
        menu.attach_to_widget(btn)
        menu.popup_at_widget(btn, Gdk.Gravity.CENTER, Gdk.Gravity.NORTH_WEST, None)

    def _choose_icon(self, btn):
        mount_usb_sticks()
        dialog = Gtk.FileChooserDialog(title=f"Pick an image for {btn.app['name']}", transient_for=self,
                                       action=Gtk.FileChooserAction.OPEN)
        dialog.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Use this image", Gtk.ResponseType.OK)
        images = Gtk.FileFilter()
        images.set_name("Images (SVG, PNG, JPG)")
        for pattern in ("*.svg", "*.png", "*.jpg", "*.jpeg", "*.SVG", "*.PNG", "*.JPG", "*.JPEG"):
            images.add_pattern(pattern)
        dialog.add_filter(images)
        for folder in [os.path.expanduser("~/Downloads")] + glob.glob(f"/media/{os.environ.get('USER', '')}/*"):
            if os.path.isdir(folder):
                dialog.add_shortcut_folder(folder)
        dialog.set_size_request(800, 500)
        response = dialog.run()
        path = dialog.get_filename()
        dialog.destroy()
        if response != Gtk.ResponseType.OK or not path:
            return
        try:
            GdkPixbuf.Pixbuf.new_from_file_at_scale(path, ICON_SIZE, ICON_SIZE, True)
        except GLib.Error:
            self._message("That file isn't an image the station can show.")
            return
        remove_user_icon(btn.app["icon"])
        os.makedirs(USER_ICONS, exist_ok=True)
        ext = os.path.splitext(path)[1].lower().replace(".jpeg", ".jpg")
        shutil.copyfile(path, os.path.join(USER_ICONS, btn.app["icon"] + ext))
        self._set_tile_icon(btn)

    def _reset_icon(self, btn):
        remove_user_icon(btn.app["icon"])
        self._set_tile_icon(btn)

    def _message(self, text):
        dialog = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.INFO,
                                   buttons=Gtk.ButtonsType.OK, text=text)
        dialog.run()
        dialog.destroy()

    @staticmethod
    def _app_state(app):
        """'ready', 'setup' (installed, needs first-time setup) or 'missing'."""
        if shutil.which(app.get("command", "")) is None:
            return "missing"
        ready = app.get("ready")
        if ready and not os.path.exists(os.path.expanduser(ready)):
            return "setup"
        return "ready"

    def _update_tile(self, btn):
        btn.app_state = self._app_state(btn.app)
        installable = bool(btn.app.get("app"))
        btn.detail.set_text({"ready": btn.app.get("detail", ""),
                             "setup": "Tap to set up",
                             "missing": "Tap to install" if installable else "Not installed",
                             }[btn.app_state])
        btn.set_sensitive(btn.app_state != "missing" or installable)
        ctx = btn.get_style_context()
        if btn.app_state == "ready":
            ctx.remove_class("not-ready")
        else:
            ctx.add_class("not-ready")

    def _refresh_tiles(self):
        for btn in self.tiles:
            self._update_tile(btn)

    def _tile_clicked(self, btn):
        if time.monotonic() - self.last_swipe < 0.5:
            return  # the end of a swipe between pages, not a tap
        if self.arranging:
            self._arrange_tap(btn)
            return
        app = btn.app
        if app.get("page"):  # a part of the launcher, not a separate app
            {"nwr": self._edit_nwr}.get(app["page"], lambda: self.stack.set_visible_child_name(app["page"]))()
            return
        if btn.app_state != "missing":
            # Already open: bring it to the front rather than start a second copy.
            for win in open_windows():
                if window_app(win, [app], self.started):
                    wmctrl("-i", "-a", hex(win["id"]))
                    return
            self.started[app.get("code")] = run_detached(app.get("run") or [app["command"]]).pid
            if self.desktop and not self.session:
                self.iconify()  # a desktop may open the app behind a full-screen window
            return
        if self._confirm(f"Install {app['name']}?",
                         "It's downloaded from the internet, which takes a few minutes."):
            self._run_in_terminal(f"Installing {app['name']}", UPDATE_CMD + ["--app", app["app"]],
                                  self._refresh_tiles)

    def _confirm(self, text, secondary):
        dialog = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.QUESTION,
                                   buttons=Gtk.ButtonsType.OK_CANCEL, text=text)
        dialog.format_secondary_text(secondary)
        response = dialog.run()
        dialog.destroy()
        return response == Gtk.ResponseType.OK

    def _run_in_terminal(self, title, argv, on_done=None):
        """Show argv's progress in a terminal window; call on_done once it's closed."""
        script = '"$@"; echo; read -r -p "Press Enter to close. " _'
        proc = subprocess.Popen(["xterm", "-fa", "IBM Plex Mono", "-fs", "12", "-geometry", "110x30",
                                 "-T", title, "-e", "bash", "-c", script, "emcomm"] + argv,
                                start_new_session=True)
        if on_done:
            GLib.child_watch_add(GLib.PRIORITY_DEFAULT, proc.pid, lambda *_: on_done())

    def _update_station(self, *_):
        if self._confirm("Update the station?",
                         "Downloads the latest Emcomm-CNC and installs any missing apps. Settings are kept. "
                         "The home screen restarts when it's done."):
            # The kiosk's autostart loop starts the new launcher after this one quits.
            self._run_in_terminal("Updating the station", UPDATE_CMD, self._restart)

    def _restart(self):
        """Start the newly installed launcher. The kiosk and the desktop session start it again
        when this one quits; opened from a desktop's app menu, it starts itself."""
        if self.desktop and not self.session:
            os.execv(sys.executable, [sys.executable] + sys.argv)
        self.quit()

    def quit(self, status=0):
        """Leave the launcher, giving back the computer's own sound (Settings > Audio)."""
        self.exit_status = status
        with self._audio_lock:
            if self.desktop and self._audio_choice() == "while_open":
                restore_sound_before()
        Gtk.main_quit()

    def _navbtn(self, label, handler, extra_class=None):
        btn = Gtk.Button(label=label)
        btn.get_style_context().add_class("navbtn")
        if extra_class:
            btn.get_style_context().add_class(extra_class)
        btn.connect("clicked", handler)
        return btn

    def _power_dialog(self, *_):
        dialog = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.QUESTION,
                                   text="Leave Emcomm-CNC?" if self.desktop else "Shut down the station?")
        dialog.add_buttons("Cancel", Gtk.ResponseType.CANCEL)
        if self.desktop:
            dialog.add_buttons("Log out" if self.session else "Exit Emcomm-CNC", 3)
        dialog.add_buttons("Restart", 1, "Shut down", 2)
        response = dialog.run()
        dialog.destroy()
        if response == 3:
            self.quit(EXIT_LOG_OUT if self.session else 0)
        elif response == 1:
            run_detached(["systemctl", "reboot"])
        elif response == 2:
            run_detached(["systemctl", "poweroff"])

