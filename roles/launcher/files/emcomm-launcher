def recordings(limit=200):
    """(path, size in bytes, seconds) of finished recordings, newest first."""
    paths = sorted(glob.glob(os.path.join(RECORDINGS, "*", "*.wav")), reverse=True)[:limit]
    found = []
    for path in paths:
        try:
            size = os.path.getsize(path)
        except OSError:
            continue
        found.append((path, size, max(0, size - 44) / 16000))
    return found


