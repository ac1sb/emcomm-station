def read_json(path, default):
    try:
        with open(path, encoding="utf-8") as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


def load_config():
    return read_json(CONFIG_PATH, {"apps": []})


def load_station():
    return read_json(STATION_PATH, {"callsign": "N0CALL", "grid": "", "radio": ""})


def load_presets():
    """Radio presets as (id, preset), sorted by display name."""
    presets = []
    for path in sorted(glob.glob(os.path.join(PRESETS_DIR, "*.json"))):
        preset = read_json(path, None)
        if preset:
            presets.append((os.path.basename(path)[:-5], preset))
    return sorted(presets, key=lambda p: p[1].get("radio_name", p[0]))


def load_hamlib_models():
    """{manufacturer: [(model number, model name)]} from `rigctl -l`."""
    try:
        out = subprocess.run(["rigctl", "-l"], capture_output=True, text=True, timeout=10).stdout
    except (OSError, subprocess.TimeoutExpired):
        return {}
    lines = out.splitlines()
    if not lines or "Mfg" not in lines[0]:
        return {}
    header = lines[0]
    mfg_at, model_at, ver_at = header.index("Mfg"), header.index("Model"), header.index("Version")
    models = {}
    for line in lines[1:]:
        number = line[:mfg_at].strip()
        if number.isdigit():
            mfg, name = line[mfg_at:model_at].strip(), line[model_at:ver_at].strip()
            models.setdefault(mfg, []).append((int(number), name))
    return models


def udev_props(args):
    try:
        out = subprocess.run(["udevadm", "info", "-q", "property", *args],
                             capture_output=True, text=True, timeout=5).stdout
    except (OSError, subprocess.TimeoutExpired):
        return {}
    return dict(line.split("=", 1) for line in out.splitlines() if "=" in line)


def usb_match(props, with_interface):
    match = {"vendor": props.get("ID_VENDOR_ID", "").lower(), "product": props.get("ID_MODEL_ID", "").lower()}
    if not (match["vendor"] and match["product"]):
        return None
    if props.get("ID_SERIAL_SHORT"):
        match["serial"] = props["ID_SERIAL_SHORT"]
    if with_interface and props.get("ID_USB_INTERFACE_NUM"):
        match["interface"] = props["ID_USB_INTERFACE_NUM"]
    return match


def describe_match(match):
    text = f"USB {match['vendor']}:{match['product']}"
    if "interface" in match:
        text += f" port {int(match['interface'])}"
    return text


def detect_devices():
    """([(label, match)] for USB serial ports, [(label, match)] for USB sound cards) plugged in now."""
    if FAKE_DEVICES:
        fake = read_json(FAKE_DEVICES, {})
        return ([tuple(p) for p in fake.get("serial", [])], [tuple(c) for c in fake.get("sound", [])])
    ports = []
    for link in sorted(glob.glob("/dev/serial/by-id/*")):
        props = udev_props(["-n", link])
        match = usb_match(props, with_interface=True)
        if match:
            name = props.get("ID_MODEL", "").replace("_", " ") or os.path.basename(link)
            ports.append((f"{describe_match(match)} · {os.path.basename(os.path.realpath(link))} · {name}", match))
    cards = []
    for path in sorted(glob.glob("/sys/class/sound/card[0-9]*")):
        props = udev_props(["-p", path])
        match = usb_match(props, with_interface=False)
        if match:
            name = props.get("ID_MODEL", "").replace("_", " ") or os.path.basename(path)
            cards.append((f"{describe_match(match)} · {name}", match))
    return ports, cards


def rigctld_query(host, port, command, timeout=1.0):
    """Send one rigctld command and return the first reply line, or None."""
    try:
        with socket.create_connection((host, port), timeout=timeout) as s:
            s.sendall(command.encode() + b"\n")
            data = s.recv(256).decode(errors="replace")
            return data.splitlines()[0].strip() if data else None
    except OSError:
        return None


def format_freq(hz_text):
    try:
        hz = int(hz_text)
    except (TypeError, ValueError):
        return None
    mhz, rest = divmod(hz, 1_000_000)
    khz, h = divmod(rest, 1000)
    return f"{mhz}.{khz:03d}.{h:03d}"


# ---- tile icons --------------------------------------------------------------

ICONS_DIR = os.environ.get("EMCOMM_ICONS", "/usr/share/emcomm/icons")
USER_ICONS = os.path.expanduser("~/.local/share/emcomm/icons")  # the operator's own pictures win
ICON_EXTS = (".svg", ".png", ".jpg")
ICON_SIZE = 44


def user_icon(name):
    for ext in ICON_EXTS:
        path = os.path.join(USER_ICONS, name + ext)
        if os.path.isfile(path):
            return path
    return None


def find_icon(name):
    if not name:
        return None
    if user_icon(name):
        return user_icon(name)
    for ext in ICON_EXTS:
        path = os.path.join(ICONS_DIR, name + ext)
        if os.path.isfile(path):
            return path
    return None


def remove_user_icon(name):
    for ext in ICON_EXTS:
        try:
            os.remove(os.path.join(USER_ICONS, name + ext))
        except FileNotFoundError:
            pass


def mount_usb_sticks():
    """Mount plugged-in USB sticks (under /media/USER) so their pictures can be picked."""
    if not shutil.which("udisksctl"):
        return
    for link in glob.glob("/dev/disk/by-id/usb-*-part*"):
        subprocess.run(["udisksctl", "mount", "--no-user-interaction", "-b", os.path.realpath(link)],
                       capture_output=True, check=False)


def run_detached(argv):
    subprocess.Popen(argv, start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


