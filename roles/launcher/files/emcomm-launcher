def parse_wmctrl(text):
    """Windows from `wmctrl -lpx`: [{"id", "pid", "cls", "title"}]. Windows on every
    desktop (-1: the Home bar, the keyboard) aren't apps, so they're left out."""
    windows = []
    for line in text.splitlines():
        parts = line.split(None, 5)
        if len(parts) < 5 or parts[1] == "-1":
            continue
        try:
            windows.append({"id": int(parts[0], 16), "pid": int(parts[2]), "cls": parts[3],
                            "title": parts[5].strip() if len(parts) > 5 else ""})
        except ValueError:
            continue
    return windows


def open_windows():
    try:
