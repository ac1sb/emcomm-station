    # ---- sending a message over the radio through fldigi -------------------

    def _send_dialog(self, path):
        """Send an flmsg message file the way flmsg's AutoSend does (emcomm-ics send): the
        modem is picked here, fldigi is started if need be, and the dialog says when fldigi
        is back on receive."""
        dialog = Gtk.Dialog(title="Send over the radio", transient_for=self, modal=True)
        dialog.set_default_size(620, -1)
        box = dialog.get_content_area()
        box.set_spacing(12)
        box.set_property("margin", 16)
        name = Gtk.Label(label=f"Send {os.path.basename(path)} with fldigi", xalign=0)
        name.get_style_context().add_class("tile-name")
        status = Gtk.Label(label="Looking for fldigi…", xalign=0, wrap=True)
        modem = PickList()
        box.pack_start(name, False, False, 0)
        box.pack_start(status, False, False, 0)
        box.pack_start(self._field("Modem (the one the net uses; MT63-2000L is usual on VHF)", modem),
                       False, False, 0)
        start_btn = dialog.add_button("Start fldigi", 1)
        send_btn = dialog.add_button("Send", Gtk.ResponseType.OK)
        send_btn.get_style_context().add_class("primary")
        send_btn.set_sensitive(False)
        dialog.add_button("Close", Gtk.ResponseType.CLOSE)
        state = {"online": False, "sending": False, "sent": None, "starting": None, "closed": False}

        def check(delay=0):
            def ask():
                if not state["closed"]:
                    threading.Thread(target=lambda: GLib.idle_add(found, fldigi_status(modems=True)),
                                     daemon=True).start()
                return False
            if delay:
                GLib.timeout_add_seconds(delay, ask)
            else:
                ask()

        def found(st):
            if state["closed"]:
                return False
            if st.get("online"):
                if not state["online"]:
                    state["online"] = True
                    names = st.get("modems") or [st.get("modem") or ""]
                    modem.remove_all()
                    for n in names:
                        modem.append(n, n)
                    modem.set_active_id(st.get("modem") if st.get("modem") in names else names[0])
                start_btn.hide()
                if state["sent"]:
                    if st.get("trx") == "rx":
                        status.set_text(f"Sent as {state['sent']}. fldigi is back on receive.")
                        send_btn.set_label("Send again")
                        send_btn.set_sensitive(True)
                    else:
                        status.set_text(f"Transmitting as {state['sent']}… the radio stays keyed until it's "
                                        "through.")
                        check(2)
                elif not state["sending"]:
                    status.set_text(f"fldigi is running, on {st.get('modem', '?')}. Pick the modem the net uses and "
                                    "tap Send: fldigi keys the radio and sends the message.")
                    send_btn.set_sensitive(True)
            else:
                state["online"] = False
                send_btn.set_sensitive(False)
                start_btn.show()
                if state["starting"] and time.time() - state["starting"] < 90:
                    status.set_text("Starting fldigi… its window opens in a few seconds.")
                    check(2)
                elif state["starting"]:
                    state["starting"] = None
                    start_btn.set_sensitive(True)
                    status.set_text("fldigi didn't start. Open it from its tile on Home, then tap Send.")
                else:
                    status.set_text("fldigi isn't running. Tap Start fldigi; once its window is up, tap Send.")
            return False

        def sent(outcome):
            if state["closed"]:
                return False
            state["sending"] = False
            ok, info = outcome
            if ok:
                state["sent"] = info
                status.set_text(f"In fldigi's transmit buffer as {info}: the radio is keyed until it's through.")
                self.f213_status.set_text(f"Sent {os.path.basename(path)} as {info} with fldigi at "
                                          f"{time.strftime('%H%MZ', time.gmtime())}.")
                check(2)
            else:
                status.set_text(info)
                send_btn.set_sensitive(True)
            return False

        def send():
            chosen = modem.get_active_id()
            state["sending"], state["sent"] = True, None
            send_btn.set_sensitive(False)
            status.set_text("Sending…")

            def work():
                try:
                    result = subprocess.run([ICS_CMD, "send", path] + (["--modem", chosen] if chosen else []),
                                            capture_output=True, text=True, timeout=60, check=False)
                    if result.returncode == 0:
                        outcome = (True, json.loads(result.stdout).get("modem") or chosen or "the current modem")
                    else:
                        outcome = (False, (result.stderr.strip().splitlines() or ["Couldn't send."])[-1])
                except (OSError, ValueError, subprocess.TimeoutExpired) as exc:
                    outcome = (False, f"Couldn't send: {exc}")
                GLib.idle_add(sent, outcome)

            threading.Thread(target=work, daemon=True).start()

        def respond(_dialog, response):
            if response == Gtk.ResponseType.OK:
                send()
            elif response == 1:
                if not shutil.which("fldigi"):
                    status.set_text("fldigi isn't installed: tap its tile on Home to install it.")
                    return
                state["starting"] = time.time()
                start_btn.set_sensitive(False)
                status.set_text("Starting fldigi… its window opens in a few seconds.")
                run_detached(["emcomm-start", "fldigi"])
                check(3)
            else:
                state["closed"] = True
                dialog.destroy()

        dialog.connect("response", respond)
        dialog.show_all()
        start_btn.hide()
        check()

    def _ics213_show(self, path):
        """Fill FEMA's form from the flmsg file and draw it; with no file, draw the blank form."""
        self.f213_path, self.f213_doc = path, None
        pdf = ICS213_BLANK
        if path:
            pdf = None
            try:
                result = subprocess.run([ICS_CMD, "213", path], capture_output=True, text=True,
                                        timeout=30, check=False)
                if result.returncode == 0:
                    pdf = result.stdout.strip().splitlines()[-1]
                    self.f213_status.set_text(f"Saved as {pdf.replace(os.path.expanduser('~'), '~')}")
                else:
                    self.f213_status.set_text(result.stderr.strip().splitlines()[-1] if result.stderr.strip()
                                              else "Couldn't fill in the form.")
            except (OSError, subprocess.TimeoutExpired) as exc:
                self.f213_status.set_text(f"Couldn't fill in the form: {exc}")
        if pdf and Poppler is None:
            self.f213_status.set_text("Can't show the form: gir1.2-poppler-0.18 is missing. Run Update station.")
        elif pdf:
            try:
                self.f213_doc = Poppler.Document.new_from_file(GLib.filename_to_uri(pdf, None), None)
            except GLib.Error as exc:
                self.f213_status.set_text(f"Couldn't open the form: {exc.message}")
        self.f213_print_btn.set_sensitive(self.f213_doc is not None)
        self.f213_open_btn.set_sensitive(path is not None)
        self.f213_flmsg_btn.set_sensitive(path is not None)
        self.f213_send_btn.set_sensitive(path is not None)
        self._ics213_fit()
        self.f213_form.queue_draw()

    def _ics213_fit(self):
        """Size the form to the width of its pane; it scrolls up and down."""
        if not self.f213_doc:
            self.f213_form.set_size_request(-1, -1)
            return
        width_pt, height_pt = self.f213_doc.get_page(0).get_size()
        width = self.f213_scroller.get_allocated_width()
        height = int(width * height_pt / width_pt)
        if self.f213_form.get_size_request()[1] != height:
            self.f213_form.set_size_request(-1, height)

    def _ics213_draw(self, widget, cr):
        if not self.f213_doc:
            return False
        page = self.f213_doc.get_page(0)
        width_pt, _height_pt = page.get_size()
        scale = widget.get_allocated_width() / width_pt
        cr.set_source_rgb(1, 1, 1)
        cr.paint()
        cr.scale(scale, scale)
        page.render(cr)
        return False

    def _ics213_print(self, *_):
        if not self.f213_doc:
            return
        doc = self.f213_doc

        def draw_page(_op, context, _number):
            page = doc.get_page(0)
            width_pt, _height_pt = page.get_size()
            cr = context.get_cairo_context()
            scale = context.get_width() / width_pt
            cr.scale(scale, scale)
            page.render_for_printing(cr)

        op = Gtk.PrintOperation(n_pages=1, use_full_page=False, job_name="ICS-213")
        op.connect("draw-page", draw_page)
        try:
            op.run(Gtk.PrintOperationAction.PRINT_DIALOG, self)
        except GLib.Error as exc:
            self.f213_status.set_text(f"Couldn't print: {exc.message}")

    def _ics213_edit(self, *_):
        if self.f213_path and shutil.which("flmsg"):
            run_detached(["emcomm-start", "flmsg", self.f213_path])

    # ---- typing an ICS-213 on the form ------------------------------------
    # The blank FEMA form is drawn and a box sits on each of its fields, so the
    # message is typed where it goes on paper. It's saved as an flmsg file, so
    # it can go over the radio through fldigi, flmsg can open it, and the Forms
    # list shows it.

    def _ics213_editor(self):
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12, margin=20)
        header = Gtk.Box(spacing=12)
        header.pack_start(self._navbtn("‹ Forms", lambda *_: self.stack.set_visible_child_name("forms")),
                          False, False, 0)
        self.f213e_title = Gtk.Label(xalign=0)
        self.f213e_title.get_style_context().add_class("title")
        header.pack_start(self.f213e_title, False, False, 0)
        self.f213e_status = Gtk.Label(xalign=0, ellipsize=Pango.EllipsizeMode.END)
        self.f213e_status.get_style_context().add_class("muted")
        header.pack_start(self.f213e_status, True, True, 0)
        header.pack_end(self._navbtn("Send over the radio", lambda *_: self._ics213_editor_send(), "primary"),
                        False, False, 0)
        header.pack_end(self._navbtn("Save", lambda *_: self._ics213_editor_save()), False, False, 0)
        header.pack_end(self._navbtn("Print", lambda *_: self._ics213_editor_print()), False, False, 0)
        header.pack_end(self._navbtn("Open in flmsg", lambda *_: self._ics213_editor_flmsg()), False, False, 0)
        page.pack_start(header, False, False, 0)

        self.f213e_doc = None
        if Poppler is not None and os.path.exists(ICS213_BLANK):
            try:
                self.f213e_doc = Poppler.Document.new_from_file(GLib.filename_to_uri(ICS213_BLANK, None), None)
            except GLib.Error:
                pass
        overlay = Gtk.Overlay()
        self.f213e_paper = Gtk.DrawingArea()
        self.f213e_paper.connect("draw", self._ics213_editor_draw)
        overlay.add(self.f213e_paper)
        self.f213e_fixed = Gtk.Fixed()
        overlay.add_overlay(self.f213e_fixed)
        self.f213e_fields = {}
        for key, *_box in ICS213_BOXES:
            if key in ("mg", "rp"):
                view = Gtk.TextView(wrap_mode=Gtk.WrapMode.WORD_CHAR, left_margin=4, right_margin=4)
                view.get_style_context().add_class("formfield")
                widget = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER)
                widget.add(view)
                self.f213e_fields[key] = view
            else:
                widget = Gtk.Entry(placeholder_text=ICS213_HINTS.get(key, ""), width_chars=1)
                widget.get_style_context().add_class("formfield")
                self.f213e_fields[key] = widget
            widget.box = _box
            self.f213e_fixed.put(widget, 0, 0)
        self.f213e_scroller = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER)
        self.f213e_scroller.add(overlay)
        self.f213e_scroller.connect("size-allocate", lambda *_: self._ics213_editor_fit())
        page.pack_start(self.f213e_scroller, True, True, 0)
        self.f213e_path, self.f213e_scale = None, 0
        return page

    def _ics213_editor_fit(self):
        """Scale the form to the page's width and put each box on its field."""
        width = self.f213e_scroller.get_allocated_width() - 16  # room for the scroll bar
        if width <= 0 or not self.f213e_doc:
            return
        width_pt, height_pt = self.f213e_doc.get_page(0).get_size()
        scale = width / width_pt
        if abs(scale - self.f213e_scale) < 0.001:
            return
        self.f213e_scale = scale
        self.f213e_paper.set_size_request(width, int(height_pt * scale))
        for child in self.f213e_fixed.get_children():
            left, bottom, right, top = child.box
            self.f213e_fixed.move(child, int(left * scale), int((height_pt - top) * scale))
            child.set_size_request(int((right - left) * scale), int((top - bottom) * scale))

    def _ics213_editor_draw(self, widget, cr):
        cr.set_source_rgb(1, 1, 1)
        cr.paint()
        if self.f213e_doc and self.f213e_scale:
            cr.scale(self.f213e_scale, self.f213e_scale)
            self.f213e_doc.get_page(0).render(cr)
        return False

    def _ics213_field(self, key):
        widget = self.f213e_fields[key]
        if isinstance(widget, Gtk.TextView):
            buf = widget.get_buffer()
            return buf.get_text(buf.get_start_iter(), buf.get_end_iter(), False)
        return widget.get_text()

    def _ics213_write(self, path):
        """Open the form: blank for a new message, or filled from an flmsg file to edit or reply to."""
        if not self.f213e_doc:
            self._set_message("Can't show the form: run Update station (it needs gir1.2-poppler-0.18).", None)
            return
        fields = {}
        if path:
            try:
                result = subprocess.run([ICS_CMD, "213", "--fields", path], capture_output=True, text=True,
                                        timeout=20, check=False)
                fields = json.loads(result.stdout) if result.returncode == 0 else {}
            except (OSError, ValueError, subprocess.TimeoutExpired):
                fields = {}
        received = bool(path) and not os.path.dirname(os.path.abspath(path)) == os.path.abspath(ICS213_SENT)
        if not path:
            now = time.gmtime()  # UTC, as flmsg is set to write it (emcomm-app-setup flmsg)
            fields = {"d1": time.strftime("%Y-%m-%d", now), "t1": time.strftime("%H%MZ", now)}
            net_path, net = open_net()
            if net and net.get("incident"):
                fields["inc"] = net["incident"]
        if received and not fields.get("rp"):
            now = time.gmtime()
            fields.setdefault("d2", time.strftime("%Y-%m-%d", now))
            fields.setdefault("t2", time.strftime("%H%MZ", now))
        for key, widget in self.f213e_fields.items():
            value = fields.get(key, "")
            if isinstance(widget, Gtk.TextView):
                widget.get_buffer().set_text(value)
            else:
                widget.set_text(value)
        # A received message is answered in a copy, so what came in stays as it was.
        self.f213e_path = None if received else path
        self.f213e_title.set_text("Reply" if received else "Edit ICS-213" if path else "New ICS-213")
        self.f213e_status.set_text("Type the reply at the bottom." if received else "")
        self.stack.set_visible_child_name("ics213-edit")
        focus = "rp" if received else "to" if not path else "mg"
        GLib.idle_add(lambda: self.f213e_fields[focus].grab_focus() and False)

    def _ics213_editor_save(self):
        """Save the form as an flmsg file in flmsg's messages folder; the path, or None."""
        fields = {key: self._ics213_field(key).strip("\n") if key in ("mg", "rp") else self._ics213_field(key).strip()
                  for key in self.f213e_fields}
        if not any(fields.values()):
            self.f213e_status.set_text("The form is empty.")
            return None
        path = self.f213e_path
        if not path:
            stem = time.strftime("ICS213-%Y%m%d-%H%M%SZ", time.gmtime())
            subject = re.sub(r"[^A-Za-z0-9 _-]+", "", fields.get("sb", ""))[:30].strip()
            path = os.path.join(ICS213_SENT, f"{stem} {subject}.213" if subject else f"{stem}.213")
        try:
            result = subprocess.run([ICS_CMD, "213", "--save", path, self.station.get("callsign", "")],
                                    input=json.dumps(fields), capture_output=True, text=True, timeout=20,
                                    check=False)
        except (OSError, subprocess.TimeoutExpired) as exc:
            self.f213e_status.set_text(f"Couldn't save: {exc}")
            return None
        if result.returncode != 0:
            self.f213e_status.set_text("Couldn't save: " + (result.stderr.strip().splitlines() or ["?"])[-1])
            return None
        self.f213e_path = path
        self.f213e_title.set_text("Edit ICS-213")
        self.f213e_status.set_text("Saved " + time.strftime("%H:%MZ", time.gmtime()) + ". It's in the Forms list.")
        self.forms_listed = None  # list it next time the Forms page shows
        return path

    def _ics213_editor_send(self):
        """Save, then send through fldigi (the dialog starts fldigi if it isn't running)."""
        path = self._ics213_editor_save()
        if path:
            self._send_dialog(path)

    def _ics213_editor_flmsg(self):
        path = self._ics213_editor_save()
        if not path:
            return
        if not shutil.which("flmsg"):
            self.f213e_status.set_text("Saved. flmsg isn't installed: tap its tile on Home to install it.")
            return
        run_detached(["emcomm-start", "flmsg", path])
        self.f213e_status.set_text("Opened in flmsg.")

    def _ics213_editor_print(self):
        path = self._ics213_editor_save()
        if path:
            self.f213_path = None
            self.forms_view.set_visible_child_name("pdf")
            self._ics213_show(path)
            self._ics213_print()

