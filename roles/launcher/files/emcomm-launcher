#!/usr/bin/env python3
"""Full-screen touch launcher for the Emcomm-CNC station.

Home: app tiles plus station status. Diagnostics: hardware/service status
and radio tests. Settings: callsign, grid, radio, baud rate and PTT, saved
through emcomm-apply-settings. The app list comes from
/etc/emcomm/launcher.json, which the playbook writes.
"""

import json
import os
import shutil
import socket
import subprocess
import tempfile
import threading
import time

import gi

gi.require_version("Gtk", "3.0")
from gi.repository import GLib, Gtk, Gdk  # noqa: E402

CONFIG_PATH = os.environ.get("EMCOMM_LAUNCHER_CONFIG", "/etc/emcomm/launcher.json")
STATION_PATH = os.environ.get("EMCOMM_STATION", "/etc/emcomm/station.json")
PROFILES_DIR = os.environ.get("EMCOMM_PROFILES", "/usr/share/emcomm/radios")
APPLY_CMD = os.environ.get("EMCOMM_APPLY", "sudo -n /usr/local/sbin/emcomm-apply-settings").split()
RIGCTLD = ("127.0.0.1", 4532)
BAUD_RATES = ["4800", "9600", "19200", "38400", "57600", "115200"]
PTT_CHOICES = [("RTS", "RTS (Digirig)"), ("DTR", "DTR"), ("CAT", "CAT"), ("NONE", "VOX / none")]

