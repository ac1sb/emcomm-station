def grid_to_latlon(grid):
    """Centre of a Maidenhead square (4 or 6 characters), or None."""
    grid = (grid or "").strip()
    if not re.fullmatch(r"[A-Ra-r]{2}[0-9]{2}([A-Xa-x]{2})?", grid):
        return None
    lon = (ord(grid[0].upper()) - 65) * 20 - 180 + int(grid[2]) * 2
    lat = (ord(grid[1].upper()) - 65) * 10 - 90 + int(grid[3])
    if len(grid) == 6:
        lon += (ord(grid[4].lower()) - 97) * 5 / 60 + 2.5 / 60
        lat += (ord(grid[5].lower()) - 97) * 2.5 / 60 + 1.25 / 60
    else:
        lon, lat = lon + 1, lat + 0.5
    return lat, lon


def distance_bearing(a, b):
    """Great-circle miles and initial bearing in degrees from a to b, both (lat, lon)."""
    lat1, lon1, lat2, lon2 = map(math.radians, (*a, *b))
    d = 2 * math.asin(math.sqrt(math.sin((lat2 - lat1) / 2) ** 2
                                + math.cos(lat1) * math.cos(lat2) * math.sin((lon2 - lon1) / 2) ** 2))
    y = math.sin(lon2 - lon1) * math.cos(lat2)
    x = math.cos(lat1) * math.sin(lat2) - math.sin(lat1) * math.cos(lat2) * math.cos(lon2 - lon1)
    return d * 3958.8, (math.degrees(math.atan2(y, x)) + 360) % 360


def gateway_matches(modes, want):
    modes = modes.upper()
    if want == "vara fm":
        return modes.startswith("VARA FM")
    if want == "vara hf":
        return modes.startswith("VARA") and not modes.startswith("VARA FM")
    return want == "all" or want.upper() in modes


def nearest_gateways(grid, want="all", limit=60):
    """Winlink gateway channels nearest the station, as Reference rows, from Pat's list."""
    here = grid_to_latlon(grid)
    try:
        with open(RMSLIST, encoding="utf-8") as f:
            gateways = json.load(f).get("Gateways") or []
    except (OSError, ValueError):
        return None
    rows = []
    for gw in gateways:
        for ch in gw.get("GatewayChannels") or []:
            modes, freq = ch.get("SupportedModes", ""), ch.get("Frequency") or 0
            if not freq or not gateway_matches(modes, want):
                continue
            there = grid_to_latlon(ch.get("Gridsquare")) or (gw.get("Latitude"), gw.get("Longitude"))
            if here and None not in there:
                miles, bearing = distance_bearing(here, there)
                where = f"{miles:,.0f} mi at {bearing:03.0f}°"
            else:
                miles, where = float("inf"), ch.get("Gridsquare", "")
            fm = "FM" in modes.upper() or "PACKET" in modes.upper()
            # Pat lists the centre frequency; HF modes are dialled 1.5 kHz lower.
            dial = freq if fm else freq - 1500
            rows.append({"MHz": dial / 1e6, "Mode": "FM" if fm else "PKTUSB",
                         "Name": f"{gw.get('Callsign', '')}  ·  {modes}",
                         "Note": f"{where} · hours {ch.get('OperatingHours') or '?'} UTC", "miles": miles})
    rows.sort(key=lambda r: (r["miles"], r["MHz"]))
    return rows[:limit]


def reference_sections():
    """[(title, path)]: the operator's frequencies first, then the standard pages in file order."""
    files = {}
    for folder in (REFERENCE_DIR, USER_REFERENCE):
        for path in glob.glob(os.path.join(folder, "*.csv")) + glob.glob(os.path.join(folder, "*.txt")):
            files[os.path.basename(path)] = path
    sections = [(re.sub(r"^\d+\s+", "", os.path.splitext(name)[0]), files[name]) for name in sorted(files)]
    mine = os.path.basename(MY_FREQS)
    sections = [s for s in sections if os.path.basename(s[1]) != mine]
    return [("My frequencies", MY_FREQS), ("Nearest Winlink gateways", GATEWAYS)] + sections


def to_float(text):
    try:
        return float((text or "").strip().replace("+", ""))
    except ValueError:
        return None


def read_freqs(path):
    """Rows of a frequency list; rows without a usable frequency are skipped."""
    rows = []
    try:
        with open(path, encoding="utf-8", newline="") as f:
            for row in csv.DictReader(f):
                mhz = to_float(row.get("MHz"))
                if mhz is None:
                    continue
                rows.append({"MHz": mhz, "Mode": (row.get("Mode") or "").strip().upper(),
                             "Name": (row.get("Name") or "").strip(), "Note": (row.get("Note") or "").strip(),
                             "Offset": to_float(row.get("Offset")), "Tone": to_float(row.get("Tone"))})
    except OSError:
        pass
    return rows


def offset_text(offset):
    return "simplex" if offset == 0 else f"{offset:+.3f}".rstrip("0").rstrip(".") + " MHz"


def freq_detail(row):
    """Offset, tone and note, for under a frequency's name."""
    parts = [offset_text(row["Offset"]) if row.get("Offset") is not None else "",
             f"tone {row['Tone']:g}" if row.get("Tone") else "", row["Note"]]
    return " · ".join(filter(None, parts))


def write_freqs(path, rows):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w", encoding="utf-8", newline="") as f:
        out = csv.DictWriter(f, FREQ_FIELDS)
        out.writeheader()
        for row in rows:
            out.writerow({**row, "MHz": f"{row['MHz']:.6f}".rstrip("0").rstrip("."),
                          "Offset": "" if row.get("Offset") is None else f"{row['Offset']:+g}",
                          "Tone": f"{row['Tone']:g}" if row.get("Tone") else ""})
    if path == MY_FREQS:
        export_chirp(rows)


def export_chirp(rows, path=CHIRP_EXPORT):
    """Write the FM channels for CHIRP, numbered from 1 in list order."""
    channels = [r for r in rows if r["Mode"] in ("FM", "PKTFM")]
    try:
        with open(path, "w", encoding="utf-8", newline="") as f:
            out = csv.DictWriter(f, CHIRP_FIELDS)
            out.writeheader()
            for i, r in enumerate(channels, 1):
                offset = r.get("Offset") or 0
                tone = r.get("Tone")
                out.writerow({"Location": i, "Name": r["Name"], "Frequency": f"{r['MHz']:.6f}",
                              "Duplex": "+" if offset > 0 else "-" if offset < 0 else "",
                              "Offset": f"{abs(offset):.6f}", "Tone": "Tone" if tone else "",
                              "rToneFreq": f"{tone or 88.5:.1f}", "cToneFreq": f"{tone or 88.5:.1f}",
                              "DtcsCode": "023", "DtcsPolarity": "NN", "Mode": "FM", "TStep": "5.00",
                              "Skip": "", "Comment": r["Note"], "URCALL": "", "RPT1CALL": "", "RPT2CALL": ""})
    except OSError:
        pass


def nmcli_fields(line):
    """Split one line of `nmcli -t` output; colons inside a field come escaped as \\:."""
    fields, cur, i = [], "", 0
    while i < len(line):
        if line[i] == "\\" and i + 1 < len(line):
            cur += line[i + 1]
            i += 2
            continue
        if line[i] == ":":
            fields.append(cur)
            cur = ""
        else:
            cur += line[i]
        i += 1
    return fields + [cur]


def nmcli(*args, timeout=30):
    """Run nmcli; (ok, output or error message)."""
    try:
        result = subprocess.run(["nmcli", *args], capture_output=True, text=True, timeout=timeout)
    except (OSError, subprocess.TimeoutExpired) as exc:
        return False, str(exc)
    if result.returncode != 0:
        return False, (result.stderr or result.stdout).strip().removeprefix("Error: ")
    return True, result.stdout


def wifi_state():
    """(wifi device or None, its state, connected network or ''), from NetworkManager."""
    ok, out = nmcli("-t", "-f", "DEVICE,TYPE,STATE,CONNECTION", "device", timeout=10)
    if not ok:
        return None, out, ""
    for line in out.splitlines():
        dev, kind, state, conn = (nmcli_fields(line) + ["", "", "", ""])[:4]
        if kind == "wifi":
            return dev, state, conn if state == "connected" else ""
    return None, "no Wi-Fi adapter", ""


def has_default_route():
    """Whether any interface has a default route (/proc/net/route: destination 0, interface up)."""
    try:
        with open("/proc/net/route", encoding="ascii") as f:
            rows = [line.split() for line in f.readlines()[1:]]
    except OSError:
        return False
    return any(len(r) > 3 and r[1] == "00000000" and int(r[3], 16) & 1 for r in rows)


def wifi_networks():
    """Visible networks, strongest first: [{ssid, signal, secure, in_use}], one per name."""
    ok, out = nmcli("-t", "-f", "IN-USE,SSID,SIGNAL,SECURITY", "device", "wifi", "list", "--rescan", "yes")
    if not ok:
        return None, out
    best = {}
    for line in out.splitlines():
        in_use, ssid, signal, security = (nmcli_fields(line) + ["", "", "", ""])[:4]
        if not ssid:
            continue
        net = {"ssid": ssid, "signal": int(signal) if signal.isdigit() else 0,
               "secure": security not in ("", "--"), "in_use": in_use == "*"}
        if ssid not in best or net["in_use"] or net["signal"] > best[ssid]["signal"]:
            best[ssid] = {**net, "in_use": net["in_use"] or best.get(ssid, {}).get("in_use", False)}
    return sorted(best.values(), key=lambda n: (not n["in_use"], -n["signal"])), ""


def tune_radio(mhz, mode):
    """Set the radio's frequency and mode through rigctld. True if it took both."""
    if rigctld_query(*RIGCTLD, f"F {round(mhz * 1_000_000)}") != "RPRT 0":
        return False
    if not mode:
        return True
    # Radios without a separate data mode get plain USB/LSB/FM instead.
    for m in dict.fromkeys([mode, mode.removeprefix("PKT")]):
        if rigctld_query(*RIGCTLD, f"M {m} 0") == "RPRT 0":
            return True
    return False


