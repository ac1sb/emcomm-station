    def _settings_shown(self):
        """Show the saved settings and the devices plugged in now, unless there are unsaved
        changes (say, after a trip to the Wi-Fi page), which are kept."""
        station, form = self._settings_filled
        if self.station is not station or self._settings_form() == form:
            self.serial_ports, self.sound_cards = detect_devices()
            self._fill_settings()

    # Each port/sound-card combo keeps its matches in self.choices[combo]: id -> match.

    def _fill_match_combo(self, combo, detected, current, fixed=()):
        """Fill combo with fixed entries, detected devices and (if not plugged in) the saved one."""
        combo.remove_all()
        choices = {}
        for choice_id, label in fixed:
            combo.append(choice_id, label)
            choices[choice_id] = choice_id
        for i, (label, match) in enumerate(detected):
            combo.append(f"d{i}", label)
            choices[f"d{i}"] = match
        selected = next((cid for cid, m in choices.items() if m == current), None)
        if selected is None and isinstance(current, dict):
            # A preset's match (no serial number) still picks the plugged-in device it describes.
            selected = next((cid for cid, m in choices.items()
                             if isinstance(m, dict) and current.items() <= m.items()), None)
        if selected is None and isinstance(current, dict):
            combo.append("saved", f"{describe_match(current)} (not plugged in)")
            choices["saved"] = current
            selected = "saved"
        self.choices[combo] = choices
        combo.set_active_id(selected if selected is not None else (fixed[0][0] if fixed else None))

    def _chosen(self, combo):
        return self.choices.get(combo, {}).get(combo.get_active_id())

    def _fill_radio(self, values):
        """Show a radio setup (saved settings or a preset) in the Radio section."""
        model = values.get("rig_model")
        mfg = next((m for m, models in self.models.items() if any(n == model for n, _ in models)), None)
        self._model_to_select = model
        self.mfg_combo.set_active_id(mfg)
        self._mfg_changed(self.mfg_combo)
        self.baud_combo.set_active_id(str(values.get("cat_baud", 38400)))
        self._fill_match_combo(self.cat_combo, self.serial_ports, values.get("cat_match"))
        self.ptt_combo.set_active_id(values.get("ptt_method", "CAT"))
        self._fill_match_combo(self.ptt_port_combo, self.serial_ports, values.get("ptt_match") or "cat",
                               fixed=[("cat", "Same as CAT port")])
        self._fill_match_combo(self.audio_combo, self.sound_cards, values.get("audio_match") or "",
                               fixed=[("", "Choose later")])
        self._ptt_changed()

    def _fill_settings(self):
        st = self.station
        self._filling = True
        self.callsign_entry.set_text("" if st.get("callsign") == "N0CALL" else st.get("callsign", ""))
        self.grid_entry.set_text(st.get("grid", ""))
        preset_id = next((pid for pid, p in self.presets if p.get("radio_name") == st.get("radio_name")), "")
        self.preset_combo.set_active_id(preset_id)
        self._fill_radio(st)
        self._fill_match_combo(self.gps_combo, self.serial_ports, st.get("gps_match") or "", fixed=GPS_FIXED)
        self._filling = False
        self._settings_filled = (self.station, self._settings_form())
        self.settings_message.set_text("")

    def _rescan_devices(self):
        self.serial_ports, self.sound_cards = detect_devices()
        current = {"cat_match": self._chosen(self.cat_combo), "ptt_match": self._chosen(self.ptt_port_combo),
                   "audio_match": self._chosen(self.audio_combo), "gps_match": self._chosen(self.gps_combo)}
        self._fill_match_combo(self.cat_combo, self.serial_ports, current["cat_match"])
        self._fill_match_combo(self.ptt_port_combo, self.serial_ports, current["ptt_match"],
                               fixed=[("cat", "Same as CAT port")])
        self._fill_match_combo(self.audio_combo, self.sound_cards, current["audio_match"],
                               fixed=[("", "Choose later")])
        self._fill_match_combo(self.gps_combo, self.serial_ports, current["gps_match"], fixed=GPS_FIXED)
        found = len(self.serial_ports) + len(self.sound_cards)
        self._set_message(f"Found {len(self.serial_ports)} serial port(s) and {len(self.sound_cards)} USB sound card(s)."
                          if found else "No USB radio devices found. Plug in the radio and rescan.", found > 0)

    def _preset_changed(self, combo):
        preset = dict(self.presets).get(combo.get_active_id())
        if preset and not self._filling:
            self._fill_radio(preset)

    def _mfg_changed(self, combo):
        self.model_combo.remove_all()
        for number, name in sorted(self.models.get(combo.get_active_id(), []), key=lambda m: m[1].lower()):
            self.model_combo.append(str(number), name)
        want = getattr(self, "_model_to_select", None)
        self.model_combo.set_active_id(str(want) if want else None)
        self._model_to_select = None

    def _model_changed(self, combo):
        # Picking a model by hand means the setup no longer matches a preset.
        preset = dict(self.presets).get(self.preset_combo.get_active_id())
        if preset and combo.get_active_id() and int(combo.get_active_id()) != preset.get("rig_model"):
            self.preset_combo.set_active_id("")

    def _ptt_changed(self):
        self.ptt_port_combo.set_sensitive(self.ptt_combo.get_active_id() in ("RTS", "DTR"))

    def _save_settings(self, *_):
        preset = dict(self.presets).get(self.preset_combo.get_active_id())
        model_id = self.model_combo.get_active_id()
        if preset:
            radio_name = preset["radio_name"]
        else:
            radio_name = f"{self.mfg_combo.get_active_text() or ''} {self.model_combo.get_active_text() or ''}"
            radio_name = re.sub(r"[^A-Za-z0-9 +/()._-]", "", radio_name).strip()[:60]
        new = {
            "callsign": self.callsign_entry.get_text().strip().upper(),
            "grid": self.grid_entry.get_text().strip(),
            "radio_name": radio_name,
            "rig_model": int(model_id) if model_id else None,
            "cat_baud": int(self.baud_combo.get_active_id() or 38400),
            "cat_match": self._chosen(self.cat_combo),
            "ptt_method": self.ptt_combo.get_active_id(),
            "ptt_match": self._chosen(self.ptt_port_combo),
            "audio_match": self._chosen(self.audio_combo) or None,
            "gps_match": self._chosen(self.gps_combo) or None,
        }
        self._set_message("Saving…", None)

        def work():
            with tempfile.NamedTemporaryFile("w", suffix=".json", delete=False) as f:
                json.dump(new, f)
                path = f.name
            try:
                result = subprocess.run(APPLY_CMD + [path], stdout=subprocess.PIPE,
                                        stderr=subprocess.STDOUT, text=True, timeout=60)
                ok, text = result.returncode == 0, result.stdout.strip()
            except (OSError, subprocess.TimeoutExpired) as exc:
                ok, text = False, f"Settings not saved: {exc}"
            finally:
                os.unlink(path)
            GLib.idle_add(self._saved, ok, text)

        threading.Thread(target=work, daemon=True).start()

    def _saved(self, ok, text):
        self._set_message(text, ok)
        if ok:
            self.station = load_station()
            self._show_station()
            self.callsign_entry.set_text(self.station.get("callsign", ""))
            self.grid_entry.set_text(self.station.get("grid", ""))
        return False

    def _backup_dialog(self, *_):
        """Back up to a USB stick, or restore from a backup on one."""
        dialog = Gtk.Dialog(title="Backup", transient_for=self, modal=True)
        dialog.set_default_size(820, 420)
        dialog.add_buttons("Close", Gtk.ResponseType.CLOSE)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12, margin=16)
        dialog.get_content_area().pack_start(box, True, True, 0)
        top = Gtk.Box(spacing=12)
        sticks = Gtk.ComboBoxText()
        top.pack_start(sticks, True, True, 0)
        look = self._navbtn("Look again", lambda *_: find())
        back_up = self._navbtn("Back up now", lambda *_: run(["create", sticks.get_active_id()]), "primary")
        top.pack_start(look, False, False, 0)
        top.pack_start(back_up, False, False, 0)
        box.pack_start(top, False, False, 0)
        message = Gtk.Label(xalign=0, wrap=True)
        box.pack_start(message, False, False, 0)
        listbox = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE)
        scroller = Gtk.ScrolledWindow(vexpand=True)
        scroller.add(listbox)
        box.pack_start(scroller, True, True, 0)
        hint = Gtk.Label(xalign=0, wrap=True, label=(
            "A backup holds the station settings, contact notes, nets, ICS forms, My frequencies, tile pictures, "
            "Winlink mail and the apps' settings and logs. Passwords and keys aren't included, so enter them "
            "again after a restore (Accounts on the Online page, and Pat's Winlink password)."))
        hint.set_max_width_chars(100)
        hint.get_style_context().add_class("muted")
        box.pack_start(hint, False, False, 0)

        def say(text, ok=None):
            ctx = message.get_style_context()
            for name in ("ok", "error"):
                ctx.remove_class(name)
            if ok is not None:
                ctx.add_class("ok" if ok else "error")
            message.set_text(text)

        def find():
            mount_usb_sticks()
            sticks.remove_all()
            user = os.environ.get("USER", "")
            for path in glob.glob(f"/media/{user}/*") + glob.glob(f"/run/media/{user}/*"):
                if os.access(path, os.W_OK):
                    sticks.append(path, f"USB stick: {os.path.basename(path)}")
            sticks.set_active(0)
            found = sticks.get_active_id() is not None
            back_up.set_sensitive(found)
            sticks.set_sensitive(found)
            if not found:
                say("Plug in a USB stick, then tap Look again.")
            else:
                say("")
            list_backups()

        def list_backups(*_):
            for child in listbox.get_children():
                listbox.remove(child)
            stick = sticks.get_active_id()
            paths = []
            if stick:
                result = subprocess.run([BACKUP_CMD, "list", stick], capture_output=True, text=True, check=False)
                paths = result.stdout.split("\n")[:8] if result.returncode == 0 else []
            for path in filter(None, paths):
                stamp = re.search(r"(\d{8})-(\d{4})Z", path)
                when = (f"{stamp[1][:4]}-{stamp[1][4:6]}-{stamp[1][6:]} {stamp[2]}Z" if stamp else "")
                size = os.path.getsize(path) if os.path.exists(path) else 0
                size = f"{size / 1e6:.1f} MB" if size >= 1e6 else f"{size // 1000 + 1} kB" if size else ""
                listbox.add(self._info_row("Backup", when, " · ".join(filter(None, [os.path.basename(path), size])),
                                           [("Restore", lambda *_, p=path: confirm_restore(p))]))
            listbox.show_all()

        def run(args):
            say("Backing up…" if args[0] == "create" else "Restoring…")
            for widget in (back_up, look):
                widget.set_sensitive(False)

            def work():
                try:
                    result = subprocess.run([BACKUP_CMD] + args, capture_output=True, text=True, timeout=600,
                                            check=False)
                    ok, out = result.returncode == 0, (result.stdout or result.stderr).strip()
                except (OSError, subprocess.TimeoutExpired) as exc:
                    ok, out = False, str(exc)
                if ok and args[0] == "create":
                    subprocess.run(["sync"], check=False)
                    out = f"Backed up to {os.path.basename(out)}. You can unplug the stick."
                GLib.idle_add(done, ok, out, args[0])

            threading.Thread(target=work, daemon=True).start()

        def done(ok, out, action):
            say(out, ok)
            for widget in (back_up, look):
                widget.set_sensitive(True)
            list_backups()
            if action == "restore":
                self._saved(ok, out)
                self._apply_theme(load_theme())
                self._refresh_tiles()
            return False

        def confirm_restore(path):
            ask = Gtk.MessageDialog(transient_for=dialog, modal=True, message_type=Gtk.MessageType.QUESTION,
                                    text="Restore this backup?",
                                    secondary_text=f"{os.path.basename(path)}\n\nThe station's settings, logs "
                                                   "and app settings are replaced by the ones in the backup.")
            ask.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Restore", Gtk.ResponseType.OK)
            response = ask.run()
            ask.destroy()
            if response == Gtk.ResponseType.OK:
                run(["restore", path])

        sticks.connect("changed", list_backups)
        dialog.show_all()
        find()
        dialog.run()
        dialog.destroy()

    def _set_message(self, text, ok):
