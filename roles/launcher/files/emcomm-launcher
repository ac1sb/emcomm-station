def same_codes(path=SAME_CODES):
    """{state: [(county, 6-digit SAME code)]} from the bundled list, states and counties in order."""
    by_state = {}
    try:
        with open(path, encoding="utf-8", newline="") as f:
            rows = csv.DictReader(line for line in f if not line.startswith("#"))
            for row in rows:
                if re.fullmatch(r"\d{6}", row.get("SAME") or ""):
                    by_state.setdefault(row["State"], []).append((row["County"], row["SAME"]))
    except OSError:
        pass
    return dict(sorted(by_state.items()))


def same_label(code, by_state):
    """'Bennington County, Vermont' for a SAME code, or the code itself if it isn't a whole county."""
    for state, counties in by_state.items():
        for county, same in counties:
            if same == code:
                return f"{county}, {state}"
    if re.fullmatch(r"[1-9]\d{5}", code):  # first digit: a part of a county
        whole = same_label("0" + code[1:], by_state)
        if whole != "0" + code[1:]:
            return f"Part of {whole}"
    return code


def county_names(codes, by_state=None):
    """'Bennington, Rutland and part of Bennington' for a list of SAME codes."""
    by_state = same_codes() if by_state is None else by_state
    names = [re.sub(r" County, .*| Parish, .*|, .*", "", same_label(c, by_state)).replace("Part of", "part of")
             for c in codes]
    return ", ".join(names[:-1]) + " and " + names[-1] if len(names) > 1 else "".join(names)


