    def _set_text_scale(self, scale):
        self.text_scale = scale
        # Text the launcher doesn't size itself (pt sizes) follows the font DPI.
        Gtk.Settings.get_default().set_property("gtk-xft-dpi", round(96 * scale * 1024))
        self._apply_theme(self.theme)
        self.home_bar.place()

    # ---- display -------------------------------------------------------

    def _display_dialog(self, *_):
        """Colours, resolution, text size and rotation. A change to the screen goes
        back by itself unless kept, in case the screen can't show it."""
        try:
            result = subprocess.run([DISPLAY_CMD, "show"], capture_output=True, text=True, timeout=20, check=False)
            info = json.loads(result.stdout)
        except (OSError, ValueError, subprocess.TimeoutExpired):
            info = {}
        outputs = info.get("outputs") or []
        old = info.get("config") or {"mode": "auto", "rotate": "normal", "text_scale": self.text_scale}
        output = outputs[0] if outputs else None

        dialog = Gtk.Dialog(title="Display", transient_for=self, modal=True)
        dialog.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Apply", Gtk.ResponseType.OK)
        dialog.set_default_response(Gtk.ResponseType.OK)
        box = dialog.get_content_area()
        box.set_spacing(10)
        box.set_border_width(16)
        grid = Gtk.Grid(column_spacing=16, row_spacing=10)
        box.pack_start(grid, False, False, 0)

        def combo(row, label, choices, current):
            widget = Gtk.ComboBoxText()
            for value, text in choices:
                widget.append(value, text)
            widget.set_active_id(current if current in [v for v, _ in choices] else choices[0][0])
            name = Gtk.Label(label=label, xalign=0)
            name.get_style_context().add_class("field-label")
            grid.attach(name, 0, row, 1, 1)
            grid.attach(widget, 1, row, 1, 1)
            return widget

        theme = combo(0, "Colours", [("dark", "Dark (for night)"), ("light", "Light (easier in daylight)")], self.theme)
        modes = [("auto", "Automatic" + (f" ({output['preferred']})" if output and output["preferred"] else ""))]
        modes += [(m, m.replace("x", " × ")) for m in (output["modes"] if output else [])]
        mode = combo(1, "Resolution", modes, old["mode"])
        size = combo(2, "Text size", [(str(v), t) for v, t in TEXT_SIZES], str(old["text_scale"]))
        rotate = combo(3, "Rotation", ROTATIONS, old["rotate"])
        if output:
            where = f"{output['name']} screen, now {(output['current'] or 'off').replace('x', ' × ')}."
            if len(outputs) > 1:
                where += f" Other screens ({', '.join(o['name'] for o in outputs[1:])}) are left as they are."
        else:
            where = "Couldn't read the screen, so only colours and text size can change."
            mode.set_sensitive(False)
            rotate.set_sensitive(False)
        note = Gtk.Label(label=where + " A touchscreen turns with the screen. Large text needs a screen bigger "
                         "than 1024 × 600.", xalign=0, wrap=True, max_width_chars=50)
        note.get_style_context().add_class("muted")
        box.pack_start(note, False, False, 0)
        dialog.show_all()
        response = dialog.run()
        new = {"mode": mode.get_active_id(), "rotate": rotate.get_active_id(),
               "text_scale": float(size.get_active_id())}
        new_theme = theme.get_active_id()
        dialog.destroy()
        if response != Gtk.ResponseType.OK:
            return
        if new_theme != self.theme:
            self._set_theme(new_theme)
        if new == old:
            return
        error = self._apply_display(new)
        if error:
            self._apply_display(old)
            self._message(f"The screen didn't change: {error}")
            return
        # Anything that might leave the screen unreadable goes back by itself unless kept.
        if not self._keep_display():
            self._apply_display(old)

    def _apply_display(self, config):
        """Save the display settings and set the screen. Returns an error message, or None."""
        try:
            os.makedirs(os.path.dirname(DISPLAY_PATH), exist_ok=True)
            with open(DISPLAY_PATH + ".tmp", "w", encoding="utf-8") as f:
                json.dump(config, f)
            os.replace(DISPLAY_PATH + ".tmp", DISPLAY_PATH)
            result = subprocess.run([DISPLAY_CMD, "apply"], capture_output=True, text=True, timeout=30, check=False)
        except (OSError, subprocess.TimeoutExpired) as exc:
            return str(exc)
        self._set_text_scale(config["text_scale"])
        if result.returncode != 0:
            return result.stderr.strip() or "it didn't work"
        return None

    def _keep_display(self, seconds=15):
        dialog = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.QUESTION,
                                   text="Keep these display settings?")
        dialog.add_buttons("Go back", Gtk.ResponseType.CANCEL, "Keep", Gtk.ResponseType.OK)
        left = [seconds]

        def tick():
            if left[0] is None:
                return False
            left[0] -= 1
            if left[0] <= 0:
                dialog.response(Gtk.ResponseType.CANCEL)
                return False
            dialog.format_secondary_text(f"Going back to the old settings in {left[0]} seconds.")
            return True

        dialog.format_secondary_text(f"Going back to the old settings in {seconds} seconds.")
        GLib.timeout_add_seconds(1, tick)
        response = dialog.run()
        left[0] = None
        dialog.destroy()
        return response == Gtk.ResponseType.OK

    def _set_tile_icon(self, btn):
        for child in btn.icon_slot.get_children():
            btn.icon_slot.remove(child)
        path = find_icon(btn.app.get("icon", ""))
        widget = None
        if path:
            try:
                widget = Gtk.Image.new_from_pixbuf(load_icon(path, self.colours["accent"]))
            except (GLib.Error, OSError):
                widget = None
        if widget is None:
            # No icon, or it can't be read: show the short code instead.
            widget = Gtk.Label(label=btn.app.get("code", ""))
            widget.get_style_context().add_class("tile-code")
        widget.set_halign(Gtk.Align.START)
        btn.icon_slot.pack_start(widget, False, False, 0)
        btn.icon_slot.show_all()

    @staticmethod
    def _tile_long_pressed(btn, gesture):
        # Claim the press, so lifting the finger doesn't also tap the tile.
        gesture.set_state(Gtk.EventSequenceState.CLAIMED)
        btn.long_pressed = True

    def _tile_long_press_end(self, btn):
        if btn.long_pressed:
            btn.long_pressed = False
            GLib.idle_add(lambda: self._icon_menu(btn) and False)

    def _icon_menu(self, btn):
        if not btn.app.get("icon"):
            return
        menu = Gtk.Menu()
        change = Gtk.MenuItem(label=f"Change {btn.app['name']} icon…")
        change.connect("activate", lambda *_: self._choose_icon(btn))
        menu.append(change)
        if user_icon(btn.app["icon"]):
            reset = Gtk.MenuItem(label="Use the standard icon")
            reset.connect("activate", lambda *_: self._reset_icon(btn))
            menu.append(reset)
        menu.show_all()
        menu.attach_to_widget(btn)
        menu.popup_at_widget(btn, Gdk.Gravity.CENTER, Gdk.Gravity.NORTH_WEST, None)

    def _choose_icon(self, btn):
        mount_usb_sticks()
        dialog = Gtk.FileChooserDialog(title=f"Pick an image for {btn.app['name']}", transient_for=self,
                                       action=Gtk.FileChooserAction.OPEN)
        dialog.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Use this image", Gtk.ResponseType.OK)
        images = Gtk.FileFilter()
        images.set_name("Images (SVG, PNG, JPG)")
        for pattern in ("*.svg", "*.png", "*.jpg", "*.jpeg", "*.SVG", "*.PNG", "*.JPG", "*.JPEG"):
            images.add_pattern(pattern)
        dialog.add_filter(images)
        for folder in [os.path.expanduser("~/Downloads")] + glob.glob(f"/media/{os.environ.get('USER', '')}/*"):
            if os.path.isdir(folder):
                dialog.add_shortcut_folder(folder)
        dialog.set_size_request(800, 500)
        response = dialog.run()
        path = dialog.get_filename()
        dialog.destroy()
        if response != Gtk.ResponseType.OK or not path:
            return
        try:
            GdkPixbuf.Pixbuf.new_from_file_at_scale(path, ICON_SIZE, ICON_SIZE, True)
        except GLib.Error:
            self._message("That file isn't an image the station can show.")
            return
        remove_user_icon(btn.app["icon"])
        os.makedirs(USER_ICONS, exist_ok=True)
        ext = os.path.splitext(path)[1].lower().replace(".jpeg", ".jpg")
        shutil.copyfile(path, os.path.join(USER_ICONS, btn.app["icon"] + ext))
        self._set_tile_icon(btn)

    def _reset_icon(self, btn):
        remove_user_icon(btn.app["icon"])
        self._set_tile_icon(btn)

    def _message(self, text):
        dialog = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.INFO,
                                   buttons=Gtk.ButtonsType.OK, text=text)
        dialog.run()
        dialog.destroy()

    @staticmethod
    def _app_state(app):
        """'ready', 'setup' (installed, needs first-time setup) or 'missing'."""
        if shutil.which(app.get("command", "")) is None:
            return "missing"
        ready = app.get("ready")
        if ready and not os.path.exists(os.path.expanduser(ready)):
            return "setup"
        return "ready"

    def _update_tile(self, btn):
        btn.app_state = self._app_state(btn.app)
        installable = bool(btn.app.get("app"))
        btn.detail.set_text({"ready": btn.app.get("detail", ""),
                             "setup": "Tap to set up",
                             "missing": "Tap to install" if installable else "Not installed",
                             }[btn.app_state])
        btn.set_sensitive(btn.app_state != "missing" or installable)
        ctx = btn.get_style_context()
        if btn.app_state == "ready":
            ctx.remove_class("not-ready")
        else:
            ctx.add_class("not-ready")

    def _refresh_tiles(self):
        for btn in self.tiles:
            self._update_tile(btn)

    def _tile_clicked(self, btn):
        app = btn.app
        if btn.app_state != "missing":
            run_detached(app.get("run") or [app["command"]])
            return
        if self._confirm(f"Install {app['name']}?",
                         "It's downloaded from the internet, which takes a few minutes."):
            self._run_in_terminal(f"Installing {app['name']}", UPDATE_CMD + ["--app", app["app"]],
                                  self._refresh_tiles)

    def _confirm(self, text, secondary):
        dialog = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.QUESTION,
                                   buttons=Gtk.ButtonsType.OK_CANCEL, text=text)
        dialog.format_secondary_text(secondary)
        response = dialog.run()
        dialog.destroy()
        return response == Gtk.ResponseType.OK

    def _run_in_terminal(self, title, argv, on_done=None):
        """Show argv's progress in a terminal window; call on_done once it's closed."""
        script = '"$@"; echo; read -r -p "Press Enter to close. " _'
        proc = subprocess.Popen(["xterm", "-fa", "IBM Plex Mono", "-fs", "12", "-geometry", "110x30",
                                 "-T", title, "-e", "bash", "-c", script, "emcomm"] + argv,
                                start_new_session=True)
        if on_done:
            GLib.child_watch_add(GLib.PRIORITY_DEFAULT, proc.pid, lambda *_: on_done())

    def _update_station(self, *_):
        if self._confirm("Update the station?",
                         "Downloads the latest Emcomm-CNC and installs any missing apps. Settings are kept. "
                         "The home screen restarts when it's done."):
            # The kiosk's autostart loop starts the new launcher after this one quits.
            self._run_in_terminal("Updating the station", UPDATE_CMD, Gtk.main_quit)

    def _navbtn(self, label, handler, extra_class=None):
        btn = Gtk.Button(label=label)
        btn.get_style_context().add_class("navbtn")
        if extra_class:
            btn.get_style_context().add_class(extra_class)
        btn.connect("clicked", handler)
        return btn

    def _power_dialog(self, *_):
        dialog = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.QUESTION,
                                   text="Shut down the station?")
        dialog.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Restart", 1, "Shut down", 2)
        response = dialog.run()
        dialog.destroy()
        if response == 1:
            run_detached(["systemctl", "reboot"])
        elif response == 2:
            run_detached(["systemctl", "poweroff"])

