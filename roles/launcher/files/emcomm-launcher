    def _recorder_tick(self, page):
        """While the page shows: the level meter twice a second, the list when it changes."""
        if not page.get_mapped():
            return False
        status = recorder_status()
        running = status is not None
        self.rec_stop.set_sensitive(running)
        self.rec_voice.set_sensitive(not running)
        self.rec_all.set_sensitive(not running)
        level = (status or {}).get("level")
        self.rec_level.set_value(max(0, 60 + level) if isinstance(level, (int, float)) else 0)
        last = None if status else read_json(RECORDER_STATUS, None)
        if status and status.get("error"):
            text = status["error"]
        elif isinstance(last, dict) and last.get("error"):
            text = last["error"]  # the recorder stopped with an error
        elif status and status.get("recording"):
            text = f"Recording {status.get('file') or ''}"
        elif status:
            text = "Listening for a signal…" if status.get("mode") == "voice" else "Recording everything"
        else:
            text = "Stopped"
        if not getattr(self, "rec_message_until", 0) > time.time():
            self.rec_page_status.set_text(text)
        found = recordings()
        stamp = [(p, s) for p, s, _l in found[:50]]
        if stamp != self.rec_listed:
            self.rec_listed = stamp
            self._recorder_fill(found)
        if not getattr(self, "rec_ticking", False):
            self.rec_ticking = True

            def tick():
                alive = self._recorder_tick(page)
                if not alive:
                    self.rec_ticking = False
                return alive

            GLib.timeout_add(500, tick)
        return True

    def _recorder_fill(self, found):
        for child in self.rec_list.get_children():
            self.rec_list.remove(child)
        if not found:
            self.rec_list.add(self._info_row("", "No recordings yet", "Tap a Record button to start."))
        for path, size, seconds in found[:50]:
            day = os.path.basename(os.path.dirname(path))
            name = os.path.splitext(os.path.basename(path))[0]
            when, _, rest = name.partition(" ")
            length = f"{int(seconds // 60)}:{int(seconds % 60):02d}"
            mb = f"{size / 1e6:.1f} MB" if size >= 1e6 else f"{size // 1000 + 1} kB"
            detail = " · ".join(filter(None, [rest.replace(" ", " MHz ", 1) if rest else "", length, mb]))
            clock = f"{when[:2]}:{when[2:4]}:{when[4:6]}" if len(when) >= 6 else when
            self.rec_list.add(self._info_row(clock, day, detail,
                                             [("Play", lambda *_, p=path: self._recorder_play(p)),
                                              ("Delete", lambda *_, p=path: self._recorder_delete(p))]))
        self.rec_list.show_all()

    def _recorder_message(self, text):
        self.rec_page_status.set_text(text)
        self.rec_message_until = time.time() + 6

    def _recorder_start(self, everything):
        if not shutil.which(RECORDER_CMD):
            self._recorder_message("The recorder isn't installed; tap Update station in Settings.")
            return
        try:
            os.remove(RECORDER_STATUS)  # a previous run's error
        except OSError:
            pass
        run_detached([RECORDER_CMD, "run"] + (["--all"] if everything else []))
        self._recorder_message("Starting…")

    def _recorder_stop(self):
        status = recorder_status()
        if status:
            try:
                os.kill(int(status["pid"]), signal.SIGTERM)
            except OSError:
                pass
        self._recorder_message("Stopped. The last recording is saved.")

    def _recorder_play(self, path):
        self._recorder_message(f"Playing {os.path.basename(path)}…")

        def work():
            result = subprocess.run([RECORDER_CMD, "play", path], capture_output=True, text=True, check=False)
            if result.returncode != 0 and result.stderr.strip():
                GLib.idle_add(self._recorder_message, result.stderr.strip().splitlines()[-1])

        threading.Thread(target=work, daemon=True).start()

    def _recorder_delete(self, path):
        dialog = Gtk.MessageDialog(transient_for=self, modal=True, message_type=Gtk.MessageType.QUESTION,
                                   text="Delete this recording?", secondary_text=os.path.basename(path))
        dialog.add_buttons("Keep it", Gtk.ResponseType.CANCEL, "Delete", Gtk.ResponseType.OK)
        response = dialog.run()
        dialog.destroy()
        if response == Gtk.ResponseType.OK:
            try:
                os.remove(path)
            except OSError as exc:
                self._recorder_message(f"Couldn't delete it: {exc}")

