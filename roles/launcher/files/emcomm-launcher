        add_other = self._navbtn("Add code", lambda *_: None)
        add_row.pack_start(add, False, False, 0)
        add_row.pack_end(add_other, False, False, 0)
        add_row.pack_end(other, False, False, 0)
        box.pack_start(add_row, False, False, 0)
        heading = Gtk.Label(xalign=0)
        heading.get_style_context().add_class("section-title")
        box.pack_start(heading, False, False, 0)
        chosen_box = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE, max_children_per_line=3,
                                 column_spacing=8, row_spacing=8, homogeneous=False)
        chosen_scroll = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER, min_content_height=96,
                                           max_content_height=96)
        chosen_scroll.add(chosen_box)
        box.pack_start(chosen_scroll, False, False, 0)
        message = Gtk.Label(xalign=0)
        message.get_style_context().add_class("error")

        def show_chosen():
            for child in chosen_box.get_children():
                chosen_box.remove(child)
            heading.set_text("YOUR COUNTIES" if chosen else "YOUR COUNTIES: NONE, SO EVERY ALERT HEARD IS KEPT")
            for code in chosen:
                chip = Gtk.Box(spacing=6)
                chip.pack_start(Gtk.Label(label=f"{same_label(code, by_state)}  {code}"), False, False, 0)
                remove = Gtk.Button(label="✕")
                remove.get_style_context().add_class("chip-x")
                remove.connect("clicked", lambda _b, c=code: (chosen.remove(c), show_chosen()))
                chip.pack_start(remove, False, False, 0)
                chosen_box.add(chip)
            chosen_box.show_all()

        def fill_counties(*_):
            county.remove_all()
            for name, code in by_state.get(state.get_active_id() or "", []):
                county.append(code, name)
            county.set_active(0 if by_state.get(state.get_active_id() or "") else -1)

        def add_code(code):
            message.set_text("")
            if code and code not in chosen:
                chosen.append(code)
                show_chosen()

        def add_typed(*_):
            code = other.get_text().strip()
            if not re.fullmatch(r"\d{6}", code):
                message.set_text("A SAME code is 6 digits, such as 050003.")
                return
            other.set_text("")
            add_code(code)

        state.connect("changed", fill_counties)
        add.connect("clicked", lambda *_: add_code(county.get_active_id()))
