    def _add_note(self, *_):
        call, note = self.note_call.get_text().strip(), self.note_text.get_text().strip()
        if not (call or note):
            return
        freq = format_freq(rigctld_query(*RIGCTLD, "f"))
        mode = rigctld_query(*RIGCTLD, "m")
        os.makedirs(os.path.dirname(NOTES_PATH), exist_ok=True)
        with open(NOTES_PATH, "a", encoding="utf-8") as f:
            f.write(note_line(call, note, freq, mode))
        self.note_call.set_text("")
        self.note_text.set_text("")
        self.log_combo.set_active_id("notes")
        self._show_log()

