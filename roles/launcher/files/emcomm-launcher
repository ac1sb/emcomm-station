def tune_split(mhz, offset_mhz, tone):
    """Tune an FM repeater: output frequency, FM, transmit offset and CTCSS tone.
    Returns None if the radio didn't take the frequency, else what it didn't take."""
    if not tune_radio(mhz, "FM"):
        return None
    missed = []
    if offset_mhz is not None:
        offset = round(offset_mhz * 1_000_000)
        shift = "+" if offset > 0 else "-" if offset < 0 else "0"
        took = rigctld_query(*RIGCTLD, f"R {shift}") == "RPRT 0"
        if took and offset:
            took = rigctld_query(*RIGCTLD, f"O {abs(offset)}") == "RPRT 0"
        if not took:
            missed.append("offset")
    if tone:
        if rigctld_query(*RIGCTLD, f"C {round(tone * 10)}") == "RPRT 0":
            rigctld_query(*RIGCTLD, "U TONE 1")
        else:
            missed.append("tone")
    return missed
