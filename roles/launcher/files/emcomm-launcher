    def _run_ics(self, args, title, status=None):
        """Fill in the form with emcomm-ics and show it, with a Print button. What happened
        goes on `status` (the Net control page's line unless another is given)."""
        status = status or self.ncs_status
        try:
            result = subprocess.run([ICS_CMD] + args, capture_output=True, text=True, timeout=30, check=False)
        except (OSError, subprocess.TimeoutExpired) as exc:
            status.set_text(f"Couldn't fill in the form: {exc}")
            return
        if result.returncode != 0:
            status.set_text(result.stderr.strip().splitlines()[-1] if result.stderr.strip()
                            else "Couldn't fill in the form.")
            return
        path = result.stdout.strip().splitlines()[-1]
        status.set_text(f"Saved to {path.replace(os.path.expanduser('~'), '~')}")
        self.forms_listed = None  # it joins the Forms list
        if shutil.which("emcomm-webview"):
            run_detached(["emcomm-webview", "--print", GLib.filename_to_uri(path, None), title])

