    def _show_reference(self):
        path = self.ref_combo.get_active_id()
        if not path:
            return
        self.ref_status.set_text("")
        gateways = path == GATEWAYS
        self.ref_gw_mode.set_visible(gateways)
        self.ref_gw_update.set_visible(gateways)
        self.ref_add.set_visible(not gateways)
        if gateways:
            self._show_gateways()
            return
        if path.endswith(".txt"):
            try:
                with open(path, encoding="utf-8") as f:
                    text = f.read()
            except OSError:
                text = ""
            self.ref_text.get_buffer().set_text(text)
            self.ref_stack.set_visible_child_name("text")
            return
        rows = read_freqs(path)
        mine = path == MY_FREQS
        if not rows:
            self.ref_status.set_text("Nothing here yet. Tune the radio and tap Add frequency." if mine else "")
        self._fill_ref_list(rows, my_index=mine)

    def _fill_ref_list(self, rows, my_index=False):
        for child in self.ref_list.get_children():
            self.ref_list.remove(child)
        for index, row in enumerate(rows):
            self.ref_list.add(self._freq_row(row, index if my_index else None))
        self.ref_list.show_all()
        self.ref_stack.set_visible_child_name("list")

    def _show_gateways(self):
        rows = nearest_gateways(self.station.get("grid", ""), self.ref_gw_mode.get_active_id() or "all")
        if rows is None:
            self._fill_ref_list([])
            if shutil.which("pat"):
                # Pat writes its list the first time it's asked (from its built-in copy when offline).
                self._update_gateway_list(force=False)
            else:
                self.ref_status.set_text("Install Winlink mail (Pat) from its tile to get the gateway list.")
            return
        self._fill_ref_list(rows)
        try:
            updated = time.strftime("%Y-%m-%d", time.localtime(os.path.getmtime(RMSLIST)))
        except OSError:
            updated = "?"
        self.ref_status.set_text(f"Nearest to {self.station.get('grid', '?')} · list from {updated}")

    def _update_gateway_list(self, *_, force=True):
        if not shutil.which("pat"):
            self.ref_status.set_text("Install Winlink mail (Pat) from its tile to get the gateway list.")
            return
        self.ref_status.set_text("Getting the gateway list…")
        self.ref_gw_update.set_sensitive(False)

        def work():
            args = ["pat", "rmslist"] + (["--force-download"] if force else [])
            try:
                result = subprocess.run(args, capture_output=True, text=True, timeout=60)
                ok = result.returncode == 0
            except (OSError, subprocess.TimeoutExpired):
                ok = False
            GLib.idle_add(self._gateway_list_done, ok)

        threading.Thread(target=work, daemon=True).start()

    def _gateway_list_done(self, ok):
        self.ref_gw_update.set_sensitive(True)
        if self.ref_combo.get_active_id() == GATEWAYS:
            self._show_gateways()
            if not ok:
                self.ref_status.set_text("Couldn't download a new gateway list; the station needs internet for that.")
        return False

