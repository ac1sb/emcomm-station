    scale = saved.get("text_scale") if isinstance(saved, dict) else None
    return scale if scale in [s for s, _ in TEXT_SIZES] else 1.0


def scaled_css(colours, scale=1.0):
    """The launcher's CSS in these colours, with text and button heights scaled for
    the Text size setting."""
    css = CSS.substitute(colours)
    if scale != 1.0:
        css = re.sub(r"(font-size|min-height): (\d+)px",
                     lambda m: f"{m.group(1)}: {round(int(m.group(2)) * scale)}px", css)
    return css


