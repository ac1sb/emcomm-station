def esc(value):
    return html.escape(str(value if value is not None else ""))


def utc(seconds, fmt="%Y-%m-%d %H:%MZ"):
    return time.strftime(fmt, time.gmtime(seconds)) if seconds else ""


def chunks(rows, size):
    return [rows[i:i + size] for i in range(0, len(rows), size)] or [[]]


def document(title, pages):
    return (f"<!doctype html><html><head><meta charset='utf-8'><title>{esc(title)}</title>"
            f"<style>{CSS}</style></head><body>{''.join(pages)}</body></html>\n")


def field(label, value, colspan=1):
    return f"<td colspan='{colspan}'><span class='label'>{esc(label)}</span>{esc(value)}</td>"


def ics309(net):
    """The ICS 309 Communications Log for one net, as an HTML page."""
    operator = " ".join(filter(None, [net.get("operator", ""), net.get("callsign", "")]))
    period = f"From {utc(net.get('started'))} to {utc(net.get('closed')) or 'open'}"
    entries = sorted(net.get("entries", []), key=lambda e: e.get("time", 0))
    pages = chunks(entries, ROWS_309)
    out = []
    for number, rows in enumerate(pages, 1):
        body = "".join(
            f"<tr><td>{esc(utc(e.get('time'), '%m/%d %H%M'))}</td><td>{esc(e.get('from', ''))}</td>"
            f"<td>{esc(e.get('from_msg', ''))}</td><td>{esc(e.get('to', ''))}</td>"
            f"<td>{esc(e.get('to_msg', ''))}</td><td>{esc(e.get('message', ''))}</td></tr>"
            for e in rows)
        body += "<tr><td></td><td></td><td></td><td></td><td></td><td></td></tr>" * (ROWS_309 - len(rows))
        out.append(
            "<div class='page'><table>"
            "<tr class='title'><td colspan='6'>COMMUNICATIONS LOG (ICS 309)</td></tr>"
            f"<tr>{field('1. Incident Name', net.get('incident', ''), 2)}"
            f"{field('2. Operational Period (Date/Time)', period, 4)}</tr>"
            f"<tr>{field('3. Radio Net Name or Position/Tactical Call', net.get('name', ''), 2)}"
            f"{field('4. Radio Operator (Name, Call Sign)', operator, 4)}</tr>"
            "<tr><th colspan='6'>5. Communications Log</th></tr>"
            "<tr><th rowspan='2' style='width:9%'>Date/Time</th><th colspan='2'>From</th>"
            "<th colspan='2'>To</th><th rowspan='2'>Message</th></tr>"
            "<tr><th style='width:11%'>Call Sign/ID</th><th style='width:6%'>Msg #</th>"
            "<th style='width:11%'>Call Sign/ID</th><th style='width:6%'>Msg #</th></tr>"
            f"<tbody class='log'>{body}</tbody>"
            f"<tr class='foot'>{field('6. Prepared By (Name, Call Sign)', operator, 3)}"
            f"{field('Date/Time Prepared', utc(time.time()), 2)}"
            f"<td>ICS 309 &nbsp; Page {number} of {len(pages)}</td></tr>"
            "</table></div>")
    return document(f"ICS 309 {net.get('name', '')}", out)


def read_freqs(path):
    try:
        with open(path, encoding="utf-8", newline="") as f:
            return list(csv.DictReader(f))
    except OSError:
        return []


def number(text):
    try:
        return float(str(text).strip().replace("+", ""))
    except (TypeError, ValueError):
        return None


def channel(row):
    """One row of the ICS 205 table from a My frequencies row, or None if it has no frequency."""
    rx = number(row.get("MHz"))
    if rx is None:
        return None
    offset, tone = number(row.get("Offset")), number(row.get("Tone"))
    mode = (row.get("Mode") or "").strip().upper()
    tx = rx + offset if offset else rx
    wide = "W" if mode in ("FM", "PKTFM") else "N" if mode in ("NFM",) else ""
    return {"name": (row.get("Name") or "").strip(), "assignment": (row.get("Note") or "").strip(),
            "rx": f"{rx:.4f}", "tx": f"{tx:.4f}", "wide": wide, "tone": f"{tone:g}" if tone else "",
            "mode": mode}


def ics205(rows, incident="", prepared_by="", now=None):
    """The ICS 205 Incident Radio Communications Plan for a list of frequencies, as an HTML page."""
    now = now or time.time()
    channels = [c for c in map(channel, rows) if c]
    pages = chunks(channels, ROWS_205)
    out = []
    count = 0
    for number_, chans in enumerate(pages, 1):
        body = ""
        for c in chans:
            count += 1
            body += (f"<tr><td>{count}</td><td></td><td>{esc(c['name'])}</td><td>{esc(c['assignment'])}</td>"
                     f"<td>{c['rx']}</td><td>{c['wide']}</td><td>{esc(c['tone'])}</td>"
                     f"<td>{c['tx']}</td><td>{c['wide']}</td><td>{esc(c['tone'])}</td>"
                     f"<td>A</td><td>{esc(c['mode'])}</td></tr>")
        body += ("<tr>" + "<td></td>" * 12 + "</tr>") * (ROWS_205 - len(chans))
        out.append(
            "<div class='page'><table>"
            "<tr class='title'><td colspan='12'>INCIDENT RADIO COMMUNICATIONS PLAN (ICS 205)</td></tr>"
            f"<tr>{field('1. Incident Name', incident, 4)}"
            f"{field('2. Date/Time Prepared', utc(now), 4)}"
            f"{field('3. Operational Period', '', 4)}</tr>"
            "<tr><th colspan='12'>4. Basic Radio Channel Use</th></tr>"
            "<tr><th>Ch #</th><th>Function</th><th>Channel Name/ Trunked Radio System Talkgroup</th>"
            "<th>Assignment</th><th>RX Freq (MHz)</th><th>N or W</th><th>RX Tone/ NAC</th>"
            "<th>TX Freq (MHz)</th><th>N or W</th><th>TX Tone/ NAC</th><th>Mode (A, D, or M)</th>"
            "<th>Remarks</th></tr>"
            f"<tbody class='log'>{body}</tbody>"
            f"<tr>{field('5. Special Instructions', '', 12)}</tr>"
            f"<tr class='foot'>{field('6. Prepared By (Communications Unit Leader)', prepared_by, 6)}"
            f"{field('Date/Time', utc(now), 4)}<td colspan='2'>ICS 205 &nbsp; Page {number_} of {len(pages)}</td></tr>"
            "</table></div>")
    return document(f"ICS 205 {incident}", out)


# flmsg's ICS-213 fields (src/ics/ics213.cxx) and the FEMA form fields they fill.
FIELD_RE = re.compile(rb"\s*:(\w+):(\d+) ")
FIELDS_213 = {
    "1 Incident Name Optional": ("inc",),
    "2 To Name and Position": ("to", "p1"),
    "3 From Name and Position": ("fm", "p2"),
    "4 Subject": ("sb",),
    "5 Date": ("d1",),
    "6 Time": ("t1",),
    "7 Message": ("mg",),
    "8 Approved by Name": ("s1",),
    "PositionTitle_13": ("p3",),
    "9 Reply": ("rp",),
    "10 Replied by Name": ("s2",),
    "PositionTitle_14": ("p4",),
    "DateTime_14": ("d2", "t2"),
}
LONG_FIELDS = {"7 Message", "9 Reply"}  # text shrinks to fit these boxes
# The order flmsg writes them in (src/ics/ics213.cxx).
ORDER_213 = ("inc", "to", "p1", "fm", "p2", "d1", "t1", "sb", "s1", "p3", "s2", "p4", "d2", "t2", "mg", "rp")
FLMSG_VERSION = "4.0.23"


def parse_flmsg(data):
    """The fields of an flmsg ICS-213 file (bytes), e.g. {"to": ..., "mg": ...}.
    Each field is written ":key:LENGTH value" with LENGTH in bytes; a file fldigi
    received may still be in its [WRAP:...] envelope."""
    start = data.find(b"<ics213>")
    if data.find(b"<flmsg>") < 0 or start < 0:
        raise ValueError("not an flmsg ICS-213 message")
    fields, pos = {}, start + len(b"<ics213>")
    while True:
        m = FIELD_RE.match(data, pos)
        if not m:
            break
        end = m.end() + int(m.group(2))
        fields[m.group(1).decode()] = data[m.end():end].decode("utf-8", "replace").replace("\r\n", "\n")
        pos = end
    return fields


def write_flmsg(fields, call="", now=None):
    """An flmsg ICS-213 file (bytes) as flmsg itself writes one: each non-empty field
    as ":key:LENGTH value" with LENGTH in bytes, after a header naming who edited it."""
    def line(key, value):
        data = value.encode("utf-8")
        return b":%s:%d " % (key.encode(), len(data)) + data + b"\n" if data else b""
    stamp = time.strftime("%Y%m%d%H%M%S", time.gmtime(now))
    out = b"<flmsg>" + FLMSG_VERSION.encode() + b"\n"
    if call:
        out += line("hdr_ed", f"\n{call} {stamp}")
    out += b"<ics213>\n"
    for key in ORDER_213:
        out += line(key, str(fields.get(key, "")).replace("\r\n", "\n"))
    return out


def form_values(fields):
    """FEMA form field name -> text, from flmsg fields."""
    joiners = {"DateTime_14": " "}
    values = {}
    for name, keys in FIELDS_213.items():
        text = joiners.get(name, ", ").join(fields[k].strip() for k in keys if fields.get(k, "").strip())
        if text:
            values[name] = text
    return values


def font_size(text, width, height, sizes=(10, 9, 8, 7, 6)):
    """The largest font size (points) at which text roughly fits a box of width x height points."""
    for size in sizes:
        per_line = max(1, int(width / (0.5 * size)))  # Helvetica averages about half an em a character
        lines = sum(max(1, math.ceil(len(line) / per_line)) for line in text.split("\n"))
        if lines * size * 1.17 <= height:
            return size
    return sizes[-1]


def ics213_pdf(fields, template, out):
    """Fill FEMA's ICS 213 PDF with flmsg fields and write it to out."""
    from pypdf import PdfReader, PdfWriter
    from pypdf.generic import BooleanObject, NameObject, TextStringObject

    values = form_values(fields)
    writer = PdfWriter(clone_from=PdfReader(template))
    annots = writer.pages[0].get("/Annots")
    for annot in annots.get_object() if annots else []:
        widget = annot.get_object()
        name = widget.get("/T")
        if name not in values:
            continue
        widget[NameObject("/V")] = TextStringObject(values[name])
        widget.pop("/AP", None)  # the viewer draws the text, wrapping long lines
        if name in LONG_FIELDS:
            x1, y1, x2, y2 = (float(v) for v in widget["/Rect"])
            size = font_size(values[name], x2 - x1 - 4, y2 - y1 - 4)
            widget[NameObject("/DA")] = TextStringObject(f"/Helv {size} Tf 0 g")
    writer._root_object["/AcroForm"][NameObject("/NeedAppearances")] = BooleanObject(True)
    os.makedirs(os.path.dirname(out) or ".", exist_ok=True)
    with open(out + ".tmp", "wb") as f:
        writer.write(f)
    os.replace(out + ".tmp", out)
    print(out)


def list_213(dirs=FLMSG_DIRS):
    """flmsg's ICS-213 messages, newest first."""
    found = []
    for folder, path in dirs:
        for name in glob.glob(os.path.join(path, "*.213")):
            try:
                with open(name, "rb") as f:
                    fields = parse_flmsg(f.read())
                mtime = os.path.getmtime(name)
            except (OSError, ValueError):
                continue
            found.append({"path": name, "folder": folder, "modified": int(mtime),
                          "subject": fields.get("sb", ""), "from": fields.get("fm", ""),
                          "to": fields.get("to", ""), "date": fields.get("d1", ""), "time": fields.get("t1", "")})
    return sorted(found, key=lambda m: m["modified"], reverse=True)


def list_forms(dirs=FLMSG_DIRS, nets_dir=NETS_DIR, forms_dir=FORMS_DIR):
    """Everything the Forms page lists, newest first: ICS-213 messages (kind "213"),
    nets (kind "net", "open" while the net is) and filled-in ICS-309 and ICS-205 pages
    (kind "309" or "205"). Each has a path, a title, a detail line and a modified time."""
    found = []
    for m in list_213(dirs):
        other = m["from"] if m["folder"] == "Received" else m["to"]
        detail = " · ".join(filter(None, ["ICS-213", m["folder"],
                                          ("from " if m["folder"] == "Received" else "to ") + other if other else "",
                                          m["date"], m["time"]]))
        found.append(dict(m, kind="213", title=m["subject"] or "(no subject)", detail=detail))
    for path in glob.glob(os.path.join(nets_dir, "*.json")):
        try:
            with open(path, encoding="utf-8") as f:
                net = json.load(f)
            if not isinstance(net, dict):
                continue
        except (OSError, ValueError):
            continue
        entries = net.get("entries") or []
        calls = {e.get("from") for e in entries if e.get("checkin") and e.get("from")}
        started, closed = net.get("started"), net.get("closed")
        # When it last changed: an open net's stamp moves only when an entry is logged, so the
        # list isn't rebuilt every time it's asked; open nets go to the top when sorting.
        latest = max([started or 0, closed or 0] + [e.get("time") or 0 for e in entries])
        when = (f"open since {utc(started, '%H%MZ')}" if not closed else
                f"{utc(started, '%Y-%m-%d %H%MZ')} to {utc(closed, '%H%MZ')}")
        detail = " · ".join(filter(None, ["Net", when, f"{len(calls)} checked in", net.get("incident", "")]))
        found.append({"kind": "net", "path": path, "title": net.get("name") or "Net", "detail": detail,
                      "modified": int(latest), "open": not closed})
    for path in glob.glob(os.path.join(forms_dir, "*.html")):
        name = os.path.splitext(os.path.basename(path))[0]
        kind = "309" if name.startswith("ICS-309") else "205" if name.startswith("ICS-205") else "form"
        try:
            mtime = int(os.path.getmtime(path))
        except OSError:
            continue
        label = {"309": "ICS-309 Communications Log", "205": "ICS-205 Radio Communications Plan"}.get(kind, "Form")
        found.append({"kind": kind, "path": path, "title": name, "modified": mtime,
                      "detail": f"{label} · saved {utc(mtime)}"})
    return sorted(found, key=lambda m: (bool(m.get("open")), m["modified"]), reverse=True)


# ---- sending through fldigi, as flmsg's AutoSend does (flmsg src/utils/wrap.cxx) ----

def flmsg_crc16(data):
    """flmsg's checksum of a wrapped message (Ccrc16: CRC-16 with the 0xA001 polynomial from
    0xFFFF), as four hex digits. A byte above 127 is taken as a negative char, as flmsg's
    C++ does, so the digits match flmsg's for any text."""
    crc = 0xFFFF
    for byte in data:
        crc ^= (byte - 256 if byte > 127 else byte) & 0xFFFFFFFF
        for _ in range(8):
            crc = (crc >> 1) ^ 0xA001 if crc & 1 else crc >> 1
    return f"{crc:04X}"[:4]  # flmsg prints it into char[5]: past 16 bits, the first four digits


def wrap_for_fldigi(name, data):
    """The text flmsg's AutoSend puts in fldigi's transmit buffer for a message file:
    the file name and contents between [WRAP:beg] and [WRAP:end] with a checksum, so the
    receiving fldigi saves it for flmsg exactly as sent. Returns (text, wrapped), the
    second being the part a .wrap file holds."""
    crlf = b"\r\n" in data
    payload = b"[WRAP:fn " + name.encode("utf-8") + b"]" + data.replace(b"\r\n", b"\n")
    wrapped = (b"[WRAP:beg]" + (b"[WRAP:crlf]" if crlf else b"[WRAP:lf]") + payload
               + b"[WRAP:chksum " + flmsg_crc16(payload).encode() + b"][WRAP:end]")
    text = b"\n\n\n... start\n" + wrapped + b"\n... end\n\n\n"
    return text.decode("utf-8", "replace"), wrapped


def fldigi(timeout=5):
    return xmlrpc.client.ServerProxy(FLDIGI_URL, allow_none=True,
                                     transport=TimeoutTransport(timeout))


class TimeoutTransport(xmlrpc.client.Transport):
    def __init__(self, timeout):
        super().__init__()
        self.timeout = timeout

    def make_connection(self, host):
        connection = super().make_connection(host)
        connection.timeout = self.timeout
        return connection


def fldigi_status(modems=False):
    """{"online": bool, "modem": name, "trx": "rx"/"tx"/"tune", "version"} and, asked for,
    "modems": the NBEMS modems fldigi has, in NBEMS_MODEMS order, then every other."""
    proxy = fldigi()
    try:
        status = {"online": True, "version": str(proxy.fldigi.version()), "modem": str(proxy.modem.get_name()),
                  "trx": str(proxy.main.get_trx_state()).lower()}
        if modems:
            names = [str(n) for n in proxy.modem.get_names()]
            status["modems"] = [m for m in NBEMS_MODEMS if m in names] + sorted(set(names) - set(NBEMS_MODEMS))
    except (OSError, xmlrpc.client.Error, ValueError, TypeError):
        return {"online": False}
    return status


def send_to_fldigi(path, modem=None):
    """Put an flmsg message in fldigi's transmit buffer and start transmitting, on `modem`
    if given. Keeps a copy of what went out in ~/.nbems/WRAP/send and a line in flmsg's
    auto_sent.csv. Returns {"name", "modem", "wrap"}; raises OSError if fldigi isn't there."""
    with open(path, "rb") as f:
        data = f.read()
    name = os.path.basename(path)
    text, wrapped = wrap_for_fldigi(name, data)
    proxy = fldigi(timeout=15)
    try:
        if modem:
            proxy.modem.set_by_name(modem)
        used = str(proxy.modem.get_name())
        try:
            proxy.text.add_tx_queu(text + "^r")  # ^r: back to receive once it's sent
        except xmlrpc.client.Fault:  # an fldigi from before the queued form
            proxy.text.add_tx(text + "^r")
        proxy.main.tx()
    except xmlrpc.client.Error as exc:
        raise OSError(f"fldigi didn't accept the message: {exc}") from None
    try:
        os.makedirs(WRAP_SEND_DIR, exist_ok=True)
        wrap_path = os.path.join(WRAP_SEND_DIR, name + ".wrap")
        with open(wrap_path, "wb") as f:
            f.write(wrapped)
        os.makedirs(os.path.dirname(SENT_LOG), exist_ok=True)
        with open(SENT_LOG, "a", encoding="utf-8") as f:  # a line as flmsg appends it; no header
            f.write(f"{name},{time.strftime('%Y-%m-%d,%H%M', time.gmtime())}\n")
    except OSError:
        wrap_path = None  # sent all the same
    return {"name": name, "modem": used, "wrap": wrap_path}


def main_send(args):
    modem = None
    if "--modem" in args:
        i = args.index("--modem")
        modem = args[i + 1] if i + 1 < len(args) else None
        del args[i:i + 2]
    if len(args) != 1:
        print("emcomm-ics send MSG.213 [--modem NAME]", file=sys.stderr)
        return 2
    if not fldigi_status().get("online"):
        print("fldigi isn't running. Open it from its tile first.", file=sys.stderr)
        return 1
    try:
        print(json.dumps(send_to_fldigi(args[0], modem)))
    except OSError as exc:
        print(f"Couldn't send: {exc}", file=sys.stderr)
        return 1
    return 0


def main_213(args):
    if args == ["--list"]:
        print(json.dumps(list_213()))
        return 0
    if len(args) == 2 and args[0] == "--fields":
        try:
            with open(args[1], "rb") as f:
                print(json.dumps(parse_flmsg(f.read())))
        except (OSError, ValueError) as exc:
            print(f"Couldn't read {os.path.basename(args[1])}: {exc}", file=sys.stderr)
            return 1
        return 0
    if args[:1] == ["--save"] and len(args) in (2, 3):
        fields = json.load(sys.stdin)
        out = args[1]
        os.makedirs(os.path.dirname(out) or ".", exist_ok=True)
        with open(out + ".tmp", "wb") as f:
            f.write(write_flmsg(fields, args[2] if len(args) == 3 else ""))
        os.replace(out + ".tmp", out)
        print(out)
        return 0
    if not args:
        print("emcomm-ics 213 MSG.213 [OUT.pdf]", file=sys.stderr)
        return 2
    try:
        with open(args[0], "rb") as f:
            fields = parse_flmsg(f.read())
    except (OSError, ValueError) as exc:
        print(f"Couldn't read {os.path.basename(args[0])}: {exc}", file=sys.stderr)
        return 1
    stem = os.path.splitext(os.path.basename(args[0]))[0]
    out = args[1] if len(args) > 1 else os.path.join(FORMS_DIR, f"ICS-213 {safe_name(stem)}.pdf")
    try:
        ics213_pdf(fields, os.path.join(FORMS_PDF_DIR, "ics213.pdf"), out)
    except ImportError:
        print("The ICS-213 form needs python3-pypdf: run Update station.", file=sys.stderr)
        return 1
    return 0


def safe_name(text):
    return "".join(c if c.isalnum() or c in " -_" else "-" for c in text).strip() or "form"


def write_out(text, path):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w", encoding="utf-8") as f:
        f.write(text)
    print(path)


def main(argv):
    if not argv or argv[0] not in ("309", "205", "213", "list", "fldigi", "send"):
        print(__doc__.strip(), file=sys.stderr)
        return 2
    if argv[0] == "213":
        return main_213(argv[1:])
    if argv[0] == "list":
        print(json.dumps(list_forms()))
        return 0
    if argv[0] == "fldigi":
        print(json.dumps(fldigi_status(modems="--modems" in argv[1:])))
        return 0
    if argv[0] == "send":
        return main_send(argv[1:])
    try:
        with open(STATION, encoding="utf-8") as f:
            station = json.load(f)
    except (OSError, ValueError):
        station = {}
    if argv[0] == "309":
        if len(argv) < 2:
            print("emcomm-ics 309 NET.json [OUT.html]", file=sys.stderr)
            return 2
        with open(argv[1], encoding="utf-8") as f:
            net = json.load(f)
        net.setdefault("callsign", station.get("callsign", ""))
        out = argv[2] if len(argv) > 2 else os.path.join(
            FORMS_DIR, f"ICS-309 {utc(net.get('started'), '%Y-%m-%d %H%MZ')} {safe_name(net.get('name', 'net'))}.html")
        write_out(ics309(net), out)
        return 0
    args = argv[1:]
    incident = ""
    if "--incident" in args:
        i = args.index("--incident")
        incident = args[i + 1] if i + 1 < len(args) else ""
        del args[i:i + 2]
    path = MY_FREQS if os.path.exists(MY_FREQS) else os.path.join(REFERENCE_DIR, "My frequencies.csv")
    rows = read_freqs(path)
    if not rows:
        print("My frequencies is empty: add some on the Reference page first.", file=sys.stderr)
        return 1
    out = args[0] if args else os.path.join(
        FORMS_DIR, f"ICS-205 {utc(time.time(), '%Y-%m-%d %H%MZ')} {safe_name(incident or 'plan')}.html")
    write_out(ics205(rows, incident, station.get("callsign", "")), out)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
