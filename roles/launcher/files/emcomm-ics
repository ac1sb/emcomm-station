#!/usr/bin/env python3
"""Fill in ICS forms as printable pages, from the station's own records, and send
messages over the radio through fldigi.

  emcomm-ics 309 NET.json [OUT.html]          Communications Log for a net
  emcomm-ics 205 [--incident NAME] [OUT.html] Radio Communications Plan from My frequencies
  emcomm-ics 213 MSG.213 [OUT.pdf]            General Message from an flmsg file, on FEMA's form
  emcomm-ics 213 --list                       flmsg's ICS-213 messages, newest first, as JSON
  emcomm-ics 213 --fields MSG.213             an flmsg ICS-213 file's fields, as JSON
  emcomm-ics 213 --save OUT.213 [CALL]        write the fields given as JSON on stdin as an
                                              flmsg ICS-213 file (CALL: who edited it)
  emcomm-ics list                             every message, net and filled-in form, newest
                                              first, as JSON (the launcher's Forms page)
  emcomm-ics fldigi [--modems]                whether fldigi is running, its modem and whether
                                              it's transmitting (--modems: the modems it has)
  emcomm-ics send MSG.213 [--modem NAME]      send an flmsg message over the radio: wrapped the
                                              way flmsg's AutoSend does and put in fldigi's
                                              transmit buffer, which keys the radio

The launcher's Net control page keeps each net as a JSON file:
  {"name", "incident", "operator", "callsign", "started", "closed",
   "entries": [{"time", "from", "to", "message"}]}
with times in seconds since 1970 (UTC). Without OUT.html the page is written to
~/ICS forms/ and its path printed.

The ICS 213 is filled into FEMA's own fillable PDF (/usr/share/emcomm/forms/ics213.pdf),
so it looks like the paper form on screen and in print. flmsg keeps the messages
you write in ~/.nbems/ICS/messages and the ones fldigi receives in ~/.nbems/WRAP/recv.
"""

import csv
import glob
import html
import json
import math
import os
import re
import sys
import time
import xmlrpc.client

FORMS_DIR = os.environ.get("EMCOMM_ICS_FORMS", os.path.expanduser("~/ICS forms"))
NETS_DIR = os.environ.get("EMCOMM_NETS", os.path.expanduser("~/.local/share/emcomm/nets"))
# fldigi's XML-RPC server, on its standard port; the same one flmsg talks to.
FLDIGI_URL = os.environ.get("EMCOMM_FLDIGI", "http://127.0.0.1:7362/")
WRAP_SEND_DIR = os.path.expanduser("~/.nbems/WRAP/send")  # a copy of each message as sent, as flmsg keeps
SENT_LOG = os.path.expanduser("~/.nbems/ICS/auto_sent.csv")  # flmsg's record of what AutoSend sent
# Modems NBEMS nets use for forms, fastest first (MT63-2000L is the usual choice on VHF).
NBEMS_MODEMS = ["MT63-2000L", "MT63-1000L", "MT63-500L", "MFSK128", "MFSK64", "MFSK32", "MFSK16",
                "PSK500R", "PSK250R", "PSK125R", "Olivia-8-500", "Olivia-16-500", "THOR50x1", "THOR22",
                "BPSK63", "BPSK31"]
STATION = os.environ.get("EMCOMM_STATION", "/etc/emcomm/station.json")
REFERENCE_DIR = os.environ.get("EMCOMM_REFERENCE", "/usr/share/emcomm/reference")
MY_FREQS = os.path.join(os.path.expanduser("~/.local/share/emcomm/reference"), "My frequencies.csv")
FORMS_PDF_DIR = os.environ.get("EMCOMM_FORMS", "/usr/share/emcomm/forms")
FLMSG_DIRS = (("Sent", os.path.expanduser("~/.nbems/ICS/messages")),
              ("Received", os.path.expanduser("~/.nbems/WRAP/recv")))
ROWS_309 = 30   # rows per printed page, as on the paper form
ROWS_205 = 16

