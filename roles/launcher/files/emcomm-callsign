#!/usr/bin/env python3
"""The FCC's amateur licence list and RadioID.net's DMR ID list, kept on the station
so callsigns and DMR IDs can be looked up with no internet: net control and contact
notes fill in the name and town, and the Look up box finds either.

  emcomm-callsign update [--max-age DAYS]  download both lists and rebuild their
                                           databases, when older than DAYS
                                           (default 7; 0 always rebuilds)
  emcomm-callsign build ZIP [DB]           rebuild the FCC database from a
                                           downloaded l_amat.zip
  emcomm-callsign build-dmr CSV [DB]       rebuild the DMR ID database from a
                                           downloaded RadioID user.csv
  emcomm-callsign lookup CALL|ID...        print what the databases have, as JSON

Update station runs `update` as root. The FCC list is its weekly full file of
amateur licences (ULS l_amat.zip, roughly 150 MB). Only active licences and ones
expired within the two-year grace period are kept, so a miscopied or lapsed call
shows up as such. The DMR list is RadioID.net's user.csv (every registered DMR
user worldwide, roughly 20 MB), so it also covers calls outside the US.
"""

import contextlib
import csv
import io
import json
import os
import re
import shutil
import sqlite3
import sys
import tempfile
import time
import urllib.request
import zipfile

DB = os.environ.get("EMCOMM_CALLSIGN_DB", "/var/lib/emcomm/callsigns.db")
URL = os.environ.get("EMCOMM_CALLSIGN_URL", "https://data.fcc.gov/download/pub/uls/complete/l_amat.zip")
CACHE = os.environ.get("EMCOMM_CALLSIGN_CACHE", "/var/cache/emcomm")
DMR_DB = os.environ.get("EMCOMM_DMR_DB", "/var/lib/emcomm/dmrids.db")
DMR_URL = os.environ.get("EMCOMM_DMR_URL", "https://radioid.net/static/user.csv")
DAY = 24 * 3600

CLASSES = {"E": "Amateur Extra", "A": "Advanced", "G": "General", "P": "Technician Plus",
           "T": "Technician", "N": "Novice"}
STATUS = {"A": "active", "E": "expired"}
# The FCC issues calls starting A[A-L], K, N and W; anything else isn't in its list.
US_CALL = re.compile(r"(?:A[A-L]|[KNW][A-Z]?)[0-9][A-Z]{1,3}")


def is_us_call(call):
    return bool(US_CALL.fullmatch(call.strip().upper()))


def iso_date(mdy):
    """'03/01/2034' as '2034-03-01'; '' when blank or odd."""
    m = re.fullmatch(r"(\d\d)/(\d\d)/(\d{4})", mdy.strip())
    return f"{m.group(3)}-{m.group(1)}-{m.group(2)}" if m else ""


def records(zf, name):
    """Rows of one of the zip's pipe-separated .dat files. A few records carry a stray
    line break inside a field; those come out short and are skipped."""
    with zf.open(name) as raw:
        for line in io.TextIOWrapper(raw, encoding="latin-1", newline=""):
            yield line.rstrip("\r\n").split("|")


def nice(text):
    """FCC names are in capitals: 'JOHN Q SMITH' reads better as 'John Q Smith'."""
    return " ".join(w.capitalize() if w.isupper() else w for w in text.split())


def build(zip_path, db_path):
    """Writes a fresh database next to db_path and moves it into place, so a lookup
    never sees half a build. Returns how many callsigns it holds."""
    os.makedirs(os.path.dirname(os.path.abspath(db_path)), exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(os.path.abspath(db_path)), suffix=".tmp")
    os.close(fd)
    try:
        con = sqlite3.connect(tmp)
        con.executescript("""
            PRAGMA journal_mode = OFF; PRAGMA synchronous = OFF;
            CREATE TEMP TABLE hd (usi INTEGER PRIMARY KEY, call TEXT, status TEXT, expires TEXT);
            CREATE TEMP TABLE am (usi INTEGER PRIMARY KEY, class TEXT);
            CREATE TEMP TABLE en (usi INTEGER PRIMARY KEY, name TEXT, city TEXT, state TEXT, zip TEXT);
        """)
        with zipfile.ZipFile(zip_path) as zf:
            names = {os.path.basename(n).upper(): n for n in zf.namelist()}
            for need in ("HD.DAT", "EN.DAT", "AM.DAT"):
                if need not in names:
                    raise ValueError(f"{zip_path} has no {need}; is it the FCC's l_amat.zip?")
            # HD: licence header. 4 call, 5 status, 6 service (HA/HV amateur), 8 expiry.
            con.executemany("INSERT OR REPLACE INTO hd VALUES (?, ?, ?, ?)", (
                (int(r[1]), r[4].upper(), r[5], iso_date(r[8]))
                for r in records(zf, names["HD.DAT"])
                if len(r) > 8 and r[0] == "HD" and r[1].isdigit() and r[5] in STATUS and r[4]))
            # AM: amateur details. 5 operator class.
            con.executemany("INSERT OR REPLACE INTO am VALUES (?, ?)", (
                (int(r[1]), r[5]) for r in records(zf, names["AM.DAT"])
                if len(r) > 5 and r[0] == "AM" and r[1].isdigit()))
            # EN: the licensee. 5 entity type (L licensee), 7 entity name, 8 first, 9 mi,
            # 10 last, 11 suffix, 16 city, 17 state, 18 zip.
            con.executemany("INSERT OR REPLACE INTO en VALUES (?, ?, ?, ?, ?)", (
                (int(r[1]),
                 nice(" ".join(filter(None, (r[8], r[9], r[10], r[11])))) or r[7].strip(),  # a club as filed
                 nice(r[16]), r[17].upper(), r[18][:5])
                for r in records(zf, names["EN.DAT"])
                if len(r) > 18 and r[0] == "EN" and r[1].isdigit() and r[5] in ("L", "")))
        # One row per call: an active licence wins over an expired one, then the
        # latest expiry (a call that was reissued keeps its old records too).
        con.executescript("""
            CREATE TABLE calls (call TEXT PRIMARY KEY, name TEXT, city TEXT, state TEXT, zip TEXT,
                                class TEXT, status TEXT, expires TEXT);
            INSERT OR IGNORE INTO calls
              SELECT hd.call, COALESCE(en.name, ''), COALESCE(en.city, ''), COALESCE(en.state, ''),
                     COALESCE(en.zip, ''), COALESCE(am.class, ''), hd.status, hd.expires
              FROM hd LEFT JOIN en USING (usi) LEFT JOIN am USING (usi)
              ORDER BY hd.status = 'A' DESC, hd.expires DESC;
            CREATE TABLE meta (key TEXT PRIMARY KEY, value TEXT);
        """)
        count = con.execute("SELECT COUNT(*) FROM calls").fetchone()[0]
        con.execute("INSERT INTO meta VALUES ('built', ?)", (str(int(time.time())),))
        con.execute("INSERT INTO meta VALUES ('source', ?)",
                    (str(int(os.path.getmtime(zip_path))),))
        con.commit()
        con.execute("VACUUM")
        con.close()
        os.chmod(tmp, 0o644)
        os.replace(tmp, db_path)
        return count
    finally:
        with contextlib.suppress(FileNotFoundError):
            os.unlink(tmp)


def build_dmr(csv_path, db_path):
    """The DMR ID database from RadioID's user.csv (RADIO_ID, CALLSIGN, FIRST_NAME,
    LAST_NAME, CITY, STATE, COUNTRY; columns found by name). Written aside and moved
    into place like the FCC one. Returns how many IDs it holds."""
    os.makedirs(os.path.dirname(os.path.abspath(db_path)), exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(os.path.abspath(db_path)), suffix=".tmp")
    os.close(fd)
    try:
        with open(csv_path, encoding="utf-8", errors="replace", newline="") as f:
            reader = csv.reader(f)
            header = [h.strip().lower() for h in next(reader, [])]
            col = {name: header.index(name) for name in
                   ("radio_id", "callsign", "first_name", "last_name", "city", "state", "country") if name in header}
            if "radio_id" not in col or "callsign" not in col:
                raise ValueError(f"{csv_path} has no RADIO_ID and CALLSIGN columns; is it RadioID's user.csv?")

            def field(row, name):
                i = col.get(name)
                return row[i].strip() if i is not None and i < len(row) else ""

            con = sqlite3.connect(tmp)
            con.executescript("""
                PRAGMA journal_mode = OFF; PRAGMA synchronous = OFF;
                CREATE TABLE dmr (id INTEGER PRIMARY KEY, call TEXT, name TEXT, city TEXT, state TEXT,
                                  country TEXT);
                CREATE TABLE meta (key TEXT PRIMARY KEY, value TEXT);
            """)
            con.executemany("INSERT OR REPLACE INTO dmr VALUES (?, ?, ?, ?, ?, ?)", (
                (int(field(row, "radio_id")), field(row, "callsign").upper(),
                 " ".join(filter(None, (field(row, "first_name"), field(row, "last_name")))),
                 field(row, "city"), field(row, "state"), field(row, "country"))
                for row in reader if field(row, "radio_id").isdigit() and field(row, "callsign")))
        con.execute("CREATE INDEX dmr_call ON dmr (call)")
        count = con.execute("SELECT COUNT(*) FROM dmr").fetchone()[0]
        con.execute("INSERT INTO meta VALUES ('built', ?)", (str(int(time.time())),))
        con.commit()
        con.execute("VACUUM")
        con.close()
        os.chmod(tmp, 0o644)
        os.replace(tmp, db_path)
        return count
    finally:
        with contextlib.suppress(FileNotFoundError):
            os.unlink(tmp)


def dmr_lookup(key, db_path=DMR_DB):
    """DMR IDs for a callsign, or the one ID asked for by number: a list of
    {id, call, name, city, state, country}, lowest ID first; [] when none."""
    key = str(key).strip().upper()
    if not key:
        return []
    try:
        with contextlib.closing(sqlite3.connect(f"file:{db_path}?mode=ro", uri=True)) as con:
            con.row_factory = sqlite3.Row
            if key.isdigit():
                rows = con.execute("SELECT * FROM dmr WHERE id = ?", (int(key),)).fetchall()
            else:
                rows = con.execute("SELECT * FROM dmr WHERE call = ? ORDER BY id", (key,)).fetchall()
    except sqlite3.Error:
        return []
    return [dict(r) for r in rows]


def built(db_path=DB):
    """When the database was built (epoch seconds), or None if there isn't one."""
    try:
        with contextlib.closing(sqlite3.connect(f"file:{db_path}?mode=ro", uri=True)) as con:
            row = con.execute("SELECT value FROM meta WHERE key = 'built'").fetchone()
        return int(row[0]) if row else None
    except (sqlite3.Error, ValueError):
        return None


def lookup(call, db_path=DB):
    """{call, name, city, state, zip, class, status, expires} for a call, or None."""
    call = call.strip().upper()
    try:
        with contextlib.closing(sqlite3.connect(f"file:{db_path}?mode=ro", uri=True)) as con:
            con.row_factory = sqlite3.Row
            row = con.execute("SELECT * FROM calls WHERE call = ?", (call,)).fetchone()
    except sqlite3.Error:
        return None
    if not row:
        return None
    found = dict(row)
    found["class"] = CLASSES.get(found["class"], "Club" if not found["class"] else found["class"])
    found["status"] = STATUS.get(found["status"], found["status"])
    return found


def download(url, dest):
    """Downloads to dest.part first, so a cut-off download never replaces a good file."""
    part = dest + ".part"
    req = urllib.request.Request(url, headers={"User-Agent": "emcomm-station callsign list"})
    with urllib.request.urlopen(req, timeout=60) as resp, open(part, "wb") as out:
        shutil.copyfileobj(resp, out, 1 << 20)
    os.replace(part, dest)


def update_dmr(max_age_days=7, db_path=DMR_DB, url=DMR_URL, cache=CACHE):
    when = built(db_path)
    if when and max_age_days and time.time() - when < max_age_days * DAY:
        print(f"The DMR ID list is {int((time.time() - when) / DAY)} days old; not updating yet.")
        return 0
    os.makedirs(cache, exist_ok=True)
    csv_path = os.path.join(cache, "dmr-user.csv")
    print(f"Downloading the DMR ID list from {url}")
    try:
        download(url, csv_path)
    except OSError as exc:
        if not when:
            print(f"Couldn't download the DMR ID list ({exc}). DMR ID lookup needs one download with internet.",
                  file=sys.stderr)
            return 1
        print(f"Couldn't download the DMR ID list ({exc}). "
              f"Keeping the list from {time.strftime('%Y-%m-%d', time.gmtime(when))}.")
        return 0
    try:
        count = build_dmr(csv_path, db_path)
    finally:
        os.unlink(csv_path)
    print(f"DMR ID list rebuilt: {count} IDs.")
    return 0


def update(max_age_days=7, db_path=DB, url=URL, cache=CACHE):
    when = built(db_path)
    if when and max_age_days and time.time() - when < max_age_days * DAY:
        print(f"The callsign list is {int((time.time() - when) / DAY)} days old; not updating yet.")
        return 0
    os.makedirs(cache, exist_ok=True)
    zip_path = os.path.join(cache, "l_amat.zip")
    print(f"Downloading the FCC amateur licence list from {url}")
    try:
        download(url, zip_path)
    except OSError as exc:
        if not when:
            print(f"Couldn't download it ({exc}). Callsign lookup needs one download with internet.",
                  file=sys.stderr)
            return 1
        # Offline is normal for this station; the old list still works.
        print(f"Couldn't download it ({exc}). Keeping the list from {time.strftime('%Y-%m-%d', time.gmtime(when))}.")
        return 0
    count = build(zip_path, db_path)
    os.unlink(zip_path)  # 150 MB that's only needed while building
    print(f"Callsign list rebuilt: {count} callsigns.")
    return 0


def main(argv):
    if argv[:1] == ["update"]:
        days = 7
        if argv[1:2] == ["--max-age"] and len(argv) > 2 and argv[2].isdigit():
            days = int(argv[2])
        elif len(argv) > 1:
            print(__doc__, file=sys.stderr)
            return 2
        # Each list on its own: one failing to download doesn't stop the other.
        return max(update(days), update_dmr(days))
    if argv[:1] == ["build"] and len(argv) in (2, 3):
        print(f"{build(argv[1], argv[2] if len(argv) == 3 else DB)} callsigns.")
        return 0
    if argv[:1] == ["build-dmr"] and len(argv) in (2, 3):
        print(f"{build_dmr(argv[1], argv[2] if len(argv) == 3 else DMR_DB)} IDs.")
        return 0
    if argv[:1] == ["lookup"] and len(argv) > 1:
        for key in argv[1:]:
            dmr = dmr_lookup(key)
            call = dmr[0]["call"] if key.strip().isdigit() and dmr else key.upper()
            found = lookup(call) or {"call": call, "found": False}
            found["dmr"] = dmr if key.strip().isdigit() else dmr_lookup(call)
            print(json.dumps(found))
        return 0
    print(__doc__, file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
