#!/usr/bin/env python3
"""Choose what the station shows while it starts up.

Runs as root: the launcher's Settings > Display calls it through sudo, and the
playbook runs "apply" so the computer matches the saved choice.

  emcomm-splash                     the choice, as JSON
  emcomm-splash apply               make the computer match /etc/emcomm/splash.json
  emcomm-splash set logo            the Emcomm-CNC logo with the station's callsign
  emcomm-splash set picture PNG     a picture of your own (a PNG), filling the screen
  emcomm-splash set spinner         Debian's plain spinner
  emcomm-splash set text            no picture: the start-up messages scroll past

The logo and the picture are a Plymouth script theme ("emcomm") in
/usr/share/plymouth/themes/emcomm. Plymouth reads its theme from the initramfs,
so a change rebuilds it (update-initramfs, about a minute). "text" takes
"quiet splash" off the kernel command line (update-grub). Prints "changed" or
"unchanged".
"""

import filecmp
import json
import os
import re
import shutil
import subprocess
import sys

ROOT = os.environ.get("EMCOMM_ROOT", "")  # tests work in a scratch tree
SETTINGS = f"{ROOT}/etc/emcomm/splash.json"
PICTURE = f"{ROOT}/etc/emcomm/splash-picture.png"
STATION = f"{ROOT}/etc/emcomm/station.json"
THEME_DIR = f"{ROOT}/usr/share/plymouth/themes/emcomm"
GRUB = f"{ROOT}/etc/default/grub"
GRUB_CFG = f"{ROOT}/etc/default/grub.d/emcomm-quiet-boot.cfg"
STYLES = ("logo", "picture", "spinner", "text")
MAX_PICTURE = 20 * 1024 * 1024
PNG_MAGIC = b"\x89PNG\r\n\x1a\n"

GRUB_QUIET = ("# Managed by emcomm-splash: a quiet boot with a start-up screen.\n"
              'GRUB_CMDLINE_LINUX_DEFAULT="$GRUB_CMDLINE_LINUX_DEFAULT quiet splash loglevel=3 '
              'rd.udev.log_level=3 vt.global_cursor_default=0"\n')
GRUB_TEXT = ("# Managed by emcomm-splash: start-up messages shown (Settings > Display).\n"
             "GRUB_CMDLINE_LINUX_DEFAULT=\"$(echo \"$GRUB_CMDLINE_LINUX_DEFAULT\" | "
             "sed -e 's/\\bquiet\\b//' -e 's/\\bsplash\\b//')\"\n")

SCRIPT = """// Written by emcomm-splash: the station's start-up screen.
Window.SetBackgroundTopColor(0.078, 0.090, 0.110);
Window.SetBackgroundBottomColor(0.078, 0.090, 0.110);
w = Window.GetWidth();
h = Window.GetHeight();
whole = {whole};
pic = Image("splash.png");
if (whole) {{
  fit = Math.Min(w / pic.GetWidth(), h / pic.GetHeight());
  pic = pic.Scale(pic.GetWidth() * fit, pic.GetHeight() * fit);
  top = h / 2 - pic.GetHeight() / 2;
}} else {{
  top = h / 2 - pic.GetHeight() / 2 - 60;
}}
logo = Sprite(pic);
logo.SetPosition(w / 2 - pic.GetWidth() / 2, top, 1);
below = top + pic.GetHeight() + 24;
if (!whole) {{
  name = Sprite(Image.Text("Emcomm-CNC", 0.91, 0.90, 0.88, 1, "Sans Bold 30"));
  name.SetPosition(w / 2 - name.GetImage().GetWidth() / 2, below, 2);
  below = below + name.GetImage().GetHeight() + 8;
  call = Sprite(Image.Text("{callsign}", 0.95, 0.64, 0.23, 1, "Sans Bold 22"));
  call.SetPosition(w / 2 - call.GetImage().GetWidth() / 2, below, 2);
  below = below + call.GetImage().GetHeight() + 24;
}}
if (below > h - 110) {{
  below = h - 110;
}}

// Five dots that light up in turn while the station starts.
for (i = 0; i < 5; i++) {{
  dot[i] = Sprite(Image.Text("●", 0.95, 0.64, 0.23, 1, "Sans 18"));
  dot[i].SetPosition(w / 2 - 70 + i * 30, below, 3);
  dot[i].SetOpacity(0.25);
}}
// (A name set inside a function is local to it unless it's global.)
tick = 0;
asking = 0;
fun refresh() {{
  global.tick = global.tick + 1;
  for (i = 0; i < 5; i++) {{
    if (global.asking) {{
      dot[i].SetOpacity(0);
    }} else if (Math.Int(global.tick / 12) % 5 == i) {{
      dot[i].SetOpacity(1);
    }} else {{
      dot[i].SetOpacity(0.25);
    }}
  }}
}}
Plymouth.SetRefreshFunction(refresh);

// A disk password, if the computer asks for one: where the dots were.
fun show_password(prompt, bullets) {{
  global.asking = 1;
  global.ask = Sprite(Image.Text(prompt, 0.91, 0.90, 0.88, 1, "Sans 18"));
  global.ask.SetPosition(w / 2 - global.ask.GetImage().GetWidth() / 2, below - 6, 5);
  stars = "";
  for (i = 0; i < bullets; i++) {{
    stars = stars + "●";
  }}
  global.typed = Sprite(Image.Text(stars + " ", 0.95, 0.64, 0.23, 1, "Sans 18"));
  global.typed.SetPosition(w / 2 - global.typed.GetImage().GetWidth() / 2, below + 28, 5);
}}
fun show_normal() {{
  global.asking = 0;
  global.ask = NULL;
  global.typed = NULL;
}}
Plymouth.SetDisplayPasswordFunction(show_password);
Plymouth.SetDisplayNormalFunction(show_normal);

fun show_message(text) {{
  global.note = Sprite(Image.Text(text, 0.6, 0.62, 0.65, 1, "Sans 14"));
  global.note.SetPosition(w / 2 - global.note.GetImage().GetWidth() / 2, h - 40, 4);
}}
Plymouth.SetMessageFunction(show_message);
"""


def load():
    try:
        with open(SETTINGS, encoding="utf-8") as f:
            style = json.load(f).get("style")
    except (OSError, ValueError, AttributeError):
        style = None
    if style == "picture" and not os.path.exists(PICTURE):
        style = None
    return style if style in STYLES else "logo"


def callsign():
    try:
        with open(STATION, encoding="utf-8") as f:
            call = str(json.load(f).get("callsign", ""))
    except (OSError, ValueError, AttributeError):
        call = ""
    call = call.upper() if re.fullmatch(r"[A-Za-z0-9/]{1,12}", call) else ""
    return "" if call == "N0CALL" else call


def write_if_changed(path, data):
    """Write bytes to path unless it already holds them; True if it changed."""
    try:
        with open(path, "rb") as f:
            if f.read() == data:
                return False
    except OSError:
        pass
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path + ".tmp", "wb") as f:
        f.write(data)
    os.chmod(path + ".tmp", 0o644)
    os.replace(path + ".tmp", path)
    return True


def theme_files(style):
    """Put the picture and script for the logo or picture style in the theme; True if changed."""
    source = PICTURE if style == "picture" else os.path.join(THEME_DIR, "logo.png")
    target = os.path.join(THEME_DIR, "splash.png")
    changed = False
    if not (os.path.exists(target) and filecmp.cmp(source, target, shallow=False)):
        shutil.copyfile(source, target + ".tmp")
        os.chmod(target + ".tmp", 0o644)
        os.replace(target + ".tmp", target)
        changed = True
    script = SCRIPT.format(whole=1 if style == "picture" else 0, callsign=callsign())
    return write_if_changed(os.path.join(THEME_DIR, "emcomm.script"), script.encode()) or changed


def current_theme():
    result = subprocess.run(["plymouth-set-default-theme"], capture_output=True, text=True, check=False)
    return result.stdout.strip()


def apply():
    style = load()
    theme = "emcomm" if style in ("logo", "picture") else "spinner"
    rebuild = theme_files(style) if theme == "emcomm" else False
    if current_theme() != theme:
        subprocess.run(["plymouth-set-default-theme", theme], check=True)
        rebuild = True
    grub = False
    if os.path.exists(GRUB):
        grub = write_if_changed(GRUB_CFG, (GRUB_TEXT if style == "text" else GRUB_QUIET).encode())
    if rebuild:
        subprocess.run(["update-initramfs", "-u"], check=True, stdout=subprocess.DEVNULL)
    if grub:
        subprocess.run(["update-grub"], check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return rebuild or grub


def set_style(style, picture=None):
    if style not in STYLES:
        raise ValueError(f"unknown style {style!r}: use one of {', '.join(STYLES)}")
    if style == "picture":
        if not picture:
            raise ValueError("picture needs a PNG file")
        with open(picture, "rb") as f:
            data = f.read(MAX_PICTURE + 1)
        if len(data) > MAX_PICTURE or not data.startswith(PNG_MAGIC):
            raise ValueError("the picture must be a PNG of 20 MB or less")
        write_if_changed(PICTURE, data)
    write_if_changed(SETTINGS, (json.dumps({"style": style}) + "\n").encode())
    return apply()


def main(argv):
    try:
        if not argv:
            print(json.dumps({"style": load(), "picture": os.path.exists(PICTURE)}))
            return 0
        if argv == ["apply"]:
            changed = apply()
        elif argv[0] == "set" and len(argv) in (2, 3):
            changed = set_style(argv[1], argv[2] if len(argv) == 3 else None)
        else:
            print(__doc__.strip(), file=sys.stderr)
            return 2
    except (OSError, ValueError, subprocess.CalledProcessError) as exc:
        print(f"Couldn't change the start-up screen: {exc}", file=sys.stderr)
        return 1
    print("changed" if changed else "unchanged")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
