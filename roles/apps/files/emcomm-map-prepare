#!/usr/bin/env python3
"""Turn Natural Earth GeoJSON files into the station map's offline base map.

  emcomm-map-prepare SOURCE_DIR OUTPUT.js

Keeps only what the map draws (names, and roads in North America), rounds
coordinates to about 100 m, drops the points a line doesn't need to look the
same at the zooms it's drawn at, and writes two scripts the map page loads,
since a page opened from disk can't fetch files: OUTPUT.js (countries, lakes,
state lines, towns: always drawn) and OUTPUT-detail.js (counties and roads,
loaded the first time the map is zoomed in far enough to show them).

US town names come from the Census Bureau's gazetteer files, if SOURCE_DIR has
them (*_Gaz_place_national.zip and *_Gaz_cousubs_national.zip): every city,
town, village and census-designated place, plus New England's towns, which the
Census counts as county subdivisions rather than places.
"""

import csv
import glob
import io
import json
import math
import os
import re
import sys
import zipfile

ROAD_TYPES = {"Major Highway", "Secondary Highway", "Beltway", "Bypass"}
# How far (in degrees) a dropped point may sit from the line drawn without it. Counties
# and roads show from zoom 6, where a pixel is 0.02 degrees; the coarser 50 m sets
# are drawn at every zoom but hold no finer detail than this anyway.
TOLERANCE_10M = 0.002
TOLERANCE_50M = 0.005


def rounded(coords, digits):
    if isinstance(coords, (int, float)):
        return round(coords, digits)
    return [rounded(c, digits) for c in coords]


def simplify_line(points, tolerance):
    """Douglas-Peucker: the fewest of these points that trace the same line to within
    tolerance. The ends always stay, so a ring stays closed."""
    if len(points) < 3 or tolerance <= 0:
        return points
    keep = [False] * len(points)
    keep[0] = keep[-1] = True
    stack = [(0, len(points) - 1)]
    while stack:
        first, last = stack.pop()
        (x1, y1), (x2, y2) = points[first][:2], points[last][:2]
        dx, dy = x2 - x1, y2 - y1
        length2 = dx * dx + dy * dy
        worst, where = 0.0, None
        for i in range(first + 1, last):
            x, y = points[i][:2]
            if length2:
                t = max(0.0, min(1.0, ((x - x1) * dx + (y - y1) * dy) / length2))
                px, py = x1 + t * dx, y1 + t * dy
            else:
                px, py = x1, y1
            d = (x - px) ** 2 + (y - py) ** 2
            if d > worst:
                worst, where = d, i
        if where is not None and worst > tolerance * tolerance:
            keep[where] = True
            stack.append((first, where))
            stack.append((where, last))
    return [p for p, k in zip(points, keep) if k]


def simplified(coords, tolerance):
    """Simplify every line or ring in a GeoJSON coordinate array, whatever its depth."""
    if not coords or isinstance(coords[0], (int, float)):
        return coords  # a point
    if isinstance(coords[0][0], (int, float)):
        return simplify_line(coords, tolerance)  # a line or ring
    return [simplified(c, tolerance) for c in coords]


def load(src, name):
    with open(os.path.join(src, name + ".geojson"), encoding="utf-8") as f:
        return json.load(f)["features"]


def collection(features, props, digits=3, keep=lambda p: True, tolerance=0):
    out = []
    for feat in features:
        p = feat.get("properties") or {}
        geom = feat.get("geometry")
        if not geom or not keep(p):
            continue
        coords = rounded(simplified(geom["coordinates"], tolerance), digits)
        out.append({"type": "Feature",
                    "properties": {k: p.get(k) for k in props},
                    "geometry": {"type": geom["type"], "coordinates": coords}})
    return {"type": "FeatureCollection", "features": out}


# New England's towns are county subdivisions; elsewhere those are mostly
# townships and census areas, which would only crowd the map.
TOWN_STATES = {"CT", "MA", "ME", "NH", "RI", "VT"}
SUFFIX = re.compile(r"\s+(city|town|village|CDP|borough|municipality|plantation|township|"
                    r"comunidad|zona urbana|city and borough|unified government|"
                    r"metropolitan government|consolidated government|urban county)"
                    r"(\s+\(balance\))?$")


def gazetteer(path):
    """Rows of a Census gazetteer zip (tab-separated; the last header has trailing spaces)."""
    with zipfile.ZipFile(path) as z:
        name = next(n for n in z.namelist() if n.endswith(".txt"))
        with z.open(name) as f:
            reader = csv.reader(io.TextIOWrapper(f, encoding="latin-1"), delimiter="\t")
            header = [h.strip() for h in next(reader)]
            for row in reader:
                yield dict(zip(header, (v.strip() for v in row)))


def towns(src):
    """[lat, lon, name, tier] for US towns: tier 1 a city or town, 2 a village or CDP."""
    found = []
    for path in sorted(glob.glob(os.path.join(src, "*_Gaz_place_national.zip"))):
        for r in gazetteer(path):
            name = SUFFIX.sub("", r.get("NAME", ""))
            tier = 1 if re.search(r" (city|town|municipality|borough)$", r.get("NAME", "")) else 2
            found.append((float(r["INTPTLAT"]), float(r["INTPTLONG"]), name, tier))
    for path in sorted(glob.glob(os.path.join(src, "*_Gaz_cousubs_national.zip"))):
        for r in gazetteer(path):
            if r.get("USPS") in TOWN_STATES and r.get("FUNCSTAT") == "A" and r.get("NAME", "").endswith(" town"):
                found.append((float(r["INTPTLAT"]), float(r["INTPTLONG"]), SUFFIX.sub("", r["NAME"]), 1))
    # A New England town and its village of the same name: keep one, as a town.
    found.sort(key=lambda t: t[3])
    kept, seen = [], {}
    for lat, lon, name, tier in found:
        if any(abs(lat - a) < 0.08 and abs(lon - b) < 0.08 / math.cos(math.radians(lat))
               for a, b in seen.get(name, [])):
            continue
        seen.setdefault(name, []).append((lat, lon))
        kept.append([round(lat, 4), round(lon, 4), name, tier])
    return kept


def main(argv):
    if len(argv) != 2:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    src, dest = argv
    basemap = {
        "countries": collection(load(src, "ne_50m_admin_0_countries"), ["NAME"], tolerance=TOLERANCE_50M),
        "lakes": collection(load(src, "ne_50m_lakes"), [], tolerance=TOLERANCE_50M),
        "states": collection(load(src, "ne_50m_admin_1_states_provinces_lines"), [], tolerance=TOLERANCE_50M),
        "places": collection(load(src, "ne_10m_populated_places_simple"), ["name", "scalerank"], digits=4),
        "towns": towns(src),
    }
    detail = {
        "counties": collection(load(src, "ne_10m_admin_2_counties"), ["NAME", "REGION"], tolerance=TOLERANCE_10M),
        "roads": collection(load(src, "ne_10m_roads"), ["type"], tolerance=TOLERANCE_10M,
                            keep=lambda p: str(p.get("continent", "")).startswith("North America")
                            and p.get("type") in ROAD_TYPES),
    }
    write_script(detail_path(dest), "BASEMAP_DETAIL", detail)
    write_script(dest, "BASEMAP", basemap)
    return 0


def detail_path(dest):
    stem, ext = os.path.splitext(dest)
    return f"{stem}-detail{ext or '.js'}"


def write_script(dest, name, data):
    tmp = dest + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(f"window.{name} = ")
        json.dump(data, f, separators=(",", ":"))
        f.write(";\n")
    os.replace(tmp, dest)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
