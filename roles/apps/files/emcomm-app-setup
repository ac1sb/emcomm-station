#!/usr/bin/env python3
"""Fill in an app's settings from the station settings before it starts.

  emcomm-app-setup radio     write the radio in Settings > Radio into every app
                             installed (WSJT-X, JS8Call, fldigi, QSSTV, Pat, Xastir), skipping
                             any that's open; one JSON line per app
  emcomm-app-setup pat       callsign, grid and rig control in Pat's config
  emcomm-app-setup direwolf  write the Direwolf config and print its path
  emcomm-app-setup xastir    callsign and position from the grid in Xastir's config;
                             first run only: APRS through Direwolf's AGW port
  emcomm-app-setup js8call   callsign, grid and rig control
  emcomm-app-setup wsjtx     callsign, grid and rig control
  emcomm-app-setup fldigi    callsign, grid and rig control, and the radio put in the
                             mode for digital apps (DATA-U or USB), which fldigi doesn't set
  emcomm-app-setup qsstv     callsign, grid and rig control, and the radio put in the
                             mode for digital apps, like fldigi
  emcomm-app-setup flmsg     dates and times in UTC (2026-10-21, 1356Z), the full
                             window with flmsg's own forms, and the callsign if
                             flmsg has none yet

Every app reaches the radio through rigctld on 127.0.0.1:4532, which already
handles PTT the way Settings says (CAT, or RTS/DTR on a Digirig), so each app is
told to key the radio by CAT through it, or by VOX when the radio has no PTT.

Only the settings that say how to reach the radio (and the callsign and grid) are
written; everything else in an app's settings is the operator's and stays as it is.
Sound cards are left alone too: emcomm-audio moves radio apps onto the radio's sound
card. Before a file is changed, the old one is copied to
~/.local/state/emcomm/config-backups (the last 5 of each).

Nothing in WSJT-X, JS8Call, fldigi, QSSTV, Pat or Xastir is changed until the operator allows
it (Settings > Radio, saved as "allowed": true in ~/.config/emcomm/app-radio.json), and
an app listed there under "leave_alone" is never touched.
An app that's open writes its own settings back when it closes, so it's skipped and
gets the radio the next time it starts from its tile.
"""

import glob
import json
import os
import re
import shutil
import socket
import sys
import time

STATION_PATH = os.environ.get("EMCOMM_STATION", "/etc/emcomm/station.json")
HOME = os.path.expanduser("~")
RIGCTLD = os.environ.get("EMCOMM_RIGCTLD", "127.0.0.1:4532")
# A second radio running alongside (Settings > Radio > Radio 2): its own rigctld, and the
# apps picked for it in ~/.config/emcomm/app-radio.json under "radio2_apps".
RIGCTLD2 = os.environ.get("EMCOMM_RIGCTLD2", "127.0.0.1:4533")
RADIO2_PATH = os.environ.get("EMCOMM_RADIO2", "/etc/emcomm/radio2.json")
RADIO2_APPS = ("wsjtx", "js8call", "fldigi", "direwolf", "varafm")
# The radio's sound card through PipeWire, which emcomm-audio-default makes the
# default, so Direwolf can share it with JS8Call, fldigi and the recorder.
# Opening the card directly (plughw:CARD=rigaudio) would lock the others out.
RIG_AUDIO = "pipewire"
APRS_CARD = os.environ.get("EMCOMM_APRS_CARD", "/proc/asound/aprsaudio")  # Settings > APRS iGate
APP_RADIO = os.path.join(HOME, ".config/emcomm/app-radio.json")
BACKUPS = os.path.join(HOME, ".local/state/emcomm/config-backups")
KEEP_BACKUPS = 5
# What the radio is put in for digital modes: WSJT-X and JS8Call's "Mode" setting.
DATA_MODES = {"data": "data_mode_data", "usb": "data_mode_USB", "none": "data_mode_none"}
# Apps whose rig settings are written: (name shown, program, settings file under HOME).
RADIO_APPS = {
    "wsjtx": ("WSJT-X", "wsjtx", ".config/WSJT-X.ini"),
    "js8call": ("JS8Call", "js8call", ".config/JS8Call.ini"),
    "fldigi": ("fldigi", "fldigi", ".fldigi/fldigi_def.xml"),
    "qsstv": ("QSSTV", "qsstv", ".config/ON4QZ/qsstv_9.0.conf"),
    "pat": ("Pat", "pat", ".config/pat/config.json"),
    "xastir": ("Xastir", "xastir", ".xastir/config/xastir.cnf"),
}


def load_station():
    try:
        with open(STATION_PATH, encoding="utf-8") as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def write(path, text):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = f"{path}.tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(text)
    os.replace(tmp, path)


def read(path):
    try:
        with open(path, encoding="utf-8") as f:
            return f.read()
    except OSError:
        return None


def back_up(path):
    """Copy path to the backups folder before it's changed, keeping the last few. Returns the copy."""
    if not os.path.exists(path):
        return None
    os.makedirs(BACKUPS, exist_ok=True)
    name = os.path.basename(path)
    copy = os.path.join(BACKUPS, f"{name}.{time.strftime('%Y%m%dT%H%M%SZ', time.gmtime())}")
    shutil.copy2(path, copy)
    for old in sorted(glob.glob(os.path.join(BACKUPS, glob.escape(name) + ".*")))[:-KEEP_BACKUPS]:
        os.remove(old)
    return copy


def write_changed(path, text):
    """Write text to path if it differs, backing up the old file. (changed, backup path)."""
    if read(path) == text:
        return False, None
    backup = back_up(path)
    write(path, text)
    return True, backup


def app_radio():
    try:
        with open(APP_RADIO, encoding="utf-8") as f:
            saved = json.load(f)
    except (OSError, ValueError):
        return {}
    return saved if isinstance(saved, dict) else {}


def allowed():
    """The operator has said Emcomm-CNC may change other apps' settings."""
    return app_radio().get("allowed") is True


def leave_alone():
    names = app_radio().get("leave_alone", [])
    return {str(n) for n in names} if isinstance(names, list) else set()


def running(program):
    """True if a process of that name is running for anyone (the station has one operator)."""
    for comm in glob.glob("/proc/[0-9]*/comm"):
        try:
            with open(comm, encoding="utf-8") as f:
                if f.read().strip() == program[:15]:
                    return True
        except OSError:
            continue
    return False


def radio2():
    """The second radio's settings, or None when there isn't one."""
    try:
        with open(RADIO2_PATH, encoding="utf-8") as f:
            radio = json.load(f)
    except (OSError, ValueError):
        return None
    return radio if isinstance(radio, dict) and radio.get("radio_name") else None


def on_radio2(app):
    names = app_radio().get("radio2_apps", [])
    return isinstance(names, list) and app in names and radio2() is not None


def for_app(station, app):
    """The station settings as an app sees them: radio 2's rig control, PTT and mode for an
    app picked for radio 2, else radio 1's. "rig" is the rigctld address."""
    if on_radio2(app):
        r2 = radio2()
        return {**station, "ptt_method": r2.get("ptt_method"), "data_mode": r2.get("data_mode"), "rig": RIGCTLD2}
    return {**station, "rig": RIGCTLD}


def ptt_by_vox(station):
    """No PTT in Settings > Radio: the radio keys itself on the audio (VOX)."""
    return str(station.get("ptt_method", "CAT")).upper() == "NONE"


def setup_pat(station):
    path = os.path.join(HOME, ".config/pat/config.json")
    try:
        with open(path, encoding="utf-8") as f:
            cfg = json.load(f)
    except FileNotFoundError:
        cfg = {}
    if station.get("callsign"):
        cfg["mycall"] = station["callsign"]
    if station.get("grid"):
        cfg["locator"] = station["grid"]
    cfg.setdefault("http_addr", "localhost:8080")
    rigs = cfg.setdefault("hamlib_rigs", {})
    rigs["radio"] = {"address": RIGCTLD, "network": "tcp"}
    if radio2():
        rigs["radio2"] = {"address": RIGCTLD2, "network": "tcp"}
    for modem, addr in (("ardop", "localhost:8515"), ("varahf", "localhost:8300"), ("varafm", "localhost:8300")):
        section = cfg.setdefault(modem, {})
        section.setdefault("addr", addr)
        section.setdefault("rig", "radio")
        section.setdefault("ptt_ctrl", True)
    # VARA FM follows Settings > Radio > Apps… between the two radios.
    if on_radio2("varafm"):
        cfg["varafm"]["rig"] = "radio2"
    elif cfg["varafm"].get("rig") == "radio2":
        cfg["varafm"]["rig"] = "radio"
    # Packet goes through Direwolf's AGW port (emcomm-start packet).
    cfg.setdefault("ax25", {}).setdefault("engine", "agwpe")
    cfg.setdefault("agwpe", {"addr": "localhost:8000", "radio_port": 0})
    changed, backup = write_changed(path, json.dumps(cfg, indent=2) + "\n")
    return path, changed, backup


def setup_direwolf(station):
    station = for_app(station, "direwolf")
    custom = os.path.join(HOME, ".config/emcomm/direwolf.custom.conf")
    if os.path.exists(custom):
        return custom
    path = os.path.join(HOME, ".config/emcomm/direwolf.conf")
    write(path, "\n".join([
        "# Written by emcomm-app-setup each time Packet starts; edits are lost.",
        f"# To use your own settings, copy this file to {custom}",
        f"ADEVICE {RIG_AUDIO}",
        "CHANNEL 0",
        f"MYCALL {station.get('callsign', 'N0CALL')}",
        "MODEM 1200",
        # Hamlib model 2 is "NET rigctl": key the radio through rigctld. VOX needs no PTT line.
        "# PTT: none, the radio keys on the audio (VOX)" if ptt_by_vox(station)
        else f"PTT RIG 2 {station['rig'].replace('127.0.0.1', 'localhost')}",
        "AGWPORT 8000",
        "KISSPORT 8001",
        "",
    ]))
    return path


def grid_to_latlon(grid):
    """Centre of a Maidenhead grid square (4 or 6 characters), or None."""
    grid = grid.strip()
    if len(grid) not in (4, 6) or not grid[:2].isalpha() or not grid[2:4].isdigit():
        return None
    lon = (ord(grid[0].upper()) - ord("A")) * 20 - 180 + int(grid[2]) * 2
    lat = (ord(grid[1].upper()) - ord("A")) * 10 - 90 + int(grid[3])
    if len(grid) == 6:
        if not grid[4:].isalpha():
            return None
        lon += (ord(grid[4].lower()) - ord("a")) * 5 / 60 + 2.5 / 60
        lat += (ord(grid[5].lower()) - ord("a")) * 2.5 / 60 + 1.25 / 60
    else:
        lon, lat = lon + 1, lat + 0.5
    if not (-180 <= lon <= 180 and -90 <= lat <= 90):
        return None
    return lat, lon


def aprs_degrees(value, width, pos, neg):
    """Degrees as APRS writes them: DDMM.mmm with a hemisphere letter."""
    hemi = pos if value >= 0 else neg
    value = abs(value)
    deg = int(value)
    minutes = (value - deg) * 60
    return f"{deg:0{width}d}{minutes:06.3f}{hemi}"


def setup_xastir(station):
    path = os.path.join(HOME, ".xastir/config/xastir.cnf")
    try:
        with open(path, encoding="utf-8") as f:
            lines = f.read().splitlines()
    except FileNotFoundError:
        lines = []
    values = {}
    if station.get("callsign"):
        values["STATION_CALLSIGN"] = station["callsign"].upper()
    pos = grid_to_latlon(station.get("grid", ""))
    if pos:
        values["STATION_LAT"] = aprs_degrees(pos[0], 2, "N", "S")
        values["STATION_LONG"] = aprs_degrees(pos[1], 3, "E", "W")
    # Direwolf's AGW port: the APRS radio's (8010) when one is plugged in, else the
    # main radio's (8000). Changed only while it's still one of these two.
    port = "8010" if os.path.exists(APRS_CARD) else "8000"
    current = dict(line.split(":", 1) for line in lines if ":" in line)
    if current.get("DEVICE0_TYPE") == "12" and current.get("DEVICE0_HOST") == "localhost" \
            and current.get("DEVICE0_SPEED") in ("8000", "8010"):
        values["DEVICE0_SPEED"] = port
    if not any(line.startswith("DEVICE0_TYPE:") for line in lines):
        # Type 12 is "Networked AGWPE": Direwolf's AGW port, which emcomm-start
        # opens before Xastir starts. Direwolf keys the radio through rigctld.
        values.update({
            "DEVICE0_TYPE": "12",
            "DEVICE0_HOST": "localhost",
            "DEVICE0_SPEED": port,
            "DEVICE0_RADIO_PORT": "0",
            "DEVICE0_INTERFACE_COMMENT": "Radio (Direwolf)",
            "DEVICE0_UNPROTO1": "WIDE1-1,WIDE2-1",
            "DEVICE0_TXMT": "1",
            "DEVICE0_ONSTARTUP": "1",
            "DEVICE0_RECONN": "1",
        })
    kept = [line for line in lines if line.split(":", 1)[0] not in values]
    changed, backup = write_changed(path, "\n".join(kept + [f"{k}:{v}" for k, v in values.items()]) + "\n")
    return path, changed, backup


def qt_ini_keys(station):
    """The [Configuration] keys WSJT-X and JS8Call need to reach the radio through rigctld."""
    mode = DATA_MODES.get(station.get("data_mode"), DATA_MODES["data"])
    keys = {
        "Rig": "Hamlib NET rigctl",
        "CATNetworkPort": station.get("rig", RIGCTLD),
        "PTTMethod": "PTT_method_VOX" if ptt_by_vox(station) else "PTT_method_CAT",
        "DataMode": mode,
        # "Fake It": the transmit audio stays in the radio's passband by moving the
        # radio rather than the tone. Off on a radio left in its own mode (VHF FM).
        "SplitMode": "split_mode_none" if mode == DATA_MODES["none"] else "split_mode_emulate",
    }
    if station.get("callsign"):
        keys["MyCall"] = station["callsign"]
    if station.get("grid"):
        keys["MyGrid"] = station["grid"]
    return keys


def merge_qt_ini(text, keys, section="Configuration"):
    """Set keys in one [section] of a Qt settings file, keeping every other line."""
    lines = (text or "").splitlines()
    head = f"[{section}]"
    if head not in lines:
        if lines and lines[-1].strip():
            lines.append("")
        lines.append(head)
    start = lines.index(head) + 1
    end = next((i for i in range(start, len(lines)) if lines[i].startswith("[")), len(lines))
    todo = dict(keys)
    for i in range(start, end):
        key = lines[i].split("=", 1)[0]
        if "=" in lines[i] and key in todo:
            lines[i] = f"{key}={todo.pop(key)}"
    while end > start and not lines[end - 1].strip():
        end -= 1  # new keys go before the blank line that ends the section
    lines[end:end] = [f"{k}={v}" for k, v in todo.items()]
    return "\n".join(lines) + "\n"


def setup_qt_ini(station, name):
    path = os.path.join(HOME, ".config", name)
    changed, backup = write_changed(path, merge_qt_ini(read(path), qt_ini_keys(station)))
    return path, changed, backup


def fldigi_keys(station):
    """fldigi_def.xml settings: rig control by Hamlib through rigctld (model 2, "NET
    rigctl"), PTT by Hamlib's command, and not by its own RigCAT or flrig."""
    keys = {
        "CHKUSEHAMLIBIS": "1",
        "CHKUSERIGCATIS": "0",
        "CHKUSEXMLRPCIS": "0",
        "HAMRIGMODEL": "2",
        "HAMRIGNAME": "NET rigctl",
        "HAMRIGDEVICE": station.get("rig", RIGCTLD),
        "HAMLIBCMDPTT": "0" if ptt_by_vox(station) else "1",
    }
    if station.get("callsign"):
        keys["MYCALL"] = station["callsign"]
    if station.get("grid"):
        keys["MYLOC"] = station["grid"]
    return keys


def merge_fldigi(text, keys):
    """Set <KEY>value</KEY> elements in fldigi_def.xml, keeping the rest. A new file holds
    only these, which fldigi fills out with its defaults (and skips its first-run wizard)."""
    if not text or "</FLDIGI_DEFS>" not in text:
        text = '<?xml version="1.0" encoding="UTF-8"?>\n<FLDIGI_DEFS>\n</FLDIGI_DEFS>\n'
    for key, value in keys.items():
        value = value.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
        element = f"<{key}>{value}</{key}>"
        text, found = re.subn(rf"<{key}>.*?</{key}>", lambda _m: element, text, count=1, flags=re.S)
        if not found:
            text = text.replace("</FLDIGI_DEFS>", f"{element}\n</FLDIGI_DEFS>", 1)
    return text


def setup_fldigi(station):
    path = os.path.join(HOME, ".fldigi/fldigi_def.xml")
    changed, backup = write_changed(path, merge_fldigi(read(path), fldigi_keys(station)))
    return path, changed, backup


def setup_qsstv(station):
    """QSSTV's settings: CAT through rigctld (Hamlib "NET rigctl", which QSSTV names by the
    model number right-aligned in 5 characters; any other spelling and it can't find the
    model and quits), PTT by CAT or else VOX, and the callsign and locator. PTT is "CAT
    (Data port)" (Hamlib's RIG_PTT_RIG_MICDATA, 5), which sends "T 3" to rigctld: with "CAT
    (Voice port)" (1), Hamlib 4.5 refuses QSSTV's PTT ("Invalid parameter") and never keys."""
    path = os.path.join(HOME, RADIO_APPS["qsstv"][2])
    text = merge_qt_ini(read(path), {"enableCAT": "true", "radioModel": '"    2 Hamlib,NET rigctl"',
                                     "serialPort": station.get("rig", RIGCTLD), "pttType": "5"}, "radio1")
    text = merge_qt_ini(text, {"useVOX": "true" if ptt_by_vox(station) else "false"}, "TX")
    personal = {"callsign": station.get("callsign"), "locator": station.get("grid")}
    personal = {key: value for key, value in personal.items() if value}
    if personal:
        text = merge_qt_ini(text, personal, "PERSONAL")
    changed, backup = write_changed(path, text)
    return path, changed, backup


SETUP = {"wsjtx": lambda st: setup_qt_ini(for_app(st, "wsjtx"), "WSJT-X.ini"),
         "js8call": lambda st: setup_qt_ini(for_app(st, "js8call"), "JS8Call.ini"),
         "fldigi": lambda st: setup_fldigi(for_app(st, "fldigi")),
         "qsstv": lambda st: setup_qsstv(for_app(st, "qsstv")), "pat": setup_pat, "xastir": setup_xastir}


# Hamlib's names for the mode for digital apps; "none" leaves the radio as it is.
RIG_MODES = {"data": "PKTUSB", "usb": "USB"}


def rigctld(command, timeout=3, address=RIGCTLD):
    """One rigctld command; the first line of its answer, or None."""
    host, port = address.rsplit(":", 1)
    try:
        with socket.create_connection((host, int(port)), timeout=timeout) as s:
            s.settimeout(timeout)
            s.sendall(command.encode() + b"\n")
            data = s.recv(256).decode(errors="replace")
    except OSError:
        return None
    return data.splitlines()[0].strip() if data else None


def set_rig_mode(station):
    """Put the radio in the mode for digital apps, unless it's there already. True if changed."""
    want = RIG_MODES.get(station.get("data_mode") or "data")
    address = station.get("rig", RIGCTLD)
    if not want or rigctld("m", address=address) in (want, None):
        return False
    return rigctld(f"M {want} 0", address=address) == "RPRT 0"


def setup_radio(station):
    """Write the radio into every installed app's settings. [(app, name, state, backup)],
    state being updated, unchanged, open, left alone, not installed or not allowed."""
    skip = leave_alone()
    results = []
    for app, (name, program, rel) in RADIO_APPS.items():
        if not allowed():
            state, backup = "not allowed", None
        elif app in skip:
            state, backup = "left alone", None
        elif not shutil.which(program) and not os.path.exists(os.path.join(HOME, rel)):
            state, backup = "not installed", None
        elif running(program):
            state, backup = "open", None
        else:
            _path, changed, backup = SETUP[app](station)
            state = "updated" if changed else "unchanged"
        results.append((app, name, state, backup))
    return results


def setup_flmsg(station):
    """flmsg keeps its settings in ~/.nbems/flmsg.prefs (FLTK preferences: "key:value"
    lines). utc 2 writes times as HHMMZ in UTC, dtformat 0 dates as YYYY-MM-DD, and
    dt_fname 4 stamps file names with UTC (Z). UI_expert opens flmsg on its own forms
    (ICS-213 and the rest): its "Simple" window lists only HTML templates the station
    doesn't have, so New Message there shows an empty list. UI_default skips the
    first-run question that leads to it. Every other setting is left alone."""
    path = os.path.join(HOME, ".nbems/flmsg.prefs")
    try:
        with open(path, encoding="utf-8") as f:
            lines = f.read().splitlines()
    except OSError:
        lines = ["; FLTK preferences file format 1.0", "; vendor: w1hkj.com", "; application: flmsg", "", "[.]", ""]
    wanted = {"utc": "2", "dtformat": "0", "dt_fname": "4", "UI_default": "1", "UI_expert": "1"}
    if station.get("callsign"):
        wanted["mycall"] = station["callsign"]
    out = []
    for line in lines:
        key = line.split(":", 1)[0]
        if ":" in line and not line.startswith(";") and key in wanted:
            if key == "mycall" and line.split(":", 1)[1].strip():
                wanted.pop(key)  # the operator's own entry stays
                out.append(line)
                continue
            out.append(f"{key}:{wanted.pop(key)}")
        else:
            out.append(line)
    if "[.]" not in out:
        out.append("[.]")
    at = out.index("[.]") + 1
    out[at:at] = [f"{key}:{value}" for key, value in wanted.items()]
    write(path, "\n".join(out).rstrip("\n") + "\n")
    return path


def main(argv):
    if len(argv) != 1:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    station = load_station()
    app = argv[0]
    if app == "radio":
        for key, name, state, backup in setup_radio(station):
            print(json.dumps({"app": key, "name": name, "state": state, "backup": backup}))
        return 0
    if app in SETUP:
        if not allowed() or app in leave_alone():  # the operator sets this app up by hand
            path = os.path.join(HOME, RADIO_APPS[app][2])
        else:
            path = SETUP[app](station)[0]
            if app in ("fldigi", "qsstv"):  # neither puts the radio in a mode itself
                set_rig_mode(for_app(station, app))
    elif app == "direwolf":
        path = setup_direwolf(station)
    elif app == "flmsg":
        path = setup_flmsg(station)
    else:
        print(f"unknown app: {app}", file=sys.stderr)
        return 2
    print(path)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
