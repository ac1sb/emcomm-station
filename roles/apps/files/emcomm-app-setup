#!/usr/bin/env python3
"""Fill in an app's settings from the station settings before it starts.

  emcomm-app-setup pat       callsign, grid and rig control in Pat's config
  emcomm-app-setup direwolf  write the Direwolf config and print its path
  emcomm-app-setup xastir    callsign and position from the grid in Xastir's config;
                             first run only: APRS through Direwolf's AGW port
  emcomm-app-setup js8call   first run only: callsign, grid and rig control
  emcomm-app-setup wsjtx     first run only: callsign, grid and rig control
  emcomm-app-setup flmsg     dates and times in UTC (2026-10-21, 1356Z), and the
                             callsign if flmsg has none yet

Every app reaches the radio through rigctld on 127.0.0.1:4532, which already
handles PTT the way Settings says, so each app is told to key the radio by CAT
through it. Callsign and grid follow Settings every time for Pat and Direwolf;
JS8Call and WSJT-X keep their own settings once they exist, so changes made in
those apps stick.
"""

import json
import os
import sys

STATION_PATH = os.environ.get("EMCOMM_STATION", "/etc/emcomm/station.json")
HOME = os.path.expanduser("~")
RIGCTLD = "127.0.0.1:4532"
# The radio's sound card through PipeWire, which emcomm-audio-default makes the
# default, so Direwolf can share it with JS8Call, fldigi and the recorder.
# Opening the card directly (plughw:CARD=rigaudio) would lock the others out.
RIG_AUDIO = "pipewire"
APRS_CARD = os.environ.get("EMCOMM_APRS_CARD", "/proc/asound/aprsaudio")  # Settings > APRS iGate


def load_station():
    try:
        with open(STATION_PATH, encoding="utf-8") as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def write(path, text):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = f"{path}.tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(text)
    os.replace(tmp, path)


def setup_pat(station):
    path = os.path.join(HOME, ".config/pat/config.json")
    try:
        with open(path, encoding="utf-8") as f:
            cfg = json.load(f)
    except FileNotFoundError:
        cfg = {}
    if station.get("callsign"):
        cfg["mycall"] = station["callsign"]
    if station.get("grid"):
        cfg["locator"] = station["grid"]
    cfg.setdefault("http_addr", "localhost:8080")
    cfg.setdefault("hamlib_rigs", {})["radio"] = {"address": RIGCTLD, "network": "tcp"}
    for modem, addr in (("ardop", "localhost:8515"), ("varahf", "localhost:8300"), ("varafm", "localhost:8300")):
        section = cfg.setdefault(modem, {})
        section.setdefault("addr", addr)
        section.setdefault("rig", "radio")
        section.setdefault("ptt_ctrl", True)
    # Packet goes through Direwolf's AGW port (emcomm-start packet).
    cfg.setdefault("ax25", {}).setdefault("engine", "agwpe")
    cfg.setdefault("agwpe", {"addr": "localhost:8000", "radio_port": 0})
    write(path, json.dumps(cfg, indent=2) + "\n")
    return path


def setup_direwolf(station):
    custom = os.path.join(HOME, ".config/emcomm/direwolf.custom.conf")
    if os.path.exists(custom):
        return custom
    path = os.path.join(HOME, ".config/emcomm/direwolf.conf")
    write(path, "\n".join([
        "# Written by emcomm-app-setup each time Packet starts; edits are lost.",
        f"# To use your own settings, copy this file to {custom}",
        f"ADEVICE {RIG_AUDIO}",
        "CHANNEL 0",
        f"MYCALL {station.get('callsign', 'N0CALL')}",
        "MODEM 1200",
        # Hamlib model 2 is "NET rigctl": key the radio through rigctld.
        f"PTT RIG 2 {RIGCTLD.replace('127.0.0.1', 'localhost')}",
        "AGWPORT 8000",
        "KISSPORT 8001",
        "",
    ]))
    return path


def grid_to_latlon(grid):
    """Centre of a Maidenhead grid square (4 or 6 characters), or None."""
    grid = grid.strip()
    if len(grid) not in (4, 6) or not grid[:2].isalpha() or not grid[2:4].isdigit():
        return None
    lon = (ord(grid[0].upper()) - ord("A")) * 20 - 180 + int(grid[2]) * 2
    lat = (ord(grid[1].upper()) - ord("A")) * 10 - 90 + int(grid[3])
    if len(grid) == 6:
        if not grid[4:].isalpha():
            return None
        lon += (ord(grid[4].lower()) - ord("a")) * 5 / 60 + 2.5 / 60
        lat += (ord(grid[5].lower()) - ord("a")) * 2.5 / 60 + 1.25 / 60
    else:
        lon, lat = lon + 1, lat + 0.5
    if not (-180 <= lon <= 180 and -90 <= lat <= 90):
        return None
    return lat, lon


def aprs_degrees(value, width, pos, neg):
    """Degrees as APRS writes them: DDMM.mmm with a hemisphere letter."""
    hemi = pos if value >= 0 else neg
    value = abs(value)
    deg = int(value)
    minutes = (value - deg) * 60
    return f"{deg:0{width}d}{minutes:06.3f}{hemi}"


def setup_xastir(station):
    path = os.path.join(HOME, ".xastir/config/xastir.cnf")
    try:
        with open(path, encoding="utf-8") as f:
            lines = f.read().splitlines()
    except FileNotFoundError:
        lines = []
    values = {}
    if station.get("callsign"):
        values["STATION_CALLSIGN"] = station["callsign"].upper()
    pos = grid_to_latlon(station.get("grid", ""))
    if pos:
        values["STATION_LAT"] = aprs_degrees(pos[0], 2, "N", "S")
        values["STATION_LONG"] = aprs_degrees(pos[1], 3, "E", "W")
    # Direwolf's AGW port: the APRS radio's (8010) when one is plugged in, else the
    # main radio's (8000). Changed only while it's still one of these two.
    port = "8010" if os.path.exists(APRS_CARD) else "8000"
    current = dict(line.split(":", 1) for line in lines if ":" in line)
    if current.get("DEVICE0_TYPE") == "12" and current.get("DEVICE0_HOST") == "localhost" \
            and current.get("DEVICE0_SPEED") in ("8000", "8010"):
        values["DEVICE0_SPEED"] = port
    if not any(line.startswith("DEVICE0_TYPE:") for line in lines):
        # Type 12 is "Networked AGWPE": Direwolf's AGW port, which emcomm-start
        # opens before Xastir starts. Direwolf keys the radio through rigctld.
        values.update({
            "DEVICE0_TYPE": "12",
            "DEVICE0_HOST": "localhost",
            "DEVICE0_SPEED": port,
            "DEVICE0_RADIO_PORT": "0",
            "DEVICE0_INTERFACE_COMMENT": "Radio (Direwolf)",
            "DEVICE0_UNPROTO1": "WIDE1-1,WIDE2-1",
            "DEVICE0_TXMT": "1",
            "DEVICE0_ONSTARTUP": "1",
            "DEVICE0_RECONN": "1",
        })
    kept = [line for line in lines if line.split(":", 1)[0] not in values]
    write(path, "\n".join(kept + [f"{k}:{v}" for k, v in values.items()]) + "\n")
    return path


def setup_qt_ini(station, name):
    path = os.path.join(HOME, ".config", name)
    if os.path.exists(path):
        return path
    write(path, "\n".join([
        "[Configuration]",
        f"MyCall={station.get('callsign', '')}",
        f"MyGrid={station.get('grid', '')}",
        "Rig=Hamlib NET rigctl",
        f"CATNetworkPort={RIGCTLD}",
        "PTTMethod=PTT_method_CAT",
        "",
    ]))
    return path


def setup_flmsg(station):
    """flmsg keeps its settings in ~/.nbems/flmsg.prefs (FLTK preferences: "key:value"
    lines). utc 2 writes times as HHMMZ in UTC, dtformat 0 dates as YYYY-MM-DD, and
    dt_fname 4 stamps file names with UTC (Z). Every other setting is left alone."""
    path = os.path.join(HOME, ".nbems/flmsg.prefs")
    try:
        with open(path, encoding="utf-8") as f:
            lines = f.read().splitlines()
    except OSError:
        lines = ["; FLTK preferences file format 1.0", "; vendor: w1hkj.com", "; application: flmsg", "", "[.]", ""]
    wanted = {"utc": "2", "dtformat": "0", "dt_fname": "4"}
    if station.get("callsign"):
        wanted["mycall"] = station["callsign"]
    out = []
    for line in lines:
        key = line.split(":", 1)[0]
        if ":" in line and not line.startswith(";") and key in wanted:
            if key == "mycall" and line.split(":", 1)[1].strip():
                wanted.pop(key)  # the operator's own entry stays
                out.append(line)
                continue
            out.append(f"{key}:{wanted.pop(key)}")
        else:
            out.append(line)
    if "[.]" not in out:
        out.append("[.]")
    at = out.index("[.]") + 1
    out[at:at] = [f"{key}:{value}" for key, value in wanted.items()]
    write(path, "\n".join(out).rstrip("\n") + "\n")
    return path


def main(argv):
    if len(argv) != 1:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    station = load_station()
    app = argv[0]
    if app == "pat":
        path = setup_pat(station)
    elif app == "direwolf":
        path = setup_direwolf(station)
    elif app == "xastir":
        path = setup_xastir(station)
    elif app == "js8call":
        path = setup_qt_ini(station, "JS8Call.ini")
    elif app == "wsjtx":
        path = setup_qt_ini(station, "WSJT-X.ini")
    elif app == "flmsg":
        path = setup_flmsg(station)
    else:
        print(f"unknown app: {app}", file=sys.stderr)
        return 2
    print(path)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
