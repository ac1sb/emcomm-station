def pick_for_gqrx():
    """Ask which receiver Gqrx should use (only if there's a choice) and print it for emcomm-start:
    key, Gqrx device string, sample rate, start frequency (Hz), 1 if it's the weather radio's dongle, tab-separated."""
    choices = gqrx_choices(receivers())
    chosen = choices[0] if len(choices) == 1 else None
    if len(choices) != 1:
        Gtk, _GLib = gtk_with_theme()
        dialog = Gtk.Dialog(title="Which receiver?", modal=True)
        dialog.set_default_size(620, -1)
        dialog.set_position(Gtk.WindowPosition.CENTER)
