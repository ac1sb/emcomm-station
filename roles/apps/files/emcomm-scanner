def hang_rule(choice):
    """(seconds to stay from when a signal is found, or None; seconds to wait once it goes quiet)."""
    choice = str(choice or "")
    if choice.startswith("quiet") and choice[5:].isdigit():
        return None, float(choice[5:])
    if choice.isdigit() and int(choice) > 0:
        return float(choice), None
    return None, HANG


# ---- channel list -------------------------------------------------------

def _col(row, *names):
    for name in names:
        for key, value in row.items():
            if key and key.strip().lower() == name:
                return (value or "").strip()
    return ""


def parse_tone(text):
    """('pl', 118.8), ('dpl', '023') or (None, None) for none/CSQ/anything else."""
    text = (text or "").strip().upper()
    m = re.fullmatch(r"(\d{2,3}(?:\.\d)?)\s*(?:PL|HZ)?", text)
    if m and 60 <= float(m.group(1)) <= 260 and ("." in m.group(1) or "PL" in text):
        return "pl", float(m.group(1))
    m = re.fullmatch(r"D?(\d{3})\s*[NI]?\s*(?:DPL|DCS)?", text)
    if m and ("DPL" in text or "DCS" in text or text.startswith("D")):
        return "dpl", m.group(1)
    return None, None


def channel_key(ch):
    return f"{ch['mhz']:.4f} {ch['name']}"


def default_mode(mhz):
    """AM in the aircraft band, FM everywhere else the scanner goes."""
    return "AM" if 108 <= mhz < 137 else "FM"


def load_channels(path=None):
    """The channels in a CSV list, in file order; rows without a usable frequency are skipped.
    The operator's own list also gets the station's airband channels it doesn't already have."""
    path = path or CHANNELS
    channels = read_channels(path)
    if path == CHANNELS and os.path.exists(AIRBAND_LIST):
        have = {ch["mhz"] for ch in channels}
        channels += [ch for ch in read_channels(AIRBAND_LIST) if ch["mhz"] not in have]
    return channels


def read_channels(path):
    with open(path, encoding="utf-8-sig", newline="") as f:
        rows = list(csv.DictReader(f))
    channels = []
    for row in rows:
        try:
            mhz = float(_col(row, "frequency", "frequency output", "freq", "mhz"))
        except ValueError:
            continue
        if mhz > 10000:  # given in Hz
            mhz /= 1e6
        if not 0.1 <= mhz <= 6000:  # what any receiver here tunes
            continue
        try:
            lat, lon = float(_col(row, "latitude", "lat")), float(_col(row, "longitude", "lon"))
        except ValueError:
            lat = lon = None
        tone_kind, tone = parse_tone(_col(row, "tone", "pl tone", "ctcss"))
        mode = _col(row, "mode").upper() or default_mode(mhz)
        ch = {"mhz": round(mhz, 5),
              "name": _col(row, "alpha tag", "name", "tag", "description")[:24] or f"{mhz:.4f}",
              "group": _col(row, "group", "tag", "category", "service type") or "Channels",
              "agency": _col(row, "agency", "description", "department"),
              "county": _col(row, "county"),
              "tone_text": _col(row, "tone", "pl tone", "ctcss"),
              "tone_kind": tone_kind, "tone": tone, "mode": mode,
              "lat": lat, "lon": lon}
        if mode in ("P25", "DMR", "NXDN", "D-STAR", "DSTAR", "TETRA"):
            ch["unsupported"] = mode  # listed, but the scanner only plays analog FM and AM
        channels.append(ch)
    return channels


def manual_channel(mhz, name=None):
    """A channel typed in on the Tune pad rather than taken from the list."""
    return {"mhz": round(mhz, 5), "name": name or "Manual", "group": "Manual", "agency": "",
            "county": "", "tone_text": "", "tone_kind": None, "tone": None, "mode": default_mode(mhz),
            "lat": None, "lon": None, "miles": None, "manual": True}


def parse_mhz(text):
    """MHz from what was typed ("155.475", "155,475", "155475000" Hz), or None if no receiver tunes it."""
    try:
        mhz = float(text.strip().replace(",", "."))
    except ValueError:
        return None
    if mhz > 10000:
        mhz /= 1e6
    return round(mhz, 5) if 0.1 <= mhz <= 6000 else None


def append_channel(path, mhz, name, group="My channels"):
    """Add a channel to the end of a CSV list, filling whichever of its columns fit."""
    fields = None
    if os.path.exists(path):
        with open(path, encoding="utf-8-sig", newline="") as f:
            fields = next(csv.reader(f), None)
    if not fields:
        fields = ["Group", "Alpha Tag", "Agency", "County", "Frequency", "Callsign", "Tone"]
        with open(path, "w", encoding="utf-8", newline="") as f:
            csv.writer(f).writerow(fields)
    wanted = {"frequency": f"{mhz:.4f}", "frequency output": f"{mhz:.4f}", "freq": f"{mhz:.4f}",
              "mhz": f"{mhz:.4f}", "alpha tag": name, "name": name, "group": group, "mode": default_mode(mhz)}
    row, named = [], False
    for field in fields:
        key = field.strip().lower()
        value = wanted.get(key, "")
        if key in ("alpha tag", "name"):
            value, named = ("", True) if named else (value, True)
        row.append(value)
    with open(path, "rb+") as f:  # start on a new line even if the file doesn't end with one
        f.seek(0, os.SEEK_END)
        if f.tell():
            f.seek(-1, os.SEEK_END)
            if f.read(1) not in (b"\n", b"\r"):
                f.write(b"\n")
    with open(path, "a", encoding="utf-8", newline="") as f:
        csv.writer(f).writerow(row)


