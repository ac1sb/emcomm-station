# What each SoapySDR driver is assumed to do when it can't be asked (it's busy):
# (scanner sample rate, Gqrx sample rate, lowest MHz, highest MHz).
DRIVER_DEFAULTS = {
    "rtlsdr": (240000, 1800000, 24, 1766), "airspyhf": (192000, 768000, 0.009, 260),
    "airspy": (2500000, 2500000, 24, 1800), "hackrf": (2000000, 2000000, 1, 6000),
    "sdrplay": (2000000, 2000000, 0.001, 2000), "lime": (2000000, 2000000, 0.1, 3800),
    "uhd": (1000000, 1000000, 10, 6000), "bladerf": (2000000, 2000000, 47, 6000),
}
GENERIC = (2000000, 2000000, 24, 1766)
# Asked for by name, so SoapySDR doesn't also list sound cards and network servers as receivers.
RECEIVER_DRIVERS = ["rtlsdr", "airspyhf", "airspy", "hackrf", "sdrplay", "lime", "bladerf", "uhd", "plutosdr"]
HF_BELOW = 10  # MHz: a receiver reaching below this covers the HF bands that matter


def soapy():
    try:
        import SoapySDR  # python3-soapysdr
    except ImportError:
        return None
    SoapySDR.setLogLevel(SoapySDR.SOAPY_SDR_CRITICAL)
    return SoapySDR


def _pick_rate(rates, ranges, want, ceiling=None):
    """The smallest supported rate at or above want (or the largest there is)."""
    choices = sorted(r for r in rates if r > 0)
    for lo, hi in ranges:
        if lo <= want <= hi:
            choices.append(float(want))
        elif lo > want:
            choices.append(float(lo))
    above = sorted(r for r in choices if r >= want and (ceiling is None or r <= ceiling))
    return int(above[0]) if above else int(max(choices)) if choices else None


def _probe(sd, args):
    """(scan rate, gqrx rate, low MHz, high MHz) asked of the device itself, or None if it's busy."""
    rx = sd.SOAPY_SDR_RX
    try:
        dev = sd.Device(args)
    except Exception:  # busy or no permission: SoapySDR raises RuntimeError
        return None
    try:
        rates = list(dev.listSampleRates(rx, 0))
        ranges = [(r.minimum(), r.maximum()) for r in dev.getSampleRateRange(rx, 0)]
        freqs = [(r.minimum(), r.maximum()) for r in dev.getFrequencyRange(rx, 0)]
        scan = _pick_rate(rates, ranges, 192000, ceiling=3000000)
        gqrx = _pick_rate(rates, ranges, 1500000)
        if not (scan and gqrx and freqs):
            return None
        return scan, gqrx, min(f[0] for f in freqs) / 1e6, max(f[1] for f in freqs) / 1e6
    except Exception:
        return None
    finally:
        del dev


def adsb_serial():
    """The serial number of the RTL-SDR kept for ADS-B, or None with ADS-B off."""
    try:
        with open(ADSB_CONFIG, encoding="utf-8") as f:
            config = json.load(f)
    except (OSError, ValueError):
        config = {}
    if not isinstance(config, dict) or config.get("off"):
        return None
    return str(config.get("serial") or ADSB_MARK)


def receivers(probe=True):
    """Every SDR receiver plugged in, as dicts: key, label, driver, args, scan_rate, gqrx_rate,
    low_mhz, high_mhz, gqrx (Gqrx's device string), rtl_index (-1 if not an RTL-SDR), and
    nwr (the dongle the weather radio listener uses). The ADS-B dongle is left out."""
    sd = soapy()
    adsb = adsb_serial()
    found, rtl_count = [], 0
    if sd:
        listed = []
        for driver in RECEIVER_DRIVERS:
            try:
                listed += [dict(a) for a in sd.Device.enumerate(f"driver={driver}")]
            except Exception:  # no module for it
                pass
    else:  # without SoapySDR, RTL-SDR dongles only, from sysfs
        listed = [{"driver": "rtlsdr", "label": "RTL-SDR dongle"} for _ in range(usb_dongles())]
    for args in listed:
        args = {k: str(v) for k, v in args.items()}
        driver = args.get("driver", "")
        if driver in ("audio", "remote", "") or args.get("remote"):
            continue  # sound cards and network devices aren't receivers plugged in here
        scan, gqrx, low, high = DRIVER_DEFAULTS.get(driver, GENERIC)
        if probe and sd and driver != "rtlsdr":  # an RTL may be in use by the weather radio listener
            scan, gqrx, low, high = _probe(sd, args) or (scan, gqrx, low, high)
        rtl_index = -1
        if driver == "rtlsdr":
            rtl_index, rtl_count = rtl_count, rtl_count + 1
            if adsb and args.get("serial") == adsb:
                continue  # kept for ADS-B; still counted, as librtlsdr numbers it
        label = args.get("label") or " ".join(x for x in (args.get("manufacturer"), args.get("product")) if x) \
            or driver
        serial = args.get("serial", "")
        key = re.sub(r"[^a-z0-9]+", "-", f"{driver}-{serial or rtl_index if driver == 'rtlsdr' else serial}".lower())
        key = key.strip("-") or driver
        if driver == "rtlsdr":
            device = f"rtl={serial or rtl_index}" if serial and serial != "00000001" else f"rtl={rtl_index}"
            if "V4" in label.upper():
                low = 0.5  # the RTL-SDR Blog V4 has an HF upconverter built in
        else:
            device = "soapy=0," + ",".join(f"{k}={args[k]}" for k in ("driver", "serial") if args.get(k))
        found.append({"key": key, "label": label, "driver": driver, "args": args, "scan_rate": scan,
                      "gqrx_rate": gqrx, "low_mhz": low, "high_mhz": high, "gqrx": device,
                      "rtl_index": rtl_index, "nwr": False})
    rtls = [rx for rx in found if rx["driver"] == "rtlsdr"]
    if rtls:
        rtls[0]["nwr"] = True
    keys = set()
    for rx in found:  # two receivers with no serial number: keep keys apart
        while rx["key"] in keys:
            rx["key"] += "-2"
        keys.add(rx["key"])
    return found


def gqrx_choices(rxs):
    """What the Gqrx tile offers: each receiver, plus an HF entry for an RTL-SDR that needs direct sampling."""
    choices = []
    for rx in rxs:
        hf = rx["low_mhz"] < HF_BELOW
        reach = (f"{fmt_mhz(rx['low_mhz'])} to {fmt_mhz(rx['high_mhz'])}"
                 + ("  ·  HF and up" if hf else ""))
        choices.append(dict(rx, detail=reach, start_hz=7200000 if hf else 162550000))
        if rx["driver"] == "rtlsdr" and not hf:
            choices.append(dict(rx, key=rx["key"] + "-hf", label=rx["label"] + " on HF (direct sampling)",
                                gqrx=rx["gqrx"] + ",direct_samp=2", low_mhz=0.5, high_mhz=28.8,
                                detail="0.5 to 28.8 MHz with an HF antenna on the dongle's input. "
                                       "Works on RTL-SDR Blog V3 and similar; deafer than a real HF receiver.",
                                start_hz=7200000))
    return choices


def morse_keying(text, rate, wpm=18):
    """1/0 per sample for text sent in Morse code."""
    codes = {"C": "-.-.", "Q": "--.-", "D": "-..", "E": ".", "M": "--", "O": "---", " ": " "}
    dot = int(rate * 1.2 / wpm)
    out = []
    for ch in text:
        if ch == " ":
            out.append(np.zeros(dot * 4))
            continue
        for sym in codes[ch]:
            out += [np.ones(dot * (3 if sym == "-" else 1)), np.zeros(dot)]
        out.append(np.zeros(dot * 2))
    return np.concatenate(out)


def practice_recording(path=PRACTICE, rate=PRACTICE_RATE, seconds=6):
    """A made-up recording around 146.5 MHz for Gqrx to play with no receiver: an FM
    signal on 146.520 (a tone, on and off), Morse code on 146.455 and a steady
    carrier on 146.580, over noise. Written once, as complex float32."""
    if os.path.exists(path):
        return path
    rng = np.random.default_rng(1)
    n = rate * seconds
    t = np.arange(n) / rate
    iq = (rng.standard_normal(n) + 1j * rng.standard_normal(n)) * 0.02
    talking = (t % 3) < 2  # two seconds on, one off
    audio = np.sin(2 * np.pi * 800 * t) * 0.6 + np.sin(2 * np.pi * 1300 * t) * 0.4
    phase = 2 * np.pi * np.cumsum(20000 + 2500 * audio * talking) / rate
    iq += talking * 0.25 * np.exp(1j * phase)
    keying = np.resize(morse_keying("CQ CQ DE EMCOMM ", rate), n)
    iq += keying * 0.08 * np.exp(2j * np.pi * -45000 * t)
    iq += 0.03 * np.exp(2j * np.pi * 80000 * t)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    iq.astype(np.complex64).tofile(path + ".tmp")
    os.replace(path + ".tmp", path)
    return path


def practice_choice():
    return {"key": "practice", "label": "Practice signal (no receiver)",
            "detail": "A made-up recording around 146.5 MHz, played over and over, to learn Gqrx with.",
            "gqrx": f"file={PRACTICE},rate={PRACTICE_RATE},freq={PRACTICE_HZ},repeat=true,throttle=true",
            "gqrx_rate": PRACTICE_RATE, "start_hz": PRACTICE_HZ + 20000, "rtl_index": -1}


def network_choice(address):
    """Gqrx on an RTL-SDR shared over the network by rtl_tcp (host:port)."""
    host, _, port = address.strip().partition(":")
    port = port if port.isdigit() else "1234"
    return {"key": "net-" + re.sub(r"[^A-Za-z0-9.-]", "-", host) + "-" + port,
            "label": f"Network receiver {host}:{port}", "gqrx": f"rtl_tcp={host}:{port}",
            "gqrx_rate": 1024000, "start_hz": 162550000, "rtl_index": -1}


def fmt_mhz(mhz):
    if mhz >= 1000:
        return f"{mhz / 1000:g} GHz"
    if mhz < 1:
        return f"{mhz * 1000:g} kHz"
    return f"{mhz:g} MHz"


def pick_receiver(key, rxs, nwr):
    """The receiver the scanner uses: the one chosen, else one that leaves the weather radio its dongle."""
    for rx in rxs:
        if key and rx["key"] == key:
            return rx
    rtls = [rx for rx in rxs if rx["driver"] == "rtlsdr"]
    others = [rx for rx in rxs if rx["driver"] != "rtlsdr" and rx["high_mhz"] >= 150]
    if nwr and others:
        return others[0]
    if nwr and len(rtls) > 1:
        return rtls[1]
    return (rtls + others)[0] if rtls or others else None


# ---- signal processing ----------------------------------------------------

def lowpass(cutoff, rate, taps):
    n = np.arange(taps) - (taps - 1) / 2
    h = np.sinc(2 * cutoff / rate * n) * np.hamming(taps)
    return (h / h.sum()).astype(np.float32)


def bandpass(low, high, rate, taps):
    h = lowpass(high, rate, taps) - lowpass(low, rate, taps)
    return h.astype(np.float32)


class Decimator:
    """Low-pass filter and keep every nth sample, carrying state from block to block."""

    def __init__(self, taps, factor):
        self.taps, self.factor = taps, factor
        self.reset()

    def reset(self):
        self.tail = np.zeros(len(self.taps) - 1, np.complex64)
        self.offset = 0

    def __call__(self, x):
        joined = np.concatenate([self.tail, x])
        self.tail = joined[-(len(self.taps) - 1):]
        filtered = np.convolve(joined, self.taps, mode="valid")
        out = filtered[self.offset::self.factor]
        self.offset = (self.offset - len(filtered)) % self.factor
        return out


class Demod:
    """Narrow FM from one channel of IQ at any sample rate: audio near 48 kHz, plus how much hiss is left.

    A fast receiver (HackRF, Airspy, SDRplay: 2 MS/s and up) first comes down to
    200-400 kS/s through a short filter, then the 7.5 kHz channel filter takes it
    to about 48 kHz. An RTL-SDR at 240 kS/s goes straight to the channel filter."""

    def __init__(self, rate=RATE):
        self.rate = rate
        first = max(1, int(rate // 200000))
        mid = rate / first
        second = max(1, round(mid / 48000))
        self.audio_rate = mid / second
        self.stages = []
        if first > 1:
            self.stages.append(Decimator(lowpass(0.4 * mid, rate, 8 * first + 1), first))
        self.stages.append(Decimator(lowpass(7500, mid, int(97 * mid / RATE) | 1), second))
        self.audio_taps = bandpass(300, 3400, self.audio_rate, 511)
        self.reset()

    def reset(self):
        self.phase = 0
        for stage in self.stages:
            stage.reset()
        self.audio_tail = np.zeros(len(self.audio_taps) - 1, np.float32)
        self.last = np.complex64(1)

    def channel(self, iq):
        """Mix the channel down to 0 Hz, filter it and drop to about 48 kS/s."""
        n = np.arange(self.phase, self.phase + len(iq))
        self.phase = (self.phase + len(iq)) % int(self.rate)
        mixed = (iq * np.exp(-2j * np.pi * OFFSET / self.rate * n)).astype(np.complex64)
        for stage in self.stages:
            mixed = stage(mixed)
        return mixed

    def discriminate(self, base):
        joined = np.concatenate([[self.last], base])
        self.last = base[-1] if len(base) else self.last
        return np.angle(joined[1:] * np.conj(joined[:-1])).astype(np.float32)

    def process(self, iq):
        """(audio -1..1 with the PL tone removed, raw discriminator output, hiss 0..~1)."""
        fm = self.discriminate(self.channel(iq))
        return self.audio(fm), fm, hiss(fm, self.audio_rate)

    def audio(self, fm):
        joined = np.concatenate([self.audio_tail, fm])
        self.audio_tail = joined[-(len(self.audio_taps) - 1):]
        voice = np.convolve(joined, self.audio_taps, mode="valid")
        return np.clip(voice / (2 * np.pi * DEVIATION / self.audio_rate), -1, 1)


class AMDemod(Demod):
    """AM (the aircraft band) from one channel of IQ: the envelope, scaled by the carrier,
    plus how far the channel stands above the noise floor around it (as for FM: about 1
    with nothing there, lower as a signal comes up)."""

    def process(self, iq):
        env = np.abs(self.channel(iq)).astype(np.float32)
        joined = np.concatenate([self.audio_tail, env])
        self.audio_tail = joined[-(len(self.audio_taps) - 1):]
        voice = np.convolve(joined, self.audio_taps, mode="valid")
        carrier = max(float(env.mean()), 1e-9) if len(env) else 1.0
        return np.clip(voice / carrier, -1, 1), env, am_level(iq, self.rate)


def am_level(iq, rate):
    """Noise floor over the channel's power: about 1 with no carrier, falling as one comes up.
    The floor is the median across 200 kHz around the tuned centre, so a few busy
    neighbouring channels don't raise it."""
    if len(iq) < 1024:
        return 1.0
    spec = np.abs(np.fft.fft(iq * np.hanning(len(iq)))) ** 2
    freqs = np.fft.fftfreq(len(iq), 1 / rate)
    chan = np.abs(freqs - OFFSET) <= 3000
    ref = ((np.abs(freqs) <= min(100000, 0.4 * rate)) & (np.abs(freqs) >= 5000)
           & (np.abs(freqs - OFFSET) > 12500))
    floor = np.median(spec[ref]) / math.log(2)  # the median of noise power is ln 2 of its mean
    return float(floor / max(spec[chan].mean(), 1e-30))


def demod_for(ch, demods):
    return demods["AM" if ch.get("mode") == "AM" else "FM"]


def hiss(fm, audio_rate=AUDIO_RATE):
    """Discriminator power from 6 to 11 kHz, relative to what no signal gives (about 1)."""
    if len(fm) < 256:
        return 1.0
    spec = np.abs(np.fft.rfft(fm * np.hanning(len(fm)))) ** 2
    freqs = np.fft.rfftfreq(len(fm), 1 / audio_rate)
    band = spec[(freqs >= 6000) & (freqs <= 11000)].mean()
    # Uniform phase noise has variance pi^2/3 spread evenly over 0..24 kHz; after the
    # 7.5 kHz channel filter the 6-11 kHz band keeps about a fifth of that (measured).
    flat = (np.pi ** 2 / 3) * len(fm) * (np.hanning(len(fm)) ** 2).mean() * 0.205
    return float(band / flat)


def has_tone(fm, tone, audio_rate=AUDIO_RATE):
    """Whether the discriminator output carries the CTCSS tone (within 1%)."""
    if len(fm) < audio_rate // 4:
        return False
    spec = np.abs(np.fft.rfft(fm * np.hanning(len(fm)))) ** 2
    freqs = np.fft.rfftfreq(len(fm), 1 / audio_rate)
    sub = (freqs >= 60) & (freqs <= 260)
    near = sub & (np.abs(freqs - tone) <= max(1.5, tone * 0.01))
    if not near.any():
        return False
    peak = spec[sub].max()
    return bool(spec[near].max() >= peak * 0.7 and spec[near].max() > 20 * np.median(spec[sub]))


# ---- the dongle -------------------------------------------------------------

class Dongle:
    def __init__(self, index, gain_db, ppm):
        name = ctypes.util.find_library("rtlsdr")
        try:
            lib = ctypes.CDLL(name or "librtlsdr.so.2")
        except OSError:
            lib = ctypes.CDLL("librtlsdr.so.0")
        vp, u32, i32 = ctypes.c_void_p, ctypes.c_uint32, ctypes.c_int
        for fn, args in (("rtlsdr_open", [ctypes.POINTER(vp), u32]), ("rtlsdr_close", [vp]),
                         ("rtlsdr_set_sample_rate", [vp, u32]), ("rtlsdr_set_center_freq", [vp, u32]),
                         ("rtlsdr_set_freq_correction", [vp, i32]), ("rtlsdr_set_tuner_gain_mode", [vp, i32]),
                         ("rtlsdr_get_tuner_gains", [vp, ctypes.POINTER(i32)]),
                         ("rtlsdr_set_tuner_gain", [vp, i32]), ("rtlsdr_reset_buffer", [vp]),
                         ("rtlsdr_read_sync", [vp, vp, i32, ctypes.POINTER(i32)])):
            getattr(lib, fn).argtypes = args
            getattr(lib, fn).restype = i32
        self.lib, self.dev = lib, vp()
        if lib.rtlsdr_open(ctypes.byref(self.dev), index) != 0:
            raise OSError("busy")
        lib.rtlsdr_set_sample_rate(self.dev, RATE)
        if ppm:
            lib.rtlsdr_set_freq_correction(self.dev, int(ppm))
        if gain_db in (None, "auto"):
            lib.rtlsdr_set_tuner_gain_mode(self.dev, 0)
        else:
            lib.rtlsdr_set_tuner_gain_mode(self.dev, 1)
            count = lib.rtlsdr_get_tuner_gains(self.dev, None)
            gains = (ctypes.c_int * max(count, 1))()
            lib.rtlsdr_get_tuner_gains(self.dev, gains)
            if count > 0:
                lib.rtlsdr_set_tuner_gain(self.dev, min(gains[:count], key=lambda g: abs(g - gain_db * 10)))
        lib.rtlsdr_reset_buffer(self.dev)
        self.buf = ctypes.create_string_buffer(LISTEN * 2)
        self.rate = RATE

    @staticmethod
    def count():
        name = ctypes.util.find_library("rtlsdr")
        try:
            lib = ctypes.CDLL(name or "librtlsdr.so.2")
        except OSError:
            try:
                lib = ctypes.CDLL("librtlsdr.so.0")
            except OSError:
                return -1
        return lib.rtlsdr_get_device_count()

    def tune(self, mhz):
        self.lib.rtlsdr_set_center_freq(self.dev, int(round(mhz * 1e6)) - OFFSET)

    def read(self, samples):
        got = ctypes.c_int(0)
        if self.lib.rtlsdr_read_sync(self.dev, self.buf, samples * 2, ctypes.byref(got)) != 0 or got.value <= 0:
            raise OSError("The RTL-SDR stopped answering (unplugged?).")
        raw = np.frombuffer(self.buf.raw[:got.value], dtype=np.uint8).astype(np.float32)
        return ((raw[0::2] - 127.4) + 1j * (raw[1::2] - 127.4)).astype(np.complex64) / 128

    def close(self):
        self.lib.rtlsdr_close(self.dev)


class SoapySource:
    """Any receiver SoapySDR knows (Airspy, HackRF, SDRplay, LimeSDR, USRP...), read as complex IQ."""

    def __init__(self, args, rate, gain_db):
        sd = soapy()
        if sd is None:
            raise OSError("SoapySDR isn't installed. Run Update station in Settings.")
        self.sd, rx = sd, sd.SOAPY_SDR_RX
        try:
            self.dev = sd.Device(args)
            self.dev.setSampleRate(rx, 0, rate)
            self.rate = self.dev.getSampleRate(rx, 0)
            if gain_db in (None, "auto"):
                if self.dev.hasGainMode(rx, 0):
                    self.dev.setGainMode(rx, 0, True)
            else:
                self.dev.setGain(rx, 0, float(gain_db))
            self.stream = self.dev.setupStream(rx, sd.SOAPY_SDR_CF32)
            self.dev.activateStream(self.stream)
        except Exception as err:  # SoapySDR raises RuntimeError for busy, missing and bad settings
            raise OSError(f"busy: {err}") from err
        self.buf = np.empty(65536, np.complex64)

    def tune(self, mhz):
        self.dev.setFrequency(self.sd.SOAPY_SDR_RX, 0, mhz * 1e6 - OFFSET)

    def read(self, samples):
        out, got, misses = np.empty(samples, np.complex64), 0, 0
        while got < samples:
            want = min(samples - got, len(self.buf))
            result = self.dev.readStream(self.stream, [self.buf], want, timeoutUs=500000)
            if result.ret > 0:
                out[got:got + result.ret] = self.buf[:result.ret]
                got += result.ret
            elif result.ret != self.sd.SOAPY_SDR_OVERFLOW:
                misses += 1
                if misses > 6:
                    raise OSError("The receiver stopped sending (unplugged?).")
        return out

    def close(self):
        try:
            self.dev.deactivateStream(self.stream)
            self.dev.closeStream(self.stream)
        except Exception:
            pass


class FakeDongle:
    """Noise everywhere, and a talking-ish FM (or, in the aircraft band, AM) signal on the
    test frequencies (EMCOMM_SCANNER_FAKE)."""

    def __init__(self, busy_mhz, tone=None):
        self.busy, self.tone, self.mhz, self.n = busy_mhz, tone, None, 0
        self.rate = RATE
        self.rng = np.random.default_rng(1)

    def tune(self, mhz):
        self.mhz = mhz

    def read(self, samples):
        time.sleep(samples / RATE)
        if default_mode(self.mhz) == "AM":
            return am_test_signal(samples, self.n, self.mhz in self.busy, self.rng, advance=self)
        return fm_test_signal(samples, self.n, self.mhz in self.busy, self.tone, self.rng, advance=self)

    def close(self):
        pass


def am_test_signal(samples, start, on, rng, advance=None, snr_db=25, rate=RATE):
    """IQ at rate: noise, plus (if on) an AM carrier OFFSET above centre, 80% modulated by a 1 kHz note.
    snr_db is the carrier over the noise in 240 kHz, as for fm_test_signal."""
    noise = (rng.standard_normal(samples) + 1j * rng.standard_normal(samples)) * 0.05 * math.sqrt(rate / RATE)
    if advance is not None:
        advance.n += samples
    if not on:
        return noise.astype(np.complex64)
    t = (np.arange(samples) + start) / rate
    amp = 0.05 * math.sqrt(2) * 10 ** (snr_db / 20) * (1 + 0.8 * np.sin(2 * np.pi * 1000 * t))
    return (noise + amp * np.exp(2j * np.pi * OFFSET * t)).astype(np.complex64)


def fm_test_signal(samples, start, on, tone, rng, advance=None, snr_db=25, rate=RATE):
    """IQ at rate: noise, plus (if on) a narrow FM carrier OFFSET above centre with a 1 kHz note and tone.
    snr_db is over 240 kHz, whatever the rate, so it means the same in the channel."""
    noise = (rng.standard_normal(samples) + 1j * rng.standard_normal(samples)) * 0.05 * math.sqrt(rate / RATE)
    if advance is not None:
        advance.n += samples
    if not on:
        return noise.astype(np.complex64)
    t = (np.arange(samples) + start) / rate
    message = 0.6 * np.sin(2 * np.pi * 1000 * t) * DEVIATION
    if tone:
        message = message + 0.15 * DEVIATION * np.sin(2 * np.pi * tone * t)
    phase = 2 * np.pi * (OFFSET * t + np.cumsum(message) / rate)
    amp = 0.05 * math.sqrt(2) * 10 ** (snr_db / 20)
    return (noise + amp * np.exp(1j * phase)).astype(np.complex64)


# ---- the scanning loop ---------------------------------------------------------

class Scanner(threading.Thread):
    """Steps through the scan list; stops on a channel with a signal (and its PL tone)."""

    def __init__(self, on_state):
        super().__init__(daemon=True)
        self.on_state = on_state
        self.lock = threading.Lock()
        self.channels, self.settings = [], load_settings()
        self.hold = None       # channel held by the operator
        self.skip_now = False
        self.stopping = False
        self.dongle = None
        self.audio = None
        self.demod = None
        self.receiver = None
        self.wake = threading.Event()

    def configure(self, channels, settings):
        with self.lock:
            self.channels, self.settings = list(channels), dict(settings)

    def set_hold(self, ch):
        """Stay on one channel (None: back to scanning). Leaves the channel being listened to."""
        with self.lock:
            self.hold = ch
        self.wake.set()

    def skip(self):
        self.skip_now = True

    def stop(self):
        self.stopping = True
        self.wake.set()

    def _open(self):
        if FAKE:
            busy = [float(x) for x in FAKE.split(",") if x.strip()]
            self.dongle = FakeDongle(busy, tone=float(os.environ.get("EMCOMM_SCANNER_FAKE_TONE", "0")) or None)
            return
        rx = pick_receiver(self.settings.get("receiver"), receivers(), nwr_in_use())
        if rx is None:
            raise OSError("No SDR receiver found. Plug one in (RTL-SDR, Airspy, HackRF, SDRplay...) "
                          "with a VHF/UHF antenna.")
        self.receiver = rx
        if rx["driver"] == "rtlsdr":
            if Dongle.count() < 0:
                raise OSError("The RTL-SDR library isn't installed. Run Update station in Settings.")
            if rx["nwr"]:
                claim_sdr("Scanner")  # the weather radio listener lets go of the dongle
            make = lambda: Dongle(rx["rtl_index"], self.settings.get("gain"), self.settings.get("ppm"))  # noqa: E731
        else:
            make = lambda: SoapySource(rx["args"], rx["scan_rate"], self.settings.get("gain"))  # noqa: E731
        for attempt in range(24):
            try:
                self.dongle = make()
                return
            except OSError:
                if attempt == 11 and not stop_stuck_gqrx():
                    break
                time.sleep(0.5)
        holder = "Gqrx" if gqrx_pids() else "another app"
        raise OSError(f"The {rx['label']} is busy in {holder}. Close it and tap Scan, or use "
                      "Settings > Devices > Free the SDR receiver.")

    def _play(self, samples):
        if self.audio is None or self.audio.poll() is not None:
            rate = round(self.demod.audio_rate)
            try:
                self.audio = subprocess.Popen(["pacat", "--playback", "--raw", "--format=s16le",
                                               f"--rate={rate}", "--channels=1", "--latency-msec=150",
                                               "--client-name=Scanner"], stdin=subprocess.PIPE)
            except OSError:
                self.audio = None
                return
        volume = (self.settings.get("volume", 70) / 100) ** 2
        try:
            self.audio.stdin.write((np.clip(samples * volume, -1, 1) * 32000).astype("<i2").tobytes())
            self.audio.stdin.flush()
        except (BrokenPipeError, OSError):
            self.audio = None

    def run(self):
        try:
            self._open()
        except OSError as err:
            release_sdr()
            self.on_state({"state": "error", "text": str(err)})
            return
        demods = {"FM": Demod(self.dongle.rate), "AM": AMDemod(self.dongle.rate)}
        self.demod = demods["FM"]  # both give audio at the same rate
        position = 0
        try:
            while not self.stopping:
                self.wake.clear()
                with self.lock:
                    held, settings = self.hold, self.settings
                    targets = [held] if held else scan_list(self.channels, settings)
                if not targets:
                    self.on_state({"state": "idle", "text": "Nothing to scan: turn on a group or widen the distance."})
                    self.wake.wait(0.5)
                    continue
                position %= len(targets)
                ch = targets[position]
                if self._visit(ch, demod_for(ch, demods), settings, held is not None):
                    position += 1 if held is None else 0
                else:
                    position += 1
        except OSError as err:
            self.on_state({"state": "error", "text": str(err)})
        finally:
            if self.dongle:
                self.dongle.close()
            release_sdr()
            if self.audio and self.audio.poll() is None:
                self.audio.terminate()

    def _visit(self, ch, demod, settings, held):
        """Look at one channel; stay while it's active. True if it was active."""
        threshold = SQUELCH_LEVELS.get(int(settings.get("squelch", 4)), 0.38)
        self.dongle.tune(ch["mhz"])
        def samples(count):  # the block sizes are set for 240 kS/s
            return int(count * self.dongle.rate / RATE)
        self.dongle.read(samples(SETTLE))
        demod.reset()
        _audio, fm, noise = demod.process(self.dongle.read(samples(LOOK)))
        if not held:
            self.on_state({"state": "scanning", "channel": ch, "level": noise})
        if noise > threshold:
            if held:
                self.on_state({"state": "holding", "channel": ch, "level": noise, "open": False})
            return False
        # Something's there. With tone squelch, it must carry this channel's PL tone.
        want_tone = settings.get("tone_squelch") and ch.get("tone_kind") == "pl"
        heard = [fm]
        quiet_since, started, toned = None, time.time(), not want_tone
        stay, wait = hang_rule(settings.get("hang"))
        if held:
            stay, wait = None, HANG  # a held channel is listened to until the operator moves on
        while not self.stopping and not self.wake.is_set():
            if self.skip_now:
                self.skip_now = False
                return True
            audio, fm, noise = demod.process(self.dongle.read(samples(LISTEN)))
            if not toned:
                heard.append(fm)
                joined = np.concatenate(heard)
                if has_tone(joined, ch["tone"], demod.audio_rate):
                    toned = True
                elif len(joined) >= TONE_WAIT * demod.audio_rate:
                    if held:
                        heard = heard[-2:]
                        self.on_state({"state": "holding", "channel": ch, "level": noise, "open": False,
                                       "other": True})
                        continue
                    return False  # someone else on the frequency
                if not toned:
                    continue
            is_open = noise <= threshold * 1.25  # a little hysteresis
            if is_open:
                quiet_since = None
                self._play(audio)
            elif quiet_since is None:
                quiet_since = time.time()
            self.on_state({"state": "holding" if held else "listening", "channel": ch, "level": noise,
                           "open": is_open, "since": started})
            if stay is not None and time.time() - started >= stay:
                return True
            if stay is None and quiet_since and time.time() - quiet_since > wait:
                return True
            settings = self.settings  # squelch, volume and hang changes apply straight away
            threshold = SQUELCH_LEVELS.get(int(settings.get("squelch", 4)), 0.38)
            if not held:
                stay, wait = hang_rule(settings.get("hang"))
        return True


