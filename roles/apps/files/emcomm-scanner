        head = Gtk.Label(xalign=0, wrap=True, label=(
            "Pick the receiver for Gqrx." if choices else
            "No SDR receiver is plugged in. Plug one in (RTL-SDR, Airspy, HackRF, SDRplay...) and tap Gqrx "
            "again, or open Gqrx without one:"))
        box.pack_start(head, False, False, 0)
        picked = []
        extras = []
        if np is not None:
            extras.append(practice_choice())
        extras.append({"key": "network", "label": "Network receiver (rtl_tcp)…",
                       "detail": "An RTL-SDR on another computer, shared with rtl_tcp. You type its address next."})
        for choice in choices + extras:
            btn = Gtk.Button()
            inner = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2, margin=6)
            name = Gtk.Label(label=choice["label"], xalign=0)
            name.get_style_context().add_class("pick-name")
            detail = Gtk.Label(label=choice["detail"], xalign=0, wrap=True, max_width_chars=60)
            detail.get_style_context().add_class("muted")
            inner.pack_start(name, False, False, 0)
            inner.pack_start(detail, False, False, 0)
            btn.add(inner)
            btn.connect("clicked", lambda _b, c=choice: (picked.append(c), dialog.response(Gtk.ResponseType.OK)))
            box.pack_start(btn, False, False, 0)
        dialog.add_buttons("Cancel", Gtk.ResponseType.CANCEL)
        dialog.get_content_area().add(box)
        dialog.show_all()
        dialog.run()
        dialog.destroy()
        chosen = picked[0] if picked else None
        if chosen and chosen["key"] == "network":
            chosen = ask_network_address(Gtk)
        if chosen and chosen["key"] == "practice":
            practice_recording()
    if not chosen:
        return 1
    print("\t".join(str(x) for x in (chosen["key"], chosen["gqrx"], chosen["gqrx_rate"], chosen["start_hz"],
                                     1 if chosen.get("nwr") else 0)))
    return 0


def ask_network_address(Gtk):
    """Ask for the rtl_tcp receiver's address (remembered for next time)."""
    try:
        with open(GQRX_NETWORK, encoding="utf-8") as f:
            last = json.load(f).get("address", "")
    except (OSError, ValueError, AttributeError):
        last = ""
    dialog = Gtk.Dialog(title="Network receiver", modal=True)
    dialog.set_position(Gtk.WindowPosition.CENTER)
    dialog.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Open Gqrx", Gtk.ResponseType.OK)
    dialog.set_default_response(Gtk.ResponseType.OK)
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, margin=16)
    box.pack_start(Gtk.Label(xalign=0, wrap=True, max_width_chars=60, label=(
        "The address of the computer running rtl_tcp, and its port if it isn't 1234, "
        "e.g. 192.168.1.20 or shack-pi.local:1234. On that computer run: rtl_tcp -a 0.0.0.0")), False, False, 0)
    entry = Gtk.Entry(text=last, activates_default=True, width_chars=30)
    box.pack_start(entry, False, False, 0)
    dialog.get_content_area().add(box)
    dialog.show_all()
    response = dialog.run()
    address = entry.get_text().strip()
    dialog.destroy()
    if response != Gtk.ResponseType.OK or not address:
        return None
    os.makedirs(os.path.dirname(GQRX_NETWORK), exist_ok=True)
    with open(GQRX_NETWORK, "w", encoding="utf-8") as f:
        json.dump({"address": address}, f)
    return network_choice(address)


