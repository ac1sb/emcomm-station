def window_main():
    import gi
    gi.require_version("Gtk", "3.0")
    from gi.repository import GLib, Gtk, Gdk

    def theme():
        try:
            with open(THEME_PATH, encoding="utf-8") as f:
                return THEMES.get(f.read().strip(), THEMES["dark"])
        except OSError:
            return THEMES["dark"]

    class Window(Gtk.Window):
        def __init__(self):
            super().__init__(title="Scanner")
