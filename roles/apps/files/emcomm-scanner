def usb_dongles():
    """How many RTL-SDR dongles are plugged in, from sysfs."""
    count = 0
    for dev in os.listdir("/sys/bus/usb/devices") if os.path.isdir("/sys/bus/usb/devices") else []:
        base = os.path.join("/sys/bus/usb/devices", dev)
        try:
            with open(os.path.join(base, "idVendor")) as v, open(os.path.join(base, "idProduct")) as p:
                if (v.read().strip(), p.read().strip()) in RTL_USB_IDS:
                    count += 1
        except OSError:
            pass
    return count


def nwr_in_use():
    try:
        with open(NWR_CONFIG, encoding="utf-8") as f:
            return bool(json.load(f).get("freq"))
    except (OSError, ValueError, AttributeError):
        return False


def gqrx_pids():
    """This user's running Gqrx programs."""
    pids = []
    for entry in os.listdir("/proc"):
        try:
            if entry.isdigit() and os.stat(f"/proc/{entry}").st_uid == os.getuid():
                with open(f"/proc/{entry}/comm", encoding="utf-8") as f:
                    if f.read().strip() == "gqrx":
                        pids.append(int(entry))
        except OSError:
            continue
    return pids


def stop_stuck_gqrx():
    """Gqrx can hang on after its window is closed, still holding the receiver. Stop any
    Gqrx with no window on screen; True if one was stopped."""
    pids = gqrx_pids()
    if not pids:
        return False
    try:
        windows = subprocess.run(["wmctrl", "-lp"], capture_output=True, text=True, timeout=5, check=False).stdout
    except (OSError, subprocess.TimeoutExpired):
        return False  # can't tell whether it's still in use
    shown = {int(f[2]) for f in (line.split(None, 3) for line in windows.splitlines()) if len(f) > 2 and f[2].isdigit()}
    stuck = [pid for pid in pids if pid not in shown]
    for sig in (signal.SIGTERM, signal.SIGKILL):
        for pid in stuck:
            try:
                os.kill(pid, sig)
            except OSError:
                pass
        time.sleep(2)
    return bool(stuck)


def claim_sdr(app):
    os.makedirs(os.path.dirname(SDR_LOCK), exist_ok=True)
    with open(SDR_LOCK, "w", encoding="utf-8") as f:
        json.dump({"pid": os.getpid(), "app": app}, f)


def release_sdr():
    try:
        with open(SDR_LOCK, encoding="utf-8") as f:
            if json.load(f).get("pid") != os.getpid():
                return
        os.remove(SDR_LOCK)
    except (OSError, ValueError, AttributeError):
        pass


