                                                     Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
            self.settings = load_settings()
            self.scanner = None
            self.state = {}
            self.held = None
            self.filling = False
            self.connect("destroy", self._quit)

            page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10, margin=12)
            page.get_style_context().add_class("page")
            self.add(page)

            # What's on now.
            now = Gtk.Box(spacing=16)
            now.get_style_context().add_class("panel")
            left = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            self.state_label = Gtk.Label(xalign=0)
            self.state_label.get_style_context().add_class("state")
            self.name_label = Gtk.Label(xalign=0, ellipsize=3)
            self.name_label.get_style_context().add_class("big")
            self.detail_label = Gtk.Label(xalign=0, ellipsize=3)
            self.detail_label.get_style_context().add_class("muted")
            for w in (self.state_label, self.name_label, self.detail_label):
                left.pack_start(w, False, False, 0)
            now.pack_start(left, True, True, 0)
            right = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6, valign=Gtk.Align.CENTER)
            self.freq_label = Gtk.Label(xalign=1)
            self.freq_label.get_style_context().add_class("freq")
            self.level = Gtk.LevelBar(min_value=0, max_value=1, width_request=220)
            right.pack_start(self.freq_label, False, False, 0)
            right.pack_start(self.level, False, False, 0)
            now.pack_start(right, False, False, 0)
            page.pack_start(now, False, False, 0)

            # Controls.
            bar = Gtk.Box(spacing=8)
            self.scan_btn = self._button("Scan", self._scan_clicked)
            self.hold_btn = self._button("Hold", self._hold_clicked)
            bar.pack_start(self.scan_btn, False, False, 0)
            bar.pack_start(self.hold_btn, False, False, 0)
            bar.pack_start(self._button("Skip", lambda *_: self.scanner and self.scanner.skip()), False, False, 0)
            bar.pack_start(self._button("Lock out", self._lock_out), False, False, 0)
            bar.pack_start(Gtk.Label(label="Squelch", margin_start=10), False, False, 0)
            self.squelch = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 1, 9, 1)
            self.squelch.set_size_request(130, -1)
            self.squelch.set_value(self.settings["squelch"])
            self.squelch.connect("value-changed", self._changed)
            bar.pack_start(self.squelch, False, False, 0)
            bar.pack_start(Gtk.Label(label="Volume"), False, False, 0)
            self.volume = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 5)
            self.volume.set_draw_value(False)
            self.volume.set_size_request(130, -1)
            self.volume.set_value(self.settings["volume"])
            self.volume.connect("value-changed", self._changed)
            bar.pack_start(self.volume, False, False, 0)
            self.tone = Gtk.CheckButton(label="Tone squelch")
            self.tone.set_active(self.settings["tone_squelch"])
            self.tone.set_tooltip_text("Only stop for the channel's own PL tone, not other users of the frequency")
            self.tone.connect("toggled", self._changed)
            bar.pack_end(self.tone, False, False, 0)
            page.pack_start(bar, False, False, 0)

            body = Gtk.Box(spacing=10)
            page.pack_start(body, True, True, 0)

            # Groups and distance.
            side = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4, width_request=250)
            side.get_style_context().add_class("panel")
            title = Gtk.Label(label="GROUPS", xalign=0)
            title.get_style_context().add_class("section-title")
            side.pack_start(title, False, False, 0)
            self.group_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            groups_scroll = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER)
            groups_scroll.add(self.group_box)
            side.pack_start(groups_scroll, True, True, 0)
            title = Gtk.Label(label="WITHIN", xalign=0)
            title.get_style_context().add_class("section-title")
            side.pack_start(title, False, False, 0)
            self.distance = Gtk.ComboBoxText()
            for miles, label in DISTANCES:
                self.distance.append(str(miles), label)
            self.distance.set_active_id(str(self.settings["miles"]))
            if self.distance.get_active_id() is None:
                self.distance.set_active_id("25")
            self.distance.connect("changed", self._changed)
            side.pack_start(self.distance, False, False, 0)
            self.where_label = Gtk.Label(xalign=0, wrap=True)
            self.where_label.get_style_context().add_class("muted")
            side.pack_start(self.where_label, False, False, 0)
            row = Gtk.Box(spacing=6)
            row.pack_start(self._button("Load a list", self._load_list), True, True, 0)
            row.pack_start(self._button("Dongle", self._dongle_dialog), True, True, 0)
            side.pack_end(row, False, False, 0)
            body.pack_start(side, False, False, 0)

            # Channels.
            self.store = Gtk.ListStore(bool, str, str, str, str, str, str, int)
            self.view = Gtk.TreeView(model=self.store)
            toggle = Gtk.CellRendererToggle()
            toggle.connect("toggled", self._toggle_channel)
            self.view.append_column(Gtk.TreeViewColumn("Scan", toggle, active=0))
            for i, (name, width) in enumerate((("Channel", 170), ("MHz", 90), ("Agency", 200), ("Tone", 80),
                                               ("Miles", 60)), start=1):
                cell = Gtk.CellRendererText(ellipsize=3)
                col = Gtk.TreeViewColumn(name, cell, text=i, foreground=6)
                col.set_fixed_width(width)
                col.set_resizable(True)
                col.set_sizing(Gtk.TreeViewColumnSizing.FIXED)
                self.view.append_column(col)
            self.view.set_activate_on_single_click(True)
            self.view.connect("row-activated", self._row_activated)
            scroll = Gtk.ScrolledWindow()
            scroll.add(self.view)
            frame = Gtk.Box()
            frame.get_style_context().add_class("panel")
            frame.pack_start(scroll, True, True, 0)
            body.pack_start(frame, True, True, 0)

            self.message = Gtk.Label(xalign=0, wrap=True)
            page.pack_start(self.message, False, False, 0)

            self._load()
            self.show_all()
            self.maximize()
            GLib.timeout_add(150, self._show_state)
            if np is None:
                self._say("The scanner needs numpy (python3-numpy). Run Update station in Settings.", True)
            else:
                self._start()

        def _button(self, label, handler):
            btn = Gtk.Button(label=label)
            btn.connect("clicked", handler)
            return btn

        def _say(self, text, error=False):
            self.message.set_text(text or "")
            ctx = self.message.get_style_context()
            (ctx.add_class if error else ctx.remove_class)("error")

        # -- channel list --

        def _load(self):
            ensure_list()
            try:
                self.channels = load_channels()
            except OSError:
                self.channels = []
                self._say(f"No channel list yet. Put a CSV with a Frequency column at ~/{os.path.basename(CHANNELS)} "
                          "or tap Load a list.", True)
            self.here = station_location()
            add_distances(self.channels, self.here)
            self.where_label.set_text("of this station's grid square" if self.here else
                                      "Set the station's grid square in Settings > User to filter by distance.")
            for child in self.group_box.get_children():
                child.destroy()
            groups = []
            for ch in self.channels:
                if ch["group"] not in groups:
                    groups.append(ch["group"])
            self.group_checks = {}
            for group in groups:
                count = sum(1 for ch in self.channels if ch["group"] == group)
                check = Gtk.CheckButton(label=f"{group}  ({count})")
                check.set_active(group not in self.settings["groups_off"])
                check.connect("toggled", self._changed)
                self.group_box.pack_start(check, False, False, 0)
                self.group_checks[group] = check
            self.group_box.show_all()
            self._fill()

        def _fill(self):
            self.filling = True
            self.store.clear()
            scanning = {channel_key(ch) for ch in scan_list(self.channels, self.settings)}
            locked = set(self.settings["lockouts"])
            colours = theme()
            self.rows = []
            for ch in self.channels:
                if ch["group"] in self.settings["groups_off"]:
                    continue
                miles = self.settings["miles"]
                if miles and ch.get("miles") is not None and ch["miles"] > miles:
                    continue
                key = channel_key(ch)
                self.rows.append(ch)
                dim = key in locked or ch.get("unsupported")
                tone = ch["tone_text"] if ch["tone_kind"] else ""
                self.store.append([key in scanning, ch["name"], f"{ch['mhz']:.4f}",
                                   ch.get("unsupported") or ch["agency"], tone,
                                   "" if ch.get("miles") is None else f"{ch['miles']:.0f}",
                                   colours["muted"] if dim else colours["text"], len(self.rows) - 1])
            self.filling = False
            count = len(scanning)
            self.count_text = f"{count} channel{'s' if count != 1 else ''}"

        def _changed(self, *_):
            if self.filling:
                return
            self.settings.update(
                squelch=int(self.squelch.get_value()), volume=int(self.volume.get_value()),
                tone_squelch=self.tone.get_active(), miles=int(self.distance.get_active_id() or 0),
                groups_off=[g for g, c in self.group_checks.items() if not c.get_active()])
            save_settings(self.settings)
            self._fill()
            if self.scanner:
                self.scanner.configure(self.channels, self.settings)

        def _toggle_channel(self, _cell, path):
            ch = self.rows[self.store[path][7]]
            key = channel_key(ch)
            if ch.get("unsupported"):
                self._say(f"{ch['name']} is {ch['unsupported']}; the scanner plays analog FM only.", True)
                return
            locked = self.settings["lockouts"]
            if key in locked:
                locked.remove(key)
            else:
                locked.append(key)
            self._changed()

        def _lock_out(self, *_):
            ch = self.state.get("channel")
            if not ch:
                return
            if channel_key(ch) not in self.settings["lockouts"]:
                self.settings["lockouts"].append(channel_key(ch))
            if self.held and channel_key(self.held) == channel_key(ch):
                self._scan_clicked()
            self._changed()
            if self.scanner:
                self.scanner.skip()
            self._say(f"Locked out {ch['name']}. Tick it in the list to scan it again.")

        def _row_activated(self, view, path, col):
            if col == view.get_column(0):
                return  # the Scan tick box
            ch = self.rows[self.store[path][7]]
            if ch.get("unsupported"):
                self._say(f"{ch['name']} is {ch['unsupported']}; the scanner plays analog FM only.", True)
                return
            self.held = ch
            if self.scanner:
                self.scanner.set_hold(ch)
            self._show_buttons()

        def _scan_clicked(self, *_):
            self.held = None
            if self.scanner and self.scanner.is_alive():
                self.scanner.set_hold(None)
            else:
                self._start()
            self._show_buttons()

        def _hold_clicked(self, *_):
            ch = self.state.get("channel")
            if ch and not self.held:
                self.held = ch
                if self.scanner:
                    self.scanner.set_hold(ch)
            elif self.held:
                self._scan_clicked()
            self._show_buttons()

        def _show_buttons(self):
            for btn, on in ((self.scan_btn, not self.held), (self.hold_btn, bool(self.held))):
                (btn.get_style_context().add_class if on else btn.get_style_context().remove_class)("on")

        def _start(self):
            self._say("")
            self.scanner = Scanner(self._got_state)
            self.scanner.configure(self.channels, self.settings)
            self.scanner.set_hold(self.held)
            self.scanner.start()
            self._show_buttons()

        def _got_state(self, state):
            self.state = state  # read by the GTK timer; the scanner thread never touches widgets

        def _show_state(self):
            s = self.state
            ch = s.get("channel")
            kind = s.get("state")
            if kind == "error":
                self.state_label.set_text("STOPPED")
                self.name_label.set_text("No receiver")
                self.detail_label.set_text("")
                self.freq_label.set_text("")
                self._say(s.get("text", ""), True)
                self.state = {"state": "stopped"}
            elif kind == "idle":
                self.state_label.set_text("IDLE")
                self.name_label.set_text(s.get("text", ""))
            elif ch:
                live = kind in ("listening", "holding") and s.get("open")
                label = {"scanning": f"SCANNING  {self.count_text}", "listening": "ACTIVE",
                         "holding": "HOLD" + ("  · another user, wrong tone" if s.get("other") else "")}[kind]
                self.state_label.set_text(label)
                ctx = self.state_label.get_style_context()
                (ctx.add_class if live else ctx.remove_class)("live")
                self.name_label.set_text(ch["name"])
                bits = [ch["agency"], ch["county"] if ch["county"] not in ch["agency"] else "",
                        ch["tone_text"] if ch["tone_kind"] else "",
                        "" if ch.get("miles") is None else f"{ch['miles']:.0f} mi"]
                self.detail_label.set_text("  ·  ".join(b for b in bits if b))
                self.freq_label.set_text(f"{ch['mhz']:.4f}")
                self.level.set_value(max(0.0, min(1.0, 1 - s.get("level", 1))))
            return True

        def _load_list(self, *_):
            dialog = Gtk.FileChooserDialog(title="Choose a channel list (CSV)", transient_for=self,
                                           action=Gtk.FileChooserAction.OPEN)
            dialog.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Use this list", Gtk.ResponseType.OK)
            filt = Gtk.FileFilter()
            filt.set_name("CSV lists")
            filt.add_pattern("*.csv")
            filt.add_pattern("*.CSV")
            dialog.add_filter(filt)
            for folder in ("/media", HOME):
                if os.path.isdir(folder):
                    dialog.add_shortcut_folder(folder)
            sticks = [d for d in glob.glob("/media/*/*") + glob.glob("/media/*") if os.path.ismount(d)]
            dialog.set_current_folder(sticks[0] if sticks else HOME)
            path = dialog.get_filename() if dialog.run() == Gtk.ResponseType.OK else None
            dialog.destroy()
            if not path:
                return
            try:
                found = load_channels(path)
            except (OSError, UnicodeDecodeError, csv.Error) as err:
                self._say(f"Couldn't read that file: {err}", True)
                return
            if not found:
                self._say("That file has no channels: it needs a Frequency column in MHz.", True)
                return
            if os.path.exists(CHANNELS):
                shutil.copyfile(CHANNELS, CHANNELS + ".old")
            shutil.copyfile(path, CHANNELS)
            self.settings["groups_off"], self.settings["lockouts"] = [], []
            save_settings(self.settings)
            self._load()
            if self.scanner:
                self.scanner.configure(self.channels, self.settings)
            self._say(f"Loaded {len(found)} channels. The previous list is kept as "
                      f"~/{os.path.basename(CHANNELS)}.old")

        def _dongle_dialog(self, *_):
            dialog = Gtk.Dialog(title="RTL-SDR dongle", transient_for=self, modal=True)
            dialog.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Save", Gtk.ResponseType.OK)
            grid = Gtk.Grid(row_spacing=10, column_spacing=12, margin=16)
            gain = Gtk.ComboBoxText()
            gain.append("auto", "Automatic")
            for db in (20, 30, 35, 40, 45, 49):
                gain.append(str(db), f"{db} dB")
            gain.set_active_id(str(self.settings["gain"]))
            if gain.get_active_id() is None:
                gain.set_active_id("40")
            ppm = Gtk.SpinButton.new_with_range(-100, 100, 1)
            ppm.set_value(self.settings["ppm"])
            grid.attach(Gtk.Label(label="Gain", xalign=0), 0, 0, 1, 1)
            grid.attach(gain, 1, 0, 1, 1)
            grid.attach(Gtk.Label(label="Frequency correction (ppm)", xalign=0), 0, 1, 1, 1)
            grid.attach(ppm, 1, 1, 1, 1)
            note = Gtk.Label(xalign=0, wrap=True, max_width_chars=50, label=(
                "Lower the gain if strong local stations show up on the wrong channels. "
                "Most dongles need 0 to 60 ppm; a TCXO dongle needs 0. "
                f"Dongles plugged in: {usb_dongles()}."))
            note.get_style_context().add_class("muted")
            grid.attach(note, 0, 2, 2, 1)
            dialog.get_content_area().add(grid)
            dialog.show_all()
            if dialog.run() == Gtk.ResponseType.OK:
                value = gain.get_active_id()
                self.settings["gain"] = "auto" if value == "auto" else int(value)
                self.settings["ppm"] = int(ppm.get_value())
                save_settings(self.settings)
                self._restart()
            dialog.destroy()

        def _restart(self):
            if self.scanner:
                self.scanner.stop()
                self.scanner.join(timeout=3)
            self._start()

        def _quit(self, *_):
            if self.scanner:
                self.scanner.stop()
                self.scanner.join(timeout=3)
            release_sdr()
            Gtk.main_quit()

    Window()
    Gtk.main()
    return 0


GQRX_COLOURS = ["#e5534b", "#4fc3b8", "#f2a33a", "#6ea8fe", "#c792ea", "#a5d6a7", "#ffab91", "#c0c0c0"]


def gqrx_bookmarks(channels):
    """The channel list as a Gqrx bookmarks.csv, one tag per group."""
    def tag(group):
        return re.sub(r"[;,]", " ", group).strip() or "Channels"
    groups = []
    for ch in channels:
        if tag(ch["group"]) not in groups:
            groups.append(tag(ch["group"]))
    lines = ["# Written by Emcomm-CNC from ~/Scanner channels.csv; edit that list instead.",
             "# Tag name".ljust(20) + "; " + " color"]
    lines += [g + "; " + GQRX_COLOURS[i % len(GQRX_COLOURS)] for i, g in enumerate(groups)]
    lines += ["", "# Frequency".ljust(12) + "; " + "Name".ljust(25) + "; " + "Modulation".ljust(20) + "; "
              + "Bandwidth".rjust(10) + "; " + "Tags"]
    for ch in channels:
        name = re.sub(r"[;,]", " ", ch["name"])
        mode = "AM" if ch["mode"] == "AM" else "Narrow FM"
        lines.append(str(int(round(ch["mhz"] * 1e6))).rjust(12) + "; " + name.ljust(25) + "; " + mode.ljust(20)
                     + "; " + "10000".rjust(10) + "; " + tag(ch["group"]))
    return "\n".join(lines) + "\n"


def main(argv):
    if argv == ["--gqrx-bookmarks"]:
        ensure_list()
        sys.stdout.write(gqrx_bookmarks(load_channels()))
        return 0
    if argv[:1] == ["--list"]:
        path = argv[1] if len(argv) > 1 else CHANNELS
        if len(argv) == 1:
            ensure_list()
        channels = load_channels(path)
        add_distances(channels, station_location())
        settings = load_settings()
        keep = {channel_key(ch) for ch in scan_list(channels, settings)}
        for ch in channels:
            print(json.dumps(dict(ch, scan=channel_key(ch) in keep)))
        return 0
    if argv:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    return window_main()


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
