#!/usr/bin/env python3
"""Scan a channel list on an RTL-SDR dongle, like a police/fire scanner.

  emcomm-scanner                 open the scanner window
  emcomm-scanner --list [FILE]   print the channels it would scan, as JSON lines
  emcomm-scanner --gqrx-bookmarks   print the channel list as Gqrx bookmarks

The channel list is ~/Scanner channels.csv. The station ships Vermont's
emergency channels; replace the file (or use "Load a list" in the window) with
any CSV that has a Frequency column. Recognised columns, any order:
  Frequency (MHz), Alpha Tag or Name, Group or Tag, Agency or Description,
  County, Tone (e.g. "118.8 PL", "023 DPL", "CSQ"), Mode, Latitude, Longitude
Channels with a site location are filtered by distance from the station's grid
square (Settings > User); channels without one (statewide) are always kept.

The dongle is read through librtlsdr at 240 kS/s, tuned 60 kHz below the
channel so the dongle's DC spike stays out of it. Narrow FM is demodulated
here with numpy. The squelch is the classic FM noise squelch: with no carrier
the demodulated audio is loud hiss above 6 kHz, and it goes quiet as a signal
comes up, so it works the same whatever the antenna or gain. Tone squelch
checks the CTCSS (PL) tone before stopping on a channel; DPL (DCS) channels
stop on any carrier. Audio plays through PipeWire (pacat), so the recorder and
Broadcastify stream can't hear it, but anyone in the room can.

The weather radio alert listener (emcomm-nwr) uses the first dongle. While the
scanner holds that dongle it writes ~/.local/state/emcomm/sdr.json and the
listener pauses; with two dongles plugged in the scanner uses the second.
"""

import csv
import ctypes
import ctypes.util
import glob
import json
import math
import os
import re
import shutil
import subprocess
import sys
import threading
import time

try:
    import numpy as np
except ImportError:  # the window says so
    np = None

HOME = os.path.expanduser("~")
CHANNELS = os.environ.get("EMCOMM_SCANNER_LIST", os.path.join(HOME, "Scanner channels.csv"))
DEFAULT_LIST = os.environ.get("EMCOMM_SCANNER_DEFAULT",
                              "/usr/share/emcomm/scanner/Vermont emergency channels.csv")
SETTINGS = os.path.join(HOME, ".config/emcomm/scanner.json")
SDR_LOCK = os.path.join(HOME, ".local/state/emcomm/sdr.json")
STATION_PATH = os.environ.get("EMCOMM_STATION", "/etc/emcomm/station.json")
NWR_CONFIG = os.path.join(HOME, ".config/emcomm/nwr.json")
THEME_PATH = os.path.join(HOME, ".config/emcomm/theme")
FAKE = os.environ.get("EMCOMM_SCANNER_FAKE")  # "MHz,MHz" with a test signal: run without a dongle

RATE = 240000        # dongle sample rate
OFFSET = 60000       # the channel sits this far above the tuned centre
DECIM = 5            # 240 kHz -> 48 kHz after the channel filter
AUDIO_RATE = RATE // DECIM
SETTLE = 8192        # samples thrown away after retuning while the tuner settles
LOOK = 12288         # samples looked at on each channel while scanning (51 ms)
LISTEN = 24576       # samples per block while stopped on a channel (102 ms)
HANG = 2.0           # seconds to stay on a channel after it goes quiet
TONE_WAIT = 0.6      # seconds of audio searched for the channel's PL tone
DEVIATION = 2500.0   # narrow FM peak deviation, Hz
# Squelch 1 (open) .. 9 (tight): the hiss left above 6 kHz, as a share of no-signal hiss.
# Level 4 opens about 1 dB above the noise in the channel; 9 needs a near full-quieting signal.
SQUELCH_LEVELS = {1: 0.85, 2: 0.70, 3: 0.55, 4: 0.40, 5: 0.28, 6: 0.18, 7: 0.10, 8: 0.05, 9: 0.02}
DISTANCES = [(10, "10 miles"), (25, "25 miles"), (50, "50 miles"), (100, "100 miles"), (0, "Everywhere")]
CTCSS = [67.0, 69.3, 71.9, 74.4, 77.0, 79.7, 82.5, 85.4, 88.5, 91.5, 94.8, 97.4, 100.0, 103.5, 107.2,
         110.9, 114.8, 118.8, 123.0, 127.3, 131.8, 136.5, 141.3, 146.2, 150.0, 151.4, 156.7, 159.8,
         162.2, 165.5, 167.9, 171.3, 173.8, 177.3, 179.9, 183.5, 186.2, 189.9, 192.8, 196.6, 199.5,
         203.5, 206.5, 210.7, 218.1, 225.7, 229.1, 233.6, 241.8, 250.3, 254.1]
RTL_USB_IDS = {("0bda", "2838"), ("0bda", "2832")}
DEFAULTS = {"groups_off": [], "miles": 25, "lockouts": [], "squelch": 4, "volume": 70,
            "tone_squelch": True, "gain": 40, "ppm": 0}


# ---- channel list -------------------------------------------------------

def _col(row, *names):
    for name in names:
        for key, value in row.items():
            if key and key.strip().lower() == name:
                return (value or "").strip()
    return ""


def parse_tone(text):
    """('pl', 118.8), ('dpl', '023') or (None, None) for none/CSQ/anything else."""
    text = (text or "").strip().upper()
    m = re.fullmatch(r"(\d{2,3}(?:\.\d)?)\s*(?:PL|HZ)?", text)
    if m and 60 <= float(m.group(1)) <= 260 and ("." in m.group(1) or "PL" in text):
        return "pl", float(m.group(1))
    m = re.fullmatch(r"D?(\d{3})\s*[NI]?\s*(?:DPL|DCS)?", text)
    if m and ("DPL" in text or "DCS" in text or text.startswith("D")):
        return "dpl", m.group(1)
    return None, None


def channel_key(ch):
    return f"{ch['mhz']:.4f} {ch['name']}"


def load_channels(path=CHANNELS):
    """The channels in a CSV list, in file order; rows without a usable frequency are skipped."""
    with open(path, encoding="utf-8-sig", newline="") as f:
        rows = list(csv.DictReader(f))
    channels = []
    for row in rows:
        try:
            mhz = float(_col(row, "frequency", "frequency output", "freq", "mhz"))
        except ValueError:
            continue
        if mhz > 10000:  # given in Hz
            mhz /= 1e6
        if not 24 <= mhz <= 1766:  # what an RTL-SDR tunes
            continue
        try:
            lat, lon = float(_col(row, "latitude", "lat")), float(_col(row, "longitude", "lon"))
        except ValueError:
            lat = lon = None
        tone_kind, tone = parse_tone(_col(row, "tone", "pl tone", "ctcss"))
        mode = _col(row, "mode").upper() or "FM"
        ch = {"mhz": round(mhz, 5),
              "name": _col(row, "alpha tag", "name", "tag", "description")[:24] or f"{mhz:.4f}",
              "group": _col(row, "group", "tag", "category", "service type") or "Channels",
              "agency": _col(row, "agency", "description", "department"),
              "county": _col(row, "county"),
              "tone_text": _col(row, "tone", "pl tone", "ctcss"),
              "tone_kind": tone_kind, "tone": tone, "mode": mode,
              "lat": lat, "lon": lon}
        if mode in ("AM", "P25", "DMR", "NXDN", "D-STAR", "DSTAR", "TETRA"):
            ch["unsupported"] = mode  # listed, but the scanner only plays narrow FM
        channels.append(ch)
    return channels


def ensure_list():
    """Give the operator the shipped list the first time."""
    if not os.path.exists(CHANNELS) and os.path.exists(DEFAULT_LIST):
        shutil.copyfile(DEFAULT_LIST, CHANNELS)


def grid_to_latlon(grid):
    grid = (grid or "").strip()
    if not re.fullmatch(r"[A-Ra-r]{2}[0-9]{2}([A-Xa-x]{2})?", grid):
        return None
    lon = (ord(grid[0].upper()) - 65) * 20 - 180 + int(grid[2]) * 2
    lat = (ord(grid[1].upper()) - 65) * 10 - 90 + int(grid[3])
    if len(grid) == 6:
        lon += (ord(grid[4].lower()) - 97) * 5 / 60 + 2.5 / 60
        lat += (ord(grid[5].lower()) - 97) * 2.5 / 60 + 1.25 / 60
    else:
        lon, lat = lon + 1, lat + 0.5
    return lat, lon


def miles_between(a, b):
    lat1, lon1, lat2, lon2 = map(math.radians, (a[0], a[1], b[0], b[1]))
    h = math.sin((lat2 - lat1) / 2) ** 2 + math.cos(lat1) * math.cos(lat2) * math.sin((lon2 - lon1) / 2) ** 2
    return 3958.8 * 2 * math.asin(math.sqrt(min(1.0, h)))


def station_location():
    try:
        with open(STATION_PATH, encoding="utf-8") as f:
            return grid_to_latlon(json.load(f).get("grid", ""))
    except (OSError, ValueError, AttributeError):
        return None


def add_distances(channels, here):
    for ch in channels:
        ch["miles"] = (round(miles_between(here, (ch["lat"], ch["lon"])), 1)
                       if here and ch["lat"] is not None else None)


def scan_list(channels, settings):
    """The channels to scan: in a group that's on, near enough, not locked out, playable."""
    off = set(settings.get("groups_off") or [])
    locked = set(settings.get("lockouts") or [])
    miles = settings.get("miles") or 0
    return [ch for ch in channels
            if ch["group"] not in off and channel_key(ch) not in locked and not ch.get("unsupported")
            and (not miles or ch.get("miles") is None or ch["miles"] <= miles)]


def load_settings():
    try:
        with open(SETTINGS, encoding="utf-8") as f:
            saved = json.load(f)
    except (OSError, ValueError):
        saved = {}
    settings = dict(DEFAULTS)
    if isinstance(saved, dict):
        settings.update({k: v for k, v in saved.items() if k in DEFAULTS})
    return settings


def save_settings(settings):
    os.makedirs(os.path.dirname(SETTINGS), exist_ok=True)
    with open(SETTINGS + ".tmp", "w", encoding="utf-8") as f:
        json.dump(settings, f, indent=1)
    os.replace(SETTINGS + ".tmp", SETTINGS)


# ---- sharing the dongle with the weather radio ---------------------------

def usb_dongles():
    """How many RTL-SDR dongles are plugged in, from sysfs."""
    count = 0
    for dev in os.listdir("/sys/bus/usb/devices") if os.path.isdir("/sys/bus/usb/devices") else []:
        base = os.path.join("/sys/bus/usb/devices", dev)
        try:
            with open(os.path.join(base, "idVendor")) as v, open(os.path.join(base, "idProduct")) as p:
                if (v.read().strip(), p.read().strip()) in RTL_USB_IDS:
                    count += 1
        except OSError:
            pass
    return count


def nwr_in_use():
    try:
        with open(NWR_CONFIG, encoding="utf-8") as f:
            return bool(json.load(f).get("freq"))
    except (OSError, ValueError, AttributeError):
        return False


def claim_sdr(app):
    os.makedirs(os.path.dirname(SDR_LOCK), exist_ok=True)
    with open(SDR_LOCK, "w", encoding="utf-8") as f:
        json.dump({"pid": os.getpid(), "app": app}, f)


def release_sdr():
    try:
        with open(SDR_LOCK, encoding="utf-8") as f:
            if json.load(f).get("pid") != os.getpid():
                return
        os.remove(SDR_LOCK)
    except (OSError, ValueError, AttributeError):
        pass


# ---- signal processing ----------------------------------------------------

def lowpass(cutoff, rate, taps):
    n = np.arange(taps) - (taps - 1) / 2
    h = np.sinc(2 * cutoff / rate * n) * np.hamming(taps)
    return (h / h.sum()).astype(np.float32)


def bandpass(low, high, rate, taps):
    h = lowpass(high, rate, taps) - lowpass(low, rate, taps)
    return h.astype(np.float32)


class Demod:
    """Narrow FM from one channel of 240 kS/s IQ: audio at 48 kHz, plus how much hiss is left."""

    def __init__(self):
        self.chan_taps = lowpass(7500, RATE, 97)
        self.audio_taps = bandpass(300, 3400, AUDIO_RATE, 511)
        self.reset()

    def reset(self):
        self.phase = 0
        self.iq_tail = np.zeros(len(self.chan_taps) - 1, np.complex64)
        self.audio_tail = np.zeros(len(self.audio_taps) - 1, np.float32)
        self.last = np.complex64(1)
        self.offset = 0  # keeps decimation in step across blocks

    def channel(self, iq):
        """Mix the channel down to 0 Hz, filter it and drop to 48 kS/s."""
        n = np.arange(self.phase, self.phase + len(iq))
        self.phase = (self.phase + len(iq)) % RATE
        mixed = iq * np.exp(-2j * np.pi * OFFSET / RATE * n).astype(np.complex64)
        joined = np.concatenate([self.iq_tail, mixed])
        self.iq_tail = joined[-(len(self.chan_taps) - 1):]
        filtered = np.convolve(joined, self.chan_taps, mode="valid")
        out = filtered[self.offset::DECIM]
        self.offset = (self.offset - len(filtered)) % DECIM
        return out

    def discriminate(self, base):
        joined = np.concatenate([[self.last], base])
        self.last = base[-1] if len(base) else self.last
        return np.angle(joined[1:] * np.conj(joined[:-1])).astype(np.float32)

    def process(self, iq):
        """(audio -1..1 with the PL tone removed, raw discriminator output, hiss 0..~1)."""
        fm = self.discriminate(self.channel(iq))
        return self.audio(fm), fm, hiss(fm)

    def audio(self, fm):
        joined = np.concatenate([self.audio_tail, fm])
        self.audio_tail = joined[-(len(self.audio_taps) - 1):]
        voice = np.convolve(joined, self.audio_taps, mode="valid")
        return np.clip(voice / (2 * np.pi * DEVIATION / AUDIO_RATE), -1, 1)


def hiss(fm):
    """Discriminator power from 6 to 11 kHz, relative to what no signal gives (about 1)."""
    if len(fm) < 256:
        return 1.0
    spec = np.abs(np.fft.rfft(fm * np.hanning(len(fm)))) ** 2
    freqs = np.fft.rfftfreq(len(fm), 1 / AUDIO_RATE)
    band = spec[(freqs >= 6000) & (freqs <= 11000)].mean()
    # Uniform phase noise has variance pi^2/3 spread evenly over 0..24 kHz; after the
    # 7.5 kHz channel filter the 6-11 kHz band keeps about a fifth of that (measured).
    flat = (np.pi ** 2 / 3) * len(fm) * (np.hanning(len(fm)) ** 2).mean() * 0.205
    return float(band / flat)


def has_tone(fm, tone):
    """Whether the discriminator output carries the CTCSS tone (within 1%)."""
    if len(fm) < AUDIO_RATE // 4:
        return False
    spec = np.abs(np.fft.rfft(fm * np.hanning(len(fm)))) ** 2
    freqs = np.fft.rfftfreq(len(fm), 1 / AUDIO_RATE)
    sub = (freqs >= 60) & (freqs <= 260)
    near = sub & (np.abs(freqs - tone) <= max(1.5, tone * 0.01))
    if not near.any():
        return False
    peak = spec[sub].max()
    return bool(spec[near].max() >= peak * 0.7 and spec[near].max() > 20 * np.median(spec[sub]))


# ---- the dongle -------------------------------------------------------------

class Dongle:
    def __init__(self, index, gain_db, ppm):
        name = ctypes.util.find_library("rtlsdr")
        try:
            lib = ctypes.CDLL(name or "librtlsdr.so.2")
        except OSError:
            lib = ctypes.CDLL("librtlsdr.so.0")
        vp, u32, i32 = ctypes.c_void_p, ctypes.c_uint32, ctypes.c_int
        for fn, args in (("rtlsdr_open", [ctypes.POINTER(vp), u32]), ("rtlsdr_close", [vp]),
                         ("rtlsdr_set_sample_rate", [vp, u32]), ("rtlsdr_set_center_freq", [vp, u32]),
                         ("rtlsdr_set_freq_correction", [vp, i32]), ("rtlsdr_set_tuner_gain_mode", [vp, i32]),
                         ("rtlsdr_get_tuner_gains", [vp, ctypes.POINTER(i32)]),
                         ("rtlsdr_set_tuner_gain", [vp, i32]), ("rtlsdr_reset_buffer", [vp]),
                         ("rtlsdr_read_sync", [vp, vp, i32, ctypes.POINTER(i32)])):
            getattr(lib, fn).argtypes = args
            getattr(lib, fn).restype = i32
        self.lib, self.dev = lib, vp()
        if lib.rtlsdr_open(ctypes.byref(self.dev), index) != 0:
            raise OSError("busy")
        lib.rtlsdr_set_sample_rate(self.dev, RATE)
        if ppm:
            lib.rtlsdr_set_freq_correction(self.dev, int(ppm))
        if gain_db in (None, "auto"):
            lib.rtlsdr_set_tuner_gain_mode(self.dev, 0)
        else:
            lib.rtlsdr_set_tuner_gain_mode(self.dev, 1)
            count = lib.rtlsdr_get_tuner_gains(self.dev, None)
            gains = (ctypes.c_int * max(count, 1))()
            lib.rtlsdr_get_tuner_gains(self.dev, gains)
            if count > 0:
                lib.rtlsdr_set_tuner_gain(self.dev, min(gains[:count], key=lambda g: abs(g - gain_db * 10)))
        lib.rtlsdr_reset_buffer(self.dev)
        self.buf = ctypes.create_string_buffer(LISTEN * 2)

    @staticmethod
    def count():
        name = ctypes.util.find_library("rtlsdr")
        try:
            lib = ctypes.CDLL(name or "librtlsdr.so.2")
        except OSError:
            try:
                lib = ctypes.CDLL("librtlsdr.so.0")
            except OSError:
                return -1
        return lib.rtlsdr_get_device_count()

    def tune(self, mhz):
        self.lib.rtlsdr_set_center_freq(self.dev, int(round(mhz * 1e6)) - OFFSET)

    def read(self, samples):
        got = ctypes.c_int(0)
        if self.lib.rtlsdr_read_sync(self.dev, self.buf, samples * 2, ctypes.byref(got)) != 0 or got.value <= 0:
            raise OSError("The RTL-SDR stopped answering (unplugged?).")
        raw = np.frombuffer(self.buf.raw[:got.value], dtype=np.uint8).astype(np.float32)
        return ((raw[0::2] - 127.4) + 1j * (raw[1::2] - 127.4)).astype(np.complex64) / 128

    def close(self):
        self.lib.rtlsdr_close(self.dev)


class FakeDongle:
    """Noise everywhere, and a talking-ish FM signal on the test frequencies (EMCOMM_SCANNER_FAKE)."""

    def __init__(self, busy_mhz, tone=None):
        self.busy, self.tone, self.mhz, self.n = busy_mhz, tone, None, 0
        self.rng = np.random.default_rng(1)

    def tune(self, mhz):
        self.mhz = mhz

    def read(self, samples):
        time.sleep(samples / RATE)
        return fm_test_signal(samples, self.n, self.mhz in self.busy, self.tone, self.rng, advance=self)

    def close(self):
        pass


def fm_test_signal(samples, start, on, tone, rng, advance=None, snr_db=25):
    """IQ at RATE: noise, plus (if on) a narrow FM carrier OFFSET above centre with a 1 kHz note and tone."""
    noise = (rng.standard_normal(samples) + 1j * rng.standard_normal(samples)) * 0.05
    if advance is not None:
        advance.n += samples
    if not on:
        return noise.astype(np.complex64)
    t = (np.arange(samples) + start) / RATE
    message = 0.6 * np.sin(2 * np.pi * 1000 * t) * DEVIATION
    if tone:
        message = message + 0.15 * DEVIATION * np.sin(2 * np.pi * tone * t)
    phase = 2 * np.pi * (OFFSET * t + np.cumsum(message) / RATE)
    amp = 0.05 * math.sqrt(2) * 10 ** (snr_db / 20)
    return (noise + amp * np.exp(1j * phase)).astype(np.complex64)


# ---- the scanning loop ---------------------------------------------------------

class Scanner(threading.Thread):
    """Steps through the scan list; stops on a channel with a signal (and its PL tone)."""

    def __init__(self, on_state):
        super().__init__(daemon=True)
        self.on_state = on_state
        self.lock = threading.Lock()
        self.channels, self.settings = [], load_settings()
        self.hold = None       # channel held by the operator
        self.skip_now = False
        self.stopping = False
        self.dongle = None
        self.audio = None
        self.wake = threading.Event()

    def configure(self, channels, settings):
        with self.lock:
            self.channels, self.settings = list(channels), dict(settings)

    def set_hold(self, ch):
        """Stay on one channel (None: back to scanning). Leaves the channel being listened to."""
        with self.lock:
            self.hold = ch
        self.wake.set()

    def skip(self):
        self.skip_now = True

    def stop(self):
        self.stopping = True
        self.wake.set()

    def _open(self):
        if FAKE:
            busy = [float(x) for x in FAKE.split(",") if x.strip()]
            self.dongle = FakeDongle(busy, tone=float(os.environ.get("EMCOMM_SCANNER_FAKE_TONE", "0")) or None)
            return
        count = Dongle.count()
        if count < 0:
            raise OSError("The RTL-SDR library isn't installed. Run Update station in Settings.")
        if count == 0:
            raise OSError("No RTL-SDR dongle found. Plug one in with a VHF/UHF antenna.")
        index = 1 if count > 1 and nwr_in_use() else 0
        if index == 0:
            claim_sdr("Scanner")  # the weather radio listener lets go of the dongle
        for _ in range(12):
            try:
                self.dongle = Dongle(index, self.settings.get("gain"), self.settings.get("ppm"))
                return
            except OSError:
                time.sleep(0.5)
        raise OSError("The RTL-SDR is busy in another app (Gqrx?). Close it and tap Scan.")

    def _play(self, samples):
        if self.audio is None or self.audio.poll() is not None:
            try:
                self.audio = subprocess.Popen(["pacat", "--playback", "--raw", "--format=s16le",
                                               f"--rate={AUDIO_RATE}", "--channels=1", "--latency-msec=150",
                                               "--client-name=Scanner"], stdin=subprocess.PIPE)
            except OSError:
                self.audio = None
                return
        volume = (self.settings.get("volume", 70) / 100) ** 2
        try:
            self.audio.stdin.write((np.clip(samples * volume, -1, 1) * 32000).astype("<i2").tobytes())
            self.audio.stdin.flush()
        except (BrokenPipeError, OSError):
            self.audio = None

    def run(self):
        try:
            self._open()
        except OSError as err:
            release_sdr()
            self.on_state({"state": "error", "text": str(err)})
            return
        demod = Demod()
        position = 0
        try:
            while not self.stopping:
                self.wake.clear()
                with self.lock:
                    held, settings = self.hold, self.settings
                    targets = [held] if held else scan_list(self.channels, settings)
                if not targets:
                    self.on_state({"state": "idle", "text": "Nothing to scan: turn on a group or widen the distance."})
                    self.wake.wait(0.5)
                    continue
                position %= len(targets)
                ch = targets[position]
                if self._visit(ch, demod, settings, held is not None):
                    position += 1 if held is None else 0
                else:
                    position += 1
        except OSError as err:
            self.on_state({"state": "error", "text": str(err)})
        finally:
            if self.dongle:
                self.dongle.close()
            release_sdr()
            if self.audio and self.audio.poll() is None:
                self.audio.terminate()

    def _visit(self, ch, demod, settings, held):
        """Look at one channel; stay while it's active. True if it was active."""
        threshold = SQUELCH_LEVELS.get(int(settings.get("squelch", 4)), 0.38)
        self.dongle.tune(ch["mhz"])
        self.dongle.read(SETTLE)
        demod.reset()
        _audio, fm, noise = demod.process(self.dongle.read(LOOK))
        if not held:
            self.on_state({"state": "scanning", "channel": ch, "level": noise})
        if noise > threshold:
            if held:
                self.on_state({"state": "holding", "channel": ch, "level": noise, "open": False})
            return False
        # Something's there. With tone squelch, it must carry this channel's PL tone.
        want_tone = settings.get("tone_squelch") and ch.get("tone_kind") == "pl"
        heard = [fm]
        quiet_since, started, toned = None, time.time(), not want_tone
        while not self.stopping and not self.wake.is_set():
            if self.skip_now:
                self.skip_now = False
                return True
            audio, fm, noise = demod.process(self.dongle.read(LISTEN))
            if not toned:
                heard.append(fm)
                joined = np.concatenate(heard)
                if has_tone(joined, ch["tone"]):
                    toned = True
                elif len(joined) >= TONE_WAIT * AUDIO_RATE:
                    if held:
                        heard = heard[-2:]
                        self.on_state({"state": "holding", "channel": ch, "level": noise, "open": False,
                                       "other": True})
                        continue
                    return False  # someone else on the frequency
                if not toned:
                    continue
            is_open = noise <= threshold * 1.25  # a little hysteresis
            if is_open:
                quiet_since = None
                self._play(audio)
            elif quiet_since is None:
                quiet_since = time.time()
            self.on_state({"state": "holding" if held else "listening", "channel": ch, "level": noise,
                           "open": is_open, "since": started})
            if quiet_since and time.time() - quiet_since > HANG:
                return True
            settings = self.settings  # squelch and volume changes apply straight away
            threshold = SQUELCH_LEVELS.get(int(settings.get("squelch", 4)), 0.38)
        return True


