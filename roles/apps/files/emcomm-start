#!/bin/bash
# Start a radio app from a launcher tile, with its settings filled in from the
# station settings first.
# Usage: emcomm-start js8call|wsjtx|fldigi|flmsg|pat|vara-hf|vara-fm|packet|ardop|aprs|meshtastic|meshcore|sdr
set -u

STATE="$HOME/.local/state/emcomm"
mkdir -p "$STATE"
TERM_OPTS=(-fa "IBM Plex Mono" -fs 12 -geometry 110x30)
export WINEPREFIX="$HOME/.wine-vara" WINEARCH=win32 WINEDEBUG=-all

listening() { (exec 3<>"/dev/tcp/127.0.0.1/$1") 2>/dev/null; }

# USB serial devices that aren't the radio's CAT or PTT port: a Meshtastic or
# MeshCore node.
node_ports() {
  local dev rig
  rig=" $(readlink -f /dev/rig-cat 2>/dev/null) $(readlink -f /dev/rig-ptt 2>/dev/null) "
  for dev in /dev/serial/by-id/*; do
    [ -e "$dev" ] || continue
    [[ "$rig" == *" $(readlink -f "$dev") "* ]] && continue
    echo "$dev"
  done
}

BT_SEARCH="Search for a Bluetooth radio"

# Bluetooth devices already paired, as "MAC Name" lines.
paired_bt() {
  command -v bluetoothctl >/dev/null || return 0
  bluetoothctl devices Paired 2>/dev/null | sed -n 's/^Device \([0-9A-F:]\{17\}\) \(.*\)$/\1 \2/p'
}

# Look for Bluetooth radios nearby, pick one and pair with it (the radio shows
# or uses a PIN: Meshtastic shows it on its screen or uses 123456, MeshCore
# uses 123456 unless it was changed). Prints the radio's address.
search_bt() {
  local devices dev mac
  if ! command -v bluetoothctl >/dev/null; then
    echo "Bluetooth isn't set up on this station. Run Update station in Settings." >&2; return 1
  fi
  bluetoothctl power on >/dev/null 2>&1
  if ! bluetoothctl show 2>/dev/null | grep -q "Powered: yes"; then
    echo "This computer's Bluetooth is off or missing." >&2; return 1
  fi
  echo "Looking for Bluetooth radios for 10 seconds. Turn on the $1 radio's Bluetooth..." >&2
  bluetoothctl --timeout 10 scan on >/dev/null 2>&1
  # Named devices only: a radio always has a name, phones' random addresses often don't.
  mapfile -t devices < <(bluetoothctl devices 2>/dev/null |
    sed -n 's/^Device \([0-9A-F:]\{17\}\) \(.*\)$/\1 \2/p' |
    awk '{ name = $0; sub(/^[^ ]+ /, "", name); gsub(/[-:]/, "", name); if (name != "" && name !~ /^[0-9A-F]+$/) print }')
  if [ ${#devices[@]} -eq 0 ]; then
    echo "No Bluetooth radios found. Check the radio's Bluetooth is on and tap the tile again." >&2; return 1
  fi
  echo "Which is the $1 radio?" >&2
  select dev in "${devices[@]}"; do
    [ -n "$dev" ] && break
  done
  [ -n "${dev:-}" ] || return 1
  mac=${dev%% *}
  if ! bluetoothctl info "$mac" 2>/dev/null | grep -q "Paired: yes"; then
    echo "Pairing with ${dev#* }. Type the radio's PIN when asked (often 123456)." >&2
    if ! bluetoothctl --agent KeyboardOnly pair "$mac" >&2; then
      echo "Pairing didn't work. Check the PIN and try again." >&2; return 1
    fi
  fi
  bluetoothctl trust "$mac" >/dev/null 2>&1
  echo "$mac"
}

# Pick the node: a USB serial port ("usb PORT") or a Bluetooth address ("ble MAC").
# One USB radio and nothing paired by Bluetooth: use it without asking. Runs in a terminal.
pick_node() {
  local ports bt choices choice i
  mapfile -t ports < <(node_ports)
  mapfile -t bt < <(paired_bt)
  if [ ${#ports[@]} -eq 1 ] && [ ${#bt[@]} -eq 0 ]; then
    echo "usb ${ports[0]}"; return 0
  fi
  if [ ${#ports[@]} -eq 0 ] && [ ${#bt[@]} -eq 0 ]; then
    if ! command -v bluetoothctl >/dev/null; then
      echo "No $1 radio found. Plug it in by USB and tap the tile again." >&2; return 1
    fi
    echo "No $1 radio is plugged in by USB." >&2
    choice=$(search_bt "$1") || return 1
    echo "ble $choice"; return 0
  fi
  choices=()
  for i in "${ports[@]}"; do choices+=("USB: ${i##*/}"); done
  for i in "${bt[@]}"; do choices+=("Bluetooth: ${i#* } (${i%% *})"); done
  command -v bluetoothctl >/dev/null && choices+=("$BT_SEARCH")
  echo "How is the $1 radio connected?" >&2
  select choice in "${choices[@]}"; do
    [ -n "$choice" ] && break
  done
  case "${choice:-}" in
    "USB: "*) echo "usb /dev/serial/by-id/${choice#USB: }" ;;
    "Bluetooth: "*) i=${choice##*(}; echo "ble ${i%)}" ;;
    "$BT_SEARCH") choice=$(search_bt "$1") || return 1; echo "ble $choice" ;;
    *) return 1 ;;
  esac
}

in_terminal() {
  local title=$1; shift
  exec xterm "${TERM_OPTS[@]}" -T "$title" -e bash -c '"$@" || read -r -p "Press Enter to close. " _' _ "$@"
}

case "${1:-}" in
  js8call|wsjtx)
    emcomm-app-setup "$1" >/dev/null
    exec "$1"
    ;;
  fldigi|flmsg)
    exec "$1"
    ;;
  pat)
    # Pat runs as a small web server; the mailbox opens in its own window.
    if ! listening 8080; then
      emcomm-app-setup pat >/dev/null
      setsid pat http >"$STATE/pat.log" 2>&1 &
      for _ in $(seq 20); do listening 8080 && break; sleep 0.5; done
    fi
    exec emcomm-webview "http://localhost:8080/" "Winlink mail (Pat)"
    ;;
  vara-hf|vara-fm)
    if [ "$1" = vara-hf ]; then exe='C:\VARA\VARA.exe'; else exe='C:\VARA FM\VARAFM.exe'; fi
    if [ ! -e "$(winepath -u "$exe" 2>/dev/null)" ]; then
      exec emcomm-install-vara "${1#vara-}"
    fi
    exec wine "$exe"
    ;;
  packet)
    conf=$(emcomm-app-setup direwolf)
    exec xterm "${TERM_OPTS[@]}" -T "Packet (Direwolf)" -e direwolf -c "$conf"
    ;;
  ardop)
    # Pat keys the radio through rigctld, so ardopcf only needs the sound card,
    # reached through PipeWire so other apps can share it.
    exec xterm "${TERM_OPTS[@]}" -T "ARDOP modem" -e ardopcf --logdir "$STATE" 8515 pipewire pipewire
    ;;
  aprs)
    # Xastir sends and hears APRS through Direwolf. Start Direwolf for it unless
    # Packet already has it running, and stop it afterwards so other apps can
    # use the sound card.
    emcomm-app-setup xastir >/dev/null
    modem=""
    if ! listening 8000; then
      direwolf -t 0 -c "$(emcomm-app-setup direwolf)" >"$STATE/direwolf-aprs.log" 2>&1 &
      modem=$!
      for _ in $(seq 20); do listening 8000 && break; sleep 0.5; done
    fi
    xastir
    [ -n "$modem" ] && kill "$modem" 2>/dev/null
    exit 0
    ;;
  meshtastic)
    [ -t 1 ] || in_terminal "Meshtastic" "$0" meshtastic
    node=$(pick_node Meshtastic) || exit 1
    if [ "${node%% *}" = ble ]; then exec contact --ble "${node#* }"; fi
    exec contact --port "${node#* }"
    ;;
  meshcore)
    [ -t 1 ] || in_terminal "MeshCore" "$0" meshcore
    node=$(pick_node MeshCore) || exit 1
    if [ "${node%% *}" = ble ]; then exec meshcore-cli -a "${node#* }"; fi
    exec meshcore-cli -s "${node#* }"
    ;;
  sdr)
    # Gqrx on any SDR receiver (RTL-SDR, Airspy, HackRF, SDRplay...), with the
    # scanner's channel list as bookmarks. With more than one receiver, or an
    # RTL-SDR that can also do HF by direct sampling, it asks which. Each choice
    # keeps its own Gqrx settings (~/.config/gqrx/KEY.conf). The weather radio
    # listener uses the first RTL-SDR and lets go of it while sdr.json names a
    # running app. With no receiver it offers a practice recording or an RTL-SDR
    # shared over the network (rtl_tcp).
    choice=$(emcomm-scanner --pick-receiver 2>/dev/null) || exit 0
    IFS=$'\t' read -r key device rate start rtl_index <<< "$choice"
    mkdir -p "$HOME/.config/gqrx"
    conf="$HOME/.config/gqrx/$key.conf"
    if [ "$key" = practice ]; then
      # The recording knows nothing of tuning, so Gqrx starts on its centre each
      # time (or the frequencies shown would be off), on the FM signal there.
      printf '[General]\nconfigversion=4\ncrashed=false\n\n[input]\ndevice="%s"\nsample_rate=%s\nfrequency=%s\n\n[receiver]\ndemod=Narrow FM\noffset=20000\n' \
        "$device" "$rate" "$start" > "$conf"
    elif [ ! -f "$conf" ]; then
      printf '[General]\nconfigversion=4\ncrashed=false\n\n[input]\ndevice="%s"\nsample_rate=%s\nfrequency=%s\n' \
        "$device" "$rate" "$start" > "$conf"
    else
      # An RTL-SDR's number can change when dongles are plugged in a different order.
      sed -i "s|^device=.*|device=\"$device\"|" "$conf"
    fi
    marks="$HOME/.config/gqrx/bookmarks.csv"
    if [ ! -f "$marks" ] || head -1 "$marks" | grep -q "Emcomm-CNC"; then
      emcomm-scanner --gqrx-bookmarks > "$marks.tmp" 2>/dev/null && mv "$marks.tmp" "$marks"
      rm -f "$marks.tmp"
    fi
    if [ "$rtl_index" = 0 ]; then
      mkdir -p "$STATE"
      printf '{"pid": %s, "app": "Gqrx"}\n' "$$" > "$STATE/sdr.json"
      sleep 3  # the weather radio listener checks every 2 seconds
    fi
    # However Gqrx ends (closed, crashed, this script stopped), it mustn't keep
    # the receiver: Gqrx sometimes hangs on after its window has gone, still
    # holding the dongle, so the Scanner can't open it. Once its window has been
    # seen and is gone for 5 seconds, Gqrx is stopped, and the lock goes with it.
    gqrx -c "$key.conf" &
    gqrx_pid=$!
    # shellcheck disable=SC2329  # the EXIT trap runs it
    release_sdr() {
      if kill -0 "$gqrx_pid" 2>/dev/null; then
        kill -TERM "$gqrx_pid" 2>/dev/null
        for _ in 1 2 3 4 5; do kill -0 "$gqrx_pid" 2>/dev/null || break; sleep 1; done
        kill -KILL "$gqrx_pid" 2>/dev/null
      fi
      if grep -q "\"pid\": $$," "$STATE/sdr.json" 2>/dev/null; then rm -f "$STATE/sdr.json"; fi
    }
    trap release_sdr EXIT
    trap 'exit 0' INT TERM HUP
    seen=0 gone=0
    while kill -0 "$gqrx_pid" 2>/dev/null; do
      if wmctrl -lp 2>/dev/null | awk -v p="$gqrx_pid" '$3 == p {found=1} END {exit !found}'; then
        seen=1 gone=0
      elif [ "$seen" = 1 ]; then
        gone=$((gone + 1))
        [ "$gone" -ge 5 ] && break
      fi
      sleep 1
    done
    exit 0
    ;;
  *)
    echo "usage: $0 js8call|wsjtx|fldigi|flmsg|pat|vara-hf|vara-fm|packet|ardop|aprs|meshtastic|meshcore|sdr" >&2
    exit 2
    ;;
esac
