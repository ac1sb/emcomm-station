#!/usr/bin/env python3
"""Show a web page (Pat's mailbox, Winlink's VARA downloads) in a full-screen
window with a Close button, so the station doesn't need a full web browser.
Files that can't be shown are saved to ~/Downloads.

  emcomm-webview [--close-after-download] [--print] URL [TITLE]

With --close-after-download the window closes by itself once a file is saved,
so a setup script waiting on the download carries straight on. --print adds a
Print button (the print dialog can also save a PDF, for a USB stick).
"""

import os
import sys

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
gi.require_version("WebKit2", "4.1")
from gi.repository import Gdk, GLib, Gtk, WebKit2  # noqa: E402

DOWNLOADS = os.path.expanduser("~/Downloads")
CSS = b"""
.banner { font-size: 20px; font-weight: bold; padding: 14px; }
.banner.busy { background: #1F5FA8; color: #FFFFFF; }
.banner.done { background: #2E7D32; color: #FFFFFF; }
.banner.failed { background: #B3261E; color: #FFFFFF; }
"""


def main(argv):
    close_after_download = "--close-after-download" in argv
    printable = "--print" in argv
    argv = [a for a in argv if a not in ("--close-after-download", "--print")]
    if not argv:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    url, title = argv[0], (argv[1] if len(argv) > 1 else argv[0])

    win = Gtk.Window(title=title)
    win.set_default_size(1024, 600)
    win.connect("destroy", Gtk.main_quit)
    box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
    win.add(box)

    bar = Gtk.Box(spacing=8, margin=6)
    view = WebKit2.WebView()
    if url.startswith("file://"):
        # The station map is a page on disk that loads its scripts from disk too.
        view.get_settings().set_allow_file_access_from_file_urls(True)
    back = Gtk.Button(label="‹ Back")
    back.connect("clicked", lambda *_: view.go_back())
    reload_btn = Gtk.Button(label="Reload")
    reload_btn.connect("clicked", lambda *_: view.reload())
    close = Gtk.Button(label="Close  Esc")
    close.connect("clicked", lambda *_: win.destroy())
    for btn in (back, reload_btn):
        bar.pack_start(btn, False, False, 0)
    if printable:
        print_btn = Gtk.Button(label="Print")
        print_btn.connect("clicked", lambda *_: WebKit2.PrintOperation.new(view).run_dialog(win))
        bar.pack_start(print_btn, False, False, 0)
    status = Gtk.Label(label=title)
    bar.pack_start(status, True, True, 0)
    bar.pack_end(close, False, False, 0)
    box.pack_start(bar, False, False, 0)
    # A big coloured strip across the top while a file downloads, so it can't be missed.
    banner = Gtk.Label(wrap=True)
    banner.get_style_context().add_class("banner")
    box.pack_start(banner, False, False, 0)
    box.pack_start(view, True, True, 0)
    provider = Gtk.CssProvider()
    provider.load_from_data(CSS)
    Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), provider,
                                             Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

    def show_banner(kind, text):
        ctx = banner.get_style_context()
        for name in ("busy", "done", "failed"):
            ctx.remove_class(name)
        ctx.add_class(kind)
        banner.set_text(text)
        banner.show()

    def decide_policy(_view, decision, kind):
        # Download anything the window can't display, such as a .zip.
        if kind == WebKit2.PolicyDecisionType.RESPONSE and not decision.is_mime_type_supported():
            decision.download()
            return True
        return False

    def save_to_downloads(download, suggested_name):
        os.makedirs(DOWNLOADS, exist_ok=True)
        path = os.path.join(DOWNLOADS, os.path.basename(suggested_name))
        download.set_destination(GLib.filename_to_uri(path, None))
        name = os.path.basename(path)
        show_banner("busy", f"Downloading {name}…")
        failed = []

        def finished(*_):
            if failed:
                return
            if close_after_download:
                show_banner("done", f"✓ Saved {name}. Carrying on…")
                GLib.timeout_add_seconds(2, win.destroy)
            else:
                show_banner("done", f"✓ Saved {name} to Downloads. Open it from the Files tile.")

        def on_failed(_download, err):
            failed.append(err)
            show_banner("failed", f"Download failed: {err.message}. Tap Reload and try again.")

        download.connect("failed", on_failed)
        download.connect("finished", finished)
        return True

    view.connect("decide-policy", decide_policy)
    view.get_context().connect("download-started",
                               lambda _ctx, download: download.connect("decide-destination", save_to_downloads))

    win.connect("key-press-event",
                lambda _w, e: e.keyval == Gdk.KEY_Escape and (win.destroy() or True))
    view.load_uri(url)
    win.show_all()
    banner.hide()
    win.maximize()
    Gtk.main()
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
