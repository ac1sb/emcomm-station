#!/usr/bin/env python3
"""Make the radio's sound card (ALSA card id "rigaudio") the default speaker
and microphone, so every app's "default" audio device is the radio.

Runs as the station user, whose PipeWire session owns the defaults. The
launcher runs it whenever the radio's sound card appears; it can also be run
by hand. Exits 1 if the radio's sound card isn't plugged in.
"""

import json
import os
import subprocess
import sys

CARD_LINK = "/proc/asound/rigaudio"  # -> cardN
# PipeWire versions put the ALSA card number under different keys.
CARD_KEYS = ("api.alsa.card", "api.alsa.pcm.card", "alsa.card")


def radio_card_number():
    try:
        return os.path.basename(os.readlink(CARD_LINK)).removeprefix("card")
    except OSError:
        return None


def radio_nodes(dump, card):
    """(media class, node id) for each radio sink and source in pw-dump output."""
    found = []
    for obj in dump:
        if obj.get("type") != "PipeWire:Interface:Node":
            continue
        props = (obj.get("info") or {}).get("props") or {}
        media_class = props.get("media.class")
        if media_class not in ("Audio/Sink", "Audio/Source"):
            continue
        if any(str(props.get(key)) == card for key in CARD_KEYS):
            found.append((media_class, obj["id"]))
    return found


def main():
    card = radio_card_number()
    if card is None:
        print("Radio sound card (rigaudio) not found.", file=sys.stderr)
        return 1
    try:
        dump = json.loads(subprocess.run(["pw-dump"], capture_output=True, text=True, check=True).stdout)
    except (OSError, subprocess.CalledProcessError, ValueError) as exc:
        print(f"Can't read PipeWire's devices: {exc}", file=sys.stderr)
        return 1
    done = set()
    for media_class, node_id in radio_nodes(dump, card):
        if media_class in done:
            continue
        subprocess.run(["wpctl", "set-default", str(node_id)], check=False)
        done.add(media_class)
        print(f"Default {'speaker' if media_class == 'Audio/Sink' else 'microphone'}: radio (node {node_id})")
    if not done:
        print(f"PipeWire has no audio devices for the radio's sound card (card {card}) yet.", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
