#!/usr/bin/env python3
"""An APRS iGate on a second radio kept for APRS (say a 2 m mobile on 144.390 MHz
through a Digirig), run by Direwolf.

  emcomm-igate                 run (the emcomm-igate service does this as the station user)
  emcomm-igate --tile-conf     write the Direwolf settings the APRS tile uses on the APRS
                               radio while the iGate is off, and print their path
  emcomm-igate --status        print what the iGate is doing, as JSON
  emcomm-igate --passcode CALL print the APRS-IS passcode for a callsign

The APRS radio's sound card and PTT port are picked in Settings > APRS iGate, which
names them "aprsaudio" and /dev/aprs-ptt (emcomm-apply-settings --aprs). The iGate
settings are in ~/.config/emcomm/igate.json:

  {"mode": "off" | "receive" | "two-way", "ssid": 10, "server": "noam.aprs2.net",
   "comment": "...", "lat": 43.16, "lon": -73.07}

Receive only: packets heard on the radio go to APRS-IS, and the station's position
goes to APRS-IS only; the radio is never keyed. Two-way: also messages from APRS-IS
for stations heard nearby go out on the radio, and the station beacons on the air.
Either way Direwolf's AGW port 8010 is open on this computer, so the APRS tile's
Xastir uses the same radio. The passcode is worked out from the callsign, as
APRS-IS expects.
"""

import json
import os
import re
import shutil
import subprocess
import sys
import threading
import time

HOME = os.path.expanduser("~")
CONFIG = os.path.join(HOME, ".config/emcomm/igate.json")
CONF_DIR = os.path.join(HOME, ".config/emcomm")
OUT = os.environ.get("EMCOMM_IGATE_DIR", os.path.join(HOME, ".cache/emcomm/igate"))
STATION_PATH = os.environ.get("EMCOMM_STATION", "/etc/emcomm/station.json")
CARD = os.environ.get("EMCOMM_APRS_CARD", "/proc/asound/aprsaudio")
PTT = os.environ.get("EMCOMM_APRS_PTT", "/dev/aprs-ptt")
AGWPORT, KISSPORT = 8010, 8011  # the Packet tile's Direwolf has 8000 and 8001
MODES = ("off", "receive", "two-way")
SERVERS = ["noam.aprs2.net", "rotate.aprs2.net", "euro.aprs2.net", "asia.aprs2.net",
           "aunz.aprs2.net", "soam.aprs2.net"]
DEFAULTS = {"mode": "off", "ssid": 10, "server": SERVERS[0], "comment": "Emcomm-CNC iGate"}
CALL_RE = re.compile(r"^[A-Z0-9]{1,3}[0-9][A-Z0-9]{0,4}$")


def passcode(call):
    """The APRS-IS passcode for a callsign (the SSID doesn't count)."""
    call = call.upper().split("-")[0]
    code = 0x73E2
    for i in range(0, len(call), 2):
        code ^= ord(call[i]) << 8
        if i + 1 < len(call):
            code ^= ord(call[i + 1])
    return code & 0x7FFF


def read_json(path, default):
    try:
        with open(path, encoding="utf-8") as f:
            data = json.load(f)
        return data if isinstance(data, dict) else default
    except (OSError, ValueError):
        return default


def grid_to_latlon(grid):
    grid = (grid or "").strip()
    if not re.fullmatch(r"[A-Ra-r]{2}[0-9]{2}([A-Xa-x]{2})?", grid):
        return None
    lon = (ord(grid[0].upper()) - 65) * 20 - 180 + int(grid[2]) * 2
    lat = (ord(grid[1].upper()) - 65) * 10 - 90 + int(grid[3])
    if len(grid) == 6:
        lon += (ord(grid[4].lower()) - 97) * 5 / 60 + 2.5 / 60
        lat += (ord(grid[5].lower()) - 97) * 2.5 / 60 + 1.25 / 60
    else:
        lon, lat = lon + 1, lat + 0.5
    return round(lat, 4), round(lon, 4)


def settings():
    """igate.json with defaults filled in and anything odd put right."""
    s = dict(DEFAULTS, **read_json(CONFIG, {}))
    if s["mode"] not in MODES:
        s["mode"] = "off"
    try:
        s["ssid"] = min(max(int(s["ssid"]), 0), 15)
    except (TypeError, ValueError):
        s["ssid"] = DEFAULTS["ssid"]
    if not re.fullmatch(r"[A-Za-z0-9.-]{1,64}", str(s["server"])):
        s["server"] = DEFAULTS["server"]
    # Direwolf reads the comment up to the closing quote: keep it plain.
    s["comment"] = re.sub(r'[^ -~]|"', "", str(s.get("comment") or ""))[:40]
    for key in ("lat", "lon"):
        try:
            s[key] = float(s[key]) if s.get(key) is not None else None
        except (TypeError, ValueError):
            s[key] = None
    return s


def position(s, station):
    """(lat, lon) to beacon: the one set in Settings, else the grid square's centre."""
    if s.get("lat") is not None and s.get("lon") is not None and -90 <= s["lat"] <= 90 and -180 <= s["lon"] <= 180:
        return s["lat"], s["lon"]
    return grid_to_latlon(station.get("grid", ""))


def callsign(station):
    call = str(station.get("callsign") or "").upper().split("/")[0]
    return call if CALL_RE.match(call) and call != "N0CALL" else None


def direwolf_conf(s, station, igate, ptt):
    """Direwolf's settings for the APRS radio; with igate, the iGate as well."""
    call = callsign(station) or "N0CALL"
    me = f"{call}-{s['ssid']}" if s["ssid"] else call
    lines = [
        "# Written by emcomm-igate; edits are lost. Change it in Settings > APRS iGate.",
        "ADEVICE plughw:CARD=aprsaudio,DEV=0",
        "CHANNEL 0",
        f"MYCALL {me}",
        "MODEM 1200",
    ]
    if ptt and (not igate or s["mode"] == "two-way"):  # receive only never keys the radio
        lines.append(f"PTT {PTT} RTS")
    # Direwolf keeps its default KISS port 8001 unless told "KISSPORT 0" first.
    lines += [f"AGWPORT {AGWPORT}", "KISSPORT 0", f"KISSPORT {KISSPORT}"]
    if not igate:
        return "\n".join(lines) + "\n"
    two_way = s["mode"] == "two-way" and ptt
    lines += [f"IGSERVER {s['server']}", f"IGLOGIN {me} {passcode(call)}"]
    here = position(s, station)
    if here:
        where = f'lat={here[0]:.4f} long={here[1]:.4f} symbol="igate" overlay={"T" if two_way else "R"}'
        comment = f' comment="{s["comment"]}"' if s["comment"] else ""
        lines.append(f"PBEACON sendto=IG delay=1 every=30 {where}{comment}")
        if two_way:
            lines.append(f"PBEACON delay=2 every=30 via=WIDE1-1 {where}{comment}")
    if two_way:
        # Messages from APRS-IS to stations heard nearby go out on the air, a few at most.
        lines += ["IGTXVIA 0 WIDE1-1", "IGTXLIMIT 6 10"]
    return "\n".join(lines) + "\n"


def write(path, text):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path + ".tmp", "w", encoding="utf-8") as f:
        f.write(text)
    os.replace(path + ".tmp", path)


def write_status(state, text, **counts):
    write(os.path.join(OUT, "status.json"),
          json.dumps(dict({"state": state, "text": text, "time": int(time.time())}, **counts)))


def status():
    found = read_json(os.path.join(OUT, "status.json"), {})
    s = settings()
    if not found or (s["mode"] == "off" and found.get("state") != "off"):
        found = {"state": "off" if s["mode"] == "off" else "starting", "text": ""}
    elif time.time() - (found.get("time") or 0) > 30:  # the service writes every few seconds
        found = {"state": "stopped", "text": "The iGate service isn't running. Restart the station, or run "
                 "Update station in Settings."}
    return dict(found, mode=s["mode"], card=os.path.exists(CARD), ptt=os.path.exists(PTT))


def blocker(s, station):
    """Why the iGate can't run now, or None."""
    if not callsign(station):
        return "Set your callsign in Settings > User first."
    if not os.path.exists(CARD):
        return "The APRS radio's sound card isn't plugged in (pick it in Settings > APRS iGate)."
    if s["mode"] == "two-way" and not os.path.exists(PTT):
        return "Two-way needs the APRS radio's PTT port: plug it in, or pick it in Settings > APRS iGate."
    return None


HEARD = re.compile(r"^\[\d+[^\]]*\] \S+>")  # a packet heard on the radio
SENT = re.compile(r"^\[ig\] [^#]")  # a packet passed to APRS-IS (not the server's "#" keep-alives)
TO_RF = re.compile(r"^\[ig>tx\] ")  # a message from APRS-IS sent on the air


class Counter:
    def __init__(self):
        self.heard = self.igated = self.to_rf = 0
        self.connected = False
        self.last = None

    def line(self, text):
        if HEARD.match(text):
            self.heard += 1
            self.last = int(time.time())
        elif SENT.match(text):
            self.igated += 1
        elif TO_RF.match(text):
            self.to_rf += 1
        elif "Now connected to IGate server" in text:
            self.connected = True
        elif "IGate server" in text and ("Closing connection" in text or "failed" in text or "Can't get" in text):
            self.connected = False

    def summary(self, mode):
        parts = [f"heard {self.heard}", f"sent {self.igated} to APRS-IS"]
        if mode == "two-way":
            parts.append(f"{self.to_rf} sent on the air")
        server = "connected to APRS-IS" if self.connected else "not connected to APRS-IS yet"
        return f"Running, {server}: " + ", ".join(parts) + "."


def stamp():
    out = []
    for path in (CONFIG, STATION_PATH):
        try:
            out.append(os.path.getmtime(path))
        except OSError:
            out.append(None)
    return out + [os.path.exists(PTT)]


def run():
    if not shutil.which("direwolf"):
        write_status("missing", "Direwolf isn't installed. Run Update station in Settings.")
    while not shutil.which("direwolf"):
        time.sleep(60)
    while True:
        s, station = settings(), read_json(STATION_PATH, {})
        if s["mode"] == "off":
            write_status("off", "The iGate is off.")
            time.sleep(5)
            continue
        why = blocker(s, station)
        if why:
            write_status("waiting", why)
            time.sleep(5)
            continue
        conf = os.path.join(CONF_DIR, "direwolf-igate.conf")
        custom = os.path.join(CONF_DIR, "direwolf-igate.custom.conf")
        if not os.path.exists(custom):
            write(conf, direwolf_conf(s, station, igate=True, ptt=os.path.exists(PTT)))
        else:
            conf = custom
        before = stamp()
        counter = Counter()
        write_status("starting", "Starting the iGate…")
        # Line-buffered, or Direwolf holds its output back when it isn't writing to a terminal.
        line_buffered = ["stdbuf", "-oL"] if shutil.which("stdbuf") else []
        proc = subprocess.Popen([*line_buffered, "direwolf", "-t", "0", "-c", conf], stdout=subprocess.PIPE,
                                stderr=subprocess.STDOUT, text=True, errors="replace")
        lines = []

        def read(proc=proc, counter=counter, lines=lines):
            for text in proc.stdout:
                counter.line(text)
                lines.append(text.rstrip())
                del lines[:-20]

        threading.Thread(target=read, daemon=True).start()
        while proc.poll() is None:
            time.sleep(2)
            write_status("running", counter.summary(s["mode"]), heard=counter.heard, igated=counter.igated,
                         to_rf=counter.to_rf, connected=counter.connected, last_heard=counter.last)
            if stamp() != before or not os.path.exists(CARD):
                proc.terminate()
                try:
                    proc.wait(10)
                except subprocess.TimeoutExpired:
                    proc.kill()
        busy = any("busy" in line.lower() or "address already in use" in line.lower() for line in lines)
        write_status("stopped", "The APRS radio is in use by the APRS tile; trying again." if busy else
                     "Direwolf stopped; trying again. " + (lines[-1] if lines else ""))
        time.sleep(5)


def tile_conf():
    s, station = settings(), read_json(STATION_PATH, {})
    custom = os.path.join(CONF_DIR, "direwolf-aprs.custom.conf")
    if os.path.exists(custom):
        return custom
    path = os.path.join(CONF_DIR, "direwolf-aprs.conf")
    write(path, direwolf_conf(s, station, igate=False, ptt=os.path.exists(PTT)))
    return path


def main(argv):
    if argv == ["--tile-conf"]:
        print(tile_conf())
        return 0
    if argv == ["--status"]:
        print(json.dumps(status()))
        return 0
    if len(argv) == 2 and argv[0] == "--passcode":
        print(passcode(argv[1]))
        return 0
    if argv:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    run()
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
