#!/usr/bin/env python3
"""Apply station settings: validate them, then write the radio's udev rules,
rigctld arguments and station.env, and restart rig control.

Runs as root. The launcher's Settings screen calls it through sudo with a
candidate settings file; the playbook calls it with no argument to apply the
current settings.

  emcomm-apply-settings                   apply /etc/emcomm/station.json
  emcomm-apply-settings NEW.json          validate NEW.json, install it, apply
  emcomm-apply-settings --check NEW.json  validate only
  emcomm-apply-settings --aprs NEW.json   the APRS radio's sound card and PTT port
                                          (a second radio for APRS and the iGate)

Settings name any Hamlib rig model plus USB matches (vendor/product IDs,
optional serial number and interface) for the CAT port, PTT port, sound
card and GPS. Every value that reaches a udev rule is checked against a strict
pattern first, so the settings file can't inject rule text.
"""

import json
import os
import re
import shutil
import subprocess
import sys

ROOT = os.environ.get("EMCOMM_ROOT", "")  # tests render into a scratch tree
ETC = f"{ROOT}/etc/emcomm"
SETTINGS = f"{ETC}/station.json"
UDEV_RULES = f"{ROOT}/etc/udev/rules.d/99-emcomm-radio.rules"
APRS_SETTINGS = f"{ETC}/aprs-radio.json"
# Read after the radio's rules, so an APRS sound card just like the radio's (two
# Digirigs) ends up named for APRS.
APRS_RULES = f"{ROOT}/etc/udev/rules.d/99-emcomm-vhf.rules"
ZONEINFO = f"{ROOT}/usr/share/zoneinfo"

BAUD_RATES = (1200, 2400, 4800, 9600, 19200, 38400, 57600, 115200)
PTT_METHODS = ("RTS", "DTR", "CAT", "NONE")
CALLSIGN_RE = re.compile(r"^[A-Z0-9]{1,3}[0-9][A-Z0-9]{0,4}(/[A-Z0-9]{1,4})?$")
GRID_RE = re.compile(r"^[A-R]{2}[0-9]{2}([A-X]{2})?$")
ZONE_RE = re.compile(r"^[A-Za-z][A-Za-z0-9_+-]*(/[A-Za-z0-9_+-]+){0,2}$")
NAME_RE = re.compile(r"^[A-Za-z0-9 +/()._-]{1,60}$")
MATCH_FIELDS = {
    "vendor": (re.compile(r"^[0-9a-f]{4}$"), "ID_VENDOR_ID"),
    "product": (re.compile(r"^[0-9a-f]{4}$"), "ID_MODEL_ID"),
    "serial": (re.compile(r"^[A-Za-z0-9._-]{1,64}$"), "ID_SERIAL_SHORT"),
    "interface": (re.compile(r"^[0-9]{2}$"), "ID_USB_INTERFACE_NUM"),
    # The USB socket: tells apart two sound cards with no serial number.
    "path": (re.compile(r"^[A-Za-z0-9:._+-]{1,128}$"), "ID_PATH"),
}


class SettingsError(ValueError):
    pass


def hamlib_models():
    """Model numbers rigctl knows, or None if rigctl isn't installed."""
    if not shutil.which("rigctl"):
        return None
    out = subprocess.run(["rigctl", "-l"], capture_output=True, text=True, check=False).stdout
    return {int(m.group(1)) for m in re.finditer(r"^\s*(\d+)\s", out, re.M)}


def clean_match(value, what):
    if not isinstance(value, dict):
        raise SettingsError(f"{what}: pick a device")
    match = {}
    for key, raw in value.items():
        if key not in MATCH_FIELDS:
            raise SettingsError(f"{what}: unexpected field {key!r}")
        if raw in (None, ""):
            continue
        text = str(raw).lower() if key in ("vendor", "product") else str(raw)
        if not MATCH_FIELDS[key][0].match(text):
            raise SettingsError(f"{what}: {key} {raw!r} isn't valid")
        match[key] = text
    if "vendor" not in match or "product" not in match:
        raise SettingsError(f"{what}: needs a USB vendor and product ID")
    return match


def validate(raw):
    """Return cleaned settings, or raise SettingsError."""
    callsign = str(raw.get("callsign", "")).strip().upper()
    if not CALLSIGN_RE.match(callsign):
        raise SettingsError(f"callsign doesn't look valid: {callsign!r}")

    grid = str(raw.get("grid", "")).strip()
    grid = grid[:4].upper() + grid[4:].lower()
    if not GRID_RE.match(grid.upper()):
        raise SettingsError(f"grid square should look like FN31 or FN31pr: {grid!r}")

    radio_name = str(raw.get("radio_name", "")).strip()
    if not NAME_RE.match(radio_name):
        raise SettingsError("pick a radio")

    try:
        rig_model = int(raw.get("rig_model"))
    except (TypeError, ValueError):
        raise SettingsError("pick a radio model") from None
    known = hamlib_models()
    if rig_model < 1 or (known is not None and rig_model not in known):
        raise SettingsError(f"Hamlib doesn't know rig model {rig_model}")

    try:
        baud = int(raw.get("cat_baud"))
    except (TypeError, ValueError):
        raise SettingsError("baud rate must be a number") from None
    if baud not in BAUD_RATES:
        raise SettingsError(f"baud rate must be one of {', '.join(map(str, BAUD_RATES))}")

    cat_match = clean_match(raw.get("cat_match"), "CAT port")

    ptt = str(raw.get("ptt_method", "")).upper()
    if ptt not in PTT_METHODS:
        raise SettingsError(f"PTT must be one of {', '.join(PTT_METHODS)}")
    ptt_match = None
    if ptt in ("RTS", "DTR"):
        if raw.get("ptt_match") == "cat":
            ptt_match = "cat"
        else:
            ptt_match = clean_match(raw.get("ptt_match"), "PTT port")

    audio_match = None
    if raw.get("audio_match"):
        audio_match = clean_match(raw.get("audio_match"), "Sound card")

    gps_match = None
    if raw.get("gps_match"):
        gps_match = clean_match(raw.get("gps_match"), "GPS")
        if gps_match == cat_match or gps_match == ptt_match:
            raise SettingsError("the GPS can't use the radio's port")

    # The computer's time zone, for the launcher's local clock. Left as it is when not given.
    timezone = raw.get("timezone") or None
    if timezone is not None:
        timezone = str(timezone)
        if not ZONE_RE.match(timezone) or not os.path.isfile(os.path.join(ZONEINFO, timezone)):
            raise SettingsError(f"unknown time zone: {timezone!r}")

    return {"callsign": callsign, "grid": grid, "timezone": timezone,
            "radio_name": radio_name, "rig_model": rig_model,
            "cat_baud": baud, "cat_match": cat_match, "ptt_method": ptt, "ptt_match": ptt_match,
            "audio_match": audio_match, "gps_match": gps_match}


def validate_aprs(raw):
    """The APRS radio's devices: a sound card, and a serial port keyed by RTS (or none)."""
    if not isinstance(raw, dict):
        raise SettingsError("pick the APRS radio's sound card")
    if not raw.get("audio_match"):
        return {"audio_match": None, "ptt_match": None}
    audio = clean_match(raw.get("audio_match"), "APRS sound card")
    ptt = clean_match(raw["ptt_match"], "APRS PTT port") if raw.get("ptt_match") else None
    return {"audio_match": audio, "ptt_match": ptt}


def render_aprs(a):
    rules = ["# Written by emcomm-apply-settings. Change it in Settings > APRS iGate."]
    if a["audio_match"]:
        rules += ['# APRS radio sound card -> ALSA card id "aprsaudio"',
                  f'SUBSYSTEM=="sound", KERNEL=="card*", {udev_match(a["audio_match"])}, ATTR{{id}}="aprsaudio"']
    if a["ptt_match"]:
        rules += ["# APRS radio PTT serial port (RTS) -> /dev/aprs-ptt",
                  f'SUBSYSTEM=="tty", {udev_match(a["ptt_match"])}, SYMLINK+="aprs-ptt"']
    return "\n".join(rules) + "\n"


def apply_aprs(a):
    write(APRS_SETTINGS, json.dumps(a, indent=2) + "\n")
    write(APRS_RULES, render_aprs(a))
    if ROOT:
        return
    subprocess.run(["udevadm", "control", "--reload"], check=False)
    subprocess.run(["udevadm", "trigger", "--subsystem-match=tty", "--subsystem-match=sound"], check=False)
    subprocess.run(["udevadm", "settle", "--timeout=5"], check=False)


def udev_match(match):
    return ", ".join(f'ENV{{{MATCH_FIELDS[k][1]}}}=="{v}"' for k, v in sorted(match.items()))


def render(s):
    rules = [
        f"# Written by emcomm-apply-settings for {s['radio_name']}. Change it in Settings.",
        "# CAT serial port -> /dev/rig-cat. Plugging the radio in starts rigctld.",
        f'SUBSYSTEM=="tty", {udev_match(s["cat_match"])}, SYMLINK+="rig-cat", '
        'TAG+="systemd", ENV{SYSTEMD_WANTS}+="rigctld.service"',
    ]
    if isinstance(s["ptt_match"], dict):
        rules += ["# PTT serial port -> /dev/rig-ptt",
                  f'SUBSYSTEM=="tty", {udev_match(s["ptt_match"])}, SYMLINK+="rig-ptt"']
    if s["audio_match"]:
        rules += ['# Sound card -> ALSA card id "rigaudio"',
                  f'SUBSYSTEM=="sound", KERNEL=="card*", {udev_match(s["audio_match"])}, ATTR{{id}}="rigaudio"']
    # GPS -> /dev/gps0, which gpsd reads. Without a choice in Settings, any u-blox
    # receiver (most USB GPS pucks) is used; their USB ID is never a radio's.
    gps = udev_match(s["gps_match"]) if s.get("gps_match") else 'ENV{ID_VENDOR_ID}=="1546"'
    rules += ["# GPS -> /dev/gps0. Plugging it in starts gpsd, which sets the clock through chrony.",
              f'SUBSYSTEM=="tty", {gps}, SYMLINK+="gps0", TAG+="systemd", ENV{{SYSTEMD_WANTS}}+="gpsd.service"']

    args = [f"--model={s['rig_model']}", "--rig-file=/dev/rig-cat",
            f"--serial-speed={s['cat_baud']}", f"--ptt-type={s['ptt_method']}"]
    if s["ptt_match"] == "cat":
        args.append("--ptt-file=/dev/rig-cat")
    elif s["ptt_match"]:
        args.append("--ptt-file=/dev/rig-ptt")
    rigctld_env = (f"# Written by emcomm-apply-settings for {s['radio_name']}.\n"
                   f"RIGCTLD_ARGS=\"{' '.join(args)}\"\n")

    station_env = "".join(f"{k}={v}\n" for k, v in [
        ("STATION_CALLSIGN", s["callsign"]),
        ("STATION_GRID", s["grid"]),
        ("STATION_RADIO", f'"{s["radio_name"]}"'),
        ("PTT_METHOD", s["ptt_method"]),
        ("RIGCTLD_HOST", "127.0.0.1"),
        ("RIGCTLD_PORT", "4532"),
    ])
    return "\n".join(rules) + "\n", rigctld_env, station_env


def write(path, text, mode=0o644):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = f"{path}.tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(text)
    os.chmod(tmp, mode)
    os.replace(tmp, path)


def apply(settings):
    rules, rigctld_env, station_env = render(settings)
    write(UDEV_RULES, rules)
    write(f"{ETC}/rigctld.env", rigctld_env)
    write(f"{ETC}/station.env", station_env)
    if ROOT:
        return
    subprocess.run(["udevadm", "control", "--reload"], check=False)
    subprocess.run(["udevadm", "trigger", "--subsystem-match=tty", "--subsystem-match=sound"], check=False)
    subprocess.run(["udevadm", "settle", "--timeout=5"], check=False)
    subprocess.run(["systemctl", "daemon-reload"], check=False)
    if os.path.exists("/dev/rig-cat"):
        subprocess.run(["systemctl", "restart", "rigctld"], check=False)
    else:
        subprocess.run(["systemctl", "stop", "rigctld"], check=False)
    if shutil.which("gpsd") and os.path.exists("/dev/gps0"):
        subprocess.run(["systemctl", "restart", "gpsd"], check=False)
    if settings.get("timezone") and settings["timezone"] != current_zone():
        set_zone(settings["timezone"])


def current_zone():
    link = os.path.realpath("/etc/localtime")
    return link.split("zoneinfo/", 1)[1] if "zoneinfo/" in link else ""


def set_zone(name):
    """Set the computer's time zone: timedatectl where systemd runs it, else the files it would write."""
    if shutil.which("timedatectl") and subprocess.run(["timedatectl", "set-timezone", name],
                                                      check=False).returncode == 0:
        return
    tmp = "/etc/localtime.emcomm"
    if os.path.lexists(tmp):
        os.unlink(tmp)
    os.symlink(f"/usr/share/zoneinfo/{name}", tmp)
    os.replace(tmp, "/etc/localtime")
    write("/etc/timezone", name + "\n")


def main(argv):
    if len(argv) == 2 and argv[0] == "--aprs":
        try:
            with open(argv[1], encoding="utf-8") as f:
                aprs = validate_aprs(json.load(f))
        except (OSError, ValueError) as exc:
            print(f"Not saved: {exc}", file=sys.stderr)
            return 1
        apply_aprs(aprs)
        print("Saved. " + ("No APRS radio." if not aprs["audio_match"] else
                           "Receive only: no PTT port." if not aprs["ptt_match"] else
                           "The APRS radio transmits through its PTT port."))
        return 0
    check_only = "--check" in argv
    paths = [a for a in argv if a != "--check"]
    source = paths[0] if paths else SETTINGS
    try:
        with open(source, encoding="utf-8") as f:
            settings = validate(json.load(f))
    except (OSError, ValueError) as exc:
        print(f"Settings not saved: {exc}", file=sys.stderr)
        return 1
    if check_only:
        print("Settings OK")
        return 0
    write(SETTINGS, json.dumps(settings, indent=2) + "\n")
    apply(settings)
    print(f"Saved. {settings['callsign']} on {settings['radio_name']}, "
          f"{settings['cat_baud']} baud, PTT {settings['ptt_method']}.")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
