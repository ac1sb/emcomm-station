#!/usr/bin/env python3
"""Apply station settings: validate them, then write the radio's udev rules,
rigctld arguments and station.env, and restart rig control.

Runs as root. The launcher's Settings screen calls it through sudo with a
candidate settings file; the playbook calls it with no argument to apply the
current settings.

  emcomm-apply-settings                 apply /etc/emcomm/station.json
  emcomm-apply-settings NEW.json        validate NEW.json, install it, apply
  emcomm-apply-settings --check NEW.json  validate only

Radio-specific udev matches come only from the root-owned profiles in
/usr/share/emcomm/radios, never from the settings file.
"""

import json
import os
import re
import subprocess
import sys

ROOT = os.environ.get("EMCOMM_ROOT", "")  # tests render into a scratch tree
ETC = f"{ROOT}/etc/emcomm"
SETTINGS = f"{ETC}/station.json"
PROFILES = f"{ROOT}/usr/share/emcomm/radios"
UDEV_RULES = f"{ROOT}/etc/udev/rules.d/99-emcomm-radio.rules"

BAUD_RATES = (4800, 9600, 19200, 38400, 57600, 115200)
PTT_METHODS = ("RTS", "DTR", "CAT", "NONE")
CALLSIGN_RE = re.compile(r"^[A-Z0-9]{1,3}[0-9][A-Z0-9]{0,4}(/[A-Z0-9]{1,4})?$")
GRID_RE = re.compile(r"^[A-R]{2}[0-9]{2}([A-X]{2})?$")
PROFILE_RE = re.compile(r"^[a-z0-9][a-z0-9-]{0,40}$")


class SettingsError(ValueError):
    pass


def load_profile(radio_id):
    if not PROFILE_RE.match(radio_id or ""):
        raise SettingsError(f"unknown radio profile: {radio_id!r}")
    path = f"{PROFILES}/{radio_id}.json"
    try:
        with open(path, encoding="utf-8") as f:
            return json.load(f)
    except OSError:
        raise SettingsError(f"unknown radio profile: {radio_id!r}") from None


def validate(raw):
    """Return cleaned settings plus the radio profile, or raise SettingsError."""
    callsign = str(raw.get("callsign", "")).strip().upper()
    if not CALLSIGN_RE.match(callsign):
        raise SettingsError(f"callsign doesn't look valid: {callsign!r}")

    grid = str(raw.get("grid", "")).strip()
    grid = grid[:4].upper() + grid[4:].lower()
    if not GRID_RE.match(grid[:4] + grid[4:].upper()):
        raise SettingsError(f"grid square should look like FN31 or FN31pr: {grid!r}")

    profile = load_profile(raw.get("radio"))

    try:
        baud = int(raw.get("cat_baud", profile["cat_baud"]))
    except (TypeError, ValueError):
        raise SettingsError("baud rate must be a number") from None
    if baud not in BAUD_RATES:
        raise SettingsError(f"baud rate must be one of {', '.join(map(str, BAUD_RATES))}")

    ptt = str(raw.get("ptt_method", profile["ptt_method"])).upper()
    if ptt not in PTT_METHODS:
        raise SettingsError(f"PTT must be one of {', '.join(PTT_METHODS)}")
    if ptt in ("RTS", "DTR") and not profile.get("ptt_udev_match"):
        raise SettingsError(f"{profile['radio_name']} has no separate PTT port; use CAT or NONE (VOX)")

    clean = {"callsign": callsign, "grid": grid, "radio": raw["radio"], "cat_baud": baud, "ptt_method": ptt}
    return clean, profile


def write(path, text, mode=0o644):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = f"{path}.tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write(text)
    os.chmod(tmp, mode)
    os.replace(tmp, path)


def render(settings, profile):
    name = profile["radio_name"]
    rules = [
        f"# Written by emcomm-apply-settings for {name}. Change it in Settings.",
        "# CAT serial port -> /dev/rig-cat. Plugging the radio in starts rigctld.",
        f'SUBSYSTEM=="tty", {profile["cat_udev_match"]}, SYMLINK+="rig-cat", '
        'TAG+="systemd", ENV{SYSTEMD_WANTS}+="rigctld.service"',
    ]
    if profile.get("ptt_udev_match"):
        rules += ["# PTT serial port -> /dev/rig-ptt",
                  f'SUBSYSTEM=="tty", {profile["ptt_udev_match"]}, SYMLINK+="rig-ptt"']
    rules += ["# Sound card -> ALSA card id \"rigaudio\"",
              f'SUBSYSTEM=="sound", KERNEL=="card*", {profile["audio_udev_match"]}, ATTR{{id}}="rigaudio"']

    args = [f"--model={int(profile['rig_model'])}", "--rig-file=/dev/rig-cat",
            f"--serial-speed={settings['cat_baud']}", f"--ptt-type={settings['ptt_method']}"]
    if settings["ptt_method"] in ("RTS", "DTR"):
        args.append("--ptt-file=/dev/rig-ptt")
    rigctld_env = (f"# Written by emcomm-apply-settings for {name}.\n"
                   f"RIGCTLD_ARGS=\"{' '.join(args)}\"\n")

    station_env = "".join(f"{k}={v}\n" for k, v in [
        ("STATION_CALLSIGN", settings["callsign"]),
        ("STATION_GRID", settings["grid"]),
        ("STATION_RADIO", f'"{name}"'),
        ("PTT_METHOD", settings["ptt_method"]),
        ("RIGCTLD_HOST", "127.0.0.1"),
        ("RIGCTLD_PORT", "4532"),
    ])
    return "\n".join(rules) + "\n", rigctld_env, station_env


def apply(settings, profile):
    rules, rigctld_env, station_env = render(settings, profile)
    write(UDEV_RULES, rules)
    write(f"{ETC}/rigctld.env", rigctld_env)
    write(f"{ETC}/station.env", station_env)
    if ROOT:
        return
    subprocess.run(["udevadm", "control", "--reload"], check=False)
    subprocess.run(["udevadm", "trigger", "--subsystem-match=tty", "--subsystem-match=sound"], check=False)
    subprocess.run(["udevadm", "settle", "--timeout=5"], check=False)
    subprocess.run(["systemctl", "daemon-reload"], check=False)
    if os.path.exists("/dev/rig-cat"):
        subprocess.run(["systemctl", "restart", "rigctld"], check=False)
    else:
        subprocess.run(["systemctl", "stop", "rigctld"], check=False)


def main(argv):
    check_only = "--check" in argv
    paths = [a for a in argv if a != "--check"]
    source = paths[0] if paths else SETTINGS
    try:
        with open(source, encoding="utf-8") as f:
            raw = json.load(f)
        settings, profile = validate(raw)
    except (OSError, ValueError) as exc:
        print(f"Settings not saved: {exc}", file=sys.stderr)
        return 1
    if check_only:
        print("Settings OK")
        return 0
    write(SETTINGS, json.dumps(settings, indent=2) + "\n")
    apply(settings, profile)
    print(f"Saved. {settings['callsign']} on {profile['radio_name']}, {settings['cat_baud']} baud, PTT {settings['ptt_method']}.")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
