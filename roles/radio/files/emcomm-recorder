#!/usr/bin/env python3
"""Record the radio's receive audio, so a net or a message can be listened to again.

  emcomm-recorder run [--all] [--threshold DB]   record until stopped (SIGTERM)
  emcomm-recorder play FILE                      play a recording, never through the radio

By default it records only while there's a signal (voice-activated): a new file
starts when the audio rises above the threshold (-40 dBFS unless given) and
ends a few seconds after it falls back. --all records everything, in files of
up to an hour. Files are 8 kHz mono WAV in ~/Recordings/DATE/, named with the
UTC time, frequency and mode. Other apps can use the radio's audio meanwhile.
Nothing is deleted to make room: when the disk is nearly full (DISK_STOP) it pauses
until recordings are deleted, and the launcher warns well before that.
"""

import array
import json
import math
import os
import shutil
import signal
import socket
import subprocess
import sys
import time
import wave

RECORDINGS = os.path.expanduser("~/Recordings")
STATUS = os.path.expanduser("~/.local/state/emcomm/recorder.json")
RATE = 8000
CHUNK = RATE // 10 * 2          # 100 ms of 16-bit mono
PRE_ROLL = 5                     # chunks kept from before the signal (0.5 s)
HANG = 30                        # chunks of quiet before a file ends (3 s)
MAX_CHUNKS = 3600 * 10           # an hour per file
DISK_STOP = 95                   # % of the disk used: recording pauses, so the system keeps room
MIN_FREE = 512 * 1024 ** 2       # and below this much free, on a small disk
ROOM_CHECK = 100                 # chunks between disk checks while a file is open (10 s)
RIGCTLD = ("127.0.0.1", 4532)
AUDIO_CMD = os.environ.get("EMCOMM_AUDIO", "emcomm-audio")


def level_db(chunk):
    """RMS level of 16-bit little-endian samples, in dB below full scale."""
    samples = array.array("h", chunk[:len(chunk) // 2 * 2])
    if sys.byteorder == "big":
        samples.byteswap()
    if not samples:
        return -96.0
    rms = math.sqrt(sum(s * s for s in samples) / len(samples))
    return 20 * math.log10(rms / 32768) if rms >= 1 else -96.0


class Segmenter:
    """Decides, chunk by chunk, when a recording starts and stops."""

    def __init__(self, threshold=-40.0, everything=False):
        self.threshold, self.everything = threshold, everything
        self.pre, self.open, self.quiet, self.length = [], False, 0, 0

    def feed(self, chunk):
        """Returns ("start", [chunks]) / ("write", [chunk]) / ("stop", [chunk]) / (None, [])."""
        loud = self.everything or level_db(chunk) > self.threshold
        if not self.open:
            if loud:
                self.open, self.quiet, self.length = True, 0, len(self.pre) + 1
                chunks, self.pre = self.pre + [chunk], []
                return "start", chunks
            self.pre = (self.pre + [chunk])[-PRE_ROLL:]
            return None, []
        self.length += 1
        self.quiet = 0 if loud else self.quiet + 1
        if self.quiet >= HANG or self.length >= MAX_CHUNKS:
            self.open = False
            return "stop", [chunk]
        return "write", [chunk]


def rig_query(command):
    try:
        with socket.create_connection(RIGCTLD, timeout=0.5) as s:
            s.sendall(command.encode() + b"\n")
            return s.recv(256).decode().split("\n")[0].strip()
    except OSError:
        return ""


def file_name(now=None, freq=None, mode=None):
    now = now or time.time()
    folder = os.path.join(RECORDINGS, time.strftime("%Y-%m-%d", time.gmtime(now)))
    parts = [time.strftime("%H%M%SZ", time.gmtime(now))]
    try:
        parts.append(f"{int(freq) / 1e6:.3f}")
    except (TypeError, ValueError):
        pass
    if mode and mode.isalnum():
        parts.append(mode)
    return os.path.join(folder, " ".join(parts) + ".wav")


def disk_room(folder=RECORDINGS):
    """(percent of the disk used, bytes free) for the disk the recordings go on, or None."""
    path = folder
    while not os.path.exists(path) and os.path.dirname(path) != path:
        path = os.path.dirname(path)  # ~/Recordings before its first recording
    try:
        usage = shutil.disk_usage(path)
    except OSError:
        return None
    return 100 * usage.used / usage.total if usage.total else 0, usage.free


def out_of_room(folder=RECORDINGS):
    """Why recording must pause for space, or None while there's room."""
    room = disk_room(folder)
    if room and (room[0] >= DISK_STOP or room[1] < MIN_FREE):
        return (f"Paused: the disk is {room[0]:.0f}% full. Delete recordings (or other files) and "
                "recording carries on by itself.")
    return None


def write_status(**status):
    os.makedirs(os.path.dirname(STATUS), exist_ok=True)
    with open(STATUS + ".tmp", "w", encoding="utf-8") as f:
        json.dump(dict(status, pid=os.getpid(), time=int(time.time())), f)
    os.replace(STATUS + ".tmp", STATUS)


def audio_helper(command):
    """A line from emcomm-audio (the radio's receive audio, the listening speaker), or None."""
    try:
        result = subprocess.run([AUDIO_CMD, command], capture_output=True, text=True, timeout=10, check=False)
    except (OSError, subprocess.TimeoutExpired):
        return None
    return result.stdout.strip() or None if result.returncode == 0 else None


def run(everything=False, threshold=-40.0):
    stopping = []
    signal.signal(signal.SIGTERM, lambda *_: stopping.append(1))
    signal.signal(signal.SIGINT, lambda *_: stopping.append(1))
    mode_name = "everything" if everything else "voice"
    # The radio's own receive audio, named: the default microphone isn't always the
    # radio (desktop mode, or the radio unplugged), and a room mic mustn't be recorded.
    source = audio_helper("radio-source")
    while source is None and not stopping:
        write_status(mode=mode_name, recording=False, waiting=True,
                     error="Waiting for the radio's sound card to be plugged in.")
        for _ in range(10):
            if stopping:
                break
            time.sleep(0.5)
        source = audio_helper("radio-source")
    if stopping:
        try:
            os.remove(STATUS)
        except OSError:
            pass
        return 0
    parec = subprocess.Popen(["parec", f"--device={source}", "--raw", "--format=s16le", f"--rate={RATE}",
                              "--channels=1", "--latency-msec=100", "--client-name=Recorder"],
                             stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    seg, out, path, since, last_status = Segmenter(threshold, everything), None, None, None, 0
    failed, full, written = False, None, 0
    try:
        while not stopping:
            chunk = parec.stdout.read(CHUNK)
            if not chunk:
                failed = True
                write_status(mode=mode_name, error="Stopped: no audio from the radio's sound card.",
                             recording=False)
                return 1
            action, chunks = seg.feed(chunk)
            if action == "start" or (out and written % ROOM_CHECK == 0):
                full = out_of_room()
            if full and out:  # keep what's recorded so far
                out.close()
                os.replace(path + ".part", path)
                out = None
            if full:
                action = None
            elif action == "start" or (action == "write" and not out and seg.open):
                action = "start"  # room again (or never had it) during a signal: start a file
            try:
                if action == "start":
                    written = 0
                    path = file_name(freq=rig_query("f"), mode=rig_query("m"))
                    os.makedirs(os.path.dirname(path), exist_ok=True)
                    out = wave.open(path + ".part", "wb")
                    out.setnchannels(1)
                    out.setsampwidth(2)
                    out.setframerate(RATE)
                    since = time.time()
                if out:
                    out.writeframes(b"".join(chunks))
                    written += 1
                if action == "stop" and out:
                    out.close()
                    os.replace(path + ".part", path)
                    out = None
            except OSError as exc:  # the disk is full, or the folder went away
                failed, out = True, None
                try:
                    write_status(mode=mode_name, error=f"Stopped: couldn't write the recording ({exc.strerror or exc}).",
                                 recording=False)
                except OSError:
                    pass
                return 1
            if time.time() - last_status >= 0.5:
                last_status = time.time()
                if full:
                    full = out_of_room()  # room made since: recording carries on
                write_status(mode=mode_name, level=round(level_db(chunk), 1), recording=bool(out),
                             file=os.path.basename(path) if out else None, since=since if out else None,
                             **({"error": full, "full": True} if full else {}))
    finally:
        if out:
            try:
                out.close()
                os.replace(path + ".part", path)
            except OSError:
                pass
        parec.terminate()
        if not failed:  # an error stays for the Recorder page to show
            try:
                os.remove(STATUS)
            except OSError:
                pass
    return 0


def play(path):
    sink = audio_helper("speaker")
    if sink is None:
        print("Plug in headphones or a speaker, or pick one in Settings > Audio. Recordings never "
              "play through a radio, so they can't key it by VOX.", file=sys.stderr)
        return 1
    return subprocess.run(["pw-play", f"--target={sink}", path], check=False).returncode


def main(argv):
    if argv[:1] == ["run"]:
        threshold = -40.0
        if "--threshold" in argv:
            threshold = float(argv[argv.index("--threshold") + 1])
        return run("--all" in argv, threshold)
    if argv[:1] == ["play"] and len(argv) == 2:
        return play(argv[1])
    print(__doc__.strip(), file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
