#!/usr/bin/env python3
"""Listen to NOAA Weather Radio on an RTL-SDR dongle and save the SAME alerts
for the station's counties, with no internet.

  emcomm-nwr            run (the emcomm-nwr service does this as the station user)
  emcomm-nwr --decode   read multimon-ng lines on stdin and print what's kept (for testing)

rtl_fm receives the channel and multimon-ng decodes the SAME bursts sent at the
start of every alert. Alerts go to ~/.cache/emcomm/online/nwr.json in the same
shape as the internet weather alerts, so the launcher shows both together.
Settings are in ~/.config/emcomm/nwr.json, written by the launcher:
  {"freq": 162.55, "codes": ["025017"], "ppm": 0}
codes are 6-digit SAME location codes; none means keep every alert heard.
While the Scanner or Gqrx holds the dongle (~/.local/state/emcomm/sdr.json names
it and its process), the listener lets go and waits. It uses the first RTL-SDR that
isn't the ADS-B receiver (emcomm-adsb).
"""

import calendar
import ctypes
import ctypes.util
import json
import os
import re
import subprocess
import sys
import threading
import time

CONFIG = os.path.expanduser("~/.config/emcomm/nwr.json")
CACHE = os.path.join(os.environ.get("EMCOMM_ONLINE_CACHE", os.path.expanduser("~/.cache/emcomm/online")),
                     "nwr.json")
SDR_LOCK = os.path.expanduser("~/.local/state/emcomm/sdr.json")  # written by the Scanner and Gqrx tiles
ADSB_CONFIG = os.path.expanduser("~/.config/emcomm/adsb.json")  # the ADS-B dongle's serial (emcomm-adsb)
ADSB_MARK = "00001090"
CHANNELS = (162.400, 162.425, 162.450, 162.475, 162.500, 162.525, 162.550)
HEADER_RE = re.compile(r"^EAS: ZCZC-([A-Z]{3})-([A-Z]{3})-((?:\d{6}-?)+)\+(\d{4})-(\d{7})-([^-]{1,8})-?")
TESTS = {"RWT", "RMT", "DMO", "NPT"}
ORIGINATORS = {"WXR": "National Weather Service", "CIV": "Civil authorities", "EAS": "Broadcast station",
               "PEP": "National Public Warning System"}
# SAME event codes: (name, severity in the NWS's words).
EVENTS = {
    "TOR": ("Tornado Warning", "Extreme"), "EWW": ("Extreme Wind Warning", "Extreme"),
    "SVR": ("Severe Thunderstorm Warning", "Severe"), "FFW": ("Flash Flood Warning", "Severe"),
    "TSW": ("Tsunami Warning", "Extreme"), "HUW": ("Hurricane Warning", "Extreme"),
    "SSW": ("Storm Surge Warning", "Extreme"), "TRW": ("Tropical Storm Warning", "Severe"),
    "BZW": ("Blizzard Warning", "Severe"), "WSW": ("Winter Storm Warning", "Severe"),
    "HWW": ("High Wind Warning", "Severe"), "FLW": ("Flood Warning", "Severe"),
    "CFW": ("Coastal Flood Warning", "Severe"), "DSW": ("Dust Storm Warning", "Severe"),
    "FRW": ("Fire Warning", "Severe"), "AVW": ("Avalanche Warning", "Severe"),
    "SMW": ("Special Marine Warning", "Severe"), "EQW": ("Earthquake Warning", "Extreme"),
    "VOW": ("Volcano Warning", "Severe"), "TOA": ("Tornado Watch", "Moderate"),
    "SVA": ("Severe Thunderstorm Watch", "Moderate"), "FFA": ("Flash Flood Watch", "Moderate"),
    "FLA": ("Flood Watch", "Moderate"), "HUA": ("Hurricane Watch", "Moderate"),
    "TRA": ("Tropical Storm Watch", "Moderate"), "SSA": ("Storm Surge Watch", "Moderate"),
    "TSA": ("Tsunami Watch", "Moderate"), "WSA": ("Winter Storm Watch", "Moderate"),
    "HWA": ("High Wind Watch", "Moderate"), "CFA": ("Coastal Flood Watch", "Moderate"),
    "AVA": ("Avalanche Watch", "Moderate"), "SPS": ("Special Weather Statement", "Minor"),
    "SVS": ("Severe Weather Statement", "Moderate"), "FFS": ("Flash Flood Statement", "Moderate"),
    "FLS": ("Flood Statement", "Minor"), "HLS": ("Hurricane Local Statement", "Moderate"),
    "EAN": ("Emergency Action Notification", "Extreme"), "CEM": ("Civil Emergency Message", "Extreme"),
    "EVI": ("Evacuation Immediate", "Extreme"), "SPW": ("Shelter in Place Warning", "Extreme"),
    "HMW": ("Hazardous Materials Warning", "Extreme"), "NUW": ("Nuclear Power Plant Warning", "Extreme"),
    "RHW": ("Radiological Hazard Warning", "Extreme"), "LEW": ("Law Enforcement Warning", "Severe"),
    "LAE": ("Local Area Emergency", "Severe"), "TOE": ("911 Telephone Outage Emergency", "Severe"),
    "CDW": ("Civil Danger Warning", "Extreme"), "CAE": ("Child Abduction Emergency", "Moderate"),
    "BLU": ("Blue Alert", "Moderate"), "ADR": ("Administrative Message", "Minor"),
    "NMN": ("Network Message Notification", "Minor"),
    "RWT": ("Required Weekly Test", "Test"), "RMT": ("Required Monthly Test", "Test"),
    "DMO": ("Practice/Demo Warning", "Test"), "NPT": ("National Periodic Test", "Test"),
}


def parse_header(line, now=None):
    """One decoded SAME header as a dict, or None if the line isn't one."""
    m = HEADER_RE.match(line.strip())
    if not m:
        return None
    org, code, places, purge, issued, sender = m.groups()
    now = now or time.time()
    year = time.gmtime(now).tm_year
    day, hour, minute = int(issued[:3]), int(issued[3:5]), int(issued[5:7])
    start = None
    for y in (year, year - 1):  # an alert issued on 31 December, heard on 1 January
        start = calendar.timegm(time.strptime(f"{y} {day:03d} {hour:02d} {minute:02d}", "%Y %j %H %M"))
        if start <= now + 86400:
            break
    name, severity = EVENTS.get(code, (f"{code} alert", "Unknown"))
    return {"code": code, "event": name, "severity": severity, "originator": ORIGINATORS.get(org, org),
            "places": [p for p in places.split("-") if p], "start": start,
            "end": start + int(purge[:2]) * 3600 + int(purge[2:]) * 60, "sender": sender.strip()}


def matches(places, codes):
    """Whether an alert for these SAME places covers any of the station's codes.
    A leading 0 is the whole county; county 000 is the whole state; 000000 everywhere."""
    if not codes:
        return True
    for place in places:
        if place == "000000":
            return True
        for code in codes:
            if place[1:] == code[1:] and (place[0] == "0" or code[0] == "0" or place[0] == code[0]):
                return True
            if place[3:] == "000" and place[1:3] == code[1:3]:
                return True
    return False


def as_alert(header, freq):
    """The launcher's alert shape (as emcomm-online gives for the NWS)."""
    iso = lambda t: time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(t))  # noqa: E731
    return {"event": header["event"], "severity": header["severity"], "urgency": "",
            "headline": f"{header['event']} from {header['originator']} ({header['sender']})",
            "area": "SAME " + ", ".join(header["places"]),
            "sender": f"NOAA Weather Radio {freq:.3f} MHz", "starts": iso(header["start"]),
            "ends": iso(header["end"]), "description": "", "instruction": "",
            "code": header["code"], "radio": True}


def load_record():
    try:
        with open(CACHE, encoding="utf-8") as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def save_record(record):
    os.makedirs(os.path.dirname(CACHE), exist_ok=True)
    tmp = f"{CACHE}.tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(record, f, indent=1)
    os.replace(tmp, CACHE)


def keep(record, header, codes, freq, now=None):
    """Add a decoded header to the saved record. Returns the alert if it was kept."""
    now = now or time.time()
    record["heard"] = int(now)
    if header["code"] in TESTS:
        record["last_test"] = {"event": header["event"], "time": int(now)}
        return None
    if not matches(header["places"], codes):
        return None
    alert = as_alert(header, freq)
    alerts = [a for a in record.get("data") or []
              if not (a.get("code") == alert["code"] and a.get("starts") == alert["starts"])]
    # Drop ended alerts so the file doesn't grow.
    cutoff = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(now))
    record["data"] = [a for a in alerts if a.get("ends", "") > cutoff] + [alert]
    record["updated"] = int(now)
    return alert


def load_config():
    try:
        with open(CONFIG, encoding="utf-8") as f:
            config = json.load(f)
    except (OSError, ValueError):
        config = {}
    freq = config.get("freq")
    codes = [str(c) for c in config.get("codes") or [] if re.fullmatch(r"\d{6}", str(c))]
    ppm = config.get("ppm") if isinstance(config.get("ppm"), int) else 0
    return (float(freq) if freq in CHANNELS else None), codes, ppm


def sdr_claimed():
    """The app holding the RTL-SDR for now (Scanner, Gqrx), if it's still running."""
    try:
        with open(SDR_LOCK, encoding="utf-8") as f:
            lock = json.load(f)
        os.kill(int(lock["pid"]), 0)
    except PermissionError:  # running as someone else: still running
        pass
    except (OSError, ValueError, KeyError, TypeError):
        return None
    return str(lock.get("app") or "another app")


def rtl_serials():
    """Each RTL-SDR dongle's serial number, in librtlsdr's order (empty if the library is missing)."""
    try:
        lib = ctypes.CDLL(ctypes.util.find_library("rtlsdr") or "librtlsdr.so.2")
    except OSError:
        return []
    lib.rtlsdr_get_device_count.restype = ctypes.c_uint32
    lib.rtlsdr_get_device_usb_strings.argtypes = [ctypes.c_uint32] + [ctypes.c_char_p] * 3
    serials = []
    for i in range(lib.rtlsdr_get_device_count()):
        bufs = [ctypes.create_string_buffer(256) for _ in range(3)]
        lib.rtlsdr_get_device_usb_strings(i, *bufs)
        serials.append(bufs[2].value.decode(errors="replace").strip())
    return serials


def adsb_serial():
    try:
        with open(ADSB_CONFIG, encoding="utf-8") as f:
            config = json.load(f)
    except (OSError, ValueError):
        config = {}
    if not isinstance(config, dict) or config.get("off"):
        return None
    return str(config.get("serial") or ADSB_MARK)


def weather_dongle(serials, adsb):
    """The index of the first dongle that isn't the ADS-B receiver, or None. With no list
    (librtlsdr missing), 0, and rtl_fm says whether there's a dongle."""
    if not serials:
        return 0
    return next((i for i, serial in enumerate(serials) if not adsb or serial != adsb), None)


def set_status(error=None, listening=None):
    record = load_record()
    record["tried"] = int(time.time())
    record["error"] = error
    record["listening"] = listening
    save_record(record)


def run():
    while True:
        freq, codes, ppm = load_config()
        if not freq:
            set_status("Weather radio isn't set up: pick your NOAA Weather Radio channel on the Online page.")
            time.sleep(10)
            continue
        claimed = sdr_claimed()
        if claimed:
            set_status(f"Paused while the {claimed} uses the RTL-SDR. Alerts resume when it closes.")
            time.sleep(2)
            continue
        dongle = weather_dongle(rtl_serials(), adsb_serial())
        if dongle is None:
            set_status("The only RTL-SDR is the ADS-B receiver. Plug in another for weather alerts.")
            time.sleep(10)
            continue
        stamp = os.path.getmtime(CONFIG)
        rtl = subprocess.Popen(["rtl_fm", "-d", str(dongle), "-f", f"{freq}M", "-M", "fm", "-s", "22050",
                                "-E", "dc", "-p", str(ppm), "-"], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        mm = subprocess.Popen(["multimon-ng", "-t", "raw", "-a", "EAS", "-q", "/dev/stdin"],
                              stdin=rtl.stdout, stdout=subprocess.PIPE, text=True, bufsize=1)
        rtl.stdout.close()
        set_status(None, freq)

        def read(lines=mm.stdout, codes=codes, freq=freq):
            for line in lines:
                header = parse_header(line)
                if header:
                    record = load_record()
                    keep(record, header, codes, freq)
                    save_record(record)

        threading.Thread(target=read, daemon=True).start()
        while rtl.poll() is None:
            if not os.path.exists(CONFIG) or os.path.getmtime(CONFIG) != stamp or sdr_claimed():
                break
            time.sleep(2)
        failed = rtl.poll() is not None and not sdr_claimed()
        for proc in (rtl, mm):
            if proc.poll() is None:
                proc.terminate()
            proc.wait()
        if failed:
            set_status("No RTL-SDR receiver found. Plug one in with an antenna for 162 MHz.")
            time.sleep(30)


def decode():
    freq, codes, _ppm = load_config()
    record = {}
    for line in sys.stdin:
        header = parse_header(line)
        if header:
            alert = keep(record, header, codes, freq or 0)
            print(json.dumps(alert or {"ignored": header["event"]}))
    return 0


if __name__ == "__main__":
    if "--decode" in sys.argv[1:]:
        sys.exit(decode())
    run()
