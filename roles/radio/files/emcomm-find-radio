#!/usr/bin/env python3
"""Find which radio is on a serial port, and at what baud rate.

  emcomm-find-radio PORT [MODEL]

PORT is a /dev/serial/by-id/ link (the CAT port picked in Settings > Radio); MODEL is
the Hamlib model shown there, if any. Rig control (rigctld) holds the radio's port, so
it's stopped while the port is tried and started again after. Runs as root: the
launcher calls it through sudo.

At each baud rate it asks the radio who it is, both ways radios answer:
  - Yaesu, Kenwood and Elecraft: "ID;" returns the radio's ID number.
  - Icom CI-V: "read transceiver ID" (19 00) returns the radio's CI-V address.
The answer names the radio (and so its Hamlib model). A radio that answers neither
(an older Yaesu with binary CAT, say) is tried with Hamlib as the MODEL given. Where
Hamlib is installed, its answer to "what frequency?" confirms what was found.

Prints one JSON object: {"found": true, "model", "name", "baud", "freq"} or
{"found": false, "why"}. Opening a serial port can pulse its RTS and DTR lines; they're
dropped at once, so a radio keyed by RTS on its CAT port doesn't stay keyed.
"""

import fcntl
import json
import os
import re
import shutil
import subprocess
import sys
import termios
import time

BAUDS = (4800, 9600, 19200, 38400, 57600, 115200)
PORT_RE = re.compile(r"^/dev/serial/by-id/[A-Za-z0-9._:+-]{1,200}$")
TESTING = os.environ.get("EMCOMM_FIND_TEST") == "1"  # tests use a pseudo-terminal, not a by-id link
TIMEOUT = float(os.environ.get("EMCOMM_FIND_TIMEOUT", "0.6"))

# "ID;" answers, from the radios' CAT manuals: the ID number -> the radio's name in Hamlib.
CAT_IDS = {
    "0800": "FT-710", "0650": "FT-891", "0570": "FT-991", "0761": "FTDX-10", "0681": "FTDX-101D",
    "0682": "FTDX-101MP", "0462": "FTDX-3000", "0583": "FTDX-1200", "0362": "FTDX-5000", "0310": "FT-950",
    "0251": "FT-2000", "0241": "FT-450", "0244": "FT-450D",
    "019": "TS-2000", "020": "TS-480", "021": "TS-590S", "022": "TS-990S", "023": "TS-590SG", "024": "TS-890S",
    "017": "K3",
}
# CI-V addresses (the radios' factory defaults) -> name in Hamlib.
CIV_ADDRESSES = {
    0x94: "IC-7300", 0xA4: "IC-705", 0xA2: "IC-9700", 0x98: "IC-7610", 0x88: "IC-7100", 0x70: "IC-7000",
    0x76: "IC-7200", 0x80: "IC-7410", 0x5E: "IC-718", 0x7C: "IC-9100", 0x58: "IC-706MkIIG", 0x8C: "ID-5100",
    0x8E: "IC-7851", 0xAC: "IC-905",
}
SPEEDS = {b: getattr(termios, f"B{b}") for b in BAUDS}


def open_port(path, baud):
    fd = os.open(path, os.O_RDWR | os.O_NOCTTY | os.O_NONBLOCK)
    try:
        # Drop RTS and DTR first: on some radios either one keys the transmitter.
        fcntl.ioctl(fd, termios.TIOCMBIC, (termios.TIOCM_RTS | termios.TIOCM_DTR).to_bytes(4, sys.byteorder))
    except OSError:
        pass  # a pseudo-terminal has no modem lines
    attrs = termios.tcgetattr(fd)
    attrs[0] = 0                                        # iflag: raw
    attrs[1] = 0                                        # oflag
    attrs[2] = termios.CS8 | termios.CREAD | termios.CLOCAL
    attrs[3] = 0                                        # lflag: no echo, no line editing
    attrs[4] = attrs[5] = SPEEDS[baud]
    termios.tcsetattr(fd, termios.TCSANOW, attrs)
    termios.tcflush(fd, termios.TCIOFLUSH)
    return fd


def ask(path, baud, data, done):
    """Send data and read until done(reply) or the timeout. Returns the bytes read."""
    try:
        fd = open_port(path, baud)
    except OSError:
        return b""
    reply = b""
    try:
        os.write(fd, data)
        deadline = time.monotonic() + TIMEOUT
        while time.monotonic() < deadline and not done(reply):
            try:
                chunk = os.read(fd, 256)
            except BlockingIOError:
                chunk = b""
            if chunk:
                reply += chunk
            else:
                time.sleep(0.02)
    except OSError:
        pass
    finally:
        os.close(fd)
    return reply


def cat_identity(path, baud):
    reply = ask(path, baud, b";ID;", lambda r: re.search(rb"ID\d{3,4};", r) is not None)
    m = re.search(rb"ID(\d{3,4});", reply)
    if m:
        number = m.group(1).decode()
        return CAT_IDS.get(number, f"radio ID {number}")
    return None


def civ_identity(path, baud):
    frame = re.compile(rb"\xfe\xfe\xe0(.)\x19\x00(.)\xfd", re.S)
    reply = ask(path, baud, b"\xfe\xfe\x00\xe0\x19\x00\xfd", lambda r: frame.search(r) is not None)
    m = frame.search(reply)
    if m:
        address = m.group(1)[0]
        return CIV_ADDRESSES.get(address, f"Icom radio at CI-V address {address:02X}h")
    return None


def hamlib_models():
    """{normalised name: (model number, name)} from rigctl -l."""
    try:
        out = subprocess.run(["rigctl", "-l"], capture_output=True, text=True, timeout=10).stdout
    except (OSError, subprocess.TimeoutExpired):
        return {}
    models = {}
    for line in out.splitlines()[1:]:
        parts = line.split()
        if len(parts) >= 3 and parts[0].isdigit():
            models[norm(parts[2])] = (int(parts[0]), parts[2])
    return models


def norm(name):
    return re.sub(r"[^a-z0-9]", "", name.lower())


def hamlib_freq(path, model, baud):
    """The frequency Hamlib reads with that model and baud rate, or None."""
    if not shutil.which("rigctl"):
        return None
    try:
        out = subprocess.run(["rigctl", "-m", str(model), "-r", path, "-s", str(baud), "f"],
                             capture_output=True, text=True, timeout=8).stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        return None
    first = out.splitlines()[0] if out else ""
    return first if first.isdigit() and int(first) > 0 else None


def find(path, model=None):
    models = hamlib_models()
    for baud in BAUDS:
        name = cat_identity(path, baud) or civ_identity(path, baud)
        if name:
            number = models.get(norm(name), (None, name))[0]
            freq = hamlib_freq(path, number, baud) if number else None
            return {"found": True, "model": number, "name": name, "baud": baud, "freq": freq}
    if model and shutil.which("rigctl"):
        for baud in BAUDS:
            freq = hamlib_freq(path, model, baud)
            if freq:
                name = next((n for _k, (num, n) in models.items() if num == model), f"model {model}")
                return {"found": True, "model": model, "name": name, "baud": baud, "freq": freq}
    return {"found": False, "why": "No radio answered at any baud rate. Check the radio is on, the cable is in, "
                                   "and this is the radio's CAT port (on a radio with two USB serial ports, "
                                   "the Enhanced or first one)."}


def rigctld(action):
    if not TESTING and shutil.which("systemctl"):
        subprocess.run(["systemctl", action, "rigctld"], check=False, capture_output=True)


def main(argv):
    if len(argv) not in (1, 2):
        print(__doc__.strip(), file=sys.stderr)
        return 2
    path = argv[0]
    model = None
    if len(argv) == 2:
        if not argv[1].isdigit():
            print(json.dumps({"found": False, "why": "the model must be a Hamlib model number"}))
            return 2
        model = int(argv[1])
    if not TESTING and (not PORT_RE.fullmatch(path) or not os.path.exists(path)):
        print(json.dumps({"found": False, "why": "That serial port isn't plugged in."}))
        return 1
    rigctld("stop")
    time.sleep(0 if TESTING else 0.5)  # let rigctld let go of the port
    try:
        result = find(path, model)
    finally:
        if os.path.exists(os.environ.get("EMCOMM_RIG_CAT", "/dev/rig-cat")):
            rigctld("start")
    print(json.dumps(result))
    return 0 if result["found"] else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
