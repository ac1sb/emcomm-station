# Managed by the emcomm-station playbook ({{ station_radio }}: {{ radio_name }}).
# Stable names so apps don't depend on USB plug order.

# CAT serial port -> /dev/rig-cat. Plugging the radio in starts rigctld.
SUBSYSTEM=="tty", {{ cat_udev_match }}, SYMLINK+="rig-cat", TAG+="systemd", ENV{SYSTEMD_WANTS}+="rigctld.service"

{% if ptt_method != 'CAT' %}
# PTT serial port -> /dev/rig-ptt
SUBSYSTEM=="tty", {{ ptt_udev_match }}, SYMLINK+="rig-ptt"
{% endif %}

# Sound card -> ALSA card id "rigaudio"
SUBSYSTEM=="sound", KERNEL=="card*", {{ audio_udev_match }}, ATTR{id}="rigaudio"
