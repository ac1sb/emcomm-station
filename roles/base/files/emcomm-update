#!/bin/bash
# Rebuild the station from its playbook, as root. The launcher runs this
# through sudo (see /etc/sudoers.d/emcomm-update), so the kiosk user can
# install apps and updates without a password or a root shell.
#
#   emcomm-update             download the latest playbook, then rebuild
#   emcomm-update --app NAME  install one app (a tag in roles/apps)
#
# Everything it prints is also saved in /var/log/emcomm-update.log (the run
# before is kept as .1), which the launcher's Logs page shows.
set -euo pipefail

APPS="js8call wsjtx fldigi qsstv flmsg pat ardop packet vara aprs meshtastic meshtastic-desktop meshcore meshy map browser chirp libreoffice library scanner sdr"
SOURCE_FILE=/etc/emcomm/playbook-dir

usage() { echo "usage: $0 [--app ${APPS// /|}]" >&2; exit 2; }

app=""
case "${1:-}" in
  "") ;;
  --app)
    app="${2:-}"
    [[ " $APPS " == *" $app "* ]] || usage
    ;;
  *) usage ;;
esac

refuse() {
  echo "Can't update: $1" >&2
  echo "As root (sudo -i, or su -), run: cd $dir && git pull && ansible-playbook site.yml" >&2
  exit 1
}

dir=$(cat "$SOURCE_FILE")
[ -f "$dir/site.yml" ] || refuse "there's no playbook at $dir."
# Only run a playbook the station user can't change: owned by root and not
# writable by anyone outside root's group.
read -r owner group mode < <(stat -c '%u %g %a' "$dir")
[ "$owner" = 0 ] || refuse "$dir belongs to user id $owner, not root."
(( 8#$mode & 8#002 )) && refuse "$dir can be changed by any user (mode $mode)."
(( (8#$mode & 8#020) && group != 0 )) && refuse "$dir can be changed by group id $group (mode $mode)."
cd "$dir"

LOG=/var/log/emcomm-update.log
[ -f "$LOG" ] && mv -f "$LOG" "$LOG.1"
install -m 0644 /dev/null "$LOG"
exec > >(tee -a "$LOG") 2>&1
echo "emcomm-update ${*:-} started $(date -u '+%Y-%m-%d %H:%M UTC')"

# What failed, in a few lines at the end, so it needn't be found in the scroll.
summary() {
  local rc=$?
  echo
  if [ "$rc" -ne 0 ]; then
    echo "== The update stopped with an error =="
    awk '/^TASK \[/ { task = $0 } /^fatal:|^failed:/ { print task; print substr($0, 1, 600) }' "$LOG" | tail -n 6
    echo
    echo "The whole log is on the Logs page (Station updates) and in $LOG."
  else
    grep -h "EMCOMM WARNING" "$LOG" | sed 's/^ *"msg": *"//; s/",\?$//' | sort -u || true
    echo "Done."
  fi
}
trap summary EXIT

if [ -z "$app" ]; then
  echo "== Downloading updates =="
  # Never stop to ask for a GitHub login: there's no one to type it.
  if [ -d .git ] && GIT_TERMINAL_PROMPT=0 git pull --ff-only; then
    :
  else
    echo "Couldn't download updates (no internet?). Rebuilding from the copy on this station."
  fi
  echo
  echo "== Rebuilding the station =="
  ansible-playbook site.yml
else
  echo "== Installing $app =="
  ansible-playbook site.yml --tags "$app"
fi
